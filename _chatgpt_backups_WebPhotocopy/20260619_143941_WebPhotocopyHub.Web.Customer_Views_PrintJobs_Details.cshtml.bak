@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
}

@model PrintJob
@{
    ViewData["Title"] = "Chi tiết đơn in";

    var isCompleted = Model.Status == PrintJobStatus.Completed;
    var createdAt = Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    var updatedAt = (Model.UpdatedAt ?? Model.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    var paidAt = Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận";
    var uploadedFileName = Model.UploadedFile?.OriginalFileName ?? "Không còn thông tin tên file";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">@(isCompleted ? "Completed print order" : "Print order detail")</span>
            <h1>@(isCompleted ? "Chi tiết đơn đã hoàn thành" : "Chi tiết đơn in")</h1>
            <p>Mã đơn: <span class="cu-code">@Model.Id</span></p>
            <div class="cu-actions">
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Quay lại danh sách</a>
                <a class="btn btn-primary" asp-action="DownloadFile" asp-route-id="@Model.UploadedFileId" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Tải lại file</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Trạng thái</span>
            <strong>@Model.Status.GetDisplayName()</strong>
            <small>Cập nhật gần nhất: @updatedAt</small>
        </aside>
    </section>

    @if (isCompleted)
    {
        <!-- Completed print-job review UI - start -->
        <div class="alert alert-success" role="status">
            <strong>Đơn này đã hoàn thành.</strong>
            Bạn vẫn có thể xem lại toàn bộ cấu hình, chi phí, ghi chú xử lý và file đã gửi.
        </div>
        <!-- Completed print-job review UI - end -->
    }

    <section class="cu-grid cu-grid--detail">
        <div class="cu-card">
            <div class="cu-section-head">
                <div>
                    <span class="cu-kicker">Thông tin in</span>
                    <h2>Thông tin đầy đủ của đơn</h2>
                </div>
                <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span>
            </div>

            <div class="cu-detail-list">
                <div><span>Ngày tạo</span><strong>@createdAt</strong></div>
                <div><span>Cập nhật gần nhất</span><strong>@updatedAt</strong></div>
                <div class="cu-detail-list__full"><span>Tên file</span><strong>@uploadedFileName</strong></div>

                <div><span>Khổ giấy</span><strong>@Model.PaperSize.GetDisplayName()</strong></div>
                <div><span>Kiểu in</span><strong>@Model.PrintSide.GetDisplayName()</strong></div>
                <div><span>Màu sắc</span><strong>@Model.ColorMode.GetDisplayName()</strong></div>
                <div><span>Loại tài liệu</span><strong>@(Model.IsPhoto ? "Ảnh" : "Tài liệu")</strong></div>
                <div><span>Số bản</span><strong>@Model.Copies</strong></div>
                <div><span>Số trang mỗi bản</span><strong>@Model.TotalPages</strong></div>
                <div><span>Tổng trang cần in</span><strong>@(Model.Copies * Model.TotalPages)</strong></div>

                <div><span>Đơn giá</span><strong>@Model.UnitPrice.ToString("N0") đ</strong></div>
                <div><span>Tạm tính</span><strong>@Model.SubTotal.ToString("N0") đ</strong></div>
                <div><span>Phí giao hàng</span><strong>@Model.ShippingFee.ToString("N0") đ</strong></div>
                <div><span>Tổng tiền</span><strong>@Model.TotalAmount.ToString("N0") đ</strong></div>
                <div><span>Thanh toán lúc</span><strong>@paidAt</strong></div>

                <div><span>Hình thức nhận</span><strong>@Model.DeliveryMethod.GetDisplayName()</strong></div>
                <div><span>Địa chỉ giao</span><strong>@(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "Nhận tại tiệm" : Model.DeliveryAddress)</strong></div>
                <div class="cu-detail-list__full"><span>Ghi chú của khách hàng</span><strong>@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có ghi chú." : Model.Notes)</strong></div>
                <div class="cu-detail-list__full"><span>Ghi chú xử lý</span><strong>@(string.IsNullOrWhiteSpace(Model.LastStatusNote) ? "Không có ghi chú xử lý." : Model.LastStatusNote)</strong></div>
            </div>
        </div>

        <aside class="cu-card">
            <div class="cu-section-head">
                <div>
                    <span class="cu-kicker">Preview</span>
                    <h2>File đơn in</h2>
                </div>
            </div>

            <iframe
                src="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/PreviewFile/{Model.UploadedFileId}")"
                title="Xem trước file đơn in @Model.Id"
                class="cu-preview-frame"
                loading="lazy">
            </iframe>

            <div class="cu-actions mt-3">
                <a class="btn btn-outline-secondary" asp-action="DownloadFile" asp-route-id="@Model.UploadedFileId" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Tải lại file</a>
            </div>
        </aside>
    </section>
</section>