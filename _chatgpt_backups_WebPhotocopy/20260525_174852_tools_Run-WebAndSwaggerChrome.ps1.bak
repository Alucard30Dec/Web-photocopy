$ErrorActionPreference = "Stop"

$ProjectRoot = 'E:\OneDrive - 0dpmr\WebPhotocopy\Project'
Set-Location -LiteralPath $ProjectRoot

$WebProject = Join-Path $ProjectRoot 'src\PhotoCopyHub.Web\PhotoCopyHub.Web.csproj'
$HttpBaseUrl = 'http://localhost:5250'
$HttpsBaseUrl = 'https://localhost:7250'

$env:ASPNETCORE_ENVIRONMENT = 'Development'
$env:ASPNETCORE_URLS = "$HttpBaseUrl;$HttpsBaseUrl"

function Find-Chrome {
    $candidates = @(
        "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
        "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
        "$env:LocalAppData\Google\Chrome\Application\chrome.exe"
    )

    foreach ($candidate in $candidates) {
        if (Test-Path -LiteralPath $candidate) {
            return $candidate
        }
    }

    return $null
}

function Test-TcpPort {
    param(
        [Parameter(Mandatory = $true)][string]$HostName,
        [Parameter(Mandatory = $true)][int]$Port
    )

    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $async = $client.BeginConnect($HostName, $Port, $null, $null)
        $success = $async.AsyncWaitHandle.WaitOne(1000, $false)
        if (-not $success) {
            return $false
        }

        $client.EndConnect($async)
        return $true
    }
    catch {
        return $false
    }
    finally {
        $client.Close()
    }
}

Write-Host ""
Write-Host "=== PhotoCopyHub.Web ===" -ForegroundColor Cyan
Write-Host "Web URL     : $HttpBaseUrl/" -ForegroundColor Cyan
Write-Host "Swagger URL : $HttpBaseUrl/swagger" -ForegroundColor Cyan
Write-Host ""

$openBrowserJob = Start-Job -ScriptBlock {
    param($HttpBaseUrl)

    function Find-ChromeInJob {
        $candidates = @(
            "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
            "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
            "$env:LocalAppData\Google\Chrome\Application\chrome.exe"
        )

        foreach ($candidate in $candidates) {
            if (Test-Path -LiteralPath $candidate) {
                return $candidate
            }
        }

        return $null
    }

    function Test-TcpPortInJob {
        param([string]$HostName, [int]$Port)

        $client = New-Object System.Net.Sockets.TcpClient
        try {
            $async = $client.BeginConnect($HostName, $Port, $null, $null)
            $success = $async.AsyncWaitHandle.WaitOne(1000, $false)
            if (-not $success) {
                return $false
            }

            $client.EndConnect($async)
            return $true
        }
        catch {
            return $false
        }
        finally {
            $client.Close()
        }
    }

    for ($i = 1; $i -le 90; $i++) {
        if (Test-TcpPortInJob -HostName 'localhost' -Port 5250) {
            Start-Sleep -Seconds 2

            $chrome = Find-ChromeInJob
            $webUrl = "$HttpBaseUrl/"
            $swaggerUrl = "$HttpBaseUrl/swagger"

            if ($chrome) {
                Start-Process -FilePath $chrome -ArgumentList @('--new-window', $webUrl)
                Start-Sleep -Seconds 1
                Start-Process -FilePath $chrome -ArgumentList @('--new-window', $swaggerUrl)
                return
            }

            Start-Process $webUrl
            Start-Sleep -Seconds 1
            Start-Process $swaggerUrl
            return
        }

        Start-Sleep -Seconds 1
    }
} -ArgumentList $HttpBaseUrl

Write-Host "Running command:" -ForegroundColor Yellow
Write-Host "dotnet run --project `"$WebProject`" --no-launch-profile --urls `"$HttpBaseUrl;$HttpsBaseUrl`"" -ForegroundColor Yellow
Write-Host ""

try {
    & dotnet run --project "$WebProject" --no-launch-profile --urls "$HttpBaseUrl;$HttpsBaseUrl"
}
finally {
    if ($openBrowserJob) {
        Remove-Job -Job $openBrowserJob -Force -ErrorAction SilentlyContinue
    }
}