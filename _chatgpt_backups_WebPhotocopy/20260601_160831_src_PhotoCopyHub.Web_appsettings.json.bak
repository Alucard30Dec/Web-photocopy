{
  "DatabaseProvider": "PostgreSql",
  "Database": {
    "UseSqliteFallbackWhenPrimaryUnavailable": false,
    "PrimaryConnectTimeoutMs": 3000
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "FallbackSqliteConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Api": {
    "Cors": {
      "AllowedOrigins": []
    }
  },
  "Business": {
    "ShippingFee": 15000,
    "TopUpRequireAdminApprovalThreshold": 2000000,
    "RefundRequireAdminApprovalThreshold": 1000000
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "App_Data/uploads",
    "MaxFileSizeMb": 20,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx" ],
    "AllowedMimeTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation"
    ],
    "S3": {
      "BucketName": "",
      "Region": "auto",
      "ServiceUrl": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "KeyPrefix": "uploads",
      "ForcePathStyle": true,
      "UseHttp": false
    }
  },
  "SeedAdmin": {
    "Email": "admin@photocopyhub.local",
    "Password": "",
    "FullName": "Quản trị hệ thống"
  },
  "SeedShopOperator": {
    "Email": "operator@photocopyhub.local",
    "Password": "",
    "FullName": "Nhân viên vận hành"
  },
  "TopUpInfo": {
    "BankName": "Vietcombank",
    "AccountNumber": "0123456789",
    "AccountName": "NGUYEN VAN A",
    "TransferContentPrefix": "TOPUP"
  },
  "SeedSampleData": {
    "Enabled": false
  }
}