@model List<TopUpRequest>
@{
    ViewData["Title"] = "Lịch sử yêu cầu nạp tiền";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Top-up history</span>
            <h1>Lịch sử yêu cầu nạp tiền</h1>
            <p>Theo dõi các yêu cầu đã gửi, trạng thái duyệt và ghi chú từ shop/admin.</p>
            <div class="cu-actions">
                <a class="btn btn-primary" asp-action="TopUp" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Tạo yêu cầu mới</a>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Ví của tôi</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Tổng yêu cầu</span>
            <strong>@Model.Count</strong>
            <small>Nạp tiền qua chuyển khoản và đối soát thủ công.</small>
        </aside>
    </section>

    <section class="cu-card">
        <div class="cu-table-wrap">
            <table class="table cu-table">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th class="text-end">Số tiền</th>
                        <th>Nội dung</th>
                        <th>Mã GD</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú admin</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6"><div class="cu-empty"><strong>Chưa có yêu cầu nạp tiền.</strong><span>Tạo yêu cầu mới nếu bạn muốn nạp ví.</span></div></td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end fw-semibold">@item.Amount.ToString("N0") đ</td>
                        <td>@item.TransferContent</td>
                        <td>@item.TransactionReferenceCode</td>
                        <td><span class="badge @item.Status.ToBadgeClass()">@item.Status.GetDisplayName()</span></td>
                        <td>@item.ReviewNote</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>