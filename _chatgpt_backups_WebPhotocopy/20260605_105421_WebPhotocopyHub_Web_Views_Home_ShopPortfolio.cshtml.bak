@{
    ViewData["Title"] = "Dành cho tiệm photocopy";
}

<section class="pc-portfolio-page pc-portfolio-page--shop">
    <div class="pc-portfolio-hero pc-portfolio-hero--shop">
        <div class="pc-portfolio-copy">
            <span class="pc-portfolio-pill pc-portfolio-pill--green">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18l-1.5-6h-15Z"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>
                Dành cho tiệm photocopy
            </span>

            <h1>Website vận hành đơn in cho tiệm photocopy chuyên nghiệp hơn</h1>
            <p>
                PhotoCopyHub giúp tiệm tiếp nhận đơn online, kiểm tra file, phân loại trạng thái, quản lý sản phẩm/dịch vụ,
                theo dõi ví - nạp tiền và lưu lịch sử hoạt động để vận hành gọn gàng hơn mỗi ngày.
            </p>

            <div class="pc-portfolio-actions">
                <a class="pc-btn pc-btn--success" href="/Home">Về trang chủ</a>
                <a class="pc-btn pc-btn--ghost" href="#shopGuide">Xem hướng dẫn vận hành</a>
            </div>

            <div class="pc-portfolio-trust">
                <span><svg viewBox="0 0 24 24"><path d="M3 7h18M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2M6 7v14h12V7"/></svg> Quản lý đơn</span>
                <span><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg> Kiểm file</span>
                <span><svg viewBox="0 0 24 24"><path d="M4 19V5"/><path d="M8 17V9"/><path d="M12 19V3"/><path d="M16 17v-7"/><path d="M20 19V7"/></svg> Theo dõi vận hành</span>
            </div>
        </div>

        <div class="pc-showcase-card pc-showcase-card--shop">
            <div class="pc-showcase-header">
                <span class="pc-showcase-dot pc-showcase-dot--green"></span>
                <strong>Dashboard tiệm</strong>
                <em>Demo</em>
            </div>

            <div class="pc-dashboard-stat-grid">
                <div><b>18</b><span>Đơn mới</span></div>
                <div><b>12</b><span>Đang xử lý</span></div>
                <div><b>31</b><span>Hoàn thành</span></div>
            </div>

            <div class="pc-shop-task">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                <div><b>#PC-1024</b><span>In 2 mặt, A4, 3 bản</span></div>
                <em>Đang in</em>
            </div>

            <div class="pc-shop-task">
                <svg viewBox="0 0 24 24"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
                <div><b>#PC-1025</b><span>File cần kiểm lại định dạng</span></div>
                <em>Cần xem</em>
            </div>

            <div class="pc-shop-task">
                <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                <div><b>#PC-1026</b><span>Đã hoàn tất và chờ khách nhận</span></div>
                <em>Xong</em>
            </div>
        </div>
    </div>

    <div class="pc-portfolio-section">
        <div class="pc-section-heading">
            <span class="pc-section-kicker pc-section-kicker--green">Bài toán vận hành</span>
            <h2>Tiệm photocopy cần quản lý gì mỗi ngày?</h2>
            <p>Trang này giới thiệu rõ cách PhotoCopyHub hỗ trợ tiệm gom đơn, quản lý file, theo dõi xử lý và giảm nhầm lẫn trong lúc đông khách.</p>
        </div>

        <div class="pc-feature-grid">
            <article class="pc-feature-card pc-feature-card--green">
                <div class="pc-feature-icon pc-feature-icon--green"><svg viewBox="0 0 24 24"><path d="M3 7h18M6 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2M6 7v14h12V7"/></svg></div>
                <h3>Tiếp nhận đơn tập trung</h3>
                <p>Đơn online được gom vào danh sách quản lý để nhân viên biết đơn mới, đơn đang xử lý và đơn đã hoàn thành.</p>
            </article>

            <article class="pc-feature-card pc-feature-card--green">
                <div class="pc-feature-icon pc-feature-icon--green"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg></div>
                <h3>File đi cùng đúng đơn</h3>
                <p>Mỗi file được gắn với đơn cụ thể, giúp hạn chế nhầm file khi tiệm nhận nhiều đơn qua nhiều kênh khác nhau.</p>
            </article>

            <article class="pc-feature-card pc-feature-card--green">
                <div class="pc-feature-icon pc-feature-icon--green"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 16v-5M12 16V8M17 16v-9"/></svg></div>
                <h3>Theo dõi dữ liệu vận hành</h3>
                <p>Chủ tiệm nhìn nhanh số đơn, trạng thái, sản phẩm, dịch vụ hỗ trợ, giao dịch ví và dữ liệu đối soát.</p>
            </article>
        </div>
    </div>

    <div id="shopGuide" class="pc-portfolio-section pc-portfolio-section--soft pc-portfolio-section--green-soft">
        <div class="pc-section-heading">
            <span class="pc-section-kicker pc-section-kicker--green">Hướng dẫn vận hành</span>
            <h2>Quy trình cho chủ tiệm và nhân viên</h2>
            <p>Luồng này giúp nhân viên mới cũng hiểu cách xử lý đơn từ lúc khách gửi đến khi hoàn thành và đối soát.</p>
        </div>

        <div class="pc-guide-timeline">
            <article>
                <span class="pc-step-number pc-step-number--green">01</span>
                <div class="pc-step-icon pc-step-icon--green"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg></div>
                <h3>Tiếp nhận đơn mới</h3>
                <p>Nhân viên mở danh sách đơn để xem các yêu cầu mới được gửi từ khách hàng.</p>
                <ul>
                    <li>Kiểm tra tên khách, thời gian gửi và mô tả đơn.</li>
                    <li>Xem số lượng file đính kèm trong đơn.</li>
                    <li>Ưu tiên đơn cần xử lý gấp hoặc có ghi chú đặc biệt.</li>
                </ul>
            </article>

            <article>
                <span class="pc-step-number pc-step-number--green">02</span>
                <div class="pc-step-icon pc-step-icon--green"><svg viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
                <h3>Kiểm tra file và yêu cầu</h3>
                <p>Tiệm preview hoặc tải file để xác nhận tài liệu có mở được, đúng định dạng và đúng yêu cầu in.</p>
                <ul>
                    <li>Kiểm tra số trang, khổ giấy, màu sắc.</li>
                    <li>Đọc ghi chú đóng gáy, bấm kim, in một mặt/hai mặt.</li>
                    <li>Đánh dấu cần bổ sung nếu file lỗi hoặc thiếu thông tin.</li>
                </ul>
            </article>

            <article>
                <span class="pc-step-number pc-step-number--green">03</span>
                <div class="pc-step-icon pc-step-icon--green"><svg viewBox="0 0 24 24"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg></div>
                <h3>Xử lý in/photo</h3>
                <p>Sau khi file hợp lệ, nhân viên thực hiện in, photo, đóng gáy hoặc dịch vụ hỗ trợ theo đúng cấu hình đơn.</p>
                <ul>
                    <li>Cập nhật trạng thái đang xử lý để khách nắm tiến độ.</li>
                    <li>Ghi chú nội bộ nếu có thay đổi trong quá trình xử lý.</li>
                    <li>Kiểm tra thành phẩm trước khi chuyển hoàn thành.</li>
                </ul>
            </article>

            <article>
                <span class="pc-step-number pc-step-number--green">04</span>
                <div class="pc-step-icon pc-step-icon--green"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5"/></svg></div>
                <h3>Hoàn thành và đối soát</h3>
                <p>Khi đơn xong, tiệm cập nhật trạng thái, lưu lịch sử và dùng dữ liệu đơn/giao dịch để đối soát.</p>
                <ul>
                    <li>Đánh dấu hoàn thành khi sản phẩm đã sẵn sàng.</li>
                    <li>Kiểm tra ví, nạp tiền hoặc thanh toán nếu có dùng module tiền.</li>
                    <li>Tra cứu lịch sử khi khách cần kiểm tra lại.</li>
                </ul>
            </article>
        </div>
    </div>

    <div class="pc-portfolio-section">
        <div class="pc-section-heading">
            <span class="pc-section-kicker pc-section-kicker--green">Quản lý tốt hơn</span>
            <h2>Những khu vực tiệm có thể kiểm soát</h2>
            <p>PhotoCopyHub không chỉ là trang nhận file, mà còn là nền tảng quản lý nhiều phần của hoạt động photocopy.</p>
        </div>

        <div class="pc-operation-grid">
            <article><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg><h3>Đơn in</h3><p>Theo dõi trạng thái và xử lý từng yêu cầu của khách.</p></article>
            <article><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/></svg><h3>Sản phẩm</h3><p>Quản lý sản phẩm văn phòng phẩm hoặc dịch vụ bán kèm.</p></article>
            <article><svg viewBox="0 0 24 24"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"/></svg><h3>Ví và nạp tiền</h3><p>Theo dõi giao dịch, yêu cầu nạp tiền và lịch sử số dư.</p></article>
            <article><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg><h3>Audit log</h3><p>Lưu dấu hoạt động để dễ kiểm tra khi cần truy vết.</p></article>
        </div>
    </div>

    <div class="pc-final-cta pc-final-cta--shop">
        <div>
            <span class="pc-section-kicker pc-section-kicker--green">Sẵn sàng vận hành</span>
            <h2>Giúp tiệm photocopy làm việc gọn, rõ và chuyên nghiệp hơn</h2>
            <p>Mỗi đơn, mỗi file và mỗi trạng thái đều được đưa vào một luồng quản lý dễ theo dõi.</p>
        </div>
        <a class="pc-btn pc-btn--success" href="/Home">Quay lại trang giới thiệu</a>
    </div>
</section>
