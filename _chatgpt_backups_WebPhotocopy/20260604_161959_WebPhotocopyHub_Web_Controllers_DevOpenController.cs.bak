using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Text;

namespace PhotoCopyHub.Web.Controllers;

[AllowAnonymous]
public sealed class DevOpenController : Controller
{
    [HttpGet("/dev/open")]
    [IgnoreAntiforgeryToken]
    public ContentResult Open()
    {
        var baseUrl = $"{Request.Scheme}://{Request.Host}";
        var html = $$"""
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PhotoCopyHub - Web + Swagger</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background: #f7f7fb; color: #1f2937; }
        .card { max-width: 760px; background: #fff; border-radius: 16px; padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
        h1 { margin-top: 0; }
        .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
        a { display: inline-block; padding: 12px 16px; border-radius: 10px; text-decoration: none; font-weight: 700; }
        .primary { background: #2563eb; color: white; }
        .secondary { background: #e5e7eb; color: #111827; }
        code { background: #f3f4f6; padding: 2px 6px; border-radius: 6px; }
        .muted { color: #6b7280; }
    </style>
</head>
<body>
    <div class="card">
        <h1>PhotoCopyHub đang chạy</h1>
        <p>Chọn trang muốn mở. Bạn có thể mở cả web chính và Swagger API ở hai tab khác nhau.</p>
        <div class="actions">
            <a class="primary" href="{{baseUrl}}/" target="_blank" rel="noopener">Mở Web</a>
            <a class="secondary" href="{{baseUrl}}/swagger" target="_blank" rel="noopener">Mở Swagger API</a>
            <a class="secondary" href="{{baseUrl}}/api/v1/system/ping" target="_blank" rel="noopener">Test API Ping</a>
        </div>
        <p class="muted">Web: <code>{{baseUrl}}/</code></p>
        <p class="muted">Swagger: <code>{{baseUrl}}/swagger</code></p>
        <p class="muted">API test: <code>{{baseUrl}}/api/v1/system/ping</code></p>
    </div>
</body>
</html>
""";

        return Content(html, "text/html", Encoding.UTF8);
    }
}