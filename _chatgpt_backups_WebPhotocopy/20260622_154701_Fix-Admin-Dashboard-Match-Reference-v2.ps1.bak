Lfbx26eZL3SH+Vq/Q82clVrM1Y/5J3yu4ecV/6OFv0DUMf5vFv4P0nK5H5hhAAA=
'@

$NewLayoutContent = ConvertFrom-GzipBase64 -Base64Content $LayoutGzipBase64
$NewDashboardContent = ConvertFrom-GzipBase64 -Base64Content $DashboardGzipBase64
$NewCssBlock = ConvertFrom-GzipBase64 -Base64Content $CssBlockGzipBase64

Write-ProjectFileIfChanged -RelativePath $LayoutPath -Content $NewLayoutContent
Write-ProjectFileIfChanged -RelativePath $DashboardPath -Content $NewDashboardContent

$CssAbsolutePath = Join-Path $ProjectRoot $CssPath
$CssContent = [System.IO.File]::ReadAllText($CssAbsolutePath)
$CssPattern = '/\* === Admin Dashboard Reference UI Start === \*/.*?/\* === Admin Dashboard Reference UI End === \*/'
$CssRegex = [System.Text.RegularExpressions.Regex]::new(
    $CssPattern,
    [System.Text.RegularExpressions.RegexOptions]::Singleline
)
$CssMatches = $CssRegex.Matches($CssContent)

if ($CssMatches.Count -gt 1) {
    throw "Tìm thấy nhiều block Admin Dashboard Reference UI trong $CssPath. Dừng để tránh sửa nhầm."
}

$UpdatedCssContent = $CssContent
$CssHandled = $false

if (-not $CssHandled -and $CssMatches.Count -eq 1) {
    $UpdatedCssContent = $CssRegex.Replace(
        $CssContent,
        [System.Text.RegularExpressions.MatchEvaluator]{ param($Match) $NewCssBlock.TrimEnd() },
        1
    )
    $CssHandled = $true
}

if (-not $CssHandled -and $CssMatches.Count -eq 0) {
    $UpdatedCssContent = $CssContent.TrimEnd() + [Environment]::NewLine + [Environment]::NewLine + $NewCssBlock.Trim() + [Environment]::NewLine
    $CssHandled = $true
}

if (-not $CssHandled) {
    throw "Không thể xác định cách cập nhật CSS. Dừng để tránh sửa sai file."
}

Write-ProjectFileIfChanged -RelativePath $CssPath -Content $UpdatedCssContent

Write-Host ""
Write-Host "File đã sửa:" -ForegroundColor Cyan
if ($ChangedFiles.Count -eq 0) {
    Write-Host "- Không có file nào cần sửa"
}

if ($ChangedFiles.Count -gt 0) {
    $ChangedFiles | Sort-Object -Unique | ForEach-Object { Write-Host "- $_" }
}

Write-Host ""
Write-Host "Đang build solution: $([System.IO.Path]::GetFileName($SolutionPath))" -ForegroundColor Cyan
& dotnet build $SolutionPath
if ($LASTEXITCODE -ne 0) {
    throw "Build thất bại với exit code $LASTEXITCODE. Hãy gửi lại toàn bộ log build."
}

Write-Host ""
Write-Host "Build thành công." -ForegroundColor Green
Write-Host "Mở https://localhost:7250/admin, nhấn Ctrl+F5, rồi bấm Quản Trị để kiểm tra mega menu." -ForegroundColor Cyan
