$ErrorActionPreference = "Stop"

$ProjectRoot = 'E:\OneDrive - 0dpmr\WebPhotocopy\Project'
if (-not (Test-Path -LiteralPath $ProjectRoot)) {
    throw "Không tìm thấy thư mục dự án: $ProjectRoot"
}

Set-Location -LiteralPath $ProjectRoot

$PreferredSolutionPath = Join-Path $ProjectRoot 'PhotoCopyHub.sln'
$LegacySolutionPath = Join-Path $ProjectRoot 'WebPhotocopyHub.sln'
$SolutionPath = $null

if (Test-Path -LiteralPath $PreferredSolutionPath) {
    $SolutionPath = $PreferredSolutionPath
}

if (-not $SolutionPath -and (Test-Path -LiteralPath $LegacySolutionPath)) {
    $SolutionPath = $LegacySolutionPath
    Write-Warning "Source hiện tại dùng WebPhotocopyHub.sln; script sẽ build solution này vì không tìm thấy PhotoCopyHub.sln."
}

if (-not $SolutionPath) {
    throw "Không tìm thấy PhotoCopyHub.sln hoặc WebPhotocopyHub.sln trong: $ProjectRoot"
}

$LayoutPath = 'WebPhotocopyHub.Web.Admin\Areas\Admin\Views\Shared\_Layout.cshtml'
$DashboardPath = 'WebPhotocopyHub.Web.Admin\Areas\Admin\Views\Dashboard\Index.cshtml'
$CssPath = 'WebPhotocopyHub.Web.Admin\wwwroot\css\admin-system.css'
$RequiredFiles = @($LayoutPath, $DashboardPath, $CssPath)

foreach ($RelativePath in $RequiredFiles) {
    $AbsolutePath = Join-Path $ProjectRoot $RelativePath
    if (-not (Test-Path -LiteralPath $AbsolutePath)) {
        throw "Không tìm thấy file cần sửa: $RelativePath"
    }
}

$BackupRoot = Join-Path (Split-Path -Parent $ProjectRoot) '_chatgpt_backups_WebPhotocopy'
$Timestamp = Get-Date -Format 'yyyyMMdd_HHmmss'
New-Item -ItemType Directory -Path $BackupRoot -Force | Out-Null

$ChangedFiles = New-Object System.Collections.Generic.List[string]
$BackedUpFiles = @{}
$Utf8NoBom = [System.Text.UTF8Encoding]::new($false)

function Backup-ProjectFile {
    param([Parameter(Mandatory = $true)][string]$RelativePath)

    if ($BackedUpFiles.ContainsKey($RelativePath)) {
        return
    }

    $SourcePath = Join-Path $ProjectRoot $RelativePath
    if (-not (Test-Path -LiteralPath $SourcePath)) {
        throw "Không tìm thấy file cần backup: $RelativePath"
    }

    $SafeName = $RelativePath -replace '[\\/:*?"<>|]', '_'
    $DestinationPath = Join-Path $BackupRoot "$Timestamp`_$SafeName.bak"
    Copy-Item -LiteralPath $SourcePath -Destination $DestinationPath -Force
    $BackedUpFiles[$RelativePath] = $DestinationPath
    Write-Host "Backup: $RelativePath -> $DestinationPath" -ForegroundColor Yellow
}

function ConvertFrom-GzipBase64 {
    param([Parameter(Mandatory = $true)][string]$Base64Content)

    [byte[]]$CompressedBytes = [System.Convert]::FromBase64String($Base64Content)
    $InputStream = [System.IO.MemoryStream]::new($CompressedBytes)
    $GzipStream = [System.IO.Compression.GZipStream]::new(
        $InputStream,
        [System.IO.Compression.CompressionMode]::Decompress
    )
    $OutputStream = [System.IO.MemoryStream]::new()
    $GzipStream.CopyTo($OutputStream)
    $GzipStream.Dispose()
    $InputStream.Dispose()
    [byte[]]$OutputBytes = $OutputStream.ToArray()
    $OutputStream.Dispose()
    return [System.Text.Encoding]::UTF8.GetString($OutputBytes)
}

function Write-ProjectFileIfChanged {
    param(
        [Parameter(Mandatory = $true)][string]$RelativePath,
        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Content
    )

    $AbsolutePath = Join-Path $ProjectRoot $RelativePath
    if (-not (Test-Path -LiteralPath $AbsolutePath)) {
        throw "Không tìm thấy file cần sửa: $RelativePath"
    }

    $CurrentContent = [System.IO.File]::ReadAllText($AbsolutePath)
    if ($CurrentContent -ceq $Content) {
        Write-Host "File đã đúng, không cần ghi lại: $RelativePath" -ForegroundColor DarkYellow
        return
    }

    Backup-ProjectFile -RelativePath $RelativePath
    [System.IO.File]::WriteAllText($AbsolutePath, $Content, $Utf8NoBom)
    $ChangedFiles.Add($RelativePath) | Out-Null
    Write-Host "Đã sửa: $RelativePath" -ForegroundColor Green
}

