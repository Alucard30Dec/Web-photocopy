$ErrorActionPreference = "Stop"

$ProjectRoot = 'E:\OneDrive - 0dpmr\WebPhotocopy\Project'
Set-Location -LiteralPath $ProjectRoot

$WebProject = Join-Path $ProjectRoot 'src\PhotoCopyHub.Web\PhotoCopyHub.Web.csproj'
$HttpBaseUrl = 'http://localhost:5250'
$HttpsBaseUrl = 'https://localhost:7250'
$LogDir = Join-Path $ProjectRoot 'logs'
$LogFile = Join-Path $LogDir 'run-web-and-swagger.log'

New-Item -ItemType Directory -Path $LogDir -Force | Out-Null

$env:ASPNETCORE_ENVIRONMENT = 'Development'
$env:ASPNETCORE_URLS = "$HttpBaseUrl;$HttpsBaseUrl"

function Find-Chrome {
    $candidates = @(
        "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
        "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
        "$env:LocalAppData\Google\Chrome\Application\chrome.exe"
    )

    foreach ($candidate in $candidates) {
        if (Test-Path -LiteralPath $candidate) {
            return $candidate
        }
    }

    return $null
}

function Test-TcpPort {
    param(
        [Parameter(Mandatory = $true)][string]$HostName,
        [Parameter(Mandatory = $true)][int]$Port
    )

    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $async = $client.BeginConnect($HostName, $Port, $null, $null)
        $success = $async.AsyncWaitHandle.WaitOne(1000, $false)
        if (-not $success) {
            return $false
        }

        $client.EndConnect($async)
        return $true
    }
    catch {
        return $false
    }
    finally {
        $client.Close()
    }
}

function Wait-Until-PortReady {
    param(
        [Parameter(Mandatory = $true)][string]$HostName,
        [Parameter(Mandatory = $true)][int]$Port,
        [Parameter(Mandatory = $true)]$Process
    )

    Write-Host "Đang chờ web mở cổng: $HostName`:$Port" -ForegroundColor Cyan

    for ($i = 1; $i -le 90; $i++) {
        if ($Process.HasExited) {
            Write-Host ""
            Write-Host "dotnet run đã thoát sớm. Log:" -ForegroundColor Red
            if (Test-Path -LiteralPath $LogFile) {
                Get-Content -LiteralPath $LogFile -Tail 80
            }
            throw "Web không chạy được. Xem log: $LogFile"
        }

        if (Test-TcpPort -HostName $HostName -Port $Port) {
            Write-Host "Web đã mở cổng $Port." -ForegroundColor Green
            return
        }

        Start-Sleep -Seconds 1
    }

    Write-Host ""
    Write-Host "Không thấy cổng $Port mở sau 90 giây. Log gần nhất:" -ForegroundColor Red
    if (Test-Path -LiteralPath $LogFile) {
        Get-Content -LiteralPath $LogFile -Tail 80
    }

    throw "Web chưa sẵn sàng."
}

Write-Host "Đang chạy PhotoCopyHub.Web..." -ForegroundColor Cyan
Write-Host "Log: $LogFile" -ForegroundColor DarkGray

if (Test-Path -LiteralPath $LogFile) {
    Remove-Item -LiteralPath $LogFile -Force
}

$dotnetArgs = @(
    'run',
    '--project',
    $WebProject,
    '--no-launch-profile'
)

$dotnetProcess = Start-Process `
    -FilePath 'dotnet' `
    -ArgumentList $dotnetArgs `
    -PassThru `
    -NoNewWindow `
    -RedirectStandardOutput $LogFile `
    -RedirectStandardError $LogFile

try {
    Wait-Until-PortReady -HostName 'localhost' -Port 5250 -Process $dotnetProcess

    Start-Sleep -Seconds 2

    $chrome = Find-Chrome
    $webUrl = "$HttpBaseUrl/"
    $swaggerUrl = "$HttpBaseUrl/swagger"

    if ($chrome) {
        Write-Host "Mở Chrome Web: $webUrl" -ForegroundColor Green
        Start-Process -FilePath $chrome -ArgumentList @('--new-window', $webUrl)

        Start-Sleep -Seconds 1

        Write-Host "Mở Chrome Swagger: $swaggerUrl" -ForegroundColor Green
        Start-Process -FilePath $chrome -ArgumentList @('--new-window', $swaggerUrl)
    }

    if (-not $chrome) {
        Write-Host "Không tìm thấy chrome.exe, mở bằng trình duyệt mặc định." -ForegroundColor Yellow
        Start-Process $webUrl
        Start-Sleep -Seconds 1
        Start-Process $swaggerUrl
    }

    Write-Host ""
    Write-Host "Đang chạy." -ForegroundColor Cyan
    Write-Host "Web: $webUrl" -ForegroundColor Cyan
    Write-Host "Swagger: $swaggerUrl" -ForegroundColor Cyan
    Write-Host "Bấm Stop trong Visual Studio hoặc đóng cửa sổ này để dừng." -ForegroundColor Yellow

    $dotnetProcess.WaitForExit()
}
finally {
    if ($dotnetProcess -and -not $dotnetProcess.HasExited) {
        Stop-Process -Id $dotnetProcess.Id -Force
    }
}