@{
    ViewData["Title"] = "Portfolio dịch vụ Web Photocopy";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var customerReturnUrl = Url.Action("Index", "Dashboard") ?? "/Dashboard";
    var createPrintJobUrl = Url.Action("Create", "PrintJobs") ?? "/PrintJobs/Create";
    var shopReturnUrl = Url.Action("Index", "Dashboard", new { area = "Shop" }) ?? "/Shop/Dashboard";
    var adminReturnUrl = Url.Action("Index", "Dashboard", new { area = "Admin" }) ?? "/Admin/Dashboard";

    var highlights = new[]
    {
        new { Value = "3 phút", Label = "gửi file và tạo đơn mẫu" },
        new { Value = "2 phía", Label = "khách hàng và tiệm cùng theo dõi" },
        new { Value = "1 nền tảng", Label = "đơn in, ví, sản phẩm, đối soát" }
    };

    var customerFeatures = new[]
    {
        "Upload tài liệu PDF, DOCX, PPTX, hình ảnh trước khi tới tiệm",
        "Chọn kiểu in, số bản, giấy, màu, đóng gáy và ghi chú xử lý",
        "Theo dõi trạng thái đơn, lịch sử file và ví thanh toán nội bộ"
    };

    var shopFeatures = new[]
    {
        "Nhận hàng chờ đơn in theo cơ sở, cập nhật trạng thái xử lý",
        "Quản lý sản phẩm, dịch vụ hỗ trợ, tồn kho và yêu cầu nạp tiền",
        "Admin theo dõi bảng giá, người dùng, audit log và đối soát ví"
    };

    var modules = new[]
    {
        new { Title = "Đặt in online", Text = "Khách gửi file, chọn cấu hình in và tạo đơn rõ ràng trước khi tới quầy.", Icon = "01" },
        new { Title = "Ví và nạp tiền", Text = "Theo dõi số dư, lịch sử giao dịch và yêu cầu nạp tiền minh bạch.", Icon = "02" },
        new { Title = "Quầy tiệm photocopy", Text = "Tiệm xử lý đơn, duyệt yêu cầu tại quầy và cập nhật tiến độ cho khách.", Icon = "03" },
        new { Title = "Quản trị hệ thống", Text = "Admin quản lý người dùng, bảng giá, sản phẩm, audit log và đối soát.", Icon = "04" }
    };
}

<section class="portfolio-hero" aria-labelledby="portfolioHeroTitle">
    <div class="portfolio-hero__content">
        <span class="portfolio-kicker">PhotoCopyHub / WebPhotocopy</span>
        <h1 id="portfolioHeroTitle">Website photocopy hiện đại cho khách đặt in và tiệm vận hành đơn hàng.</h1>
        <p class="portfolio-lead">
            Một trang portfolio giới thiệu nền tảng WebPhotocopy: khách hàng gửi file, tạo đơn in, nạp ví và theo dõi trạng thái; tiệm photocopy nhận đơn, xử lý hàng chờ, quản lý sản phẩm và đối soát rõ ràng.
        </p>

        <div class="portfolio-actions" aria-label="Hành động chính">
            @if (isAuthenticated)
            {
                <a class="btn btn-primary btn-lg" asp-controller="Dashboard" asp-action="Index">Vào dashboard</a>
                <a class="btn btn-light btn-lg" asp-controller="PrintJobs" asp-action="Create">Tạo đơn in ngay</a>
            }
            else
            {
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Dùng thử cho khách hàng</a>
                <a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@shopReturnUrl">Đăng nhập khu tiệm</a>
            }
            <a class="btn btn-outline-light btn-lg" href="#portfolioModules">Xem tính năng</a>
        </div>

        <div class="portfolio-proof" aria-label="Điểm nổi bật">
            @foreach (var item in highlights)
            {
                <div>
                    <strong>@item.Value</strong>
                    <span>@item.Label</span>
                </div>
            }
        </div>
    </div>

    <div class="portfolio-hero__preview" aria-label="Mô phỏng màn hình vận hành PhotoCopyHub">
        <div class="preview-window">
            <div class="preview-window__bar">
                <span></span><span></span><span></span>
                <strong>PhotoCopyHub Workspace</strong>
            </div>
            <div class="preview-status-card preview-status-card--active">
                <div>
                    <small>Đơn in mới</small>
                    <strong>Luận văn tốt nghiệp.pdf</strong>
                </div>
                <span>Đã nhận file</span>
            </div>
            <div class="preview-grid">
                <div>
                    <small>Khách hàng</small>
                    <strong>Upload file</strong>
                    <span>Chọn in màu, A4, 2 mặt</span>
                </div>
                <div>
                    <small>Tiệm photo</small>
                    <strong>Đang xử lý</strong>
                    <span>Hẹn lấy 18:30</span>
                </div>
            </div>
            <div class="preview-status-card">
                <div>
                    <small>Ví nội bộ</small>
                    <strong>Thanh toán minh bạch</strong>
                </div>
                <span>Audit ready</span>
            </div>
        </div>
    </div>
</section>

<section class="portfolio-section" id="portfolioAudience">
    <div class="portfolio-section__heading">
        <span class="portfolio-kicker">Phục vụ 2 nhóm người dùng</span>
        <h2>Một giao diện giới thiệu rõ giá trị cho cả khách hàng lẫn tiệm photocopy.</h2>
        <p>Trang chính tập trung vào lợi ích, quy trình và lối vào phù hợp thay vì chỉ là màn hình đăng nhập.</p>
    </div>

    <div class="portfolio-audience-grid">
        <article class="portfolio-audience-card">
            <div class="portfolio-card-icon">KH</div>
            <h3>Cho người dùng cần in tài liệu</h3>
            <p>Giảm thời gian chờ tại quầy bằng cách chuẩn bị file, cấu hình in và theo dõi đơn từ trước.</p>
            <ul>
                @foreach (var feature in customerFeatures)
                {
                    <li>@feature</li>
                }
            </ul>
            <a class="btn btn-primary w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@customerReturnUrl">Vào khu khách hàng</a>
        </article>

        <article class="portfolio-audience-card portfolio-audience-card--shop">
            <div class="portfolio-card-icon">TP</div>
            <h3>Cho tiệm photocopy cần số hóa vận hành</h3>
            <p>Tập trung đơn hàng, file, trạng thái, ví và dữ liệu đối soát trong một hệ thống dễ quản lý.</p>
            <ul>
                @foreach (var feature in shopFeatures)
                {
                    <li>@feature</li>
                }
            </ul>
            <a class="btn btn-outline-secondary w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@shopReturnUrl">Vào khu tiệm photocopy</a>
        </article>
    </div>
</section>

<section class="portfolio-section portfolio-section--soft" id="portfolioModules">
    <div class="portfolio-section__heading portfolio-section__heading--split">
        <div>
            <span class="portfolio-kicker">Tính năng chính</span>
            <h2>Đủ module để giới thiệu như một sản phẩm web hoàn chỉnh.</h2>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Pricing">Xem bảng giá dịch vụ in</a>
    </div>

    <div class="portfolio-module-grid">
        @foreach (var module in modules)
        {
            <article class="portfolio-module-card">
                <span>@module.Icon</span>
                <h3>@module.Title</h3>
                <p>@module.Text</p>
            </article>
        }
    </div>
</section>

<section class="portfolio-section">
    <div class="portfolio-process">
        <div class="portfolio-process__copy">
            <span class="portfolio-kicker">Quy trình sử dụng</span>
            <h2>Từ gửi file đến nhận bài, mọi bước đều có trạng thái rõ ràng.</h2>
            <p>Thiết kế phù hợp mô hình tiệm photocopy gần trường học, văn phòng hoặc chuỗi nhiều cơ sở.</p>
        </div>
        <div class="portfolio-steps">
            <div><strong>1</strong><span>Khách tạo tài khoản, nạp ví hoặc gửi yêu cầu tại quầy.</span></div>
            <div><strong>2</strong><span>Khách upload file, chọn cấu hình in và tạo đơn.</span></div>
            <div><strong>3</strong><span>Tiệm nhận đơn, xử lý, cập nhật trạng thái và giao tài liệu.</span></div>
            <div><strong>4</strong><span>Admin kiểm tra bảng giá, giao dịch, audit log và đối soát.</span></div>
        </div>
    </div>
</section>

<section class="portfolio-cta" aria-label="Kêu gọi hành động cuối trang">
    <div>
        <span class="portfolio-kicker">Sẵn sàng trải nghiệm</span>
        <h2>Bắt đầu với WebPhotocopy ngay trên localhost của bạn.</h2>
        <p>Trang này đóng vai trò portfolio giới thiệu dịch vụ, còn các nút CTA dẫn người dùng vào đúng flow đăng ký, đăng nhập, tạo đơn và vận hành tiệm.</p>
    </div>
    <div class="portfolio-cta__actions">
        @if (isAuthenticated)
        {
            <a class="btn btn-primary btn-lg" href="@createPrintJobUrl">Tạo đơn in</a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="Dashboard" asp-action="Index">Mở dashboard</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Tạo tài khoản khách</a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@adminReturnUrl">Đăng nhập admin</a>
        }
    </div>
</section>
