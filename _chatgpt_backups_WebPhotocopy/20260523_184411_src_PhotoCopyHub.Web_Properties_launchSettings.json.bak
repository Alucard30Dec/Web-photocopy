{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "PhotoCopyHub.Web - Chrome Web + Swagger": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File \"E:\\OneDrive - 0dpmr\\WebPhotocopy\\Project\\tools\\Run-WebAndSwaggerChrome.ps1\"",
      "workingDirectory": "E:\\OneDrive - 0dpmr\\WebPhotocopy\\Project"
    },
    "PhotoCopyHub.Web - Web": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "",
      "applicationUrl": "https://localhost:7250;http://localhost:5250",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "PhotoCopyHub.Web - Swagger": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "https://localhost:7250;http://localhost:5250",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}