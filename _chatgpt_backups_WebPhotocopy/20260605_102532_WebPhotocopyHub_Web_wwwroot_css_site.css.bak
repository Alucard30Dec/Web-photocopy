:root {
    --font-base: "Be Vietnam Pro", "Segoe UI", Tahoma, sans-serif;
    --font-heading: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;

    --bg-base: #f2f6fc;
    --bg-tint: #edf4ff;
    --surface: #ffffff;
    --surface-soft: #f8fbff;

    --text-main: #13243d;
    --text-muted: #5f718a;
    --brand: #0b79a8;
    --brand-strong: #075c84;
    --brand-soft: #d8f1ff;
    --accent: #f59e0b;
    --accent-soft: #fff2d8;
    --danger: #dc2626;
    --success: #15803d;

    --border: #d8e4f2;
    --shadow-sm: 0 14px 30px -24px rgba(19, 42, 82, 0.45);
    --shadow-md: 0 24px 45px -28px rgba(13, 35, 71, 0.45);
}

html,
body {
    min-height: 100%;
}

body {
    margin: 0;
    color: var(--text-main);
    font-family: var(--font-base);
    background:
        radial-gradient(circle at 0 0, rgba(11, 121, 168, 0.12), transparent 32%),
        radial-gradient(circle at 100% 0, rgba(245, 158, 11, 0.12), transparent 26%),
        linear-gradient(180deg, #f8fbff 0%, var(--bg-base) 55%, #eaf1fb 100%);
}

h1,
h2,
h3,
h4,
h5,
h6,
.navbar-brand,
.card-title,
.page-hero h1,
.page-hero h2,
.page-hero h3 {
    font-family: var(--font-heading);
    letter-spacing: 0;
}

a {
    color: var(--brand);
}

a:hover {
    color: var(--brand-strong);
}

.text-muted {
    color: var(--text-muted) !important;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 1050;
}

.site-ribbon {
    background: linear-gradient(105deg, #0d3f5f, #175a82);
    color: rgba(240, 247, 255, 0.9);
    border-bottom: 1px solid rgba(209, 233, 250, 0.22);
    font-size: 0.82rem;
    padding: 0.45rem 0;
}

.site-ribbon .ribbon-highlight {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.14rem 0.62rem;
    background: rgba(255, 255, 255, 0.16);
    font-weight: 600;
}

.site-navbar {
    background: linear-gradient(95deg, rgba(9, 48, 79, 0.95), rgba(15, 86, 130, 0.92));
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(218, 235, 250, 0.14);
    box-shadow: 0 16px 34px -28px rgba(4, 27, 51, 0.68);
}

.site-navbar .navbar-brand {
    font-size: 1.07rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.56rem;
}

.brand-dot {
    width: 0.74rem;
    height: 0.74rem;
    border-radius: 999px;
    display: inline-block;
    background: linear-gradient(145deg, #6ee7ff, #f59e0b);
    box-shadow: 0 0 0 4px rgba(127, 226, 255, 0.2);
}

.site-navbar .nav-link {
    color: rgba(238, 246, 255, 0.9);
    border-radius: 0.72rem;
    padding: 0.44rem 0.74rem;
    transition: all 0.2s ease;
    font-weight: 500;
}

.site-navbar .nav-link:hover,
.site-navbar .nav-link.active,
.site-navbar .dropdown-item.active {
    color: #ffffff;
    background: rgba(244, 250, 255, 0.18);
}

.site-navbar .btn-link.nav-link {
    border: 0;
}

.user-nav-link {
    background: rgba(244, 250, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.dropdown-menu {
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    box-shadow: var(--shadow-sm);
}

.dropdown-item {
    border-radius: 0.62rem;
    margin: 0.08rem 0.35rem;
    width: auto;
    transition: all 0.2s ease;
}

.dropdown-item:hover {
    background: #eef7ff;
}

.site-main {
    min-height: calc(100vh - 176px);
    padding-top: 1.65rem;
    padding-bottom: 2.3rem;
}

.site-footer {
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(3px);
    color: var(--text-muted);
    font-size: 0.92rem;
}

.card {
    border: 1px solid var(--border);
    border-radius: 1.06rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.card-header {
    background: linear-gradient(180deg, #fcfeff, #f3f8ff);
    border-bottom: 1px solid var(--border);
    font-weight: 600;
}

.table-responsive {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.table {
    margin-bottom: 0;
    --bs-table-bg: transparent;
}

.table thead th {
    white-space: nowrap;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #4f6684;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    background: linear-gradient(180deg, #fcfeff, #f4f8ff);
}

.table th,
.table td {
    padding: 0.78rem 0.88rem;
    vertical-align: middle;
    border-color: #e6edf7;
}

.table tbody tr:hover {
    --bs-table-accent-bg: #f7fbff;
}

.badge {
    font-weight: 600;
    border-radius: 999px;
    padding: 0.42rem 0.62rem;
    letter-spacing: 0.01em;
}

.badge.bg-secondary {
    background: #64748b !important;
}

.badge.bg-success {
    background: #16a34a !important;
}

.badge.bg-warning {
    background: #f59e0b !important;
}

.badge.bg-danger {
    background: #dc2626 !important;
}

.badge.bg-primary {
    background: #0284c7 !important;
}

.badge.bg-info {
    background: #38bdf8 !important;
}

.btn {
    border-radius: 0.78rem;
    font-weight: 600;
    transition: all 0.2s ease;
}

.btn-primary {
    background: linear-gradient(138deg, var(--brand), #2ea6d8);
    border-color: var(--brand);
}

.btn-primary:hover {
    background: linear-gradient(138deg, #07658f, #1994c8);
    border-color: #07658f;
    transform: translateY(-1px);
}

.btn-outline-secondary {
    border-color: #96adc5;
    color: #25405f;
}

.btn-outline-secondary:hover {
    background: #eef5fd;
    color: #1e3856;
    border-color: #8da6be;
}

.btn-warning {
    background: linear-gradient(140deg, #f59e0b, #facc15);
    border-color: #f59e0b;
    color: #2b2208;
}

.btn-warning:hover {
    background: linear-gradient(140deg, #e3920a, #f7c717);
    border-color: #d88407;
    color: #2b2208;
}

.form-label {
    font-weight: 600;
    font-size: 0.92rem;
}

.form-control,
.form-select {
    border-radius: 0.76rem;
    border: 1px solid #c7d8eb;
    background-color: #fff;
}

.form-control::placeholder {
    color: #8ca0b8;
}

.form-control:focus,
.form-select:focus {
    border-color: #56b6de;
    box-shadow: 0 0 0 0.2rem rgba(11, 121, 168, 0.15);
}

.form-check-input:checked {
    background-color: var(--brand);
    border-color: var(--brand);
}

.form-control[readonly] {
    background: #f7fafd;
}

.alert {
    border: 0;
    border-radius: 0.9rem;
    box-shadow: var(--shadow-sm);
}

.alert-success {
    background: #dcfce7;
    color: #14532d;
}

.alert-danger {
    background: #fee2e2;
    color: #7f1d1d;
}

.page-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid #d3e3f7;
    background: linear-gradient(130deg, #ffffff 8%, #ecf5ff 58%, #fff5e2 100%);
    padding: 1.8rem;
    box-shadow: var(--shadow-md);
    animation: slide-up 0.45s ease both;
}

.page-hero::before {
    content: "";
    position: absolute;
    left: -66px;
    bottom: -96px;
    width: 220px;
    height: 220px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(11, 121, 168, 0.22), rgba(11, 121, 168, 0));
    pointer-events: none;
}

.page-hero::after {
    content: "";
    position: absolute;
    right: -60px;
    top: -52px;
    width: 190px;
    height: 190px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.26), rgba(245, 158, 11, 0));
    pointer-events: none;
}

.page-hero > * {
    position: relative;
    z-index: 1;
}

.page-hero p {
    color: var(--text-muted);
    max-width: 70ch;
}

.hero-panel {
    border: 1px solid #d4e2f4;
    border-radius: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.84);
}

.hero-panel .hero-item + .hero-item {
    margin-top: 0.55rem;
    padding-top: 0.55rem;
    border-top: 1px dashed #dbe6f5;
}

.feature-card {
    height: 100%;
}

.feature-icon {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #094f70;
    background: linear-gradient(145deg, #d6eeff, #ffe7bd);
    margin-bottom: 0.8rem;
}

.stat-card {
    border: 1px solid #d5e4f6;
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
    box-shadow: var(--shadow-sm);
    height: 100%;
}

.stat-label {
    font-size: 0.88rem;
    color: var(--text-muted);
}

.stat-value {
    font-family: var(--font-heading);
    font-size: 1.56rem;
    margin-top: 0.12rem;
}

.info-chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
}

.info-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.36rem 0.75rem;
    border: 1px solid #d0e0f3;
    background: #f7fbff;
    color: #294866;
    font-size: 0.83rem;
    font-weight: 500;
}

.section-title {
    margin-bottom: 0.35rem;
    font-weight: 700;
}

.section-subtitle {
    margin-bottom: 1rem;
    color: var(--text-muted);
}

.empty-state {
    text-align: center;
    border: 1px dashed #cadbf1;
    border-radius: 0.9rem;
    background: #f8fbff;
    padding: 1.15rem;
    color: #5f7691;
}

/* Home */
.home-hero {
    padding-top: 2rem;
    padding-bottom: 2rem;
}

.home-title {
    font-size: 2.2rem;
    margin-bottom: 0.85rem;
}

/* Landing */
.landing-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: 1.25rem;
    align-items: stretch;
    border: 1px solid #cddfed;
    border-radius: 0.5rem;
    background:
        linear-gradient(125deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 248, 255, 0.95) 48%, rgba(255, 247, 231, 0.95) 100%),
        linear-gradient(90deg, #e2f2f8, #f8ecd5);
    padding: 1.35rem;
    box-shadow: var(--shadow-md);
}

.landing-copy {
    min-width: 0;
    padding: 0.45rem 0.2rem;
}

.landing-kicker,
.portal-eyebrow,
.strip-label {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border-radius: 999px;
    border: 1px solid #cae1ef;
    background: #f5fbff;
    color: #315d74;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.62rem;
}

.landing-copy h1 {
    margin: 0.78rem 0 0.7rem;
    font-family: var(--font-heading);
    font-size: 2.65rem;
    line-height: 1.05;
    letter-spacing: 0;
}

.landing-copy p {
    max-width: 64ch;
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 1rem;
}

.landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.2rem;
}

.landing-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.72rem;
}

.landing-metrics div {
    min-width: 0;
    border: 1px solid #d5e5f1;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.84);
    padding: 0.78rem;
}

.landing-metrics strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.36rem;
    line-height: 1;
}

.landing-metrics span {
    display: block;
    margin-top: 0.28rem;
    color: var(--text-muted);
    font-size: 0.82rem;
}

.landing-visual {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    border: 1px solid #bfd7e6;
    border-radius: 0.5rem;
    background: #102f3d;
    color: #ecf7fb;
    padding: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.visual-topline,
.visual-ticket,
.branch-card-header,
.branch-meta,
.branch-actions,
.section-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.visual-topline {
    justify-content: space-between;
    color: rgba(236, 247, 251, 0.82);
    font-size: 0.84rem;
}

.status-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: #46d191;
    box-shadow: 0 0 0 4px rgba(70, 209, 145, 0.16);
}

.print-board {
    display: grid;
    gap: 0.72rem;
}

.print-column {
    border: 1px solid rgba(210, 235, 244, 0.18);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.07);
    padding: 0.88rem;
}

.print-column.active {
    background: #f8fafc;
    color: #173646;
}

.print-column span,
.visual-ticket span {
    display: block;
    color: inherit;
    opacity: 0.72;
    font-size: 0.78rem;
    font-weight: 600;
}

.print-column strong {
    display: block;
    margin: 0.18rem 0;
    font-size: 1rem;
}

.print-column small {
    color: inherit;
    opacity: 0.78;
}

.visual-ticket {
    justify-content: space-between;
    margin-top: auto;
    border-radius: 0.5rem;
    background: #fffbeb;
    color: #3a3422;
    padding: 0.82rem;
}

.visual-ticket strong {
    display: block;
    font-family: var(--font-heading);
}

.portal-section,
.branch-section,
.operations-strip {
    scroll-margin-top: 8rem;
}

.section-heading {
    justify-content: space-between;
    margin-bottom: 0.95rem;
}

.section-heading h2 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
}

.section-heading p {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
}

.portal-grid,
.branch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
}

.portal-card,
.branch-card {
    min-width: 0;
    height: 100%;
    border: 1px solid #d3e4f0;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.9);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
}

.portal-card {
    display: flex;
    flex-direction: column;
}

.portal-card h3,
.branch-card h3 {
    margin: 0.72rem 0 0.45rem;
    font-size: 1.08rem;
    font-weight: 800;
}

.portal-card p,
.branch-card p {
    color: var(--text-muted);
}

.portal-card p {
    flex: 1;
}

.portal-customer {
    border-top: 4px solid #0b79a8;
}

.portal-shop {
    border-top: 4px solid #2f9e73;
}

.portal-admin {
    border-top: 4px solid #b45309;
}

.branch-card-header {
    justify-content: space-between;
    color: #5b7187;
    font-size: 0.83rem;
    font-weight: 700;
}

.branch-pin {
    width: 0.82rem;
    height: 0.82rem;
    border-radius: 0.24rem;
    background: #0b79a8;
    transform: rotate(45deg);
}

.branch-accent-amber .branch-pin {
    background: #d97706;
}

.branch-accent-rose .branch-pin {
    background: #be5166;
}

.branch-meta {
    flex-wrap: wrap;
    margin: 0.85rem 0;
}

.branch-meta span {
    border: 1px solid #dce7f1;
    border-radius: 999px;
    background: #f8fbff;
    padding: 0.28rem 0.58rem;
    color: #415a71;
    font-size: 0.78rem;
    font-weight: 600;
}

.branch-actions {
    flex-wrap: wrap;
}

.operations-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    border: 1px solid #d2e4ef;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 0.95rem;
    box-shadow: var(--shadow-sm);
}

.operations-strip > div {
    min-width: 0;
}

.operations-strip strong {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.98rem;
}

.login-branch {
    width: fit-content;
    border: 1px solid #d3e5f1;
    border-radius: 999px;
    background: #f7fbff;
    padding: 0.36rem 0.7rem;
    color: #37566c;
}

.login-route-grid {
    display: grid;
    gap: 0.6rem;
}

.login-route-grid a {
    display: block;
    border: 1px solid #d6e5f1;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.82);
    padding: 0.72rem;
    text-decoration: none;
}

.login-route-grid span {
    display: block;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
}

.login-route-grid strong {
    display: block;
    color: var(--text-main);
}

/* Role workspaces */
.dashboard-kicker,
.panel-eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border: 1px solid #cfe1ef;
    border-radius: 999px;
    background: #f7fbff;
    color: #315d74;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.25rem 0.58rem;
}

.workspace-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    gap: 1rem;
    align-items: stretch;
}

.workspace-panel {
    min-width: 0;
    border: 1px solid #d4e4f0;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
}

.workspace-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
}

.workspace-panel h4 {
    margin: 0.48rem 0 0.2rem;
    font-size: 1.05rem;
    font-weight: 800;
}

.workspace-panel p {
    color: var(--text-muted);
}

.quick-action-grid,
.queue-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
}

.admin-board {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.quick-action-card,
.queue-lane {
    display: block;
    min-width: 0;
    border: 1px solid #d8e7f2;
    border-radius: 0.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    color: var(--text-main);
    padding: 0.82rem;
    text-decoration: none;
    transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
}

.quick-action-card:hover,
.queue-lane:hover {
    color: var(--text-main);
    border-color: #a9cfdf;
    box-shadow: 0 16px 30px -26px rgba(9, 48, 79, 0.5);
    transform: translateY(-1px);
}

.quick-action-card span,
.queue-lane span {
    display: block;
    color: #527087;
    font-size: 0.76rem;
    font-weight: 800;
}

.quick-action-card strong,
.queue-lane strong {
    display: block;
    margin: 0.18rem 0;
    font-size: 1rem;
}

.queue-lane strong {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    line-height: 1.05;
}

.quick-action-card small,
.queue-lane small {
    display: block;
    color: var(--text-muted);
}

.queue-lane-hot {
    border-color: #f5d48d;
    background: linear-gradient(180deg, #fffdf7 0%, #fff6dc 100%);
}

.customer-branch-panel {
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(241, 249, 255, 0.96)),
        linear-gradient(90deg, #e5f5fb, #fff4df);
}

.branch-mini-list {
    display: grid;
    gap: 0.46rem;
    margin: 0.85rem 0 1rem;
}

.branch-mini-list span {
    border: 1px solid #d9e8f2;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 0.55rem 0.65rem;
    color: #37556c;
    font-weight: 700;
}

.quick-action-stack {
    display: grid;
    gap: 0.58rem;
    margin-top: 0.8rem;
}

.quick-action-stack a {
    border: 1px solid #d9e8f2;
    border-radius: 0.5rem;
    background: #f8fbff;
    color: #24475f;
    padding: 0.68rem 0.75rem;
    text-decoration: none;
    font-weight: 700;
}

.quick-action-stack a:hover {
    background: #eef8ff;
    color: #173646;
}

.sidebar-card {
    border: 1px solid #d7e6f2;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 0.88rem;
    box-shadow: var(--shadow-sm);
}

.sidebar-card span,
.sidebar-card small {
    display: block;
    color: var(--text-muted);
}

.sidebar-card span {
    font-size: 0.76rem;
    font-weight: 800;
}

.sidebar-card strong {
    display: block;
    margin: 0.18rem 0;
}

.role-mark {
    display: inline-block;
    width: 0.82rem;
    height: 0.82rem;
    border-radius: 0.22rem;
    margin-right: 0.45rem;
    transform: rotate(45deg);
    background: #ffd166;
}

.role-mark-shop {
    background: #70d6a3;
}

.role-mark-admin {
    background: #ffd166;
}

.home-lead {
    font-size: 1.03rem;
    max-width: 62ch;
}

.home-kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
}

.home-kpi {
    border: 1px solid #d4e3f6;
    border-radius: 0.92rem;
    background: rgba(255, 255, 255, 0.9);
    padding: 0.86rem;
}

.home-kpi-value {
    font-family: var(--font-heading);
    font-size: 1.28rem;
    margin-bottom: 0.2rem;
}

.home-kpi-label {
    color: var(--text-muted);
    font-size: 0.84rem;
}

.home-process-card {
    border: 1px solid #d8e5f6;
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    box-shadow: var(--shadow-sm);
    height: 100%;
}

.process-number {
    width: 1.95rem;
    height: 1.95rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.62rem;
    font-weight: 700;
    font-size: 0.85rem;
    background: linear-gradient(145deg, #d9f1ff, #ffe8c3);
    color: #134365;
}

.audience-card {
    border: 1px solid #d3e2f5;
    border-radius: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow-sm);
    height: 100%;
}

.audience-card h5 {
    margin-bottom: 0.4rem;
}

/* Print order experience */
.print-workspace {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(290px, 1fr);
    gap: 1rem;
    align-items: start;
}

.print-form-shell {
    border: 1px solid #d6e4f5;
    border-radius: 1.1rem;
    background: var(--surface);
    padding: 1.15rem;
    box-shadow: var(--shadow-md);
}

.form-step {
    border: 1px solid #dce8f6;
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.form-step + .form-step {
    margin-top: 0.9rem;
}

.step-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.25rem;
    font-weight: 700;
}

.step-label .step-dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    color: #fff;
    background: linear-gradient(135deg, #0b79a8, #26a4d7);
}

.step-description {
    margin-bottom: 0.9rem;
    color: var(--text-muted);
    font-size: 0.92rem;
}

.quick-preset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.6rem;
}

.quick-preset {
    border: 1px solid #cfe0f3;
    border-radius: 0.85rem;
    background: #f7fbff;
    color: #224768;
    text-align: left;
    padding: 0.65rem 0.72rem;
    transition: all 0.2s ease;
    cursor: pointer;
}

.quick-preset .preset-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
}

.quick-preset .preset-meta {
    display: block;
    margin-top: 0.12rem;
    font-size: 0.79rem;
    color: #5e7893;
}

.quick-preset:hover,
.quick-preset.is-active {
    border-color: #53add6;
    background: #e8f6ff;
    box-shadow: 0 10px 20px -16px rgba(11, 121, 168, 0.5);
}

.form-hint {
    display: block;
    margin-top: 0.25rem;
    color: #5e7893;
    font-size: 0.8rem;
}

.delivery-address-wrap {
    transition: all 0.25s ease;
}

.delivery-address-wrap.is-hidden {
    opacity: 0.45;
}

.print-summary-card {
    position: sticky;
    top: 110px;
    border: 1px solid #d5e3f5;
    border-radius: 1.06rem;
    background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
    box-shadow: var(--shadow-md);
    padding: 1rem;
}

.print-summary-title {
    margin-bottom: 0.16rem;
    font-weight: 700;
}

.print-summary-subtitle {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-bottom: 0.9rem;
}

.summary-line {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.48rem 0;
    border-bottom: 1px dashed #d4e2f3;
    font-size: 0.9rem;
}

.summary-line:last-child {
    border-bottom: 0;
}

.summary-value {
    font-weight: 600;
    text-align: right;
}

.summary-note {
    margin-top: 0.92rem;
    border: 1px solid #d6e4f5;
    border-radius: 0.85rem;
    padding: 0.72rem;
    background: rgba(255, 255, 255, 0.85);
    font-size: 0.84rem;
    color: #46607d;
}

.summary-note strong {
    color: #173a61;
}

/* Admin / Shop */
.admin-topbar {
    background: linear-gradient(95deg, #0f2f4a, #1f5e86);
    border-bottom: 1px solid rgba(217, 232, 246, 0.2);
    box-shadow: 0 12px 25px -20px rgba(15, 35, 58, 0.6);
}

.admin-title {
    color: #eef7ff;
    font-weight: 700;
}

.admin-shell {
    padding-top: 1rem;
}

.admin-sidebar {
    position: sticky;
    top: 84px;
}

.admin-menu {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.88);
    padding: 0.6rem;
    box-shadow: var(--shadow-sm);
}

.admin-menu .list-group-item {
    border: 1px solid transparent;
    border-radius: 0.72rem;
    margin-bottom: 0.26rem;
    font-weight: 500;
    color: #264668;
    padding: 0.57rem 0.68rem;
}

.admin-menu .list-group-item:hover {
    background: #f2f8ff;
    border-color: #d6e4f4;
    color: #1d3b5b;
}

.admin-menu .list-group-item.active {
    border-color: #0b79a8;
    background: linear-gradient(145deg, #0b79a8, #2ea6d8);
    color: #fff;
}

.status-badge {
    font-size: 0.8rem;
}

/* Motion */
@keyframes slide-up {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 1199.98px) {
    .landing-hero {
        grid-template-columns: 1fr;
    }

    .workspace-grid {
        grid-template-columns: 1fr;
    }

    .print-workspace {
        grid-template-columns: 1fr;
    }

    .print-summary-card {
        position: static;
    }
}

@media (max-width: 991.98px) {
    .site-main {
        padding-top: 1.2rem;
    }

    .landing-copy h1 {
        font-size: 2.22rem;
    }

    .portal-grid,
    .branch-grid,
    .operations-strip,
    .admin-board {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .page-hero {
        padding: 1.35rem;
    }

    .admin-sidebar {
        position: static;
    }

    .site-ribbon {
        display: none;
    }

    .home-kpi-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 767.98px) {
    .landing-hero,
    .landing-visual,
    .portal-card,
    .branch-card,
    .operations-strip {
        padding: 0.9rem;
    }

    .landing-copy h1 {
        font-size: 1.9rem;
    }

    .landing-actions .btn,
    .branch-actions .btn {
        width: 100%;
    }

    .landing-metrics {
        grid-template-columns: 1fr;
    }

    .quick-action-grid,
    .queue-board {
        grid-template-columns: 1fr;
    }

    .table th,
    .table td {
        padding: 0.62rem 0.65rem;
    }

    .site-footer {
        font-size: 0.84rem;
    }

    .print-form-shell {
        padding: 0.85rem;
    }

    .form-step {
        padding: 0.82rem;
    }

    .quick-preset-grid {
        grid-template-columns: 1fr;
    }
}

/* === ChatGPT Photocopy Final Home Start === */
/* Hoàn thiện landing page public theo ảnh mẫu */
:root {
    --pc-max: 1760px;
    --pc-pad: clamp(28px, 5.9vw, 96px);
    --pc-ink: #071344;
    --pc-text: #27355c;
    --pc-muted: #6b7690;
    --pc-blue: #0b70f5;
    --pc-blue-dark: #075bd1;
    --pc-green: #0faf86;
    --pc-green-dark: #078a6a;
    --pc-border: #dce6f3;
    --pc-soft: #f5f9ff;
    --pc-font: "Be Vietnam Pro", "Segoe UI", sans-serif;
    --pc-heading: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
}

html { scroll-behavior: smooth; }
body { margin: 0; overflow-x: hidden; background: #fff; color: var(--pc-text); font-family: var(--pc-font); }
a { text-decoration: none; }
svg { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.pc-site-header { position: sticky; top: 0; z-index: 1050; background: rgba(255,255,255,.98); border-bottom: 1px solid #dfe8f5; backdrop-filter: blur(18px); }
.pc-navbar { max-width: var(--pc-max); min-height: 82px; margin: 0 auto; padding: 0 var(--pc-pad); }
.pc-brand { display: inline-flex; align-items: center; gap: .82rem; color: var(--pc-ink); font-family: var(--pc-heading); font-weight: 800; font-size: 1.46rem; letter-spacing: .02em; }
.pc-brand:hover { color: var(--pc-ink); }
.pc-brand > span:last-child span { color: var(--pc-blue); }
.pc-brand-icon { width: 29px; height: 29px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; color: #fff; background: linear-gradient(135deg, var(--pc-blue), #075bd1); box-shadow: 0 12px 28px -18px rgba(11,112,245,.75); }
.pc-brand-icon svg { width: 17px; height: 17px; stroke-width: 2.4; }
.pc-nav-links { gap: clamp(2.1rem, 4vw, 5rem); }
.pc-nav-links .nav-link { position: relative; color: #121d45; font-size: .96rem; font-weight: 800; padding: .62rem 0; }
.pc-nav-links .nav-link:hover, .pc-nav-links .nav-link.active { color: var(--pc-blue); }
.pc-nav-links .nav-link.active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1.15rem; height: 3px; border-radius: 999px; background: var(--pc-blue); }
.pc-toggler { border: 1px solid #dbe6f3; }
.pc-toggler .navbar-toggler-icon { filter: invert(24%) sepia(41%) saturate(1182%) hue-rotate(192deg) brightness(90%) contrast(95%); }
.pc-site-main { padding: 0; }
.pc-alert-wrap { max-width: var(--pc-max); margin: 0 auto; padding: 0 var(--pc-pad); }

.pc-hero { position: relative; isolation: isolate; width: 100%; min-height: 438px; display: grid; grid-template-columns: minmax(520px,.88fr) minmax(760px,1.12fr); align-items: center; gap: clamp(46px,4.6vw,78px); padding: 26px var(--pc-pad) 28px; background: radial-gradient(circle at 46% 26%, rgba(11,112,245,.07) 0 21px, transparent 22px), radial-gradient(circle at 96% 44%, rgba(11,112,245,.055) 0 150px, transparent 151px), linear-gradient(180deg,#f8fbff 0%,#eef6ff 100%); }
.pc-hero > * { position: relative; z-index: 2; }
.pc-hero__copy { max-width: 650px; justify-self: end; }
.pc-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: .43rem .98rem; font-weight: 800; font-size: .9rem; }
.pc-pill--green { color: #079270; background: #dff8ed; }
.pc-pill--blue { color: var(--pc-blue); background: #e7f0ff; }
.pc-hero h1 { max-width: 650px; margin: 1.05rem 0 0; color: var(--pc-ink); font-family: var(--pc-heading); font-size: clamp(3rem,3.15vw,4.05rem); font-weight: 800; line-height: 1.13; letter-spacing: .018em; }
.pc-hero p { max-width: 650px; margin: 1.18rem 0 1.62rem; color: #27365f; font-size: 1.04rem; line-height: 1.72; }
.pc-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.35rem; }
.pc-btn { min-height: 55px; min-width: 190px; display: inline-flex; align-items: center; justify-content: center; gap: .58rem; border-radius: 7px; border: 1px solid transparent; padding: .92rem 1.42rem; font-weight: 800; font-size: 1rem; transition: .18s ease; }
.pc-btn svg { width: 1.08rem; height: 1.08rem; }
.pc-btn--primary { color: #fff; background: linear-gradient(135deg,var(--pc-blue),#075bd1); box-shadow: 0 18px 35px -24px rgba(11,112,245,.9); }
.pc-btn--primary:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 22px 40px -24px rgba(11,112,245,1); }
.pc-btn--ghost { color: var(--pc-blue); background: #fff; border-color: #c7d8ef; box-shadow: 0 12px 28px -28px rgba(26,55,100,.55); }
.pc-btn--ghost:hover { color: var(--pc-blue-dark); border-color: #b8cee9; transform: translateY(-1px); }
.pc-btn--success { color: #fff; background: linear-gradient(135deg,var(--pc-green),#079b78); box-shadow: 0 18px 35px -24px rgba(15,175,134,.9); }
.pc-btn--success:hover { color: #fff; transform: translateY(-1px); }
.pc-btn--compact { min-width: 172px; min-height: 44px; padding: .72rem 1.15rem; font-size: .94rem; }
.pc-hero__orb, .pc-hero__spark { position: absolute; z-index: 1; pointer-events: none; }
.pc-hero__orb--one { width: 58px; height: 58px; left: 45.2%; top: 30%; border-radius: 50%; background: rgba(11,112,245,.075); }
.pc-hero__orb--two { width: 280px; height: 172px; right: 6%; top: 29%; border-radius: 50%; background: rgba(11,112,245,.045); }
.pc-hero__spark--one { right: 5.3%; top: 50%; width: 12px; height: 12px; background: #fff; transform: rotate(45deg); box-shadow: 0 0 20px rgba(11,112,245,.18); }
.pc-hero__spark--two { left: 45.7%; bottom: 22%; width: 24px; height: 24px; border: 7px solid rgba(11,112,245,.13); border-radius: 50%; }

.pc-hero__visual { justify-self: start; width: min(900px,100%); }
.pc-dashboard-card { overflow: hidden; width: 100%; min-height: 405px; border: 1px solid #dfe8f5; border-radius: 17px; background: rgba(255,255,255,.92); box-shadow: 0 28px 80px -56px rgba(35,63,115,.52); }
.pc-dashboard-card__top { min-height: 70px; display: grid; grid-template-columns: 218px minmax(280px,1fr) 116px; align-items: center; gap: 1.1rem; padding: 1.06rem 1.55rem; border-bottom: 1px solid #e8eff8; }
.pc-logo-mini { display: inline-flex; align-items: center; gap: .7rem; color: var(--pc-ink); font-family: var(--pc-heading); font-size: 1.04rem; }
.pc-logo-mini span { width: 24px; height: 24px; border-radius: 7px; background: linear-gradient(135deg,var(--pc-blue),#075bd1); position: relative; }
.pc-logo-mini span::before { content: ""; position: absolute; inset: 7px 6px; border-top: 2px solid #fff; border-bottom: 2px solid #fff; }
.pc-search { height: 35px; display: flex; align-items: center; gap: .6rem; padding: 0 1.15rem; border-radius: 8px; background: #f5f8fd; color: #75819a; font-size: .8rem; }
.pc-search svg { width: .95rem; height: .95rem; }
.pc-top-icons { display: flex; justify-content: flex-end; align-items: center; gap: .82rem; color: #18305b; }
.pc-top-icons svg { width: 18px; height: 18px; }
.pc-avatar { width: 36px; height: 36px; border-radius: 50%; background: radial-gradient(circle at 50% 38%,#ffd88f 0 17%,transparent 18%), radial-gradient(circle at 50% 78%,#7eb4ff 0 27%,transparent 28%), #f6d694; box-shadow: inset 0 0 0 6px rgba(255,255,255,.42); }
.pc-dashboard-card__body { min-height: 333px; display: grid; grid-template-columns: 188px minmax(0,1fr); }
.pc-sidebar-demo { display: flex; flex-direction: column; gap: .5rem; padding: 1.1rem 1rem; background: #fbfdff; border-right: 1px solid #edf2f8; }
.pc-sidebar-demo span { display: flex; align-items: center; gap: .75rem; padding: .68rem .8rem; border-radius: 8px; color: #15264d; font-size: .86rem; font-weight: 700; }
.pc-sidebar-demo svg { width: 17px; height: 17px; color: #283c69; }
.pc-sidebar-demo span.active { color: var(--pc-blue); background: #edf4ff; }
.pc-sidebar-demo span.active svg { color: var(--pc-blue); }
.pc-board-demo { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(250px,.85fr); gap: 1.1rem; padding: 1.1rem 1.15rem; }
.pc-board-panel { border: 1px solid #e0e8f4; border-radius: 10px; background: #fff; padding: 1.05rem 1.15rem; }
.pc-board-panel h3 { margin: 0 0 .95rem; color: var(--pc-ink); font-size: .94rem; font-weight: 800; }
.pc-orders-panel { display: flex; flex-direction: column; gap: .8rem; }
.pc-order-row { display: grid; grid-template-columns: 26px minmax(0,1fr) auto; gap: .62rem; align-items: center; min-height: 38px; }
.pc-order-row > span { display: inline-flex; color: #31436a; }
.pc-order-row strong { display: block; color: #0c1c46; font-size: .84rem; }
.pc-order-row small { color: #7a859d; font-size: .75rem; }
.pc-order-row em { padding: .2rem .58rem; border-radius: 999px; color: #ef6b52; background: #fff0e7; font-style: normal; font-size: .7rem; font-weight: 800; }
.pc-order-row em.warn { color: #f29a30; background: #fff2db; }
.pc-order-row em.done { color: var(--pc-green); background: #e5f8f1; }
.pc-orders-panel a { margin-top: .55rem; padding: .78rem; border-radius: 8px; color: var(--pc-blue); background: #f4f8ff; text-align: center; font-weight: 800; font-size: .83rem; }
.pc-board-side { display: flex; flex-direction: column; gap: 1.05rem; }
.pc-file-line { display: grid; grid-template-columns: 28px minmax(0,1fr) auto; align-items: center; gap: .72rem; font-size: .78rem; }
.pc-file-line strong { color: #27365f; font-size: .78rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pc-file-line span { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; color: #33456d; background: #eef3fb; }
.pc-progress { height: 4px; margin-top: .82rem; border-radius: 999px; background: #e2e8f2; overflow: hidden; }
.pc-progress span { display: block; width: 100%; height: 100%; background: #19b889; }
.pc-stat-lines { display: grid; grid-template-columns: repeat(3,1fr); gap: .72rem; color: #24345b; font-size: .7rem; font-weight: 700; }
.pc-stat-lines span::after { content: ""; display: block; height: 5px; margin-top: 1.05rem; border-radius: 999px; background: #dfe7f3; }

.pc-benefits { max-width: var(--pc-max); display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1.55rem; margin: 0 auto; padding: 20px var(--pc-pad) 28px; }
.pc-benefit-card { min-height: 122px; display: grid; grid-template-columns: 86px minmax(0,1fr); align-items: center; gap: 1.05rem; padding: 1.18rem 1.35rem; border: 1px solid var(--pc-border); border-radius: 13px; background: #fff; box-shadow: 0 16px 55px -48px rgba(31,59,105,.55); }
.pc-benefit-icon { width: 64px; height: 64px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--pc-blue); background: #edf5ff; font-size: 1.82rem; }
.pc-benefit-icon--green { color: var(--pc-green); background: #e8f8f2; }
.pc-benefit-card h2 { margin: 0 0 .42rem; color: var(--pc-ink); font-size: 1.03rem; font-weight: 800; line-height: 1.25; }
.pc-benefit-card p { margin: 0; color: #263660; font-size: .96rem; line-height: 1.55; }

.pc-solutions { max-width: var(--pc-max); margin: 0 auto; padding: 0 var(--pc-pad) 18px; }
.pc-section-heading { max-width: 760px; margin: 0 auto 1.28rem; text-align: center; }
.pc-section-heading h2 { margin: 0 0 .48rem; color: var(--pc-ink); font-family: var(--pc-heading); font-size: 1.58rem; font-weight: 800; line-height: 1.2; }
.pc-section-heading p { margin: 0; color: #475778; font-size: .98rem; }
.pc-solution-grid { max-width: 1380px; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2.05rem; margin: 0 auto; }
.pc-solution-card { min-height: 170px; display: grid; grid-template-columns: 128px minmax(0,1fr); align-items: center; gap: 1.1rem; padding: 1.24rem 1.55rem; border: 1px solid var(--pc-border); border-radius: 13px; background: #fff; box-shadow: 0 16px 55px -50px rgba(31,59,105,.55); }
.pc-solution-icon { width: 88px; height: 88px; display: flex; align-items: center; justify-content: center; justify-self: center; border-radius: 50%; color: var(--pc-blue); background: #edf5ff; font-size: 2.25rem; }
.pc-solution-icon--green { color: var(--pc-green); background: #e7f8f1; }
.pc-solution-card h3 { margin: 0 0 .58rem; color: var(--pc-ink); font-size: 1.04rem; font-weight: 800; }
.pc-solution-card ul { display: grid; gap: .42rem; margin: 0; padding: 0; list-style: none; }
.pc-solution-card li { position: relative; padding-left: 1.55rem; color: #263660; font-size: .96rem; }
.pc-solution-card li::before { content: "✓"; position: absolute; left: 0; color: var(--pc-green); font-weight: 900; }
.pc-solution-card .pc-btn { justify-self: end; }

.pc-detail-section { max-width: var(--pc-max); display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2.05rem; margin: 0 auto; padding: 14px var(--pc-pad) 38px; }
.pc-detail-card { border: 1px solid var(--pc-border); border-radius: 20px; background: linear-gradient(180deg,#fff,#f8fbff); padding: 1.45rem; box-shadow: 0 18px 60px -52px rgba(31,59,105,.58); }
.pc-detail-card--green { background: linear-gradient(180deg,#fff,#f6fffb); }
.pc-detail-card h2 { margin: .72rem 0 .42rem; color: var(--pc-ink); font-family: var(--pc-heading); font-size: 1.34rem; line-height: 1.18; font-weight: 800; }
.pc-detail-card p { margin: 0; color: #465779; line-height: 1.52; }
.pc-step-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .9rem; margin-top: 1.15rem; }
.pc-step-grid div { min-height: 104px; padding: .86rem; border: 1px solid #e1eaf5; border-radius: 14px; background: #fff; }
.pc-step-grid span { display: inline-flex; margin-bottom: .7rem; color: var(--pc-blue); font-weight: 900; font-size: .88rem; }
.pc-detail-card--green .pc-step-grid span { color: var(--pc-green); }
.pc-step-grid strong { display: block; color: var(--pc-ink); margin-bottom: .25rem; font-weight: 800; }
.pc-step-grid small { color: #667391; line-height: 1.38; }

.pc-footer { border-top: 1px solid #dde7f4; background: #fff; padding: 24px 0 26px; }
.pc-footer-grid { max-width: var(--pc-max); display: grid; grid-template-columns: minmax(260px,1.35fr) minmax(130px,.56fr) minmax(140px,.58fr) minmax(150px,.62fr) minmax(310px,1fr); gap: clamp(2rem,4.2vw,5rem); margin: 0 auto; padding: 0 var(--pc-pad); }
.pc-footer h3 { margin: 0 0 .78rem; color: var(--pc-ink); font-size: .96rem; font-weight: 800; }
.pc-footer p, .pc-footer a, .pc-footer span { color: #4a5876; font-size: .94rem; line-height: 1.65; }
.pc-footer a { display: block; margin: .42rem 0; }
.pc-footer-brand p { max-width: 315px; margin: .82rem 0 0; }
.pc-brand--footer { font-size: 1.18rem; }
.pc-footer-contact p { display: flex; align-items: center; gap: .72rem; margin: .35rem 0; }
.pc-footer-contact svg { width: 18px; height: 18px; color: #536789; }

@media (max-width:1399.98px){:root{--pc-pad:clamp(22px,3vw,42px)}.pc-hero{grid-template-columns:minmax(430px,.88fr) minmax(620px,1.12fr);gap:34px}.pc-hero h1{font-size:clamp(2.65rem,3.2vw,3.35rem)}.pc-dashboard-card__top{grid-template-columns:190px minmax(180px,1fr) 100px}.pc-dashboard-card__body{grid-template-columns:168px minmax(0,1fr)}.pc-board-demo{grid-template-columns:minmax(0,1.12fr) minmax(210px,.88fr)}.pc-solution-card{grid-template-columns:105px minmax(0,1fr)}.pc-solution-card .pc-btn{grid-column:2;justify-self:start}.pc-step-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:1199.98px){.pc-navbar{padding-left:24px;padding-right:24px}.pc-hero{grid-template-columns:1fr;min-height:auto;padding:46px 24px 34px}.pc-hero__copy,.pc-hero__visual{justify-self:center;max-width:920px;width:100%}.pc-hero h1,.pc-hero p{max-width:820px}.pc-benefits{grid-template-columns:repeat(2,minmax(0,1fr));padding-left:24px;padding-right:24px}.pc-solutions,.pc-detail-section{padding-left:24px;padding-right:24px}.pc-solution-grid,.pc-detail-section{max-width:920px;grid-template-columns:1fr}.pc-solution-card{grid-template-columns:110px minmax(0,1fr)}.pc-solution-card .pc-btn{grid-column:auto;justify-self:end}.pc-footer-grid{grid-template-columns:repeat(2,minmax(0,1fr));padding-left:24px;padding-right:24px}.pc-step-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:991.98px){.pc-navbar{min-height:auto;padding-top:.82rem;padding-bottom:.82rem}.pc-nav-links{gap:.25rem}.pc-nav-links .nav-link.active::after{display:none}.pc-hero{padding-top:34px}.pc-dashboard-card__top,.pc-dashboard-card__body,.pc-board-demo{grid-template-columns:1fr}.pc-sidebar-demo{display:none}.pc-solution-card{grid-template-columns:96px minmax(0,1fr)}.pc-solution-card .pc-btn{grid-column:1/-1;justify-self:stretch;width:100%}.pc-step-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:767.98px){.pc-navbar{padding-left:16px;padding-right:16px}.pc-hero{padding:28px 16px 24px}.pc-hero h1{font-size:2.28rem;line-height:1.16}.pc-hero p{font-size:.98rem}.pc-hero__actions{gap:.8rem}.pc-hero__actions .pc-btn{width:100%}.pc-benefits,.pc-solutions,.pc-detail-section{padding-left:16px;padding-right:16px}.pc-benefits,.pc-solution-grid,.pc-detail-section{grid-template-columns:1fr}.pc-benefit-card,.pc-solution-card{grid-template-columns:1fr}.pc-benefit-card{min-height:auto}.pc-footer-grid{grid-template-columns:1fr;padding-left:16px;padding-right:16px}}
/* === ChatGPT Photocopy Final Home End === */

/* === ChatGPT Customer Shop Portfolio Pages Start === */
.pc-portfolio-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: 1740px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 6.25rem) clamp(1rem, 5.8vw, 6rem);
    overflow: hidden;
}

.pc-portfolio-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
        radial-gradient(circle at 76% 22%, rgba(8, 107, 242, 0.11), transparent 28%),
        radial-gradient(circle at 12% 76%, rgba(16, 167, 125, 0.09), transparent 25%),
        linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%);
}

.pc-portfolio-hero--shop::before {
    background:
        radial-gradient(circle at 74% 22%, rgba(16, 167, 125, 0.13), transparent 28%),
        radial-gradient(circle at 12% 76%, rgba(8, 107, 242, 0.08), transparent 25%),
        linear-gradient(180deg, #f8fffb 0%, #eefaf6 100%);
}

.pc-portfolio-hero__copy {
    max-width: 720px;
}

.pc-portfolio-hero h1 {
    margin: 1.1rem 0 1rem;
    color: #071344;
    font-size: clamp(2.5rem, 4.2vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 800;
}

.pc-portfolio-hero p {
    max-width: 680px;
    color: #33415f;
    font-size: clamp(1rem, 1.2vw, 1.16rem);
    line-height: 1.8;
}

.pc-portfolio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
}

.pc-portfolio-preview {
    display: flex;
    justify-content: center;
}

.pc-phone-card,
.pc-shop-board {
    width: min(100%, 520px);
    border: 1px solid rgba(204, 216, 234, 0.96);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 34px 95px -55px rgba(15, 45, 90, 0.56);
    backdrop-filter: blur(18px);
}

.pc-phone-card {
    max-width: 420px;
    padding: 1.35rem;
}

.pc-phone-bar {
    width: 64px;
    height: 7px;
    margin: 0 auto 1.4rem;
    border-radius: 999px;
    background: #dce7f5;
}

.pc-phone-title,
.pc-shop-board__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #071344;
    font-weight: 800;
}

.pc-phone-title span {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    color: #086bf2;
    background: #eaf3ff;
}

.pc-phone-title svg,
.pc-phone-upload svg,
.pc-feature-icon svg,
.pc-shop-board svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-phone-upload {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    margin: 1.4rem 0;
    padding: 1.8rem 1.2rem;
    border: 1px dashed #b9cef0;
    border-radius: 22px;
    color: #086bf2;
    background: linear-gradient(180deg, #f5faff, #ffffff);
    text-align: center;
}

.pc-phone-upload svg {
    width: 46px;
    height: 46px;
}

.pc-phone-upload b {
    color: #071344;
}

.pc-phone-upload small,
.pc-phone-list small,
.pc-shop-orders small {
    color: #687693;
}

.pc-phone-list {
    display: grid;
    gap: 0.8rem;
}

.pc-phone-list span,
.pc-shop-orders div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1rem;
    border: 1px solid #e2ebf6;
    border-radius: 16px;
    background: #fff;
}

.pc-phone-list b,
.pc-shop-orders strong {
    color: #071344;
}

.pc-shop-board {
    max-width: 620px;
    padding: 1.35rem;
    border-radius: 28px;
}

.pc-shop-board__top {
    padding: 0.4rem 0.2rem 1.15rem;
}

.pc-shop-board__top span {
    padding: 0.42rem 0.75rem;
    border-radius: 999px;
    background: #e8f8f2;
    color: #0e9d78;
    font-size: 0.82rem;
}

.pc-shop-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-bottom: 1rem;
}

.pc-shop-stats span {
    display: grid;
    gap: 0.18rem;
    padding: 1rem;
    border-radius: 18px;
    background: #f4fbf8;
    border: 1px solid #d9f1e8;
}

.pc-shop-stats b {
    color: #071344;
    font-size: 1.65rem;
    line-height: 1;
}

.pc-shop-stats small {
    color: #65806f;
}

.pc-shop-orders {
    display: grid;
    gap: 0.75rem;
}

.pc-shop-orders i {
    width: 34px;
    height: 34px;
    border-radius: 12px;
    background: #e8f8f2;
}

.pc-shop-chart {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: end;
    gap: 0.8rem;
    height: 120px;
    margin-top: 1.15rem;
    padding: 1rem;
    border-radius: 20px;
    background: linear-gradient(180deg, #f8fffc, #ffffff);
    border: 1px solid #e0f0ea;
}

.pc-shop-chart span {
    display: block;
    min-height: 30%;
    border-radius: 999px 999px 8px 8px;
    background: linear-gradient(180deg, #10a77d, #6ee4bd);
}

.pc-shop-chart span:nth-child(2) { height: 68%; }
.pc-shop-chart span:nth-child(3) { height: 44%; }
.pc-shop-chart span:nth-child(4) { height: 82%; }
.pc-shop-chart span:nth-child(5) { height: 58%; }

.pc-portfolio-section,
.pc-process-section,
.pc-portfolio-cta {
    max-width: 1740px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 5.2rem) clamp(1rem, 5.8vw, 6rem);
}

.pc-portfolio-grid {
    display: grid;
    gap: 1.25rem;
}

.pc-portfolio-grid--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.pc-feature-card {
    min-height: 245px;
    padding: 1.55rem;
    border: 1px solid #dfe8f5;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 22px 68px -56px rgba(18, 49, 90, 0.4);
}

.pc-feature-icon {
    width: 62px;
    height: 62px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
    border-radius: 20px;
    color: #086bf2;
    background: #eaf3ff;
}

.pc-feature-icon--green {
    color: #10a77d;
    background: #e8f8f2;
}

.pc-feature-card h3 {
    margin-bottom: 0.65rem;
    color: #071344;
    font-size: 1.1rem;
    font-weight: 800;
}

.pc-feature-card p {
    margin: 0;
    color: #5d6a86;
    line-height: 1.7;
}

.pc-process-section {
    background:
        radial-gradient(circle at 8% 10%, rgba(8, 107, 242, 0.08), transparent 26%),
        linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
}

.pc-process-section--green {
    background:
        radial-gradient(circle at 8% 10%, rgba(16, 167, 125, 0.1), transparent 26%),
        linear-gradient(180deg, #ffffff 0%, #f7fffb 100%);
}

.pc-process-timeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem;
}

.pc-process-timeline article {
    position: relative;
    min-height: 215px;
    padding: 1.45rem;
    border-radius: 22px;
    border: 1px solid #e0e9f5;
    background: rgba(255, 255, 255, 0.92);
}

.pc-process-timeline span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1rem;
    border-radius: 16px;
    background: #086bf2;
    color: #fff;
    font-weight: 800;
}

.pc-process-section--green .pc-process-timeline span {
    background: #10a77d;
}

.pc-process-timeline h3 {
    margin-bottom: 0.6rem;
    color: #071344;
    font-size: 1.05rem;
    font-weight: 800;
}

.pc-process-timeline p {
    margin: 0;
    color: #5d6a86;
    line-height: 1.65;
}

.pc-portfolio-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2rem;
    border-radius: 32px;
    background:
        radial-gradient(circle at 92% 20%, rgba(8, 107, 242, 0.15), transparent 25%),
        linear-gradient(135deg, #071344, #0b2f72);
    color: #fff;
}

.pc-portfolio-cta--green {
    background:
        radial-gradient(circle at 92% 20%, rgba(16, 167, 125, 0.2), transparent 25%),
        linear-gradient(135deg, #072b26, #075746);
}

.pc-portfolio-cta h2 {
    margin: 1rem 0 0.55rem;
    font-size: clamp(1.75rem, 2.4vw, 3rem);
    font-weight: 800;
}

.pc-portfolio-cta p {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.75;
}

@media (max-width: 1199.98px) {
    .pc-portfolio-hero {
        grid-template-columns: 1fr;
    }

    .pc-portfolio-grid--four,
    .pc-process-timeline {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pc-portfolio-cta {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 767.98px) {
    .pc-portfolio-hero,
    .pc-portfolio-section,
    .pc-process-section,
    .pc-portfolio-cta {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .pc-portfolio-grid--four,
    .pc-process-timeline,
    .pc-shop-stats {
        grid-template-columns: 1fr;
    }

    .pc-portfolio-hero h1 {
        font-size: 2.35rem;
    }

    .pc-portfolio-actions .pc-btn,
    .pc-portfolio-cta .pc-btn {
        width: 100%;
    }
}
/* === ChatGPT Customer Shop Portfolio Pages End === */

/* === ChatGPT Portfolio Pages Start === */
.pc-portfolio-page {
    background: #fff;
}

.pc-portfolio-hero2 {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(380px, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: 1740px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 5.8vw, 6rem);
    background:
        radial-gradient(circle at 75% 25%, rgba(8, 107, 242, 0.1), transparent 26%),
        linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%);
}

.pc-portfolio-page--shop .pc-portfolio-hero2 {
    background:
        radial-gradient(circle at 75% 25%, rgba(16, 167, 125, 0.12), transparent 26%),
        linear-gradient(180deg, #f8fffb 0%, #eefaf6 100%);
}

.pc-portfolio-copy {
    max-width: 760px;
}

.pc-portfolio-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: #eaf3ff;
    color: #086bf2;
    font-weight: 800;
    font-size: 0.9rem;
}

.pc-portfolio-pill--green {
    background: #e8f8f2;
    color: #10a77d;
}

.pc-portfolio-copy h1 {
    margin: 1.15rem 0 1rem;
    color: #071344;
    font-size: clamp(2.4rem, 4.2vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 800;
}

.pc-portfolio-copy p {
    max-width: 700px;
    margin: 0;
    color: #33415f;
    font-size: 1.08rem;
    line-height: 1.8;
}

.pc-portfolio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
}

.pc-portfolio-device,
.pc-portfolio-dashboard {
    width: min(100%, 560px);
    justify-self: center;
    border: 1px solid rgba(204, 216, 234, 0.96);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 34px 95px -55px rgba(15, 45, 90, 0.56);
}

.pc-portfolio-device {
    max-width: 430px;
    padding: 1.35rem;
}

.pc-device-top {
    width: 64px;
    height: 7px;
    margin: 0 auto 1.4rem;
    border-radius: 999px;
    background: #dce7f5;
}

.pc-device-upload {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    margin-bottom: 1rem;
    padding: 1.75rem 1rem;
    border: 1px dashed #b9cef0;
    border-radius: 22px;
    background: linear-gradient(180deg, #f5faff, #ffffff);
    text-align: center;
    color: #086bf2;
}

.pc-device-upload svg,
.pc-portfolio-cards svg {
    width: 44px;
    height: 44px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-device-upload strong {
    color: #071344;
}

.pc-device-upload span,
.pc-device-row span {
    color: #687693;
}

.pc-device-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1rem;
    margin-top: 0.75rem;
    border: 1px solid #e2ebf6;
    border-radius: 16px;
    background: #fff;
}

.pc-device-row b {
    color: #071344;
}

.pc-portfolio-dashboard {
    padding: 1.35rem;
    max-width: 640px;
}

.pc-dashboard-head,
.pc-dashboard-list div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

.pc-dashboard-head {
    padding-bottom: 1rem;
    color: #071344;
}

.pc-dashboard-head span {
    padding: 0.42rem 0.75rem;
    border-radius: 999px;
    background: #e8f8f2;
    color: #0e9d78;
    font-size: 0.82rem;
    font-weight: 800;
}

.pc-dashboard-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-bottom: 1rem;
}

.pc-dashboard-stats div {
    padding: 1rem;
    border: 1px solid #d9f1e8;
    border-radius: 18px;
    background: #f4fbf8;
}

.pc-dashboard-stats b {
    display: block;
    color: #071344;
    font-size: 1.7rem;
}

.pc-dashboard-stats span,
.pc-dashboard-list span {
    color: #65806f;
}

.pc-dashboard-list {
    display: grid;
    gap: 0.75rem;
}

.pc-dashboard-list div {
    padding: 0.95rem 1rem;
    border: 1px solid #e0f0ea;
    border-radius: 16px;
    background: #fff;
}

.pc-portfolio-section {
    max-width: 1740px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 5.2rem) clamp(1rem, 5.8vw, 6rem);
}

.pc-portfolio-section--soft {
    background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
}

.pc-portfolio-page--shop .pc-portfolio-section--soft {
    background: linear-gradient(180deg, #ffffff 0%, #f7fffb 100%);
}

.pc-portfolio-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
}

.pc-portfolio-cards article {
    min-height: 245px;
    padding: 1.55rem;
    border: 1px solid #dfe8f5;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 22px 68px -56px rgba(18, 49, 90, 0.4);
}

.pc-portfolio-cards svg {
    width: 58px;
    height: 58px;
    margin-bottom: 1.1rem;
    padding: 0.9rem;
    border-radius: 20px;
    color: #086bf2;
    background: #eaf3ff;
}

.pc-portfolio-page--shop .pc-portfolio-cards svg {
    color: #10a77d;
    background: #e8f8f2;
}

.pc-portfolio-cards h3,
.pc-portfolio-steps h3 {
    color: #071344;
    font-size: 1.08rem;
    font-weight: 800;
}

.pc-portfolio-cards p,
.pc-portfolio-steps p {
    color: #5d6a86;
    line-height: 1.7;
}

.pc-portfolio-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem;
}

.pc-portfolio-steps article {
    min-height: 215px;
    padding: 1.45rem;
    border: 1px solid #e0e9f5;
    border-radius: 22px;
    background: #fff;
}

.pc-portfolio-steps span {
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border-radius: 16px;
    background: #086bf2;
    color: #fff;
    font-weight: 800;
}

.pc-portfolio-page--shop .pc-portfolio-steps span {
    background: #10a77d;
}

@media (max-width: 1199.98px) {
    .pc-portfolio-hero2 {
        grid-template-columns: 1fr;
    }

    .pc-portfolio-cards,
    .pc-portfolio-steps {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 767.98px) {
    .pc-portfolio-hero2,
    .pc-portfolio-section {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .pc-portfolio-cards,
    .pc-portfolio-steps,
    .pc-dashboard-stats {
        grid-template-columns: 1fr;
    }

    .pc-portfolio-copy h1 {
        font-size: 2.35rem;
    }

    .pc-portfolio-actions .pc-btn {
        width: 100%;
    }
}
/* === ChatGPT Portfolio Pages End === */

/* === ChatGPT Shop Routing Pages Start === */
.shop-directory-shell {
    min-height: 100vh;
    margin: 0;
    background:
        radial-gradient(circle at 8% 8%, rgba(8, 107, 242, 0.08), transparent 22rem),
        radial-gradient(circle at 86% 18%, rgba(76, 151, 255, 0.09), transparent 24rem),
        linear-gradient(180deg, #f7fbff 0%, #edf5ff 42%, #f9fcff 100%);
    color: #101b49;
    font-family: "Be Vietnam Pro", "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.shop-directory-topbar {
    position: sticky;
    top: 0;
    z-index: 1040;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 74px;
    gap: 1.25rem;
    padding: 0 2.25rem;
    border-bottom: 1px solid #d7e4f5;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 10px 34px -34px rgba(10, 36, 92, 0.5);
}

.shop-directory-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: #0c1749;
    font-size: 1.22rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
}

.shop-directory-brand span {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: linear-gradient(180deg, #0c74ff 0%, #075eea 100%);
    color: #fff;
    box-shadow: 0 12px 28px -14px rgba(8, 107, 242, 0.8);
}

.shop-directory-brand svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-directory-topnav {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    color: #3f4b70;
    font-size: 0.96rem;
    font-weight: 750;
}

.shop-directory-topnav a,
.shop-directory-topnav strong {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
}

.shop-directory-topnav > span {
    width: 1px;
    height: 24px;
    background: #d9e3f3;
}

.shop-directory-topnav svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-directory-main {
    width: min(100%, 1392px);
    margin: 0 auto;
    padding: 1.6rem 1.5rem 1.25rem;
}

.shop-directory-hero {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 220px;
    align-items: center;
    min-height: 210px;
    overflow: hidden;
    padding: 2rem 2.5rem;
    border: 1px solid #d7e5f7;
    border-radius: 18px;
    background:
        linear-gradient(180deg, rgba(255,255,255,0.94), rgba(255,255,255,0.98)),
        linear-gradient(90deg, rgba(236,246,255,0.92), rgba(255,255,255,0.96));
    box-shadow: 0 26px 76px -54px rgba(19, 52, 110, 0.56);
}

.shop-hero-copy {
    position: relative;
    z-index: 2;
    text-align: center;
}

.shop-directory-hero h1 {
    margin: 0.8rem 0 0.5rem;
    color: #10164c;
    font-size: 3rem;
    line-height: 1.08;
    letter-spacing: 0;
    font-weight: 850;
}

.shop-directory-hero h1 span {
    color: #116bf4;
}

.shop-front-copy h1 {
    margin: 1rem 0;
    color: #071344;
    font-size: clamp(2.4rem, 4vw, 4.7rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 800;
}

.shop-directory-hero p {
    margin: 0;
    color: #4f5b82;
    font-size: 1rem;
    line-height: 1.6;
}

.shop-front-copy p {
    color: #5d6a86;
    line-height: 1.75;
}

.shop-route-pill {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #dcecff, #cfe4ff);
    color: #0968ef;
    font-size: 0.9rem;
    font-weight: 800;
}

.shop-hero-illustration {
    position: relative;
    z-index: 2;
    align-self: end;
    width: 160px;
    justify-self: start;
    margin-left: -0.85rem;
}

.shop-hero-illustration svg {
    width: 100%;
    height: auto;
    overflow: visible;
}

.shop-ill-shadow {
    fill: none;
    stroke: rgba(18, 92, 224, 0.16);
    stroke-width: 8;
    stroke-linecap: round;
}

.shop-ill-wall {
    fill: #d9ebff;
    stroke: #6da9ff;
    stroke-width: 2;
}

.shop-ill-roof {
    fill: #cce2ff;
}

.shop-ill-awning {
    fill: #126ff3;
}

.shop-ill-awning-stripe,
.shop-ill-door,
.shop-ill-window {
    fill: #eaf4ff;
    stroke: #126ff3;
    stroke-width: 3;
}

.shop-ill-tree {
    stroke: #1aa874;
    stroke-width: 7;
    stroke-linecap: round;
}

.shop-ill-leaf {
    fill: #42d992;
}

.shop-ill-pin {
    fill: #3d8cff;
}

.shop-ill-pin-dot {
    fill: #fff;
}

.shop-hero-dots {
    position: absolute;
    z-index: 1;
    width: 86px;
    height: 86px;
    opacity: 0.32;
    background-image: radial-gradient(circle, #8bbfff 2px, transparent 2px);
    background-size: 18px 18px;
}

.shop-hero-dots--left {
    left: 32px;
    top: 42px;
}

.shop-hero-dots--right {
    right: 20px;
    top: 54px;
}

.shop-hero-cloud {
    position: absolute;
    z-index: 1;
    width: 112px;
    height: 38px;
    border-radius: 999px;
    background: linear-gradient(180deg, #eef6ff, #dfeeff);
    opacity: 0.62;
}

.shop-hero-cloud::before,
.shop-hero-cloud::after {
    content: "";
    position: absolute;
    bottom: 8px;
    border-radius: 50%;
    background: inherit;
}

.shop-hero-cloud::before {
    left: 20px;
    width: 44px;
    height: 44px;
}

.shop-hero-cloud::after {
    left: 55px;
    width: 58px;
    height: 58px;
}

.shop-hero-cloud--left {
    left: 172px;
    top: 74px;
}

.shop-hero-cloud--right {
    right: 174px;
    top: 88px;
}

.shop-directory-benefits {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin-top: -1px;
    padding: 0.95rem 2rem;
    border: 1px solid #d7e5f7;
    border-top: 0;
    border-radius: 0 0 18px 18px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 22px 70px -62px rgba(19, 52, 110, 0.56);
}

.shop-directory-benefits article {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-width: 0;
    min-height: 50px;
    padding: 0 1rem;
    border-right: 1px solid #dfe9f7;
}

.shop-directory-benefits article:last-child {
    border-right: 0;
}

.shop-benefit-icon {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #eef6ff;
    color: #0968ef;
}

.shop-benefit-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-directory-benefits strong,
.shop-directory-benefits small {
    display: block;
}

.shop-directory-benefits strong {
    color: #0968ef;
    font-size: 0.94rem;
    font-weight: 850;
}

.shop-directory-benefits small {
    color: #596682;
    font-size: 0.86rem;
    line-height: 1.35;
}

.shop-directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0 auto;
    padding: 1.1rem 0 0;
}

.shop-directory-card {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
    padding: 1.15rem;
    border: 1px solid #e3ebf7;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.96);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 22px 58px -44px rgba(17, 45, 92, 0.42);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.shop-directory-card:hover,
.shop-directory-card:focus {
    border-color: #9ec4f4;
    box-shadow: 0 22px 54px -38px rgba(8, 107, 242, 0.48);
    color: inherit;
    transform: translateY(-2px);
}

.shop-directory-icon {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #086bf2;
    background: linear-gradient(180deg, #eff7ff, #e4f0ff);
    box-shadow: 0 14px 30px -22px rgba(8, 107, 242, 0.8);
}

.shop-directory-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-directory-slug {
    color: #0968ef;
    font-size: 0.86rem;
    font-weight: 800;
    word-break: break-word;
}

.shop-directory-card h2 {
    margin: 0.35rem 0 0.85rem;
    color: #10164c;
    font-size: 1.18rem;
    line-height: 1.28;
    font-weight: 850;
}

.shop-directory-card p {
    display: -webkit-box;
    margin-bottom: 0.95rem;
    overflow: hidden;
    color: #56637f;
    font-size: 0.9rem;
    line-height: 1.58;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
}

.shop-directory-card dl {
    display: grid;
    gap: 0.78rem;
    margin: 0 0 1rem;
}

.shop-directory-card dl div {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
}

.shop-directory-card dt {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #69758f;
    font-size: 0.86rem;
    font-weight: 650;
}

.shop-directory-card dt svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: #7b8aa8;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-directory-card dd {
    margin: 0;
    color: #17224f;
    font-size: 0.86rem;
    font-weight: 760;
    line-height: 1.55;
}

.shop-directory-actions,
.shop-front-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
}

.shop-directory-actions span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 36px;
    width: 100%;
    border-radius: 8px;
    background: linear-gradient(180deg, #0d77ff 0%, #0865ef 100%);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 850;
    box-shadow: 0 14px 28px -18px rgba(8, 101, 239, 0.88);
}

.shop-directory-actions svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-status-dot {
    width: 10px;
    height: 10px;
    display: inline-flex;
    margin-right: 0.42rem;
    border-radius: 50%;
    background: #18c874;
    box-shadow: 0 0 0 4px rgba(24, 200, 116, 0.15);
}

.shop-security-panel {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(360px, 0.92fr) 140px;
    gap: 1.1rem;
    align-items: center;
    min-height: 104px;
    margin-top: 1.25rem;
    overflow: hidden;
    padding: 1rem 1.75rem;
    border: 1px solid #d5e5f8;
    border-radius: 16px;
    background: linear-gradient(90deg, rgba(232, 244, 255, 0.9), rgba(255, 255, 255, 0.92));
    box-shadow: 0 22px 70px -58px rgba(17, 45, 92, 0.42);
}

.shop-security-badge {
    width: 58px;
    height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: linear-gradient(180deg, #6db2ff, #2779f2);
    color: #fff;
    box-shadow: 0 18px 36px -22px rgba(8, 107, 242, 0.78);
}

.shop-security-badge svg,
.shop-security-items svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.shop-security-badge svg {
    width: 32px;
    height: 32px;
}

.shop-security-copy h2 {
    margin: 0 0 0.45rem;
    color: #0968ef;
    font-size: 1.14rem;
    line-height: 1.28;
    font-weight: 850;
}

.shop-security-copy p {
    margin: 0;
    color: #5d6a86;
    font-size: 0.94rem;
}

.shop-security-items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    padding-left: 2rem;
    border-left: 1px solid #c8dcf4;
}

.shop-security-items span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 42px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.75);
    color: #23315c;
    font-size: 0.9rem;
    font-weight: 760;
}

.shop-security-items svg {
    width: 20px;
    height: 20px;
    color: #0968ef;
}

.shop-security-items span:last-child svg {
    color: #17b76b;
}

.shop-security-illustration {
    justify-self: end;
    width: 130px;
    opacity: 0.75;
}

.shop-security-illustration svg {
    width: 100%;
    height: auto;
    fill: #d8ebff;
    stroke: #75afff;
    stroke-width: 3;
    stroke-linejoin: round;
}

.shop-security-illustration path:nth-last-child(-n+3) {
    fill: #1673f7;
    stroke: #1673f7;
}

.shop-front-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(380px, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: 1740px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1rem, 5.8vw, 6rem);
    background:
        radial-gradient(circle at 82% 24%, rgba(16, 167, 125, 0.12), transparent 27%),
        linear-gradient(180deg, #f8fffb 0%, #eefaf6 100%);
}

.shop-front-copy {
    max-width: 760px;
}

.shop-front-panel {
    padding: 1.4rem;
    border: 1px solid #d9f1e8;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 34px 95px -55px rgba(15, 45, 90, 0.56);
}

.shop-front-panel-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: #071344;
}

.shop-front-panel-head span {
    color: #10a77d;
    font-weight: 800;
}

.shop-front-steps {
    display: grid;
    gap: 0.85rem;
}

.shop-front-steps article {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid #e0f0ea;
    border-radius: 18px;
    background: #fff;
}

.shop-front-steps span {
    grid-row: span 2;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #10a77d;
    color: #fff;
    font-weight: 800;
}

.shop-front-steps strong {
    color: #071344;
}

.shop-front-steps small {
    color: #6a788e;
}

@media (max-width: 1199.98px) {
    .shop-front-hero,
    .shop-directory-hero {
        grid-template-columns: 1fr;
    }

    .shop-hero-illustration {
        justify-self: center;
    }

    .shop-hero-cloud,
    .shop-hero-dots {
        opacity: 0.22;
    }

    .shop-directory-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shop-directory-benefits,
    .shop-security-panel {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shop-directory-benefits article {
        justify-content: flex-start;
        border-right: 0;
        border-bottom: 1px solid #dfe9f7;
    }

    .shop-security-items {
        grid-column: 1 / -1;
        padding-left: 0;
        border-left: 0;
    }

    .shop-security-illustration {
        display: none;
    }
}

@media (max-width: 767.98px) {
    .shop-directory-topbar {
        align-items: flex-start;
        flex-direction: column;
        padding: 0.9rem 1rem;
    }

    .shop-directory-topnav {
        flex-wrap: wrap;
        gap: 0.7rem;
    }

    .shop-directory-main {
        padding: 1rem 0.85rem 2rem;
    }

    .shop-directory-hero {
        padding: 1.3rem 1rem;
    }

    .shop-hero-illustration,
    .shop-hero-cloud,
    .shop-hero-dots {
        display: none;
    }

    .shop-directory-grid,
    .shop-directory-card,
    .shop-directory-card dl,
    .shop-directory-card dl div,
    .shop-directory-benefits,
    .shop-security-panel,
    .shop-security-items {
        grid-template-columns: 1fr;
    }

    .shop-directory-hero h1 {
        font-size: 2.25rem;
    }

    .shop-directory-benefits {
        padding: 0.9rem;
    }

    .shop-directory-benefits article {
        min-height: auto;
        padding: 0.7rem 0.4rem;
    }

    .shop-security-panel {
        padding: 1rem;
    }

    .shop-security-items span {
        justify-content: flex-start;
        padding: 0 0.85rem;
    }

    .shop-front-actions .btn,
    .shop-directory-actions .btn {
        width: 100%;
    }
}
/* === ChatGPT Shop Routing Pages End === */

/* Branch customer portal */
.branch-customer-shell {
    min-height: 100vh;
    margin: 0;
    background: linear-gradient(180deg, #f6fbff 0%, #eef6ff 48%, #ffffff 100%);
    color: #111a44;
    font-family: "Be Vietnam Pro", "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.branch-customer-header {
    position: sticky;
    top: 0;
    z-index: 1040;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto auto;
    gap: 1rem;
    align-items: center;
    min-height: 72px;
    padding: 0.75rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: 1px solid #dbe8f8;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 16px 46px -42px rgba(16, 45, 96, 0.55);
}

.branch-customer-brand,
.branch-customer-header-actions a,
.branch-customer-header-actions button,
.branch-customer-nav a,
.role-login-brand,
.role-login-alt {
    text-decoration: none;
}

.branch-customer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #10164c;
}

.branch-customer-brand span,
.role-login-brand span {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #086bf2;
    color: #fff;
}

.branch-customer-brand svg,
.role-login-brand svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.branch-customer-status {
    display: grid;
    gap: 0.1rem;
    color: #5d6a86;
    font-size: 0.86rem;
    text-align: right;
}

.branch-customer-status span {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.42rem;
    color: #107a47;
    font-weight: 800;
}

.branch-customer-status i {
    width: 9px;
    height: 9px;
    display: inline-flex;
    border-radius: 50%;
    background: #18c874;
    box-shadow: 0 0 0 4px rgba(24, 200, 116, 0.14);
}

.branch-customer-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.55rem;
}

.branch-customer-header-actions a,
.branch-customer-header-actions button {
    min-height: 36px;
    border: 1px solid #cfe0f5;
    border-radius: 8px;
    background: #fff;
    color: #1e2a55;
    padding: 0.45rem 0.8rem;
    font-weight: 750;
}

.branch-customer-nav {
    position: sticky;
    top: 72px;
    z-index: 1030;
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.7rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: 1px solid #e1ecf8;
    background: rgba(246, 251, 255, 0.96);
}

.branch-customer-nav a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    border-radius: 8px;
    padding: 0.45rem 0.8rem;
    color: #455274;
    font-size: 0.9rem;
    font-weight: 780;
}

.branch-customer-nav a.active,
.branch-customer-nav a:hover,
.branch-customer-nav a:focus {
    background: #086bf2;
    color: #fff;
}

.branch-customer-main {
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 1.4rem clamp(1rem, 3vw, 2rem) 3rem;
}

.branch-customer-landing {
    display: grid;
    gap: 1.2rem;
}

.branch-customer-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: 1.2rem;
    align-items: stretch;
}

.branch-customer-hero-copy,
.branch-customer-hero-panel,
.branch-customer-section,
.role-login-card,
.role-login-hero {
    border: 1px solid #dbe8f8;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 24px 70px -58px rgba(16, 45, 96, 0.52);
}

.branch-customer-hero-copy {
    padding: clamp(1.35rem, 3vw, 2.2rem);
}

.branch-customer-pill,
.role-login-kicker {
    display: inline-flex;
    width: fit-content;
    border-radius: 999px;
    padding: 0.36rem 0.74rem;
    background: #eaf3ff;
    color: #086bf2;
    font-size: 0.82rem;
    font-weight: 850;
}

.branch-customer-hero h1 {
    margin: 0.8rem 0 0.75rem;
    color: #10164c;
    font-size: clamp(2.1rem, 5vw, 4rem);
    line-height: 1.05;
    font-weight: 850;
}

.branch-customer-hero p,
.branch-customer-section p {
    color: #5d6a86;
    line-height: 1.68;
}

.branch-customer-meta,
.branch-customer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
}

.branch-customer-meta {
    margin: 1.2rem 0;
}

.branch-customer-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #dce8f6;
    border-radius: 999px;
    background: #f8fbff;
    padding: 0.45rem 0.72rem;
    color: #33415f;
    font-size: 0.88rem;
    font-weight: 720;
}

.branch-customer-meta svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.branch-customer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 8px;
    padding: 0.65rem 1rem;
    font-weight: 850;
    text-decoration: none;
}

.branch-customer-btn--primary {
    background: #086bf2;
    color: #fff;
}

.branch-customer-btn--soft {
    border: 1px solid #c8ddf7;
    background: #eef6ff;
    color: #086bf2;
}

.branch-customer-hero-panel {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.3rem;
}

.branch-customer-hero-panel span {
    color: #6a7690;
    font-size: 0.86rem;
    font-weight: 750;
}

.branch-customer-hero-panel strong {
    color: #086bf2;
    font-size: 1.35rem;
    word-break: break-word;
}

.branch-customer-hero-panel a {
    display: inline-flex;
    justify-content: center;
    min-height: 40px;
    border-radius: 8px;
    background: #10164c;
    color: #fff;
    padding: 0.6rem 0.9rem;
    font-weight: 850;
    text-decoration: none;
}

.branch-customer-section {
    padding: 1.35rem;
}

.branch-customer-section-head {
    max-width: 720px;
    margin-bottom: 1rem;
}

.branch-customer-section-head span {
    color: #086bf2;
    font-size: 0.86rem;
    font-weight: 850;
}

.branch-customer-section h2 {
    margin: 0.35rem 0 0;
    color: #10164c;
    font-size: clamp(1.4rem, 2.3vw, 2.1rem);
    font-weight: 850;
}

.branch-customer-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
}

.branch-customer-feature-grid a {
    min-height: 156px;
    border: 1px solid #dce8f6;
    border-radius: 8px;
    background: #f8fbff;
    padding: 1rem;
    color: #111a44;
    text-decoration: none;
}

.branch-customer-feature-grid span {
    color: #086bf2;
    font-weight: 900;
}

.branch-customer-feature-grid strong,
.branch-customer-feature-grid small {
    display: block;
}

.branch-customer-feature-grid strong {
    margin: 0.45rem 0;
    font-size: 1.02rem;
    font-weight: 850;
}

.branch-customer-feature-grid small {
    color: #5d6a86;
    line-height: 1.55;
}

.branch-customer-section--split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(300px, 1.15fr);
    gap: 1rem;
    align-items: start;
}

.branch-customer-service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
}

.branch-customer-service-list span {
    border: 1px solid #dce8f6;
    border-radius: 8px;
    background: #f8fbff;
    padding: 0.8rem;
    color: #33415f;
    font-weight: 750;
}

.role-login-page {
    min-height: calc(100vh - 160px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    gap: 1.2rem;
    align-items: stretch;
    padding: clamp(1rem, 4vw, 3rem);
}

.role-login-hero,
.role-login-card {
    padding: clamp(1.25rem, 3vw, 2rem);
}

.role-login-page--customer {
    background: linear-gradient(135deg, #eef7ff, #ffffff);
}

.role-login-page--shop {
    background: linear-gradient(135deg, #effaf5, #ffffff);
}

.role-login-page--admin {
    background: linear-gradient(135deg, #f1f5f9, #ffffff);
}

.role-login-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #10164c;
    font-weight: 850;
}

.role-login-hero h1 {
    margin: 1rem 0;
    color: #10164c;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.06;
    font-weight: 850;
}

.role-login-hero p {
    max-width: 700px;
    color: #5d6a86;
    line-height: 1.7;
}

.role-login-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.2rem;
}

.role-login-pills span {
    border-radius: 999px;
    background: #eef6ff;
    color: #086bf2;
    padding: 0.45rem 0.75rem;
    font-size: 0.88rem;
    font-weight: 800;
}

.role-login-page--shop .role-login-pills span {
    background: #e8f8ef;
    color: #11834d;
}

.role-login-page--admin .role-login-pills span {
    background: #eef2f7;
    color: #0f172a;
}

.role-login-card {
    align-self: center;
}

.role-login-card h2 {
    margin: 0.65rem 0 1rem;
    color: #10164c;
    font-size: 1.45rem;
    font-weight: 850;
}

.role-login-alt {
    display: inline-flex;
    margin-top: 1rem;
    color: #086bf2;
    font-weight: 800;
}

@media (max-width: 991.98px) {
    .branch-customer-header,
    .branch-customer-hero,
    .branch-customer-section--split,
    .role-login-page {
        grid-template-columns: 1fr;
    }

    .branch-customer-status {
        text-align: left;
    }

    .branch-customer-status span,
    .branch-customer-header-actions {
        justify-content: flex-start;
    }

    .branch-customer-feature-grid,
    .branch-customer-service-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 640px) {
    .branch-customer-feature-grid,
    .branch-customer-service-list {
        grid-template-columns: 1fr;
    }

    .branch-customer-actions .branch-customer-btn,
    .branch-customer-header-actions a,
    .branch-customer-header-actions button {
        width: 100%;
    }
}

/* ChatGPT portfolio pages routes Customer Shop */
.pc-portfolio-page {
    --portfolio-primary: #2563eb;
    --portfolio-primary-dark: #1d4ed8;
    --portfolio-primary-soft: #dbeafe;
    --portfolio-success: #059669;
    --portfolio-success-dark: #047857;
    --portfolio-success-soft: #d1fae5;
    --portfolio-ink: #0f172a;
    --portfolio-muted: #64748b;
    --portfolio-border: #e2e8f0;
    --portfolio-card: rgba(255, 255, 255, .92);
    padding: 48px clamp(18px, 4vw, 64px) 76px;
    color: var(--portfolio-ink);
    background:
        radial-gradient(circle at top left, rgba(37, 99, 235, .12), transparent 34rem),
        radial-gradient(circle at 90% 10%, rgba(14, 165, 233, .09), transparent 28rem),
        linear-gradient(180deg, #f8fbff 0%, #ffffff 42%, #f8fafc 100%);
}

.pc-portfolio-page--shop {
    background:
        radial-gradient(circle at top left, rgba(5, 150, 105, .13), transparent 34rem),
        radial-gradient(circle at 90% 10%, rgba(20, 184, 166, .09), transparent 28rem),
        linear-gradient(180deg, #f8fffc 0%, #ffffff 42%, #f8fafc 100%);
}

.pc-portfolio-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    max-width: 1180px;
    margin: 0 auto 64px;
}

.pc-portfolio-copy h1 {
    margin: 18px 0;
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: clamp(2.15rem, 5.2vw, 4.7rem);
    line-height: 1.03;
    letter-spacing: -.055em;
    font-weight: 800;
}

.pc-portfolio-copy p {
    max-width: 760px;
    color: var(--portfolio-muted);
    font-size: 1.06rem;
    line-height: 1.85;
}

.pc-portfolio-pill,
.pc-section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    border-radius: 999px;
    padding: 8px 14px;
    color: var(--portfolio-primary-dark);
    background: var(--portfolio-primary-soft);
    font-weight: 850;
    font-size: .9rem;
}

.pc-portfolio-pill--green,
.pc-section-kicker--green {
    color: var(--portfolio-success-dark);
    background: var(--portfolio-success-soft);
}

.pc-portfolio-pill svg,
.pc-section-kicker svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-portfolio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
}

.pc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 19px;
    border-radius: 999px;
    font-weight: 850;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}

.pc-btn:hover {
    transform: translateY(-1px);
}

.pc-btn--primary {
    color: #fff;
    background: var(--portfolio-primary);
    box-shadow: 0 16px 32px rgba(37, 99, 235, .22);
}

.pc-btn--success {
    color: #fff;
    background: var(--portfolio-success);
    box-shadow: 0 16px 32px rgba(5, 150, 105, .22);
}

.pc-btn--ghost {
    color: var(--portfolio-ink);
    background: #fff;
    border-color: #dbe4ef;
}

.pc-portfolio-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
}

.pc-portfolio-trust span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--portfolio-border);
    border-radius: 999px;
    padding: 9px 12px;
    color: #334155;
    background: rgba(255, 255, 255, .72);
    font-size: .92rem;
    font-weight: 750;
}

.pc-portfolio-trust svg,
.pc-check-grid svg,
.pc-operation-grid svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-showcase-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .28);
    border-radius: 30px;
    padding: 24px;
    background: rgba(255, 255, 255, .88);
    box-shadow: 0 30px 80px rgba(15, 23, 42, .13);
    backdrop-filter: blur(16px);
}

.pc-showcase-card::before {
    content: "";
    position: absolute;
    inset: -80px -80px auto auto;
    width: 180px;
    height: 180px;
    border-radius: 999px;
    background: rgba(37, 99, 235, .13);
}

.pc-showcase-card--shop::before {
    background: rgba(5, 150, 105, .14);
}

.pc-showcase-header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
}

.pc-showcase-header strong {
    font-weight: 900;
}

.pc-showcase-header em {
    margin-left: auto;
    color: var(--portfolio-muted);
    font-style: normal;
    font-size: .86rem;
    font-weight: 750;
}

.pc-showcase-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--portfolio-primary);
    box-shadow: 0 0 0 6px rgba(37, 99, 235, .12);
}

.pc-showcase-dot--green {
    background: var(--portfolio-success);
    box-shadow: 0 0 0 6px rgba(5, 150, 105, .12);
}

.pc-upload-box {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 150px;
    border: 1px dashed #93c5fd;
    border-radius: 22px;
    margin-bottom: 16px;
    padding: 20px;
    color: var(--portfolio-primary-dark);
    background: #eff6ff;
    text-align: center;
}

.pc-upload-box svg {
    width: 42px;
    height: 42px;
    margin-bottom: 8px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-upload-box b,
.pc-upload-box span {
    display: block;
}

.pc-upload-box span {
    margin-top: 4px;
    color: #3b82f6;
    font-size: .92rem;
    font-weight: 700;
}

.pc-showcase-row,
.pc-showcase-status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border-top: 1px solid var(--portfolio-border);
    padding: 14px 0;
}

.pc-showcase-row span {
    color: var(--portfolio-muted);
}

.pc-showcase-row b {
    text-align: right;
}

.pc-showcase-status {
    justify-content: flex-start;
    color: var(--portfolio-primary-dark);
    font-weight: 850;
}

.pc-showcase-status svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-dashboard-stat-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 16px;
}

.pc-dashboard-stat-grid div {
    border: 1px solid #dcfce7;
    border-radius: 18px;
    padding: 14px;
    background: #f0fdf4;
}

.pc-dashboard-stat-grid b,
.pc-dashboard-stat-grid span {
    display: block;
}

.pc-dashboard-stat-grid b {
    font-size: 1.55rem;
    font-weight: 900;
}

.pc-dashboard-stat-grid span {
    color: #047857;
    font-size: .86rem;
    font-weight: 750;
}

.pc-shop-task {
    position: relative;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    border-top: 1px solid var(--portfolio-border);
    padding: 14px 0;
}

.pc-shop-task svg {
    width: 38px;
    height: 38px;
    border-radius: 14px;
    padding: 9px;
    color: var(--portfolio-success-dark);
    background: #d1fae5;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-shop-task b,
.pc-shop-task span {
    display: block;
}

.pc-shop-task span {
    color: var(--portfolio-muted);
    font-size: .92rem;
}

.pc-shop-task em {
    border-radius: 999px;
    padding: 6px 9px;
    color: #047857;
    background: #ecfdf5;
    font-style: normal;
    font-size: .82rem;
    font-weight: 850;
}

.pc-portfolio-section {
    max-width: 1180px;
    margin: 0 auto 48px;
}

.pc-portfolio-section--soft {
    border-radius: 34px;
    padding: clamp(22px, 4vw, 46px);
    background: #f1f5f9;
}

.pc-portfolio-section--green-soft {
    background: #ecfdf5;
}

.pc-section-heading {
    max-width: 790px;
    margin-bottom: 26px;
}

.pc-section-heading h2 {
    margin: 14px 0 10px;
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -.04em;
    font-weight: 850;
}

.pc-section-heading p {
    color: var(--portfolio-muted);
    line-height: 1.78;
}

.pc-feature-grid,
.pc-guide-timeline,
.pc-check-grid,
.pc-operation-grid {
    display: grid;
    gap: 18px;
}

.pc-feature-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.pc-feature-card,
.pc-guide-timeline article,
.pc-operation-grid article {
    border: 1px solid var(--portfolio-border);
    border-radius: 26px;
    padding: 22px;
    background: var(--portfolio-card);
    box-shadow: 0 12px 30px rgba(15, 23, 42, .06);
}

.pc-feature-card h3,
.pc-guide-timeline h3,
.pc-operation-grid h3 {
    margin: 0 0 10px;
    font-weight: 900;
}

.pc-feature-card p,
.pc-guide-timeline p,
.pc-operation-grid p {
    color: var(--portfolio-muted);
    line-height: 1.72;
    margin-bottom: 0;
}

.pc-feature-icon,
.pc-step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 18px;
    margin-bottom: 16px;
    color: var(--portfolio-primary-dark);
    background: var(--portfolio-primary-soft);
}

.pc-feature-icon--green,
.pc-step-icon--green {
    color: var(--portfolio-success-dark);
    background: var(--portfolio-success-soft);
}

.pc-feature-icon svg,
.pc-step-icon svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.pc-guide-timeline {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.pc-guide-timeline article {
    position: relative;
    overflow: hidden;
}

.pc-step-number {
    position: absolute;
    top: 18px;
    right: 20px;
    color: rgba(37, 99, 235, .16);
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
}

.pc-step-number--green {
    color: rgba(5, 150, 105, .18);
}

.pc-guide-timeline ul {
    margin: 16px 0 0;
    padding-left: 18px;
    color: #475569;
    line-height: 1.7;
}

.pc-guide-timeline li + li {
    margin-top: 6px;
}

.pc-check-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.pc-check-grid div {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--portfolio-border);
    border-radius: 18px;
    padding: 15px 16px;
    background: #fff;
    color: #334155;
    font-weight: 800;
}

.pc-check-grid svg {
    flex: 0 0 auto;
    color: var(--portfolio-primary-dark);
}

.pc-operation-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.pc-operation-grid article svg {
    width: 44px;
    height: 44px;
    border-radius: 16px;
    margin-bottom: 16px;
    padding: 10px;
    color: var(--portfolio-success-dark);
    background: var(--portfolio-success-soft);
}

.pc-final-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1180px;
    margin: 0 auto;
    border: 1px solid rgba(37, 99, 235, .18);
    border-radius: 34px;
    padding: clamp(24px, 4vw, 42px);
    background:
        linear-gradient(135deg, rgba(37, 99, 235, .10), rgba(255, 255, 255, .92)),
        #fff;
    box-shadow: 0 20px 50px rgba(15, 23, 42, .08);
}

.pc-final-cta--shop {
    border-color: rgba(5, 150, 105, .20);
    background:
        linear-gradient(135deg, rgba(5, 150, 105, .12), rgba(255, 255, 255, .92)),
        #fff;
}

.pc-final-cta h2 {
    margin: 12px 0 8px;
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-weight: 850;
    letter-spacing: -.035em;
}

.pc-final-cta p {
    color: var(--portfolio-muted);
    margin-bottom: 0;
}

@media (max-width: 1100px) {
    .pc-portfolio-hero,
    .pc-feature-grid,
    .pc-guide-timeline,
    .pc-operation-grid {
        grid-template-columns: 1fr 1fr;
    }

    .pc-portfolio-copy {
        grid-column: 1 / -1;
    }
}

@media (max-width: 760px) {
    .pc-portfolio-page {
        padding: 28px 16px 54px;
    }

    .pc-portfolio-hero,
    .pc-feature-grid,
    .pc-guide-timeline,
    .pc-check-grid,
    .pc-operation-grid {
        grid-template-columns: 1fr;
    }

    .pc-showcase-card {
        padding: 18px;
        border-radius: 24px;
    }

    .pc-dashboard-stat-grid {
        grid-template-columns: 1fr;
    }

    .pc-shop-task {
        grid-template-columns: 34px minmax(0, 1fr);
    }

    .pc-shop-task em {
        grid-column: 2;
        width: fit-content;
    }

    .pc-final-cta {
        display: block;
    }

    .pc-final-cta .pc-btn {
        margin-top: 18px;
        width: 100%;
    }
}
/* ChatGPT portfolio ratio polish */
.pc-portfolio-page {
    padding-top: clamp(26px, 3.8vw, 44px);
    padding-bottom: clamp(46px, 5.6vw, 68px);
}

.pc-portfolio-hero {
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, .78fr);
    gap: clamp(22px, 3.8vw, 48px);
    align-items: center;
    max-width: 1100px;
    margin-bottom: clamp(38px, 4.8vw, 54px);
}

.pc-portfolio-copy {
    max-width: 700px;
}

.pc-portfolio-copy h1 {
    font-size: clamp(1.95rem, 4vw, 3.55rem);
    line-height: 1.07;
    margin: 13px 0 15px;
    max-width: 720px;
}

.pc-portfolio-copy p {
    max-width: 660px;
    font-size: clamp(.96rem, 1vw, 1.03rem);
    line-height: 1.68;
}

.pc-portfolio-pill,
.pc-section-kicker {
    padding: 7px 12px;
    font-size: .84rem;
}

.pc-portfolio-actions {
    margin-top: 20px;
    gap: 10px;
}

.pc-btn {
    min-height: 40px;
    padding: 10px 16px;
    font-size: .92rem;
}

.pc-portfolio-trust {
    margin-top: 17px;
    gap: 8px;
}

.pc-portfolio-trust span {
    padding: 7px 10px;
    font-size: .84rem;
}

.pc-showcase-card {
    max-width: 410px;
    width: 100%;
    justify-self: end;
    border-radius: 24px;
    padding: clamp(16px, 2vw, 20px);
}

.pc-upload-box {
    min-height: 112px;
    border-radius: 18px;
    padding: 14px;
}

.pc-upload-box svg {
    width: 32px;
    height: 32px;
}

.pc-showcase-row,
.pc-showcase-status {
    padding: 11px 0;
    font-size: .94rem;
}

.pc-dashboard-stat-grid {
    gap: 8px;
}

.pc-dashboard-stat-grid div {
    padding: 11px;
}

.pc-dashboard-stat-grid b {
    font-size: 1.28rem;
}

.pc-dashboard-stat-grid span {
    font-size: .8rem;
}

.pc-shop-task {
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 10px;
    padding: 11px 0;
}

.pc-shop-task svg {
    width: 32px;
    height: 32px;
    border-radius: 12px;
    padding: 8px;
}

.pc-shop-task span {
    font-size: .86rem;
}

.pc-shop-task em {
    font-size: .78rem;
    padding: 5px 8px;
}

.pc-portfolio-section {
    max-width: 1100px;
    margin-bottom: clamp(32px, 4vw, 44px);
}

.pc-portfolio-section--soft {
    border-radius: 26px;
    padding: clamp(20px, 3vw, 34px);
}

.pc-section-heading {
    max-width: 700px;
    margin-bottom: 20px;
}

.pc-section-heading h2 {
    font-size: clamp(1.48rem, 2.35vw, 2.1rem);
    line-height: 1.16;
    margin: 11px 0 8px;
}

.pc-section-heading p {
    font-size: .96rem;
    line-height: 1.64;
}

.pc-feature-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.pc-feature-card,
.pc-guide-timeline article,
.pc-operation-grid article {
    border-radius: 20px;
    padding: 18px;
}

.pc-feature-icon,
.pc-step-icon {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    margin-bottom: 13px;
}

.pc-feature-icon svg,
.pc-step-icon svg {
    width: 21px;
    height: 21px;
}

.pc-feature-card h3,
.pc-guide-timeline h3,
.pc-operation-grid h3 {
    font-size: 1rem;
    line-height: 1.28;
}

.pc-feature-card p,
.pc-guide-timeline p,
.pc-operation-grid p {
    font-size: .92rem;
    line-height: 1.58;
}

.pc-guide-timeline {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
}

.pc-guide-timeline article {
    min-height: 282px;
}

.pc-step-number {
    top: 15px;
    right: 17px;
    font-size: 1.85rem;
}

.pc-guide-timeline ul {
    margin-top: 12px;
    font-size: .9rem;
    line-height: 1.54;
}

.pc-guide-timeline li + li {
    margin-top: 5px;
}

.pc-check-grid {
    grid-template-columns: repeat(3, minmax(210px, 1fr));
    gap: 11px;
}

.pc-check-grid div {
    min-height: 50px;
    padding: 12px 13px;
    border-radius: 15px;
    font-size: .91rem;
}

.pc-operation-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 13px;
}

.pc-operation-grid article {
    min-height: 174px;
}

.pc-operation-grid article svg {
    width: 38px;
    height: 38px;
    border-radius: 13px;
    margin-bottom: 12px;
}

.pc-final-cta {
    max-width: 1100px;
    border-radius: 26px;
    padding: clamp(20px, 3vw, 32px);
}

.pc-final-cta h2 {
    font-size: clamp(1.28rem, 2.05vw, 1.86rem);
}

.pc-final-cta p {
    max-width: 660px;
    line-height: 1.58;
}

@media (max-width: 1100px) {
    .pc-portfolio-hero {
        grid-template-columns: minmax(0, 1fr);
        max-width: 880px;
    }

    .pc-portfolio-copy {
        max-width: 760px;
    }

    .pc-showcase-card {
        justify-self: start;
        max-width: 600px;
    }

    .pc-feature-grid,
    .pc-operation-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pc-guide-timeline {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .pc-portfolio-page {
        padding: 22px 15px 46px;
    }

    .pc-portfolio-hero {
        gap: 20px;
        margin-bottom: 34px;
    }

    .pc-portfolio-copy h1 {
        font-size: clamp(1.76rem, 8.5vw, 2.45rem);
    }

    .pc-portfolio-copy p {
        font-size: .94rem;
        line-height: 1.62;
    }

    .pc-portfolio-actions {
        flex-direction: column;
    }

    .pc-btn {
        width: 100%;
    }

    .pc-showcase-card {
        max-width: none;
        border-radius: 21px;
    }

    .pc-feature-grid,
    .pc-guide-timeline,
    .pc-check-grid,
    .pc-operation-grid {
        grid-template-columns: 1fr;
    }

    .pc-guide-timeline article {
        min-height: auto;
    }

    .pc-portfolio-section--soft {
        padding: 18px;
        border-radius: 22px;
    }

    .pc-final-cta {
        border-radius: 22px;
    }
}
/* ChatGPT branch common layout */
.branch-site-page {
    --branch-primary: #2563eb;
    --branch-primary-dark: #1d4ed8;
    --branch-primary-soft: #dbeafe;
    --branch-ink: #0f172a;
    --branch-muted: #64748b;
    --branch-border: #e2e8f0;
    padding: clamp(26px, 4vw, 48px) clamp(16px, 4vw, 64px) clamp(52px, 6vw, 76px);
    color: var(--branch-ink);
    background:
        radial-gradient(circle at top left, rgba(37, 99, 235, .13), transparent 34rem),
        radial-gradient(circle at 88% 8%, rgba(14, 165, 233, .10), transparent 28rem),
        linear-gradient(180deg, #f8fbff 0%, #fff 46%, #f8fafc 100%);
}

.branch-site-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(310px, .82fr);
    gap: clamp(24px, 4vw, 54px);
    align-items: center;
    max-width: 1120px;
    margin: 0 auto clamp(42px, 5vw, 58px);
}

.branch-site-copy h1 {
    margin: 14px 0 15px;
    max-width: 760px;
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: clamp(2rem, 4.4vw, 3.9rem);
    line-height: 1.06;
    letter-spacing: -.055em;
    font-weight: 850;
}

.branch-site-copy p {
    max-width: 700px;
    color: var(--branch-muted);
    font-size: clamp(.98rem, 1.08vw, 1.06rem);
    line-height: 1.72;
}

.branch-site-pill,
.branch-section-heading span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    border-radius: 999px;
    padding: 8px 13px;
    color: var(--branch-primary-dark);
    background: var(--branch-primary-soft);
    font-size: .88rem;
    font-weight: 850;
}

.branch-site-pill svg,
.branch-site-meta svg,
.branch-service-grid svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.branch-site-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
}

.branch-site-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--branch-border);
    border-radius: 999px;
    padding: 8px 11px;
    color: #334155;
    background: rgba(255, 255, 255, .8);
    font-size: .9rem;
    font-weight: 750;
}

.branch-site-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
}

.branch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 999px;
    padding: 10px 16px;
    text-decoration: none;
    font-size: .94rem;
    font-weight: 850;
    border: 1px solid transparent;
}

.branch-btn--primary {
    color: #fff;
    background: var(--branch-primary);
    box-shadow: 0 16px 32px rgba(37, 99, 235, .22);
}

.branch-btn--secondary {
    color: var(--branch-primary-dark);
    background: #eff6ff;
    border-color: #bfdbfe;
}

.branch-btn--ghost {
    color: var(--branch-ink);
    background: #fff;
    border-color: var(--branch-border);
}

.branch-site-panel {
    justify-self: end;
    width: 100%;
    max-width: 420px;
    border: 1px solid rgba(148, 163, 184, .28);
    border-radius: 26px;
    padding: 20px;
    background: rgba(255, 255, 255, .9);
    box-shadow: 0 28px 72px rgba(15, 23, 42, .12);
}

.branch-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.branch-panel-header strong {
    font-weight: 900;
}

.branch-panel-header span {
    color: var(--branch-muted);
    font-size: .86rem;
    font-weight: 750;
}

.branch-panel-card {
    display: flex;
    gap: 12px;
    align-items: center;
    border: 1px dashed #93c5fd;
    border-radius: 20px;
    padding: 16px;
    color: var(--branch-primary-dark);
    background: #eff6ff;
}

.branch-panel-card svg {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.branch-panel-card b,
.branch-panel-card span {
    display: block;
}

.branch-panel-card span {
    color: #3b82f6;
    font-size: .9rem;
    font-weight: 700;
}

.branch-panel-list {
    margin-top: 12px;
}

.branch-panel-list div {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    border-top: 1px solid var(--branch-border);
    padding: 12px 0;
}

.branch-panel-list span {
    color: var(--branch-muted);
}

.branch-panel-list b {
    text-align: right;
}

.branch-site-section {
    max-width: 1120px;
    margin: 0 auto clamp(34px, 4.2vw, 48px);
}

.branch-site-section--soft {
    border-radius: 30px;
    padding: clamp(22px, 3.2vw, 38px);
    background: #f1f5f9;
}

.branch-section-heading {
    max-width: 760px;
    margin-bottom: 22px;
}

.branch-section-heading h2 {
    margin: 12px 0 9px;
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: clamp(1.52rem, 2.5vw, 2.25rem);
    line-height: 1.16;
    letter-spacing: -.04em;
    font-weight: 850;
}

.branch-section-heading p {
    color: var(--branch-muted);
    line-height: 1.68;
}

.branch-service-grid,
.branch-guide-grid,
.branch-link-grid {
    display: grid;
    gap: 16px;
}

.branch-service-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.branch-service-grid article,
.branch-guide-grid article {
    border: 1px solid var(--branch-border);
    border-radius: 22px;
    padding: 20px;
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 12px 30px rgba(15, 23, 42, .06);
}

.branch-service-grid article svg {
    width: 42px;
    height: 42px;
    border-radius: 15px;
    padding: 10px;
    margin-bottom: 14px;
    color: var(--branch-primary-dark);
    background: var(--branch-primary-soft);
}

.branch-service-grid h3,
.branch-guide-grid h3 {
    font-size: 1.05rem;
    font-weight: 900;
    margin-bottom: 9px;
}

.branch-service-grid p,
.branch-guide-grid p {
    color: var(--branch-muted);
    font-size: .94rem;
    line-height: 1.62;
    margin-bottom: 0;
}

.branch-guide-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.branch-guide-grid article span {
    display: inline-flex;
    margin-bottom: 14px;
    color: rgba(37, 99, 235, .9);
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: 1.6rem;
    font-weight: 900;
}

.branch-link-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.branch-link-grid a {
    display: block;
    border: 1px solid var(--branch-border);
    border-radius: 20px;
    padding: 18px;
    color: var(--branch-ink);
    background: #fff;
    text-decoration: none;
    box-shadow: 0 12px 30px rgba(15, 23, 42, .05);
}

.branch-link-grid small,
.branch-link-grid strong {
    display: block;
}

.branch-link-grid small {
    color: var(--branch-muted);
    margin-bottom: 6px;
}

.branch-link-grid strong {
    word-break: break-word;
}

@media (max-width: 1040px) {
    .branch-site-hero {
        grid-template-columns: 1fr;
        max-width: 900px;
    }

    .branch-site-panel {
        justify-self: start;
        max-width: 620px;
    }

    .branch-service-grid,
    .branch-guide-grid,
    .branch-link-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 720px) {
    .branch-site-page {
        padding: 24px 15px 48px;
    }

    .branch-site-copy h1 {
        font-size: clamp(1.78rem, 8.6vw, 2.5rem);
    }

    .branch-site-actions {
        flex-direction: column;
    }

    .branch-btn {
        width: 100%;
    }

    .branch-site-panel,
    .branch-service-grid,
    .branch-guide-grid,
    .branch-link-grid {
        max-width: none;
        grid-template-columns: 1fr;
    }

    .branch-site-section--soft {
        padding: 20px;
        border-radius: 24px;
    }
}

/* === ChatGPT branch base page polish === */
.branch-base-page {
    --branch-primary: #1d4ed8;
    --branch-primary-dark: #1e3a8a;
    --branch-primary-soft: #dbeafe;
    --branch-ink: #0f172a;
    --branch-muted: #64748b;
    --branch-border: #e2e8f0;
    background: linear-gradient(180deg, #f8fbff 0%, #ffffff 52%, #f8fafc 100%);
}

.branch-base-hero {
    max-width: 1120px;
    margin: 0 auto clamp(30px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, .78fr);
    gap: clamp(22px, 4vw, 42px);
    align-items: stretch;
}

.branch-base-copy,
.branch-base-card,
.branch-base-section {
    border: 1px solid rgba(148, 163, 184, .24);
    border-radius: 28px;
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 24px 70px rgba(15, 23, 42, .08);
}

.branch-base-copy {
    padding: clamp(24px, 4vw, 46px);
}

.branch-base-copy h1 {
    margin: 14px 0 14px;
    max-width: 720px;
    color: var(--branch-ink);
    font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.055em;
    font-weight: 850;
}

.branch-base-copy p {
    max-width: 720px;
    color: var(--branch-muted);
    font-size: clamp(.98rem, 1.08vw, 1.06rem);
    line-height: 1.72;
}

.branch-base-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
}

.branch-base-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--branch-border);
    border-radius: 999px;
    padding: 8px 11px;
    color: #334155;
    background: #fff;
    font-size: .9rem;
    font-weight: 750;
}

.branch-base-meta svg,
.branch-base-services svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.branch-base-card {
    padding: clamp(22px, 3vw, 30px);
}

.branch-base-card-head {
    display: grid;
    gap: 5px;
    margin-bottom: 16px;
}

.branch-base-card-head span,
.branch-base-status span {
    color: var(--branch-muted);
    font-size: .88rem;
    font-weight: 750;
}

.branch-base-card-head strong {
    color: var(--branch-primary-dark);
    font-size: 1.3rem;
    word-break: break-word;
}

.branch-base-card p {
    color: var(--branch-muted);
    line-height: 1.65;
}

.branch-base-status {
    display: grid;
    gap: 10px;
    margin-top: 18px;
}

.branch-base-status div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--branch-border);
    border-radius: 16px;
    padding: 12px 14px;
    background: #f8fafc;
}

.branch-base-status b {
    text-align: right;
}

.branch-base-section {
    max-width: 1120px;
    margin: 0 auto clamp(22px, 3.4vw, 36px);
    padding: clamp(22px, 3vw, 34px);
}

.branch-base-section--compact {
    box-shadow: none;
}

.branch-base-services,
.branch-base-steps {
    display: grid;
    gap: 14px;
}

.branch-base-services {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.branch-base-services article {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 92px;
    border: 1px solid var(--branch-border);
    border-radius: 18px;
    padding: 16px;
    background: #f8fafc;
    color: #334155;
    font-weight: 800;
    line-height: 1.42;
}

.branch-base-services svg {
    color: var(--branch-primary-dark);
}

.branch-base-steps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.branch-base-steps article {
    border: 1px solid var(--branch-border);
    border-radius: 18px;
    padding: 18px;
    background: #fff;
}

.branch-base-steps span {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--branch-primary);
    font-size: 1.45rem;
    font-weight: 900;
}

.branch-base-steps h3 {
    margin: 0;
    color: var(--branch-ink);
    font-size: 1rem;
    line-height: 1.35;
    font-weight: 900;
}

.branch-base-links-wrap {
    margin-bottom: 0;
}

@media (max-width: 1040px) {
    .branch-base-hero,
    .branch-base-services,
    .branch-base-steps {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 720px) {
    .branch-base-hero,
    .branch-base-services,
    .branch-base-steps {
        grid-template-columns: 1fr;
    }

    .branch-base-copy,
    .branch-base-card,
    .branch-base-section {
        border-radius: 22px;
    }

    .branch-base-status div {
        display: grid;
        gap: 4px;
    }

    .branch-base-status b {
        text-align: left;
    }
}
/* === End ChatGPT branch base page polish === */
/* === ChatGPT Branch Customer Default UI Refresh Start === */
.branch-customer-shell {
    background:
        radial-gradient(circle at 12% 8%, rgba(8, 107, 242, 0.10), transparent 28rem),
        radial-gradient(circle at 90% 16%, rgba(24, 200, 116, 0.10), transparent 26rem),
        linear-gradient(180deg, #f7fbff 0%, #eef5ff 42%, #ffffff 100%);
}

.branch-customer-header {
    min-height: 68px;
    border-bottom: 1px solid rgba(210, 225, 245, 0.9);
    backdrop-filter: blur(14px);
}

.branch-customer-brand span,
.role-login-brand span {
    border-radius: 14px;
    box-shadow: 0 14px 30px -18px rgba(8, 107, 242, 0.9);
}

.branch-customer-status span {
    color: #059669;
}

.branch-customer-header-actions a,
.branch-customer-header-actions button {
    border-radius: 12px;
    transition: transform .16s ease, border-color .16s ease, background .16s ease;
}

.branch-customer-header-actions a:hover,
.branch-customer-header-actions button:hover {
    transform: translateY(-1px);
    border-color: #9fc5ff;
    background: #f6fbff;
}

.branch-customer-nav {
    gap: 0.5rem;
    padding-block: 0.62rem;
    background: rgba(248, 251, 255, 0.94);
    backdrop-filter: blur(14px);
}

.branch-customer-nav a {
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    transition: background .16s ease, color .16s ease, transform .16s ease;
}

.branch-customer-nav a:hover,
.branch-customer-nav a:focus {
    transform: translateY(-1px);
}

.branch-customer-main {
    width: min(100%, 1240px);
    padding-top: clamp(1.2rem, 2vw, 2rem);
}

.branch-home {
    display: grid;
    gap: 1.15rem;
}

.branch-home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: 1.15rem;
    align-items: stretch;
}

.branch-home-hero__copy,
.branch-home-panel,
.branch-home-section,
.branch-home-process,
.branch-home-services {
    border: 1px solid rgba(216, 229, 247, 0.95);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 28px 80px -62px rgba(16, 45, 96, 0.62);
}

.branch-home-hero__copy {
    position: relative;
    overflow: hidden;
    padding: clamp(1.6rem, 4vw, 3rem);
}

.branch-home-hero__copy::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -95px;
    width: 260px;
    height: 260px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(8, 107, 242, .14), transparent 68%);
    pointer-events: none;
}

.branch-home-kicker {
    display: inline-flex;
    width: fit-content;
    border-radius: 999px;
    padding: 0.42rem 0.78rem;
    background: #eaf3ff;
    color: #086bf2;
    font-size: 0.82rem;
    font-weight: 850;
}

.branch-home-hero h1 {
    max-width: 820px;
    margin: 0.8rem 0 0.75rem;
    color: #0f1550;
    font-size: clamp(2.35rem, 5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
    font-weight: 900;
}

.branch-home-lead {
    max-width: 760px;
    margin: 0;
    color: #5b6784;
    font-size: 1.02rem;
    line-height: 1.72;
}

.branch-home-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1.25rem 0;
}

.branch-home-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #dce8f6;
    border-radius: 999px;
    background: #f8fbff;
    padding: 0.5rem 0.75rem;
    color: #34415f;
    font-size: 0.9rem;
    font-weight: 760;
}

.branch-home-meta svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.branch-home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.branch-home-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 14px;
    padding: 0.75rem 1.05rem;
    font-weight: 850;
    text-decoration: none;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
}

.branch-home-btn:hover {
    transform: translateY(-1px);
}

.branch-home-btn--primary {
    background: #086bf2;
    color: #fff;
    box-shadow: 0 16px 34px -22px rgba(8, 107, 242, 0.9);
}

.branch-home-btn--secondary {
    border: 1px solid #c8ddf7;
    background: #f2f7ff;
    color: #086bf2;
}

.branch-home-panel {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
}

.branch-home-panel__top {
    display: grid;
    gap: 0.55rem;
}

.branch-home-panel__top span,
.branch-home-section__head span {
    color: #6a7690;
    font-size: 0.86rem;
    font-weight: 780;
}

.branch-home-panel__top strong {
    color: #086bf2;
    font-size: 1.35rem;
    word-break: break-word;
}

.branch-home-panel__top p {
    margin: 0;
    color: #596884;
    line-height: 1.65;
}

.branch-home-panel__actions {
    display: grid;
    gap: 0.65rem;
}

.branch-home-panel__actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    border: 1px solid #dbe8f8;
    border-radius: 14px;
    background: #f8fbff;
    color: #111a44;
    padding: 0.65rem 0.8rem;
    font-weight: 850;
    text-decoration: none;
    transition: transform .16s ease, border-color .16s ease, background .16s ease;
}

.branch-home-panel__actions a::after {
    content: "→";
    color: #086bf2;
}

.branch-home-panel__actions a:hover {
    transform: translateY(-1px);
    border-color: #a9ccff;
    background: #eef6ff;
}

.branch-home-section {
    padding: clamp(1.2rem, 3vw, 1.65rem);
}

.branch-home-section__head {
    max-width: 780px;
    margin-bottom: 1rem;
}

.branch-home-section__head h2,
.branch-home-process h2,
.branch-home-services h2 {
    margin: 0.35rem 0 0;
    color: #0f1550;
    font-size: clamp(1.55rem, 2.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 900;
}

.branch-home-section__head p {
    margin: 0.65rem 0 0;
    color: #5b6784;
    line-height: 1.65;
}

.branch-home-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
}

.branch-home-card {
    min-height: 158px;
    border: 1px solid #dce8f6;
    border-radius: 20px;
    background: #f8fbff;
    padding: 1rem;
    color: #111a44;
    text-decoration: none;
    transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;
}

.branch-home-card:hover {
    transform: translateY(-2px);
    border-color: #a9ccff;
    background: #fff;
    box-shadow: 0 18px 44px -36px rgba(8, 107, 242, 0.8);
}

.branch-home-card--main {
    background: linear-gradient(135deg, #086bf2, #0a4fd0);
    color: #fff;
}

.branch-home-card span {
    color: #086bf2;
    font-weight: 900;
}

.branch-home-card--main span,
.branch-home-card--main small {
    color: rgba(255, 255, 255, 0.82);
}

.branch-home-card strong,
.branch-home-card small {
    display: block;
}

.branch-home-card strong {
    margin: 0.45rem 0;
    font-size: 1.05rem;
    font-weight: 880;
}

.branch-home-card small {
    color: #5d6a86;
    line-height: 1.56;
}

.branch-home-bottom {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 1.05fr);
    gap: 1.15rem;
}

.branch-home-process,
.branch-home-services {
    padding: clamp(1.2rem, 3vw, 1.65rem);
}

.branch-home-process ol {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
}

.branch-home-process li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
    border: 1px solid #dce8f6;
    border-radius: 16px;
    background: #f8fbff;
    padding: 0.9rem;
}

.branch-home-process strong {
    color: #111a44;
    font-weight: 850;
}

.branch-home-process small {
    color: #5d6a86;
    line-height: 1.5;
}

.branch-home-services > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
}

.branch-home-services > div span {
    border: 1px solid #dce8f6;
    border-radius: 999px;
    background: #f8fbff;
    padding: 0.65rem 0.82rem;
    color: #33415f;
    font-weight: 760;
}

@media (max-width: 991.98px) {
    .branch-home-hero,
    .branch-home-bottom {
        grid-template-columns: 1fr;
    }

    .branch-home-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 640px) {
    .branch-customer-header {
        position: static;
    }

    .branch-customer-nav {
        top: 0;
    }

    .branch-home-grid {
        grid-template-columns: 1fr;
    }

    .branch-home-actions .branch-home-btn {
        width: 100%;
    }

    .branch-home-hero h1 {
        font-size: 2.35rem;
    }
}
/* === ChatGPT Branch Customer Default UI Refresh End === */
/* === ChatGPT Branch Auth Function Categories Start === */
.branch-customer-auth-state {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0 0;
    border: 1px solid #dbe8f8;
    border-radius: 14px;
    padding: 0.85rem 1rem;
    background: #f8fbff;
}

.branch-customer-auth-state strong {
    color: #10164c;
    font-weight: 900;
}

.branch-customer-auth-state span {
    color: #5d6a86;
    line-height: 1.55;
}

.branch-customer-auth-state.is-signed-in {
    border-color: rgba(24, 200, 116, 0.34);
    background: #f0fff7;
}

.branch-customer-auth-state.is-guest {
    border-color: rgba(8, 107, 242, 0.24);
    background: #f3f8ff;
}

.branch-customer-section-head p {
    margin: 0.55rem 0 0;
    max-width: 760px;
    color: #5d6a86;
    line-height: 1.65;
}

.branch-customer-feature-card {
    position: relative;
    overflow: hidden;
    transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;
}

.branch-customer-feature-card:hover,
.branch-customer-feature-card:focus {
    transform: translateY(-2px);
    border-color: #a9ccff;
    background: #ffffff;
    box-shadow: 0 20px 44px -36px rgba(8, 107, 242, 0.72);
}

.branch-customer-feature-card.is-primary {
    border-color: rgba(8, 107, 242, 0.38);
    background: linear-gradient(135deg, #086bf2, #0a4fd0);
    color: #ffffff;
}

.branch-customer-feature-card.is-primary span,
.branch-customer-feature-card.is-primary small {
    color: rgba(255, 255, 255, 0.86);
}

.branch-customer-feature-card.is-locked::after {
    content: "Cần đăng nhập";
    position: absolute;
    top: 0.82rem;
    right: 0.82rem;
    border-radius: 999px;
    background: #fff7ed;
    color: #9a3412;
    padding: 0.22rem 0.52rem;
    font-size: 0.72rem;
    font-weight: 850;
}

.branch-customer-feature-grid--guest .branch-customer-feature-card:not(.is-primary) {
    background: #fbfdff;
}

.branch-customer-feature-grid--signed-in .branch-customer-feature-card:not(.is-primary)::after {
    content: "Mở";
    position: absolute;
    top: 0.82rem;
    right: 0.82rem;
    border-radius: 999px;
    background: #ecfdf5;
    color: #047857;
    padding: 0.22rem 0.52rem;
    font-size: 0.72rem;
    font-weight: 850;
}

@media (max-width: 640px) {
    .branch-customer-feature-card.is-locked::after,
    .branch-customer-feature-grid--signed-in .branch-customer-feature-card:not(.is-primary)::after {
        position: static;
        width: fit-content;
        display: inline-flex;
        margin-top: 0.5rem;
    }
}
/* === ChatGPT Branch Auth Function Categories End === */
