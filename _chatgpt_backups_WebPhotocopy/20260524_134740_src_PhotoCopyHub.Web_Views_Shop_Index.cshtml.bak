@model PhotoCopyHub.Web.Models.ShopDirectoryViewModel

@{
    ViewData["Title"] = "Danh sách tiệm photocopy";
}

<section class="shop-directory-hero">
    <div>
        <span class="shop-route-pill">/shop</span>
        <h1>Danh sách cơ sở photocopy</h1>
        <p>
            Trang này dùng làm cổng vào cho các cơ sở photocopy. Mỗi cơ sở có một trang khách hàng riêng và một đường dẫn quản trị riêng cho nhân viên tiệm.
        </p>
    </div>
    <a class="shop-route-admin-link" href="/admin">Vào quản trị toàn hệ thống</a>
</section>

<section class="shop-directory-grid" aria-label="Danh sách cơ sở photocopy">
    @foreach (var branch in Model.Branches)
    {
        <article class="shop-directory-card">
            <div class="shop-directory-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M3 10h18l-1.5-6h-15z"></path>
                    <path d="M5 10v10h14V10"></path>
                    <path d="M9 20v-6h6v6"></path>
                </svg>
            </div>

            <div class="shop-directory-content">
                <span class="shop-directory-slug">/shop/@branch.Slug</span>
                <h2>@branch.Name</h2>
                <p>@branch.ShortDescription</p>

                <dl>
                    <div>
                        <dt>Địa chỉ</dt>
                        <dd>@branch.Address</dd>
                    </div>
                    <div>
                        <dt>Liên hệ</dt>
                        <dd>@branch.PhoneNumber</dd>
                    </div>
                </dl>

                <div class="shop-directory-actions">
                    <a class="btn btn-primary" href="/shop/@branch.Slug">Trang khách hàng</a>
                    <a class="btn btn-outline-primary" href="/shop/@branch.Slug/admin">Quản trị tiệm</a>
                </div>

                <div class="shop-directory-admin-links">
                    <a href="/shop/@branch.Slug/admin/PrintJobs">Đơn in</a>
                    <a href="/shop/@branch.Slug/admin/ProductOrders">Đơn sản phẩm</a>
                    <a href="/shop/@branch.Slug/admin/SupportOrders">Đơn hỗ trợ</a>
                    <a href="/shop/@branch.Slug/admin/Inventory">Tồn kho</a>
                </div>
            </div>
        </article>
    }
</section>

<section class="shop-route-note">
    <h2>Phân biệt các đường dẫn</h2>
    <div class="shop-route-note-grid">
        <article>
            <strong>/shop</strong>
            <span>Danh sách cơ sở photocopy.</span>
        </article>
        <article>
            <strong>/shop/141-dien-bien-phu</strong>
            <span>Trang khách hàng sử dụng cho cơ sở đó.</span>
        </article>
        <article>
            <strong>/shop/141-dien-bien-phu/admin</strong>
            <span>Khu quản trị của nhân viên tiệm photocopy.</span>
        </article>
        <article>
            <strong>/admin</strong>
            <span>Khu quản trị toàn hệ thống.</span>
        </article>
    </div>
</section>