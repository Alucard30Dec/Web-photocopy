@model CreateSupportOrderViewModel
@{
    ViewData["Title"] = "Dịch vụ hỗ trợ";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Support service</span>
            <h1>Tạo đơn dịch vụ hỗ trợ</h1>
            <p>Đặt các dịch vụ như scan tài liệu, đóng gáy, ép plastic, đánh máy hoặc hỗ trợ hoàn thiện file.</p>
            <div class="cu-actions">
                <a class="btn btn-outline-secondary" asp-action="History">Lịch sử đơn dịch vụ</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Dịch vụ đang có</span>
            <strong>@Model.AvailableServices.Count</strong>
            <small>Chọn dịch vụ, nhập số lượng và gửi yêu cầu.</small>
        </aside>
    </section>

    <section class="cu-card">
        <form asp-action="Create" method="post" class="cu-form">
            <input asp-for="IdempotencyKey" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
                <label asp-for="SupportServiceId" class="form-label"></label>
                <select asp-for="SupportServiceId" class="form-select">
                    <option value="">-- Chọn dịch vụ --</option>
                    @foreach (var item in Model.AvailableServices)
                    {
                        <option value="@item.Id">@item.Name - @item.UnitPrice.ToString("N0") đ (@item.FeeType.GetDisplayName())</option>
                    }
                </select>
                <span asp-validation-for="SupportServiceId" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
            </div>

            <div class="cu-actions">
                <button class="btn btn-primary" type="submit">Gửi yêu cầu dịch vụ</button>
                <a class="btn btn-outline-secondary" asp-action="History">Lịch sử đơn dịch vụ</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}