@{
    ViewData["Title"] = "Dành cho tiệm photocopy";
}

<section class="pc-portfolio-page pc-portfolio-page--shop">
    <div class="pc-portfolio-hero2">
        <div class="pc-portfolio-copy">
            <span class="pc-portfolio-pill pc-portfolio-pill--green">Dành cho tiệm photocopy</span>
            <h1>Quản lý đơn in tập trung cho tiệm photocopy hiện đại</h1>
            <p>PhotoCopyHub giúp tiệm tiếp nhận đơn online, quản lý file theo từng đơn, cập nhật trạng thái và theo dõi công việc mỗi ngày trên một dashboard gọn gàng.</p>
            <div class="pc-portfolio-actions">
                <a class="pc-btn pc-btn--success" asp-controller="Home" asp-action="Index">Về trang chủ</a>
                <a class="pc-btn pc-btn--ghost" href="#shopFlow">Xem quy trình</a>
            </div>
        </div>

        <div class="pc-portfolio-dashboard">
            <div class="pc-dashboard-head">
                <strong>Dashboard tiệm photo</strong>
                <span>Hôm nay</span>
            </div>
            <div class="pc-dashboard-stats">
                <div><b>18</b><span>Đơn mới</span></div>
                <div><b>12</b><span>Đang xử lý</span></div>
                <div><b>31</b><span>Hoàn thành</span></div>
            </div>
            <div class="pc-dashboard-list">
                <div><b>#PC-1024</b><span>Đang in</span></div>
                <div><b>#PC-1025</b><span>Cần kiểm file</span></div>
                <div><b>#PC-1026</b><span>Hoàn thành</span></div>
            </div>
        </div>
    </div>

    <div class="pc-portfolio-section">
        <div class="pc-section-heading">
            <h2>Lợi ích cho tiệm photocopy</h2>
            <p>Giảm thất lạc file, giảm nhầm yêu cầu và giúp nhân viên xử lý đơn có thứ tự hơn.</p>
        </div>

        <div class="pc-portfolio-cards">
            <article>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18l-1.5-6h-15z"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>
                <h3>Tiếp nhận đơn tập trung</h3>
                <p>Tất cả đơn in online được gom vào một danh sách dễ theo dõi.</p>
            </article>
            <article>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>
                <h3>File gắn đúng đơn</h3>
                <p>Nhân viên tải đúng tài liệu và kiểm tra yêu cầu in ngay trong chi tiết đơn.</p>
            </article>
            <article>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16v-5M12 16V8M17 16v-9"/></svg>
                <h3>Theo dõi vận hành</h3>
                <p>Nhìn nhanh số đơn mới, đơn đang xử lý, đơn hoàn thành và lịch sử.</p>
            </article>
        </div>
    </div>

    <div id="shopFlow" class="pc-portfolio-section pc-portfolio-section--soft">
        <div class="pc-section-heading">
            <h2>Quy trình cho tiệm</h2>
            <p>Phù hợp với cách tiệm photocopy tiếp nhận, kiểm file, in và trả đơn mỗi ngày.</p>
        </div>

        <div class="pc-portfolio-steps">
            <article><span>01</span><h3>Nhận đơn online</h3><p>Đơn mới xuất hiện trong khu quản lý của tiệm.</p></article>
            <article><span>02</span><h3>Kiểm file và yêu cầu</h3><p>Xem tài liệu, số bản, khổ giấy, màu sắc và ghi chú.</p></article>
            <article><span>03</span><h3>Cập nhật trạng thái</h3><p>Chuyển đơn sang đang xử lý, hoàn thành hoặc cần bổ sung.</p></article>
            <article><span>04</span><h3>Quản lý lịch sử</h3><p>Theo dõi đơn, file và hoạt động để vận hành rõ ràng hơn.</p></article>
        </div>
    </div>
</section>