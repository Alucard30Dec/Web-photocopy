@model LoginViewModel
@{
    var branch = ViewData["Branch"] as ShopBranchLinkViewModel;
    ViewData["Title"] = "Đăng nhập chủ shop";
}

<section class="role-login-page role-login-page--shop">
    <div class="role-login-hero">
        <a class="role-login-brand" href="/@branch?.Slug/Admin">
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 4h16v6H4z"></path><path d="M6 10v10h12V10"></path><path d="M9 14h6"></path></svg></span>
            @branch?.Name Admin
        </a>
        <h1>Khu vận hành cơ sở</h1>
        <p>Đăng nhập bằng tài khoản chủ shop hoặc nhân viên để xử lý đơn in, đơn sản phẩm và tồn kho.</p>
        <div class="role-login-pills">
            <span>Hàng chờ in</span>
            <span>Duyệt nạp tiền</span>
            <span>Tồn kho</span>
        </div>
    </div>

    <div class="role-login-card">
        <span class="role-login-kicker">Shop operator</span>
        <h2>Đăng nhập quản trị cơ sở</h2>
        <form asp-action="ShopLogin" asp-route-branchSlug="@branch?.Slug" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control mb-3" placeholder="operator@photocopyhub.local" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control mb-3" placeholder="Mật khẩu nhân viên" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button class="btn btn-success w-100" type="submit">Vào quản trị cơ sở</button>
        </form>
        <a class="role-login-alt" href="/@branch?.Slug/Login">Tôi là khách hàng</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
