@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    var branch = CustomerBranchContext.GetBranch(ViewContext);
    var branchHomeUrl = CustomerBranchContext.Home(ViewContext);
    var loginUrl = CustomerBranchContext.ToPath(ViewContext, "Login");
    var dashboardUrl = CustomerBranchContext.ToPath(ViewContext, "Dashboard");
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var printFilesUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Files");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var productOrdersUrl = CustomerBranchContext.ToPath(ViewContext, "Products/Orders");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var supportHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/History");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var topUpUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUp");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");
    var priceUrl = branchHomeUrl.TrimEnd('/') + "#customerPriceQuick";

    string RequireLogin(string targetUrl)
    {
        return isSignedIn ? targetUrl : loginUrl + "?returnUrl=" + System.Uri.EscapeDataString(targetUrl);
    }

    bool InController(params string[] names)
    {
        return names.Any(name => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase));
    }

    string ActiveGroup(params string[] names)
    {
        return InController(names) ? "is-active" : string.Empty;
    }

    var displayName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "Khách hàng";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @branch.Name</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="customer-shell">
<header class="customer-topbar">
    <a class="customer-brand" href="@branchHomeUrl" aria-label="Trang chủ @branch.Name">
        <span class="customer-brand-icon" aria-hidden="true">▣</span>
        <strong>@branch.Name</strong>
    </a>

    <nav class="customer-nav-groups" aria-label="Menu chức năng khách hàng">
        <a class="customer-home-link @(InController("Branch") ? "is-active" : string.Empty)" href="@branchHomeUrl">
            <span aria-hidden="true">⌂</span> Trang chủ
        </a>

        <div class="customer-nav-group dropdown @ActiveGroup("PrintJobs")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">🖨</span> Đơn in
            </button>
            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@RequireLogin(printCreateUrl)">
                    <strong>Tạo đơn in</strong>
                    <small>Upload file, chọn khổ giấy và gửi yêu cầu.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(printJobsUrl)">
                    <strong>Đơn của tôi</strong>
                    <small>Theo dõi trạng thái xử lý và thanh toán.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(printFilesUrl)">
                    <strong>File đã gửi</strong>
                    <small>Xem file đã upload, preview hoặc tải lại.</small>
                </a>
            </div>
        </div>

        <div class="customer-nav-group dropdown @ActiveGroup("Products")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">🛒</span> Sản phẩm
            </button>
            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@priceUrl">
                    <strong>Bảng giá nhanh</strong>
                    <small>Xem giá in và dịch vụ phổ biến tại cơ sở.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(productsUrl)">
                    <strong>Mua sản phẩm</strong>
                    <small>Giấy, bút, bìa, vật tư văn phòng.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(productOrdersUrl)">
                    <strong>Đơn sản phẩm</strong>
                    <small>Kiểm tra các đơn sản phẩm đã đặt.</small>
                </a>
            </div>
        </div>

        <div class="customer-nav-group dropdown @ActiveGroup("SupportOrders")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">✦</span> Dịch vụ
            </button>
            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@RequireLogin(supportCreateUrl)">
                    <strong>Tạo yêu cầu dịch vụ</strong>
                    <small>Scan, đóng gáy, ép plastic, hỗ trợ file.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(supportHistoryUrl)">
                    <strong>Lịch sử dịch vụ</strong>
                    <small>Xem các yêu cầu hỗ trợ đã gửi.</small>
                </a>
            </div>
        </div>

        <div class="customer-nav-group dropdown @ActiveGroup("Dashboard", "Wallet", "Profile")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">👤</span> Tài khoản
            </button>
            <div class="dropdown-menu customer-nav-menu customer-nav-menu--right">
                <a class="customer-nav-item" href="@RequireLogin(dashboardUrl)">
                    <strong>Dashboard</strong>
                    <small>Tổng quan đơn hàng, ví và hoạt động gần đây.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(walletUrl)">
                    <strong>Ví & giao dịch</strong>
                    <small>Xem số dư và lịch sử thanh toán.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(topUpUrl)">
                    <strong>Nạp tiền</strong>
                    <small>Tạo yêu cầu nạp ví khi cần.</small>
                </a>
                <a class="customer-nav-item" href="@RequireLogin(profileUrl)">
                    <strong>Hồ sơ</strong>
                    <small>Cập nhật thông tin cá nhân và địa chỉ.</small>
                </a>
            </div>
        </div>
    </nav>

    <div class="customer-head-actions">
        <div class="customer-open-state">
            <span>● Đang mở cửa</span>
            <small>@branch.OpenHours</small>
        </div>

        @if (isSignedIn)
        {
            <a class="customer-icon-button" href="@RequireLogin(dashboardUrl)" aria-label="Dashboard khách hàng">⌁</a>
            <div class="customer-user-pill">
                <span aria-hidden="true">👤</span>
                <strong>@displayName</strong>
            </div>
            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                <input type="hidden" name="returnUrl" value="@branchHomeUrl" />
                <button class="customer-logout-button" type="submit">Đăng xuất</button>
            </form>
        }

        @if (!isSignedIn)
        {
            <a class="customer-login-button" href="@RequireLogin(dashboardUrl)">Đăng nhập</a>
        }
    </div>
</header>

<main class="customer-main">
    <partial name="_Alert" />
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>