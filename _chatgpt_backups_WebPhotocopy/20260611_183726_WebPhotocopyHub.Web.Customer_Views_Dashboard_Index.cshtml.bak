@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard khách hàng";

    var displayName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "khách hàng";
    }

    var totalServiceOrders = Model.ProductOrdersCount + Model.SupportOrdersCount;
    var branch = CustomerBranchContext.GetBranch(ViewContext);
    var branchHomeUrl = CustomerBranchContext.Home(ViewContext);
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var productOrdersUrl = CustomerBranchContext.ToPath(ViewContext, "Products/Orders");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var supportHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/History");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var topUpUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUp");
    var topUpHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUpHistory");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");
}

<section class="customer-dashboard-page">
    <section class="customer-dashboard-hero">
        <div>
            <span class="customer-kicker">Dashboard khách hàng</span>
            <h1>Tổng quan của @displayName</h1>
            <p>Xem nhanh đơn in, đơn sản phẩm, dịch vụ hỗ trợ, ví và hồ sơ tại cơ sở @branch.Name.</p>
            <div class="customer-hero-actions">
                <a class="customer-primary-action" href="@printCreateUrl">Tạo đơn in</a>
                <a class="customer-secondary-action" href="@branchHomeUrl">Về trang chính</a>
            </div>
        </div>

        <aside class="customer-balance-card">
            <span>Số dư ví</span>
            <strong>@Model.CurrentBalance.ToString("N0") đ</strong>
            <a href="@walletUrl">Xem ví & giao dịch</a>
        </aside>
    </section>

    <section class="customer-stat-grid" aria-label="Chỉ số tổng quan">
        <a class="customer-stat-card" href="@printJobsUrl">
            <span>Đơn in</span>
            <strong>@Model.PrintJobsCount</strong>
            <small>Đơn đã tạo tại cơ sở.</small>
        </a>
        <a class="customer-stat-card" href="@productOrdersUrl">
            <span>Đơn sản phẩm</span>
            <strong>@Model.ProductOrdersCount</strong>
            <small>Văn phòng phẩm đã đặt.</small>
        </a>
        <a class="customer-stat-card" href="@supportHistoryUrl">
            <span>Dịch vụ hỗ trợ</span>
            <strong>@Model.SupportOrdersCount</strong>
            <small>Scan, đóng gáy, ép plastic.</small>
        </a>
        <a class="customer-stat-card" href="@topUpHistoryUrl">
            <span>Nạp tiền chờ duyệt</span>
            <strong>@Model.PendingTopUpCount</strong>
            <small>Yêu cầu đang chờ xử lý.</small>
        </a>
    </section>

    <section class="customer-dashboard-grid">
        <article class="customer-panel customer-panel--wide">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Thao tác nhanh</span>
                    <h2>Đi thẳng tới chức năng</h2>
                </div>
            </div>

            <div class="customer-action-grid is-dashboard-actions">
                <a class="customer-action-card is-blue" href="@printCreateUrl"><span>🖨</span><strong>Tạo đơn in</strong><small>Gửi file và yêu cầu in mới.</small></a>
                <a class="customer-action-card is-green" href="@printJobsUrl"><span>📄</span><strong>Đơn của tôi</strong><small>Theo dõi trạng thái xử lý.</small></a>
                <a class="customer-action-card is-purple" href="@productsUrl"><span>▣</span><strong>Sản phẩm</strong><small>Mua vật tư tại cơ sở.</small></a>
                <a class="customer-action-card is-rose" href="@supportCreateUrl"><span>✦</span><strong>Dịch vụ</strong><small>Tạo yêu cầu hỗ trợ.</small></a>
                <a class="customer-action-card is-amber" href="@topUpUrl"><span>₫</span><strong>Nạp tiền</strong><small>Gửi yêu cầu nạp ví.</small></a>
                <a class="customer-action-card is-sky" href="@profileUrl"><span>👤</span><strong>Hồ sơ</strong><small>Cập nhật thông tin cá nhân.</small></a>
            </div>
        </article>

        <aside class="customer-panel">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Cơ sở</span>
                    <h2>@branch.Name</h2>
                </div>
            </div>
            <div class="customer-shop-summary">
                <span>@branch.Address</span>
                <span>@branch.PhoneNumber</span>
                <span>@branch.OpenHours</span>
            </div>
        </aside>

        <article class="customer-panel customer-panel--wide">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Lịch sử</span>
                    <h2>Giao dịch gần đây</h2>
                </div>
                <a href="@walletUrl">Xem ví</a>
            </div>

            @if (Model.RecentTransactions.Count > 0)
            {
                <div class="customer-table-wrap">
                    <table class="table customer-table">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Loại</th>
                                <th class="text-end">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr>
                                <td>@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@tx.TransactionType.GetDisplayName()</td>
                                <td class="text-end @(tx.Amount >= 0 ? "text-success" : "text-danger")">@tx.Amount.ToString("N0") đ</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.RecentTransactions.Count == 0)
            {
                <div class="customer-empty-state">
                    <strong>Chưa có giao dịch gần đây</strong>
                    <span>Khi bạn thanh toán hoặc nạp tiền, lịch sử sẽ hiển thị tại đây.</span>
                </div>
            }
        </article>

        <aside class="customer-panel">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Tổng hoạt động</span>
                    <h2>@totalServiceOrders đơn dịch vụ/sản phẩm</h2>
                </div>
            </div>
            <div class="customer-mini-list">
                <a href="@printJobsUrl"><span class="is-blue">@Model.PrintJobsCount</span><div><strong>Đơn in</strong><small>Mở danh sách đơn in.</small></div><em>→</em></a>
                <a href="@productOrdersUrl"><span class="is-purple">@Model.ProductOrdersCount</span><div><strong>Sản phẩm</strong><small>Mở đơn sản phẩm.</small></div><em>→</em></a>
                <a href="@supportHistoryUrl"><span class="is-rose">@Model.SupportOrdersCount</span><div><strong>Dịch vụ</strong><small>Mở lịch sử dịch vụ.</small></div><em>→</em></a>
            </div>
        </aside>
    </section>
</section>