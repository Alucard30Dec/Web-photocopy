@model WebPhotocopyHub.Web.Models.ShopBranchLinkViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "_BranchCustomerLayout";

    var loginUrl = CustomerBranchContext.ToPath(ViewContext, "Login");
    var dashboardUrl = CustomerBranchContext.ToPath(ViewContext, "Dashboard");
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var printFilesUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Files");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var productOrdersUrl = CustomerBranchContext.ToPath(ViewContext, "Products/Orders");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var supportHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/History");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");
    var isSignedIn = User?.Identity?.IsAuthenticated == true;
    var displayName = User?.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "khách hàng";
    }

    string RequireLogin(string targetUrl)
    {
        return isSignedIn ? targetUrl : loginUrl + "?returnUrl=" + Uri.EscapeDataString(targetUrl);
    }
}

<section class="customer-home-page">
    <section class="customer-home-hero" aria-label="Trang chính khách hàng">
        <div class="customer-hero-copy">
            <span class="customer-kicker">Trang chính khách hàng</span>
            <h1>Xin chào, @displayName</h1>
            <p>Tạo đơn in, xem bảng giá, đặt dịch vụ và mở dashboard cá nhân tại đúng cơ sở @Model.Name.</p>

            <div class="customer-hero-meta">
                <span>@Model.Address</span>
                <span>@Model.OpenHours</span>
                <span>Thanh toán theo từng đơn</span>
            </div>

            <div class="customer-hero-actions">
                <a class="customer-primary-action" href="@RequireLogin(printCreateUrl)">Tạo đơn in mới</a>
                <a class="customer-secondary-action" href="@RequireLogin(dashboardUrl)">Mở dashboard</a>
                <a class="customer-secondary-action" href="#customerPriceQuick">Xem bảng giá</a>
            </div>
        </div>

        <aside class="customer-upload-card" aria-label="Tạo đơn nhanh">
            <div class="customer-upload-head">
                <strong>Tạo đơn nhanh</strong>
                <span>PDF, DOCX, PPTX</span>
            </div>
            <div class="customer-upload-drop">
                <span aria-hidden="true">⇧</span>
                <strong>Kéo thả file vào đây</strong>
                <small>Hoặc chọn file từ máy khi tạo đơn.</small>
            </div>
            <div class="customer-print-options">
                <span>A4</span>
                <span>1 mặt / 2 mặt</span>
                <span>Đen trắng / màu</span>
            </div>
            <a href="@RequireLogin(printCreateUrl)">Gửi yêu cầu in</a>
        </aside>
    </section>

    <section class="customer-home-grid" aria-label="Truy cập nhanh chức năng">
        <article class="customer-panel customer-panel--wide">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Truy cập nhanh</span>
                    <h2>Chức năng cần dùng</h2>
                </div>
                <a href="@RequireLogin(dashboardUrl)">Dashboard của tôi</a>
            </div>

            <div class="customer-action-grid">
                <a class="customer-action-card is-blue" href="@RequireLogin(printCreateUrl)">
                    <span>🖨</span>
                    <strong>Tạo đơn in</strong>
                    <small>Upload file, chọn cấu hình và gửi yêu cầu.</small>
                </a>
                <a class="customer-action-card is-green" href="@RequireLogin(printJobsUrl)">
                    <span>📄</span>
                    <strong>Đơn của tôi</strong>
                    <small>Theo dõi trạng thái đơn in đã tạo.</small>
                </a>
                <a class="customer-action-card is-sky" href="@RequireLogin(printFilesUrl)">
                    <span>☁</span>
                    <strong>File đã gửi</strong>
                    <small>Preview, tải lại hoặc dùng lại file.</small>
                </a>
                <a class="customer-action-card is-purple" href="@RequireLogin(productsUrl)">
                    <span>▣</span>
                    <strong>Sản phẩm</strong>
                    <small>Mua giấy, bút, bìa và vật tư.</small>
                </a>
                <a class="customer-action-card is-rose" href="@RequireLogin(supportCreateUrl)">
                    <span>✦</span>
                    <strong>Dịch vụ hỗ trợ</strong>
                    <small>Scan, đóng gáy, ép plastic.</small>
                </a>
                <a class="customer-action-card is-amber" href="@RequireLogin(walletUrl)">
                    <span>₫</span>
                    <strong>Ví & giao dịch</strong>
                    <small>Xem số dư và lịch sử thanh toán.</small>
                </a>
            </div>
        </article>

        <aside id="customerPriceQuick" class="customer-panel">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Bảng giá</span>
                    <h2>Giá nhanh</h2>
                </div>
            </div>
            <div class="customer-price-list">
                <div><span>In A4 đen trắng</span><strong>1.000 / trang</strong></div>
                <div><span>In A4 đảo trang</span><strong>1.500 / trang</strong></div>
                <div><span>In A4 màu</span><strong>3.000 / trang</strong></div>
                <div><span>Photo CMND / CCCD</span><strong>2.000 / mặt</strong></div>
                <div><span>Đóng gáy lò xo</span><strong>10.000 / cuốn</strong></div>
                <div><span>Ép plastic A4</span><strong>5.000 / tờ</strong></div>
            </div>
        </aside>

        <article class="customer-panel">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Hoạt động</span>
                    <h2>Đơn gần đây</h2>
                </div>
                <a href="@RequireLogin(printJobsUrl)">Xem tất cả</a>
            </div>

            <div class="customer-mini-list">
                <a href="@RequireLogin(printJobsUrl)">
                    <span class="is-blue">1</span>
                    <div><strong>Đơn in đang xử lý</strong><small>Mở danh sách đơn để xem trạng thái.</small></div>
                    <em>→</em>
                </a>
                <a href="@RequireLogin(productOrdersUrl)">
                    <span class="is-purple">2</span>
                    <div><strong>Đơn sản phẩm</strong><small>Kiểm tra sản phẩm đã đặt tại cơ sở.</small></div>
                    <em>→</em>
                </a>
                <a href="@RequireLogin(supportHistoryUrl)">
                    <span class="is-rose">3</span>
                    <div><strong>Yêu cầu dịch vụ</strong><small>Xem lịch sử scan, đóng gáy, ép plastic.</small></div>
                    <em>→</em>
                </a>
            </div>
        </article>

        <article class="customer-panel">
            <div class="customer-section-head">
                <div>
                    <span class="customer-kicker">Cơ sở</span>
                    <h2>Đang phục vụ</h2>
                </div>
                <a href="@RequireLogin(profileUrl)">Hồ sơ</a>
            </div>

            <div class="customer-shop-summary">
                <strong>@Model.Name</strong>
                <span>@Model.Address</span>
                <span>@Model.PhoneNumber</span>
                <span>@Model.OpenHours</span>
            </div>
        </article>
    </section>
</section>