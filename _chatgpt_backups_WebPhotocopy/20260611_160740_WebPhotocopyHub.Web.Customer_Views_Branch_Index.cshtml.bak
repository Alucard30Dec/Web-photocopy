@model WebPhotocopyHub.Web.Models.ShopBranchLinkViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "_BranchCustomerLayout";

    var rootUrl = "/" + Model.Slug;
    var loginUrl = rootUrl + "/Login";
    var dashboardUrl = rootUrl + "/Dashboard";
    var printCreateUrl = rootUrl + "/PrintJobs/Create";
    var printJobsUrl = rootUrl + "/PrintJobs";
    var productsUrl = rootUrl + "/Products";
    var supportUrl = rootUrl + "/SupportOrders/Create";
    var profileUrl = rootUrl + "/Profile";
    var isSignedIn = User?.Identity?.IsAuthenticated == true;
    var displayName = User?.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "khách hàng";
    }

    string RequireLogin(string targetUrl)
    {
        return isSignedIn ? targetUrl : loginUrl + "?returnUrl=" + Uri.EscapeDataString(targetUrl);
    }
}

<section class="branch-modern-page">
    <section class="branch-modern-hero" aria-label="Trang khách hàng của cơ sở">
        <div class="branch-modern-copy">
            <span class="branch-modern-kicker">Trang khách hàng</span>

            @if (isSignedIn)
            {
                <h1>Xin chào, @displayName 👋</h1>
                <p>Bạn đang tại cơ sở @Model.Name. Tạo đơn in, thanh toán theo từng đơn và theo dõi trạng thái xử lý.</p>
            }
            else
            {
                <h1>@Model.Name</h1>
                <p>Gửi file in, chọn cấu hình, thanh toán đúng theo từng đơn và theo dõi trạng thái xử lý tại cơ sở.</p>
            }

            <div class="branch-modern-meta">
                <span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    @Model.Address
                </span>
                <span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.63a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6.25 6.25l1.29-1.29a2 2 0 0 1 2.11-.45c.85.3 1.73.51 2.63.63A2 2 0 0 1 22 16.92Z"></path></svg>
                    @Model.PhoneNumber
                </span>
                <span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
                    @Model.OpenHours
                </span>
            </div>

            <div class="branch-modern-note">
                <div class="branch-modern-note-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-5"></path></svg>
                </div>
                <div>
                    <strong>Thanh toán theo đơn, không cần nạp tiền trước</strong>
                    <span>Dịch vụ hết bao nhiêu, thanh toán bấy nhiêu. Minh bạch, rõ ràng và an tâm.</span>
                </div>
            </div>
        </div>

        <aside class="branch-modern-preview" aria-label="Tạo đơn in minh họa">
            <div class="branch-preview-window">
                <div class="branch-preview-top">
                    <span></span>
                    <span></span>
                </div>

                <div class="branch-file-preview">
                    <b>PDF</b>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>

                    <div class="branch-upload-circle">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M20 20H4"></path></svg>
                    </div>
                </div>

                <div class="branch-config-floating">
                    <span>A4</span>
                    <span>2 mặt</span>
                    <span>Đen trắng</span>
                    <span>Số bản: 3</span>
                    <a href="@RequireLogin(printCreateUrl)">Tạo đơn in</a>
                </div>
            </div>
        </aside>
    </section>

    <section class="branch-quick-section" aria-labelledby="branchQuickTitle">
        <div class="branch-section-title">
            <h2 id="branchQuickTitle">Thao tác nhanh</h2>
            <p>
                @if (isSignedIn)
                {
                    <text>Những chức năng bạn có thể dùng ngay tại cơ sở này.</text>
                }
                else
                {
                    <text>Các chức năng cá nhân sẽ mở sau khi bạn đăng nhập tài khoản khách hàng.</text>
                }
            </p>
        </div>

        <div class="branch-quick-grid">
            <a class="branch-quick-card is-blue" href="@RequireLogin(printCreateUrl)">
                <span><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><path d="M14 2v6h6"></path></svg></span>
                <strong>Tạo đơn in</strong>
                <small>Gửi file và yêu cầu in mới</small>
                @if (!isSignedIn) { <em>Cần đăng nhập</em> }
            </a>

            <a class="branch-quick-card is-green" href="@RequireLogin(printJobsUrl)">
                <span><svg viewBox="0 0 24 24"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h10"></path></svg></span>
                <strong>Đơn của tôi</strong>
                <small>Theo dõi và quản lý đơn hàng</small>
                @if (!isSignedIn) { <em>Cần đăng nhập</em> }
            </a>

            <a class="branch-quick-card is-amber" href="@RequireLogin(printJobsUrl)">
                <span><svg viewBox="0 0 24 24"><path d="M12 1v22"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
                <strong>Thanh toán</strong>
                <small>Thanh toán theo từng đơn</small>
                @if (!isSignedIn) { <em>Cần đăng nhập</em> }
            </a>

            <a class="branch-quick-card is-purple" href="@RequireLogin(productsUrl)">
                <span><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg></span>
                <strong>Sản phẩm</strong>
                <small>Giấy, bút, bìa và vật tư</small>
                @if (!isSignedIn) { <em>Cần đăng nhập</em> }
            </a>

            <a class="branch-quick-card is-rose" href="@RequireLogin(supportUrl)">
                <span><svg viewBox="0 0 24 24"><path d="M12 2v20"></path><path d="M5 7h14"></path><path d="M7 17h10"></path></svg></span>
                <strong>Dịch vụ hỗ trợ</strong>
                <small>Scan, đóng gáy, ép plastic</small>
                @if (!isSignedIn) { <em>Cần đăng nhập</em> }
            </a>

            <a class="branch-quick-card is-sky" href="@RequireLogin(profileUrl)">
                <span><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 22c1.8-4 4.5-6 8-6s6.2 2 8 6"></path></svg></span>
                <strong>Hồ sơ</strong>
                <small>Thông tin tài khoản và địa chỉ</small>
                @if (!isSignedIn) { <em>Cần đăng nhập</em> }
            </a>
        </div>
    </section>

    <section class="branch-content-grid" aria-label="Thông tin đặt in">
        <div class="branch-panel branch-process-panel">
            <div class="branch-section-title">
                <h2>Quy trình đặt in</h2>
                <p>Thực hiện đúng thứ tự để đơn được xử lý nhanh hơn.</p>
            </div>

            <div class="branch-process-list">
                <article>
                    <span>01</span>
                    <div>
                        <strong>Gửi file</strong>
                        <small>Upload tài liệu cần in.</small>
                    </div>
                </article>
                <article>
                    <span>02</span>
                    <div>
                        <strong>Chọn cấu hình</strong>
                        <small>Chọn số bản, khổ giấy, màu in, 1 mặt/2 mặt.</small>
                    </div>
                </article>
                <article>
                    <span>03</span>
                    <div>
                        <strong>Thanh toán theo đơn</strong>
                        <small>Thanh toán đúng theo dịch vụ đã sử dụng.</small>
                    </div>
                </article>
                <article>
                    <span>04</span>
                    <div>
                        <strong>Theo dõi trạng thái</strong>
                        <small>Xem đơn đang tiếp nhận, xử lý hay hoàn thành.</small>
                    </div>
                </article>
            </div>
        </div>

        <div class="branch-panel">
            <div class="branch-section-title branch-title-row">
                <div>
                    <h2>Đơn hàng gần đây</h2>
                    <p>
                        @if (isSignedIn)
                        {
                            <text>Truy cập nhanh danh sách đơn của bạn.</text>
                        }
                        else
                        {
                            <text>Đăng nhập để xem đơn hàng cá nhân.</text>
                        }
                    </p>
                </div>
                <a href="@RequireLogin(printJobsUrl)">Xem tất cả</a>
            </div>

            <div class="branch-order-list">
                @if (isSignedIn)
                {
                    <article>
                        <span class="branch-order-icon is-blue"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><path d="M14 2v6h6"></path></svg></span>
                        <div><strong>Đơn in của tôi</strong><small>Theo dõi tiếp nhận, thanh toán, xử lý.</small></div>
                        <a href="@printJobsUrl">→</a>
                    </article>
                    <article>
                        <span class="branch-order-icon is-green"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg></span>
                        <div><strong>Đơn đã hoàn thành</strong><small>Xem lại lịch sử và thông tin nhận hàng.</small></div>
                        <a href="@printJobsUrl">→</a>
                    </article>
                    <article>
                        <span class="branch-order-icon is-amber"><svg viewBox="0 0 24 24"><path d="M12 1v22"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
                        <div><strong>Thanh toán theo đơn</strong><small>Kiểm tra các đơn cần thanh toán.</small></div>
                        <a href="@printJobsUrl">→</a>
                    </article>
                }
                else
                {
                    <article class="is-locked">
                        <span class="branch-order-icon is-blue"><svg viewBox="0 0 24 24"><path d="M12 17v-5"></path><path d="M8 12V8a4 4 0 0 1 8 0v4"></path><rect x="5" y="12" width="14" height="9" rx="2"></rect></svg></span>
                        <div><strong>Đơn hàng cá nhân</strong><small>Đăng nhập để xem danh sách đơn đã tạo.</small></div>
                        <a href="@loginUrl">→</a>
                    </article>
                    <article class="is-locked">
                        <span class="branch-order-icon is-amber"><svg viewBox="0 0 24 24"><path d="M12 17v-5"></path><path d="M8 12V8a4 4 0 0 1 8 0v4"></path><rect x="5" y="12" width="14" height="9" rx="2"></rect></svg></span>
                        <div><strong>Thanh toán theo đơn</strong><small>Đăng nhập để xem đơn cần thanh toán.</small></div>
                        <a href="@loginUrl">→</a>
                    </article>
                }
            </div>
        </div>

        <div class="branch-panel branch-service-panel">
            <div class="branch-section-title branch-title-row">
                <div>
                    <h2>Dịch vụ phổ biến</h2>
                    <p>Các nhu cầu hay dùng tại tiệm.</p>
                </div>
                <a href="@RequireLogin(supportUrl)">Xem thêm</a>
            </div>

            <div class="branch-service-grid">
                <a href="@RequireLogin(printCreateUrl)"><strong>In tài liệu</strong><small>A4, A3, màu/đen trắng</small></a>
                <a href="@RequireLogin(printCreateUrl)"><strong>Photocopy</strong><small>1 mặt, 2 mặt</small></a>
                <a href="@RequireLogin(supportUrl)"><strong>Scan tài liệu</strong><small>Scan màu, đen trắng</small></a>
                <a href="@RequireLogin(supportUrl)"><strong>Đóng gáy</strong><small>Gáy xoắn, gáy keo</small></a>
                <a href="@RequireLogin(supportUrl)"><strong>Ép plastic</strong><small>Ép bằng, ép card</small></a>
                <a href="@RequireLogin(supportUrl)"><strong>Cắt giấy</strong><small>Cắt A4, A3 theo yêu cầu</small></a>
            </div>
        </div>
    </section>

    <section class="branch-support-strip" aria-label="Hỗ trợ khách hàng">
        <div>
            <span><svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.63a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6.25 6.25l1.29-1.29a2 2 0 0 1 2.11-.45c.85.3 1.73.51 2.63.63A2 2 0 0 1 22 16.92Z"></path></svg></span>
            <div><strong>Cần hỗ trợ?</strong><small>@Model.PhoneNumber hoặc đến trực tiếp cửa hàng.</small></div>
        </div>
        <div>
            <span><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
            <div><strong>Chất lượng đảm bảo</strong><small>In sắc nét, đúng yêu cầu.</small></div>
        </div>
        <div>
            <span><svg viewBox="0 0 24 24"><path d="M3 3v18h18"></path><path d="m7 15 4-4 3 3 5-7"></path></svg></span>
            <div><strong>Giá minh bạch</strong><small>Thanh toán theo đơn.</small></div>
        </div>
    </section>
</section>