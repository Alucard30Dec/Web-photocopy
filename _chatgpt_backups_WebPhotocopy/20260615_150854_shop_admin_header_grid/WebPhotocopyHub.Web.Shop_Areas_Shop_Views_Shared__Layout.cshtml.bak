<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop - WebPhotocopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var shopController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var branchSlug = ViewContext.RouteData.Values["branchSlug"]?.ToString();

    string ShopUrl(string controllerName, string actionName = "Index")
    {
        object routeValues = string.IsNullOrWhiteSpace(branchSlug)
            ? new { area = "Shop" }
            : new { area = "Shop", branchSlug };

        return Url.Action(actionName, controllerName, routeValues) ?? "#";
    }
}
<nav class="navbar navbar-expand-lg navbar-dark admin-topbar shop-topbar">
    <div class="container-fluid">
        <a class="navbar-brand admin-title" href="@ShopUrl("Dashboard")">
            <span class="role-mark role-mark-shop"></span>
            <span>WebPhotocopyHub Shop</span>
        </a>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-sm rounded-pill px-3" href="@ShopUrl("PrintJobs")">Hàng chờ in</a>
            <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/">Về trang chính</a>
        </div>
    </div>
</nav>

<div class="container-fluid admin-shell">
    <div class="row">
        <aside class="col-lg-2 mb-3 admin-sidebar">
            <div class="sidebar-card mb-3">
                <span>Khu vận hành</span>
                <strong>Tiệm photocopy</strong>
                <small>Xử lý đơn, top-up tại quầy và tồn kho.</small>
            </div>
            <div class="list-group admin-menu">
                <a class="list-group-item list-group-item-action @(shopController == "Dashboard" ? "active" : string.Empty)" href="@ShopUrl("Dashboard")">Dashboard</a>
                <a class="list-group-item list-group-item-action @(shopController == "TopUpRequests" ? "active" : string.Empty)" href="@ShopUrl("TopUpRequests")">Duyệt nạp tiền</a>
                <a class="list-group-item list-group-item-action @(shopController == "TopUpRequests" ? "active" : string.Empty)" href="@ShopUrl("TopUpRequests", "CounterTopUp")">Nạp tiền tại quầy</a>
                <a class="list-group-item list-group-item-action @(shopController == "PrintJobs" ? "active" : string.Empty)" href="@ShopUrl("PrintJobs")">Hàng chờ in</a>
                <a class="list-group-item list-group-item-action @(shopController == "ProductOrders" ? "active" : string.Empty)" href="@ShopUrl("ProductOrders")">Đơn văn phòng phẩm</a>
                <a class="list-group-item list-group-item-action @(shopController == "SupportOrders" ? "active" : string.Empty)" href="@ShopUrl("SupportOrders")">Đơn dịch vụ hỗ trợ</a>
                <a class="list-group-item list-group-item-action @(shopController == "Inventory" ? "active" : string.Empty)" href="@ShopUrl("Inventory")">Quản lý tồn kho</a>
            </div>
        </aside>

        <main class="col-lg-10">
            <partial name="_Alert" />
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
