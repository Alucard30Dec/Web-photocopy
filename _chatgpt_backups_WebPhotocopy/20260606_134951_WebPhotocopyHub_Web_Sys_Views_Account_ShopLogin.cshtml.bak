@model LoginViewModel
@{
    Layout = "_BranchCustomerLayout";
    var branch = ViewData["Branch"] as ShopBranchLinkViewModel;
    ViewData["Title"] = "Đăng nhập quản trị cơ sở";

    var branchSlug = branch?.Slug ?? ViewContext.RouteData.Values["branchSlug"]?.ToString() ?? "";
    var branchName = branch?.Name ?? branchSlug;
    var formAction = "/" + branchSlug + "/Admin/Login";
    var customerLoginUrl = "/" + branchSlug + "/Login";
    var branchHomeUrl = "/" + branchSlug;
    var defaultReturnUrl = "/" + branchSlug + "/Admin";

    if (string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        Model.ReturnUrl = defaultReturnUrl;
    }
}

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-card__intro">
            <span class="eyebrow">Quản trị cơ sở</span>
            <h1>Đăng nhập quản lý @branchName</h1>
            <p>
                Khu vực này dành cho nhân viên/quản trị cơ sở xử lý đơn in, đơn sản phẩm,
                yêu cầu hỗ trợ và trạng thái nhận tài liệu của khách hàng.
            </p>
            <div class="hero-actions mt-3">
                <a class="btn btn-light" href="@branchHomeUrl">Về trang cơ sở</a>
                <a class="btn btn-outline-light" href="@customerLoginUrl">Đăng nhập khách hàng</a>
            </div>
        </div>

        <div class="auth-card__form">
            <h2>Đăng nhập vận hành</h2>
            <p class="text-muted mb-3">Sử dụng tài khoản được cấp cho cơ sở.</p>

            <div class="alert alert-info small mb-3">
                Tài khoản vận hành mẫu đã seed tự động:
                <div><strong>operator@photocopyhub.local</strong> / <strong>Operator@123456</strong></div>
            </div>

            <form action="@formAction" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="operator@photocopyhub.local" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Đăng nhập quản trị cơ sở</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}