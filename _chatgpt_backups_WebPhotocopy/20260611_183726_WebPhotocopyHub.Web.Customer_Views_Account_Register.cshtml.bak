@model RegisterViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_BranchCustomerLayout";
    var branch = ViewData["Branch"] as ShopBranchLinkViewModel;
    ViewData["Title"] = "Tạo tài khoản khách hàng";

    var branchSlug = branch?.Slug ?? ViewContext.RouteData.Values["branchSlug"]?.ToString() ?? "";
    var branchName = branch?.Name ?? branchSlug;
    var formAction = "/" + branchSlug + "/Register";
    var externalLoginUrl = "/" + branchSlug + "/ExternalLogin";
    var loginUrl = "/" + branchSlug + "/Login";
    var homeUrl = "/" + branchSlug;
    var dashboardUrl = "/" + branchSlug + "/Dashboard";

    var googleConfigured =
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
}

<section class="customer-auth-page">
    <div class="customer-auth-hero">
        <a class="customer-auth-brand" href="@homeUrl"><span>▣</span>@branchName</a>
        <span class="customer-kicker">Tạo tài khoản khách hàng</span>
        <h1>Đăng ký để dùng đầy đủ chức năng</h1>
        <p>Tài khoản khách hàng gồm họ tên, tên đăng nhập, Gmail/email, số điện thoại và địa chỉ để cơ sở xử lý đơn nhanh hơn.</p>
        <div class="customer-auth-pills">
            <span>Hồ sơ đầy đủ</span>
            <span>Đặt in nhanh</span>
            <span>Quản lý đơn</span>
        </div>
    </div>

    <div class="customer-auth-card">
        <div class="customer-auth-card-head">
            <span class="customer-kicker">Thông tin khách hàng</span>
            <h2>Đăng ký</h2>
            <p>Tạo tài khoản riêng cho khu khách hàng của @branchName.</p>
        </div>

        @if (googleConfigured)
        {
            <form action="@externalLoginUrl" method="post" class="customer-google-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@dashboardUrl" />
                <button class="customer-google-button" type="submit">
                    <span>G</span>
                    Đăng ký nhanh bằng Google/Gmail
                </button>
            </form>

            <div class="customer-auth-divider"><span>hoặc đăng ký bằng form</span></div>
        }

        <form action="@formAction" method="post" class="customer-auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="customer-auth-form-grid">
                <div>
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="vd: sinhvien01" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email" placeholder="email@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="Số điện thoại liên hệ" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="customer-auth-form-full">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" autocomplete="street-address" placeholder="Địa chỉ nhận tài liệu nếu cần" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Ít nhất 8 ký tự" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button class="customer-primary-action w-100" type="submit">Tạo tài khoản khách hàng</button>
        </form>

        <a class="customer-auth-alt" href="@loginUrl">Đã có tài khoản? Đăng nhập khách hàng</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}