:root {
    --font-base: "Be Vietnam Pro", "Segoe UI", Tahoma, sans-serif;
    --font-heading: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;

    --bg-base: #f2f6fc;
    --bg-tint: #edf4ff;
    --surface: #ffffff;
    --surface-soft: #f8fbff;

    --text-main: #13243d;
    --text-muted: #5f718a;
    --brand: #0b79a8;
    --brand-strong: #075c84;
    --brand-soft: #d8f1ff;
    --accent: #f59e0b;
    --accent-soft: #fff2d8;
    --danger: #dc2626;
    --success: #15803d;

    --border: #d8e4f2;
    --shadow-sm: 0 14px 30px -24px rgba(19, 42, 82, 0.45);
    --shadow-md: 0 24px 45px -28px rgba(13, 35, 71, 0.45);
}

html,
body {
    min-height: 100%;
}

body {
    margin: 0;
    color: var(--text-main);
    font-family: var(--font-base);
    background:
        radial-gradient(circle at 0 0, rgba(11, 121, 168, 0.12), transparent 32%),
        radial-gradient(circle at 100% 0, rgba(245, 158, 11, 0.12), transparent 26%),
        linear-gradient(180deg, #f8fbff 0%, var(--bg-base) 55%, #eaf1fb 100%);
}

h1,
h2,
h3,
h4,
h5,
h6,
.navbar-brand,
.card-title,
.page-hero h1,
.page-hero h2,
.page-hero h3 {
    font-family: var(--font-heading);
    letter-spacing: 0;
}

a {
    color: var(--brand);
}

a:hover {
    color: var(--brand-strong);
}

.text-muted {
    color: var(--text-muted) !important;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 1050;
}

.site-ribbon {
    background: linear-gradient(105deg, #0d3f5f, #175a82);
    color: rgba(240, 247, 255, 0.9);
    border-bottom: 1px solid rgba(209, 233, 250, 0.22);
    font-size: 0.82rem;
    padding: 0.45rem 0;
}

.site-ribbon .ribbon-highlight {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.14rem 0.62rem;
    background: rgba(255, 255, 255, 0.16);
    font-weight: 600;
}

.site-navbar {
    background: linear-gradient(95deg, rgba(9, 48, 79, 0.95), rgba(15, 86, 130, 0.92));
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(218, 235, 250, 0.14);
    box-shadow: 0 16px 34px -28px rgba(4, 27, 51, 0.68);
}

.site-navbar .navbar-brand {
    font-size: 1.07rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.56rem;
}

.brand-dot {
    width: 0.74rem;
    height: 0.74rem;
    border-radius: 999px;
    display: inline-block;
    background: linear-gradient(145deg, #6ee7ff, #f59e0b);
    box-shadow: 0 0 0 4px rgba(127, 226, 255, 0.2);
}

.site-navbar .nav-link {
    color: rgba(238, 246, 255, 0.9);
    border-radius: 0.72rem;
    padding: 0.44rem 0.74rem;
    transition: all 0.2s ease;
    font-weight: 500;
}

.site-navbar .nav-link:hover,
.site-navbar .nav-link.active,
.site-navbar .dropdown-item.active {
    color: #ffffff;
    background: rgba(244, 250, 255, 0.18);
}

.site-navbar .btn-link.nav-link {
    border: 0;
}

.user-nav-link {
    background: rgba(244, 250, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.dropdown-menu {
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    box-shadow: var(--shadow-sm);
}

.dropdown-item {
    border-radius: 0.62rem;
    margin: 0.08rem 0.35rem;
    width: auto;
    transition: all 0.2s ease;
}

.dropdown-item:hover {
    background: #eef7ff;
}

.site-main {
    min-height: calc(100vh - 176px);
    padding-top: 1.65rem;
    padding-bottom: 2.3rem;
}

.site-footer {
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(3px);
    color: var(--text-muted);
    font-size: 0.92rem;
}

.card {
    border: 1px solid var(--border);
    border-radius: 1.06rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.card-header {
    background: linear-gradient(180deg, #fcfeff, #f3f8ff);
    border-bottom: 1px solid var(--border);
    font-weight: 600;
}

.table-responsive {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.table {
    margin-bottom: 0;
    --bs-table-bg: transparent;
}

.table thead th {
    white-space: nowrap;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #4f6684;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    background: linear-gradient(180deg, #fcfeff, #f4f8ff);
}

.table th,
.table td {
    padding: 0.78rem 0.88rem;
    vertical-align: middle;
    border-color: #e6edf7;
}

.table tbody tr:hover {
    --bs-table-accent-bg: #f7fbff;
}

.badge {
    font-weight: 600;
    border-radius: 999px;
    padding: 0.42rem 0.62rem;
    letter-spacing: 0.01em;
}

.badge.bg-secondary {
    background: #64748b !important;
}

.badge.bg-success {
    background: #16a34a !important;
}

.badge.bg-warning {
    background: #f59e0b !important;
}

.badge.bg-danger {
    background: #dc2626 !important;
}

.badge.bg-primary {
    background: #0284c7 !important;
}

.badge.bg-info {
    background: #38bdf8 !important;
}

.btn {
    border-radius: 0.78rem;
    font-weight: 600;
    transition: all 0.2s ease;
}

.btn-primary {
    background: linear-gradient(138deg, var(--brand), #2ea6d8);
    border-color: var(--brand);
}

.btn-primary:hover {
    background: linear-gradient(138deg, #07658f, #1994c8);
    border-color: #07658f;
    transform: translateY(-1px);
}

.btn-outline-secondary {
    border-color: #96adc5;
    color: #25405f;
}

.btn-outline-secondary:hover {
    background: #eef5fd;
    color: #1e3856;
    border-color: #8da6be;
}

.btn-warning {
    background: linear-gradient(140deg, #f59e0b, #facc15);
    border-color: #f59e0b;
    color: #2b2208;
}

.btn-warning:hover {
    background: linear-gradient(140deg, #e3920a, #f7c717);
    border-color: #d88407;
    color: #2b2208;
}

.form-label {
    font-weight: 600;
    font-size: 0.92rem;
}

.form-control,
.form-select {
    border-radius: 0.76rem;
    border: 1px solid #c7d8eb;
    background-color: #fff;
}

.form-control::placeholder {
    color: #8ca0b8;
}

.form-control:focus,
.form-select:focus {
    border-color: #56b6de;
    box-shadow: 0 0 0 0.2rem rgba(11, 121, 168, 0.15);
}

.form-check-input:checked {
    background-color: var(--brand);
    border-color: var(--brand);
}

.form-control[readonly] {
    background: #f7fafd;
}

.alert {
    border: 0;
    border-radius: 0.9rem;
    box-shadow: var(--shadow-sm);
}

.alert-success {
    background: #dcfce7;
    color: #14532d;
}

.alert-danger {
    background: #fee2e2;
    color: #7f1d1d;
}

.page-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid #d3e3f7;
    background: linear-gradient(130deg, #ffffff 8%, #ecf5ff 58%, #fff5e2 100%);
    padding: 1.8rem;
    box-shadow: var(--shadow-md);
    animation: slide-up 0.45s ease both;
}

.page-hero::before {
    content: "";
    position: absolute;
    left: -66px;
    bottom: -96px;
    width: 220px;
    height: 220px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(11, 121, 168, 0.22), rgba(11, 121, 168, 0));
    pointer-events: none;
}

.page-hero::after {
    content: "";
    position: absolute;
    right: -60px;
    top: -52px;
    width: 190px;
    height: 190px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.26), rgba(245, 158, 11, 0));
    pointer-events: none;
}

.page-hero > * {
    position: relative;
    z-index: 1;
}

.page-hero p {
    color: var(--text-muted);
    max-width: 70ch;
}

.hero-panel {
    border: 1px solid #d4e2f4;
    border-radius: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.84);
}

.hero-panel .hero-item + .hero-item {
    margin-top: 0.55rem;
    padding-top: 0.55rem;
    border-top: 1px dashed #dbe6f5;
}

.feature-card {
    height: 100%;
}

.feature-icon {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #094f70;
    background: linear-gradient(145deg, #d6eeff, #ffe7bd);
    margin-bottom: 0.8rem;
}

.stat-card {
    border: 1px solid #d5e4f6;
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
    box-shadow: var(--shadow-sm);
    height: 100%;
}

.stat-label {
    font-size: 0.88rem;
    color: var(--text-muted);
}

.stat-value {
    font-family: var(--font-heading);
    font-size: 1.56rem;
    margin-top: 0.12rem;
}

.info-chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
}

.info-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.36rem 0.75rem;
    border: 1px solid #d0e0f3;
    background: #f7fbff;
    color: #294866;
    font-size: 0.83rem;
    font-weight: 500;
}

.section-title {
    margin-bottom: 0.35rem;
    font-weight: 700;
}

.section-subtitle {
    margin-bottom: 1rem;
    color: var(--text-muted);
}

.empty-state {
    text-align: center;
    border: 1px dashed #cadbf1;
    border-radius: 0.9rem;
    background: #f8fbff;
    padding: 1.15rem;
    color: #5f7691;
}

/* Home */
.home-hero {
    padding-top: 2rem;
    padding-bottom: 2rem;
}

.home-title {
    font-size: 2.2rem;
    margin-bottom: 0.85rem;
}

/* Landing */
.landing-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: 1.25rem;
    align-items: stretch;
    border: 1px solid #cddfed;
    border-radius: 0.5rem;
    background:
        linear-gradient(125deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 248, 255, 0.95) 48%, rgba(255, 247, 231, 0.95) 100%),
        linear-gradient(90deg, #e2f2f8, #f8ecd5);
    padding: 1.35rem;
    box-shadow: var(--shadow-md);
}

.landing-copy {
    min-width: 0;
    padding: 0.45rem 0.2rem;
}

.landing-kicker,
.portal-eyebrow,
.strip-label {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border-radius: 999px;
    border: 1px solid #cae1ef;
    background: #f5fbff;
    color: #315d74;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.62rem;
}

.landing-copy h1 {
    margin: 0.78rem 0 0.7rem;
    font-family: var(--font-heading);
    font-size: 2.65rem;
    line-height: 1.05;
    letter-spacing: 0;
}

.landing-copy p {
    max-width: 64ch;
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 1rem;
}

.landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.2rem;
}

.landing-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.72rem;
}

.landing-metrics div {
    min-width: 0;
    border: 1px solid #d5e5f1;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.84);
    padding: 0.78rem;
}

.landing-metrics strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.36rem;
    line-height: 1;
}

.landing-metrics span {
    display: block;
    margin-top: 0.28rem;
    color: var(--text-muted);
    font-size: 0.82rem;
}

.landing-visual {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    border: 1px solid #bfd7e6;
    border-radius: 0.5rem;
    background: #102f3d;
    color: #ecf7fb;
    padding: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.visual-topline,
.visual-ticket,
.branch-card-header,
.branch-meta,
.branch-actions,
.section-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.visual-topline {
    justify-content: space-between;
    color: rgba(236, 247, 251, 0.82);
    font-size: 0.84rem;
}

.status-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: #46d191;
    box-shadow: 0 0 0 4px rgba(70, 209, 145, 0.16);
}

.print-board {
    display: grid;
    gap: 0.72rem;
}

.print-column {
    border: 1px solid rgba(210, 235, 244, 0.18);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.07);
    padding: 0.88rem;
}

.print-column.active {
    background: #f8fafc;
    color: #173646;
}

.print-column span,
.visual-ticket span {
    display: block;
    color: inherit;
    opacity: 0.72;
    font-size: 0.78rem;
    font-weight: 600;
}

.print-column strong {
    display: block;
    margin: 0.18rem 0;
    font-size: 1rem;
}

.print-column small {
    color: inherit;
    opacity: 0.78;
}

.visual-ticket {
    justify-content: space-between;
    margin-top: auto;
    border-radius: 0.5rem;
    background: #fffbeb;
    color: #3a3422;
    padding: 0.82rem;
}

.visual-ticket strong {
    display: block;
    font-family: var(--font-heading);
}

.portal-section,
.branch-section,
.operations-strip {
    scroll-margin-top: 8rem;
}

.section-heading {
    justify-content: space-between;
    margin-bottom: 0.95rem;
}

.section-heading h2 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
}

.section-heading p {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
}

.portal-grid,
.branch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
}

.portal-card,
.branch-card {
    min-width: 0;
    height: 100%;
    border: 1px solid #d3e4f0;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.9);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
}

.portal-card {
    display: flex;
    flex-direction: column;
}

.portal-card h3,
.branch-card h3 {
    margin: 0.72rem 0 0.45rem;
    font-size: 1.08rem;
    font-weight: 800;
}

.portal-card p,
.branch-card p {
    color: var(--text-muted);
}

.portal-card p {
    flex: 1;
}

.portal-customer {
    border-top: 4px solid #0b79a8;
}

.portal-shop {
    border-top: 4px solid #2f9e73;
}

.portal-admin {
    border-top: 4px solid #b45309;
}

.branch-card-header {
    justify-content: space-between;
    color: #5b7187;
    font-size: 0.83rem;
    font-weight: 700;
}

.branch-pin {
    width: 0.82rem;
    height: 0.82rem;
    border-radius: 0.24rem;
    background: #0b79a8;
    transform: rotate(45deg);
}

.branch-accent-amber .branch-pin {
    background: #d97706;
}

.branch-accent-rose .branch-pin {
    background: #be5166;
}

.branch-meta {
    flex-wrap: wrap;
    margin: 0.85rem 0;
}

.branch-meta span {
    border: 1px solid #dce7f1;
    border-radius: 999px;
    background: #f8fbff;
    padding: 0.28rem 0.58rem;
    color: #415a71;
    font-size: 0.78rem;
    font-weight: 600;
}

.branch-actions {
    flex-wrap: wrap;
}

.operations-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    border: 1px solid #d2e4ef;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 0.95rem;
    box-shadow: var(--shadow-sm);
}

.operations-strip > div {
    min-width: 0;
}

.operations-strip strong {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.98rem;
}

.login-branch {
    width: fit-content;
    border: 1px solid #d3e5f1;
    border-radius: 999px;
    background: #f7fbff;
    padding: 0.36rem 0.7rem;
    color: #37566c;
}

.login-route-grid {
    display: grid;
    gap: 0.6rem;
}

.login-route-grid a {
    display: block;
    border: 1px solid #d6e5f1;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.82);
    padding: 0.72rem;
    text-decoration: none;
}

.login-route-grid span {
    display: block;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
}

.login-route-grid strong {
    display: block;
    color: var(--text-main);
}

/* Role workspaces */
.dashboard-kicker,
.panel-eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border: 1px solid #cfe1ef;
    border-radius: 999px;
    background: #f7fbff;
    color: #315d74;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.25rem 0.58rem;
}

.workspace-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    gap: 1rem;
    align-items: stretch;
}

.workspace-panel {
    min-width: 0;
    border: 1px solid #d4e4f0;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
}

.workspace-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
}

.workspace-panel h4 {
    margin: 0.48rem 0 0.2rem;
    font-size: 1.05rem;
    font-weight: 800;
}

.workspace-panel p {
    color: var(--text-muted);
}

.quick-action-grid,
.queue-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
}

.admin-board {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.quick-action-card,
.queue-lane {
    display: block;
    min-width: 0;
    border: 1px solid #d8e7f2;
    border-radius: 0.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    color: var(--text-main);
    padding: 0.82rem;
    text-decoration: none;
    transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
}

.quick-action-card:hover,
.queue-lane:hover {
    color: var(--text-main);
    border-color: #a9cfdf;
    box-shadow: 0 16px 30px -26px rgba(9, 48, 79, 0.5);
    transform: translateY(-1px);
}

.quick-action-card span,
.queue-lane span {
    display: block;
    color: #527087;
    font-size: 0.76rem;
    font-weight: 800;
}

.quick-action-card strong,
.queue-lane strong {
    display: block;
    margin: 0.18rem 0;
    font-size: 1rem;
}

.queue-lane strong {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    line-height: 1.05;
}

.quick-action-card small,
.queue-lane small {
    display: block;
    color: var(--text-muted);
}

.queue-lane-hot {
    border-color: #f5d48d;
    background: linear-gradient(180deg, #fffdf7 0%, #fff6dc 100%);
}

.customer-branch-panel {
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(241, 249, 255, 0.96)),
        linear-gradient(90deg, #e5f5fb, #fff4df);
}

.branch-mini-list {
    display: grid;
    gap: 0.46rem;
    margin: 0.85rem 0 1rem;
}

.branch-mini-list span {
    border: 1px solid #d9e8f2;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 0.55rem 0.65rem;
    color: #37556c;
    font-weight: 700;
}

.quick-action-stack {
    display: grid;
    gap: 0.58rem;
    margin-top: 0.8rem;
}

.quick-action-stack a {
    border: 1px solid #d9e8f2;
    border-radius: 0.5rem;
    background: #f8fbff;
    color: #24475f;
    padding: 0.68rem 0.75rem;
    text-decoration: none;
    font-weight: 700;
}

.quick-action-stack a:hover {
    background: #eef8ff;
    color: #173646;
}

.sidebar-card {
    border: 1px solid #d7e6f2;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 0.88rem;
    box-shadow: var(--shadow-sm);
}

.sidebar-card span,
.sidebar-card small {
    display: block;
    color: var(--text-muted);
}

.sidebar-card span {
    font-size: 0.76rem;
    font-weight: 800;
}

.sidebar-card strong {
    display: block;
    margin: 0.18rem 0;
}

.role-mark {
    display: inline-block;
    width: 0.82rem;
    height: 0.82rem;
    border-radius: 0.22rem;
    margin-right: 0.45rem;
    transform: rotate(45deg);
    background: #ffd166;
}

.role-mark-shop {
    background: #70d6a3;
}

.role-mark-admin {
    background: #ffd166;
}

.home-lead {
    font-size: 1.03rem;
    max-width: 62ch;
}

.home-kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
}

.home-kpi {
    border: 1px solid #d4e3f6;
    border-radius: 0.92rem;
    background: rgba(255, 255, 255, 0.9);
    padding: 0.86rem;
}

.home-kpi-value {
    font-family: var(--font-heading);
    font-size: 1.28rem;
    margin-bottom: 0.2rem;
}

.home-kpi-label {
    color: var(--text-muted);
    font-size: 0.84rem;
}

.home-process-card {
    border: 1px solid #d8e5f6;
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    box-shadow: var(--shadow-sm);
    height: 100%;
}

.process-number {
    width: 1.95rem;
    height: 1.95rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.62rem;
    font-weight: 700;
    font-size: 0.85rem;
    background: linear-gradient(145deg, #d9f1ff, #ffe8c3);
    color: #134365;
}

.audience-card {
    border: 1px solid #d3e2f5;
    border-radius: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow-sm);
    height: 100%;
}

.audience-card h5 {
    margin-bottom: 0.4rem;
}

/* Print order experience */
.print-workspace {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(290px, 1fr);
    gap: 1rem;
    align-items: start;
}

.print-form-shell {
    border: 1px solid #d6e4f5;
    border-radius: 1.1rem;
    background: var(--surface);
    padding: 1.15rem;
    box-shadow: var(--shadow-md);
}

.form-step {
    border: 1px solid #dce8f6;
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.form-step + .form-step {
    margin-top: 0.9rem;
}

.step-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.25rem;
    font-weight: 700;
}

.step-label .step-dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    color: #fff;
    background: linear-gradient(135deg, #0b79a8, #26a4d7);
}

.step-description {
    margin-bottom: 0.9rem;
    color: var(--text-muted);
    font-size: 0.92rem;
}

.quick-preset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.6rem;
}

.quick-preset {
    border: 1px solid #cfe0f3;
    border-radius: 0.85rem;
    background: #f7fbff;
    color: #224768;
    text-align: left;
    padding: 0.65rem 0.72rem;
    transition: all 0.2s ease;
    cursor: pointer;
}

.quick-preset .preset-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
}

.quick-preset .preset-meta {
    display: block;
    margin-top: 0.12rem;
    font-size: 0.79rem;
    color: #5e7893;
}

.quick-preset:hover,
.quick-preset.is-active {
    border-color: #53add6;
    background: #e8f6ff;
    box-shadow: 0 10px 20px -16px rgba(11, 121, 168, 0.5);
}

.form-hint {
    display: block;
    margin-top: 0.25rem;
    color: #5e7893;
    font-size: 0.8rem;
}

.delivery-address-wrap {
    transition: all 0.25s ease;
}

.delivery-address-wrap.is-hidden {
    opacity: 0.45;
}

.print-summary-card {
    position: sticky;
    top: 110px;
    border: 1px solid #d5e3f5;
    border-radius: 1.06rem;
    background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
    box-shadow: var(--shadow-md);
    padding: 1rem;
}

.print-summary-title {
    margin-bottom: 0.16rem;
    font-weight: 700;
}

.print-summary-subtitle {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-bottom: 0.9rem;
}

.summary-line {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.48rem 0;
    border-bottom: 1px dashed #d4e2f3;
    font-size: 0.9rem;
}

.summary-line:last-child {
    border-bottom: 0;
}

.summary-value {
    font-weight: 600;
    text-align: right;
}

.summary-note {
    margin-top: 0.92rem;
    border: 1px solid #d6e4f5;
    border-radius: 0.85rem;
    padding: 0.72rem;
    background: rgba(255, 255, 255, 0.85);
    font-size: 0.84rem;
    color: #46607d;
}

.summary-note strong {
    color: #173a61;
}

/* Admin / Shop */
.admin-topbar {
    background: linear-gradient(95deg, #0f2f4a, #1f5e86);
    border-bottom: 1px solid rgba(217, 232, 246, 0.2);
    box-shadow: 0 12px 25px -20px rgba(15, 35, 58, 0.6);
}

.admin-title {
    color: #eef7ff;
    font-weight: 700;
}

.admin-shell {
    padding-top: 1rem;
}

.admin-sidebar {
    position: sticky;
    top: 84px;
}

.admin-menu {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.88);
    padding: 0.6rem;
    box-shadow: var(--shadow-sm);
}

.admin-menu .list-group-item {
    border: 1px solid transparent;
    border-radius: 0.72rem;
    margin-bottom: 0.26rem;
    font-weight: 500;
    color: #264668;
    padding: 0.57rem 0.68rem;
}

.admin-menu .list-group-item:hover {
    background: #f2f8ff;
    border-color: #d6e4f4;
    color: #1d3b5b;
}

.admin-menu .list-group-item.active {
    border-color: #0b79a8;
    background: linear-gradient(145deg, #0b79a8, #2ea6d8);
    color: #fff;
}

.status-badge {
    font-size: 0.8rem;
}

/* Motion */
@keyframes slide-up {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 1199.98px) {
    .landing-hero {
        grid-template-columns: 1fr;
    }

    .workspace-grid {
        grid-template-columns: 1fr;
    }

    .print-workspace {
        grid-template-columns: 1fr;
    }

    .print-summary-card {
        position: static;
    }
}

@media (max-width: 991.98px) {
    .site-main {
        padding-top: 1.2rem;
    }

    .landing-copy h1 {
        font-size: 2.22rem;
    }

    .portal-grid,
    .branch-grid,
    .operations-strip,
    .admin-board {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .page-hero {
        padding: 1.35rem;
    }

    .admin-sidebar {
        position: static;
    }

    .site-ribbon {
        display: none;
    }

    .home-kpi-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 767.98px) {
    .landing-hero,
    .landing-visual,
    .portal-card,
    .branch-card,
    .operations-strip {
        padding: 0.9rem;
    }

    .landing-copy h1 {
        font-size: 1.9rem;
    }

    .landing-actions .btn,
    .branch-actions .btn {
        width: 100%;
    }

    .landing-metrics {
        grid-template-columns: 1fr;
    }

    .quick-action-grid,
    .queue-board {
        grid-template-columns: 1fr;
    }

    .table th,
    .table td {
        padding: 0.62rem 0.65rem;
    }

    .site-footer {
        font-size: 0.84rem;
    }

    .print-form-shell {
        padding: 0.85rem;
    }

    .form-step {
        padding: 0.82rem;
    }

    .quick-preset-grid {
        grid-template-columns: 1fr;
    }
}

/* === ChatGPT Portfolio Home Start === */
/* Portfolio homepage - WebPhotocopy */
.portfolio-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: 1.5rem;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid rgba(188, 215, 235, 0.9);
    border-radius: 1.45rem;
    padding: clamp(1.35rem, 3vw, 2.5rem);
    background:
        radial-gradient(circle at 12% 10%, rgba(110, 231, 255, 0.26), transparent 31%),
        radial-gradient(circle at 92% 12%, rgba(245, 158, 11, 0.24), transparent 32%),
        linear-gradient(135deg, #0b2f4a 0%, #0f5f83 54%, #f5a623 150%);
    color: #f8fbff;
    box-shadow: 0 24px 70px -38px rgba(3, 22, 39, 0.86);
}

.portfolio-hero::after {
    content: "";
    position: absolute;
    inset: auto -80px -120px auto;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    pointer-events: none;
}

.portfolio-hero__content,
.portfolio-hero__preview {
    position: relative;
    z-index: 1;
}

.portfolio-kicker {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(126, 190, 225, 0.55);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    color: inherit;
    padding: 0.38rem 0.78rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.02em;
}

.portfolio-hero h1 {
    max-width: 14ch;
    margin: 0.9rem 0 0.85rem;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 6vw, 4.65rem);
    line-height: 0.97;
    letter-spacing: -0.05em;
}

.portfolio-lead {
    max-width: 68ch;
    color: rgba(248, 251, 255, 0.86);
    font-size: clamp(1rem, 1.8vw, 1.14rem);
    line-height: 1.75;
}

.portfolio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 1.4rem;
}

.portfolio-actions .btn,
.portfolio-cta .btn {
    border-radius: 999px;
    padding-inline: 1.15rem;
}

.portfolio-actions .btn-light {
    color: #0b2f4a;
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.92);
}

.portfolio-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.78rem;
}

.portfolio-proof div {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.95rem;
    backdrop-filter: blur(10px);
}

.portfolio-proof strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.45rem;
    line-height: 1;
}

.portfolio-proof span {
    display: block;
    margin-top: 0.35rem;
    color: rgba(248, 251, 255, 0.74);
    font-size: 0.86rem;
}

.portfolio-hero__preview {
    display: flex;
    align-items: center;
}

.preview-window {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.14);
    padding: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 20px 60px -42px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(14px);
}

.preview-window__bar {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    margin-bottom: 0.9rem;
    color: rgba(255, 255, 255, 0.74);
}

.preview-window__bar span {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
}

.preview-window__bar strong {
    margin-left: auto;
    font-size: 0.82rem;
}

.preview-status-card,
.preview-grid > div {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 1rem;
    background: rgba(9, 35, 54, 0.52);
    padding: 0.95rem;
}

.preview-status-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
}

.preview-status-card--active {
    background: rgba(255, 255, 255, 0.93);
    color: #0b2f4a;
}

.preview-status-card small,
.preview-grid small {
    display: block;
    margin-bottom: 0.22rem;
    color: inherit;
    opacity: 0.68;
}

.preview-status-card span,
.preview-grid span {
    color: inherit;
    opacity: 0.75;
    font-size: 0.86rem;
}

.preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0.8rem 0;
}

.preview-grid strong {
    display: block;
    margin-bottom: 0.24rem;
}

.portfolio-section {
    margin-top: 1.4rem;
}

.portfolio-section--soft {
    border: 1px solid #d7e5f2;
    border-radius: 1.35rem;
    background: linear-gradient(180deg, #ffffff 0%, #f3f8ff 100%);
    padding: clamp(1rem, 2.4vw, 1.45rem);
    box-shadow: var(--shadow-sm);
}

.portfolio-section__heading {
    max-width: 850px;
    margin-bottom: 1rem;
}

.portfolio-section__heading .portfolio-kicker,
.portfolio-cta .portfolio-kicker,
.portfolio-process .portfolio-kicker {
    background: #eef8ff;
    color: #0b5f82;
    border-color: #c7e3f3;
}

.portfolio-section__heading h2,
.portfolio-process h2,
.portfolio-cta h2 {
    margin: 0.7rem 0 0.45rem;
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    letter-spacing: -0.03em;
}

.portfolio-section__heading p,
.portfolio-process p,
.portfolio-cta p {
    color: var(--text-muted);
    margin-bottom: 0;
}

.portfolio-section__heading--split {
    max-width: none;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
}

.portfolio-audience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.portfolio-audience-card,
.portfolio-module-card,
.portfolio-process,
.portfolio-cta {
    border: 1px solid #d5e4f2;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-sm);
}

.portfolio-audience-card {
    padding: 1.2rem;
}

.portfolio-audience-card--shop {
    background: linear-gradient(180deg, #ffffff 0%, #fff8eb 100%);
}

.portfolio-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #d7f0ff, #fff0cc);
    color: #0b5f82;
    font-weight: 800;
    margin-bottom: 0.85rem;
}

.portfolio-audience-card h3,
.portfolio-module-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.portfolio-audience-card p,
.portfolio-module-card p {
    color: var(--text-muted);
}

.portfolio-audience-card ul {
    display: grid;
    gap: 0.6rem;
    padding-left: 0;
    margin: 1rem 0 1.1rem;
    list-style: none;
}

.portfolio-audience-card li {
    position: relative;
    padding-left: 1.55rem;
    color: #304964;
}

.portfolio-audience-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: #0b79a8;
    font-weight: 800;
}

.portfolio-module-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
}

.portfolio-module-card {
    padding: 1rem;
}

.portfolio-module-card span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.8rem;
    background: #0b5f82;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 0.9rem;
}

.portfolio-process {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.2rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    background: linear-gradient(135deg, #ffffff, #f5fbff);
}

.portfolio-steps {
    display: grid;
    gap: 0.72rem;
}

.portfolio-steps div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: center;
    border: 1px solid #d9e8f4;
    border-radius: 1rem;
    background: #fff;
    padding: 0.82rem;
}

.portfolio-steps strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: #fff3d8;
    color: #8a5604;
}

.portfolio-steps span {
    color: #304964;
}

.portfolio-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.4rem;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    background:
        radial-gradient(circle at 12% 20%, rgba(11, 121, 168, 0.16), transparent 28%),
        linear-gradient(135deg, #ffffff 0%, #fff7e7 100%);
}

.portfolio-cta > div:first-child {
    max-width: 760px;
}

.portfolio-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.7rem;
}

@media (max-width: 992px) {
    .portfolio-hero,
    .portfolio-process {
        grid-template-columns: 1fr;
    }

    .portfolio-hero h1 {
        max-width: 16ch;
    }

    .portfolio-module-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .portfolio-section__heading--split,
    .portfolio-cta {
        align-items: flex-start;
        flex-direction: column;
    }

    .portfolio-cta__actions {
        justify-content: flex-start;
    }
}

@media (max-width: 768px) {
    .portfolio-audience-grid,
    .portfolio-proof,
    .preview-grid {
        grid-template-columns: 1fr;
    }

    .portfolio-hero {
        border-radius: 1.1rem;
    }

    .portfolio-actions .btn,
    .portfolio-cta .btn {
        width: 100%;
    }
}

@media (max-width: 576px) {
    .portfolio-module-grid {
        grid-template-columns: 1fr;
    }

    .portfolio-hero {
        padding: 1rem;
    }

    .preview-status-card {
        align-items: flex-start;
        flex-direction: column;
    }
}
/* === ChatGPT Portfolio Home End === */

/* === ChatGPT Photocopy Home Refresh Start === */
:root {
    --pc-blue: #0b6ff4;
    --pc-blue-strong: #0759d6;
    --pc-ink: #0b1647;
    --pc-text: #25345f;
    --pc-muted: #5f6d8b;
    --pc-border: #dce6f5;
    --pc-soft: #f6faff;
    --pc-green: #11a97d;
    --pc-shadow: 0 22px 60px -40px rgba(10, 38, 89, 0.35);
}

body {
    color: var(--pc-text);
    background: #ffffff;
}

.pc-site-header {
    position: sticky;
    top: 0;
    z-index: 1050;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(216, 227, 244, 0.95);
    backdrop-filter: blur(14px);
}

.site-ribbon {
    display: none;
}

.pc-navbar,
.site-navbar {
    min-height: 72px;
    background: transparent;
    box-shadow: none;
    border: 0;
}

.pc-brand,
.site-navbar .navbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--pc-ink);
    font-family: var(--font-heading);
    font-size: 1.42rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
}

.pc-brand span span,
.site-navbar .navbar-brand span:last-child span {
    color: var(--pc-blue);
}

.pc-brand-icon {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--pc-blue);
    color: #ffffff;
    font-size: 0.9rem;
    line-height: 1;
    box-shadow: 0 10px 24px -14px rgba(11, 111, 244, 0.9);
}

.brand-dot {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--pc-blue);
    box-shadow: 0 10px 24px -14px rgba(11, 111, 244, 0.9);
}

.pc-navbar .navbar-toggler {
    border: 1px solid var(--pc-border);
}

.pc-navbar .navbar-toggler-icon {
    filter: invert(1);
}

.pc-nav-links {
    gap: 1.15rem;
}

.pc-nav-links .nav-link,
.pc-nav-actions .nav-link,
.site-navbar .nav-link {
    position: relative;
    color: #111b4f;
    border-radius: 0;
    padding: 0.5rem 0.1rem;
    font-size: 0.95rem;
    font-weight: 700;
    background: transparent;
}

.pc-nav-links .nav-link::after,
.site-navbar .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.8rem;
    height: 3px;
    border-radius: 999px;
    background: transparent;
}

.pc-nav-links .nav-link:hover,
.pc-nav-links .nav-link.active,
.pc-nav-actions .nav-link:hover,
.pc-nav-actions .nav-link.active,
.site-navbar .nav-link:hover,
.site-navbar .nav-link.active {
    color: var(--pc-blue);
    background: transparent;
}

.pc-nav-links .nav-link.active::after,
.site-navbar .nav-link.active::after {
    background: var(--pc-blue);
}

.pc-nav-btn,
.pc-btn,
.btn-primary {
    border: 0;
    border-radius: 7px;
    background: var(--pc-blue);
    color: #ffffff;
    box-shadow: 0 16px 30px -18px rgba(11, 111, 244, 0.8);
}

.pc-nav-btn {
    padding: 0.55rem 1.35rem;
}

.pc-btn {
    min-width: 148px;
    padding: 0.8rem 1.25rem;
    font-weight: 800;
}

.pc-btn:hover,
.pc-nav-btn:hover,
.btn-primary:hover {
    background: var(--pc-blue-strong);
    color: #ffffff;
    transform: translateY(-1px);
}

.pc-btn--outline,
.btn-outline-primary {
    border: 1px solid #bfd0ea;
    background: #ffffff;
    color: var(--pc-blue);
    box-shadow: none;
}

.pc-btn--outline:hover,
.btn-outline-primary:hover {
    border-color: var(--pc-blue);
    background: #f4f8ff;
    color: var(--pc-blue-strong);
}

.btn-success {
    border: 0;
    border-radius: 7px;
    background: var(--pc-green);
    box-shadow: 0 16px 30px -18px rgba(17, 169, 125, 0.8);
}

.btn-success:hover {
    background: #0d926c;
}

.user-nav-link {
    border: 1px solid var(--pc-border);
    border-radius: 999px !important;
    background: #f8fbff !important;
}

.pc-site-main {
    min-height: calc(100vh - 260px);
    padding: 0;
    background: #ffffff;
}

.pc-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(560px, 1.1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
    overflow: hidden;
    min-height: 500px;
    padding: 2.3rem max(2rem, calc((100vw - 1320px) / 2 + 0.75rem));
    background:
        radial-gradient(circle at 48% 20%, rgba(11, 111, 244, 0.08), transparent 14%),
        radial-gradient(circle at 96% 45%, rgba(11, 111, 244, 0.07), transparent 22%),
        linear-gradient(180deg, #f7fbff 0%, #eef6ff 100%);
}

.pc-hero__decor {
    position: absolute;
    border-radius: 999px;
    background: rgba(11, 111, 244, 0.06);
    pointer-events: none;
}

.pc-hero__decor--one {
    width: 68px;
    height: 68px;
    left: 45%;
    top: 24%;
}

.pc-hero__decor--two {
    width: 280px;
    height: 160px;
    right: 7%;
    top: 26%;
}

.pc-hero__copy {
    position: relative;
    z-index: 1;
}

.pc-eyebrow {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: #ddf8ee;
    color: #0d9272;
    padding: 0.38rem 0.82rem;
    font-size: 0.86rem;
    font-weight: 800;
}

.pc-hero h1 {
    max-width: 720px;
    margin: 0;
    color: var(--pc-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 4.1vw, 4rem);
    line-height: 1.12;
    letter-spacing: 0.015em;
}

.pc-hero p {
    max-width: 680px;
    margin: 1.2rem 0 1.5rem;
    color: #27365f;
    font-size: 1.06rem;
    line-height: 1.75;
}

.pc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.pc-hero__visual {
    position: relative;
    z-index: 1;
    min-width: 0;
}

.pc-dashboard-card {
    overflow: hidden;
    border: 1px solid #e2eaf7;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--pc-shadow);
}

.pc-dashboard-card__top {
    display: grid;
    grid-template-columns: 220px minmax(180px, 1fr) 54px;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.35rem;
    border-bottom: 1px solid #edf2fa;
}

.pc-logo-mini {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--pc-ink);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
}

.pc-logo-mini span {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--pc-blue);
}

.pc-search {
    border-radius: 8px;
    background: #f4f7fb;
    color: #8190aa;
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
}

.pc-avatar {
    width: 34px;
    height: 34px;
    justify-self: end;
    border-radius: 50%;
    background: linear-gradient(140deg, #ffd38b, #b8d6ff);
}

.pc-dashboard-card__body {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    min-height: 290px;
}

.pc-sidebar-demo {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1rem;
    border-right: 1px solid #edf2fa;
}

.pc-sidebar-demo span {
    border-radius: 8px;
    color: #1d2d5b;
    padding: 0.6rem 0.75rem;
    font-size: 0.86rem;
    font-weight: 800;
}

.pc-sidebar-demo .active {
    color: var(--pc-blue);
    background: #eaf3ff;
}

.pc-board-demo {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(210px, 0.85fr);
    gap: 1rem;
    padding: 1rem;
}

.pc-board-panel {
    border: 1px solid #e2e9f4;
    border-radius: 10px;
    background: #ffffff;
    padding: 1rem;
}

.pc-board-panel h3 {
    margin: 0 0 0.8rem;
    color: var(--pc-ink);
    font-size: 0.92rem;
    font-weight: 800;
}

.pc-orders-panel {
    display: grid;
    align-content: start;
    gap: 0.7rem;
}

.pc-order-row {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
}

.pc-order-row strong {
    color: #1a2855;
    font-size: 0.86rem;
}

.pc-order-row small {
    grid-column: 2 / span 2;
    color: #7b8aa3;
    font-size: 0.75rem;
}

.pc-order-row em {
    border-radius: 999px;
    background: #ffece5;
    color: #ff7a45;
    padding: 0.18rem 0.55rem;
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 800;
}

.pc-order-row em.warning {
    background: #fff0d7;
    color: #f39a21;
}

.pc-order-row em.success {
    background: #dff8ef;
    color: #10a778;
}

.pc-orders-panel a {
    margin-top: 0.5rem;
    border-radius: 8px;
    background: #f3f7fc;
    padding: 0.72rem;
    color: var(--pc-blue);
    text-align: center;
    text-decoration: none;
    font-weight: 800;
}

.pc-board-side {
    display: grid;
    gap: 1rem;
}

.pc-file-line {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    color: #1b2a56;
    font-size: 0.82rem;
}

.pc-file-line small {
    color: #6d7c98;
}

.pc-progress {
    height: 4px;
    margin-top: 0.75rem;
    overflow: hidden;
    border-radius: 999px;
    background: #e7eef8;
}

.pc-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--pc-green);
}

.pc-stat-lines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    color: #4e5d7a;
    font-size: 0.72rem;
    font-weight: 800;
}

.pc-stat-lines span::after {
    content: "";
    display: block;
    height: 5px;
    margin-top: 1rem;
    border-radius: 999px;
    background: #dfe7f3;
}

.pc-benefits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.35rem;
    padding: 1.35rem max(2rem, calc((100vw - 1320px) / 2 + 0.75rem)) 2.1rem;
    background: #ffffff;
}

.pc-benefit-card {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    border: 1px solid var(--pc-border);
    border-radius: 12px;
    background: #ffffff;
    padding: 1.25rem 1.35rem;
    box-shadow: 0 18px 45px -38px rgba(9, 38, 89, 0.35);
}

.pc-benefit-icon,
.pc-solution-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #eef5ff;
    color: var(--pc-blue);
    font-size: 1.8rem;
    font-weight: 900;
}

.pc-benefit-icon {
    width: 64px;
    height: 64px;
}

.pc-benefit-card h2 {
    margin: 0 0 0.45rem;
    color: var(--pc-ink);
    font-size: 1.04rem;
    font-weight: 800;
}

.pc-benefit-card p {
    margin: 0;
    color: #405079;
    line-height: 1.6;
}

.pc-solutions {
    padding: 0 max(2rem, calc((100vw - 1320px) / 2 + 0.75rem)) 1.1rem;
    background: #ffffff;
}

.pc-section-heading {
    margin: 0 auto 1.35rem;
    text-align: center;
}

.pc-section-heading h2 {
    margin: 0 0 0.45rem;
    color: var(--pc-ink);
    font-size: 1.65rem;
    font-weight: 800;
}

.pc-section-heading p {
    margin: 0;
    color: var(--pc-muted);
}

.pc-solution-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem;
    max-width: 1000px;
    margin: 0 auto;
}

.pc-solution-card {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: center;
    border: 1px solid var(--pc-border);
    border-radius: 14px;
    background: #ffffff;
    padding: 1.25rem 1.45rem;
    box-shadow: 0 18px 45px -38px rgba(9, 38, 89, 0.38);
}

.pc-solution-icon {
    width: 86px;
    height: 86px;
    color: var(--pc-blue);
    font-size: 1.35rem;
}

.pc-solution-icon--green {
    background: #e6f8f2;
    color: var(--pc-green);
}

.pc-solution-card h3 {
    margin: 0 0 0.55rem;
    color: var(--pc-ink);
    font-size: 1.08rem;
    font-weight: 800;
}

.pc-solution-card ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.pc-solution-card li {
    position: relative;
    padding-left: 1.35rem;
    color: #304068;
    font-weight: 600;
}

.pc-solution-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--pc-green);
    font-weight: 900;
}

.pc-footer {
    border-top: 1px solid var(--pc-border);
    background: #ffffff;
    padding: 1.5rem 0;
}

.pc-footer-grid {
    display: grid;
    grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(120px, 0.7fr)) minmax(230px, 1fr);
    gap: 2rem;
    align-items: start;
}

.pc-footer p,
.pc-footer a,
.pc-footer span {
    color: #465577;
    font-size: 0.94rem;
}

.pc-footer h2 {
    margin: 0 0 0.75rem;
    color: var(--pc-ink);
    font-size: 1rem;
    font-weight: 800;
}

.pc-footer a,
.pc-footer-contact span {
    display: block;
    margin-bottom: 0.6rem;
    text-decoration: none;
}

.pc-footer a:hover {
    color: var(--pc-blue);
}

.pc-footer-brand p {
    max-width: 260px;
    margin: 0.85rem 0 0;
    line-height: 1.7;
}

@media (max-width: 1199.98px) {
    .pc-hero {
        grid-template-columns: 1fr;
        min-height: auto;
    }

    .pc-hero__visual {
        max-width: 860px;
    }

    .pc-benefits {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pc-solution-card {
        grid-template-columns: 86px minmax(0, 1fr);
    }

    .pc-solution-card .pc-btn {
        grid-column: 1 / -1;
        width: 100%;
    }

    .pc-footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 991.98px) {
    .pc-navbar {
        min-height: auto;
        padding: 0.8rem 0;
    }

    .pc-nav-links {
        gap: 0.25rem;
        padding-top: 1rem;
    }

    .pc-nav-links .nav-link::after,
    .site-navbar .nav-link::after {
        display: none;
    }

    .pc-nav-actions {
        align-items: stretch !important;
        padding-top: 0.75rem;
    }

    .pc-nav-actions .btn,
    .pc-nav-actions .nav-link {
        display: block;
        width: 100%;
        text-align: left;
    }

    .pc-dashboard-card__top,
    .pc-dashboard-card__body,
    .pc-board-demo {
        grid-template-columns: 1fr;
    }

    .pc-sidebar-demo {
        display: none;
    }
}

@media (max-width: 767.98px) {
    .pc-hero {
        padding: 2rem 1rem;
    }

    .pc-hero h1 {
        font-size: 2.2rem;
    }

    .pc-hero__actions .pc-btn {
        width: 100%;
    }

    .pc-benefits,
    .pc-solutions {
        grid-template-columns: 1fr;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .pc-benefits,
    .pc-solution-grid {
        grid-template-columns: 1fr;
    }

    .pc-benefit-card,
    .pc-solution-card {
        grid-template-columns: 1fr;
        text-align: left;
    }

    .pc-solution-icon,
    .pc-benefit-icon {
        width: 58px;
        height: 58px;
        font-size: 1.2rem;
    }

    .pc-footer-grid {
        grid-template-columns: 1fr;
    }
}
/* === ChatGPT Photocopy Home Refresh End === */
