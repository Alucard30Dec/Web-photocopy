@{
    ViewData["Title"] = "Nền tảng web photocopy hiện đại";
    var shopDashboardUrl = Url.Action("Index", "Dashboard", new { area = "Shop" }) ?? "/Shop/Dashboard";
}

<section class="pc-hero" aria-labelledby="pcHeroTitle">
    <span class="pc-hero__orb pc-hero__orb--one" aria-hidden="true"></span>
    <span class="pc-hero__orb pc-hero__orb--two" aria-hidden="true"></span>
    <span class="pc-hero__spark pc-hero__spark--one" aria-hidden="true"></span>
    <span class="pc-hero__spark pc-hero__spark--two" aria-hidden="true"></span>

    <div class="pc-hero__copy">
        <span class="pc-pill pc-pill--green">Nền tảng Web Photocopy hiện đại</span>
        <h1 id="pcHeroTitle">Nền tảng web photocopy hiện đại cho khách hàng và tiệm photo</h1>
        <p>
            Upload file, đặt in, theo dõi đơn hàng theo thời gian thực. Giải pháp tối ưu vận hành cho tiệm photo — tiết kiệm thời gian, tăng hiệu quả.
        </p>
        <div class="pc-hero__actions" aria-label="Hành động chính">
            <a class="pc-btn pc-btn--ghost" asp-controller="Home" asp-action="CustomerPortfolio">Tìm hiểu thêm <span aria-hidden="true">→</span></a>
        </div>
    </div>

    <div class="pc-hero__visual" aria-label="Mô phỏng màn hình quản lý PhotoCopyHub">
        <div class="pc-dashboard-card">
            <div class="pc-dashboard-card__top">
                <div class="pc-logo-mini"><span aria-hidden="true"></span><strong>PhotoCopyHub</strong></div>
                <div class="pc-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <span>Tìm đơn hàng, khách hàng...</span>
                </div>
                <div class="pc-top-icons" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 7h18s-3 0-3-7"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    <span class="pc-avatar"></span>
                </div>
            </div>

            <div class="pc-dashboard-card__body">
                <aside class="pc-sidebar-demo" aria-label="Menu mô phỏng">
                    <span class="active"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>Tổng quan</span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>Đơn hàng</span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>Tài liệu</span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Khách hàng</span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6V20a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-.6 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1H4a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 .6-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6V4a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 .6 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.2.31.4.65.6 1H20a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-.5 1z"/></svg>Cài đặt</span>
                </aside>

                <div class="pc-board-demo">
                    <div class="pc-board-panel pc-orders-panel">
                        <h3>Đơn hàng mới</h3>
                        <div class="pc-order-row">
                            <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                            <div><strong>#PC24025-001</strong><small>Đã tiếp nhận</small></div>
                            <em>Mới</em>
                        </div>
                        <div class="pc-order-row">
                            <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                            <div><strong>#PC24025-002</strong><small>Đã tiếp nhận</small></div>
                            <em class="warn">Đang xử lý</em>
                        </div>
                        <div class="pc-order-row">
                            <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                            <div><strong>#PC24025-003</strong><small>Đã tiếp nhận</small></div>
                            <em class="done">Hoàn thành</em>
                        </div>
                        <a href="@shopDashboardUrl">Xem tất cả đơn hàng <span aria-hidden="true">→</span></a>
                    </div>

                    <div class="pc-board-side">
                        <div class="pc-board-panel">
                            <h3>Tài liệu lên</h3>
                            <div class="pc-file-line">
                                <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
                                <strong>Bao_cao_the_15.pdf</strong>
                                <small>100%</small>
                            </div>
                            <div class="pc-progress"><span></span></div>
                        </div>
                        <div class="pc-board-panel">
                            <h3>Thống kê hôm nay</h3>
                            <div class="pc-stat-lines"><span>Đã tiếp nhận</span><span>Đơn in xong</span><span>Đã hoàn thành</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pc-benefits" aria-label="Lợi ích chính">
    <article class="pc-benefit-card"><div class="pc-benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3m0 0 4 4m-4-4-4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg></div><div><h2>Upload &amp; Preview</h2><p>Upload tài liệu và xem trước trước khi đặt in.</p></div></article>
    <article class="pc-benefit-card"><div class="pc-benefit-icon pc-benefit-icon--green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div><div><h2>Tiện lợi &amp; Nhanh chóng</h2><p>Đặt in online 24/7, theo dõi đơn hàng theo thời gian thực.</p></div></article>
    <article class="pc-benefit-card"><div class="pc-benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div><div><h2>Bảo mật &amp; An toàn</h2><p>Dữ liệu được bảo mật tuyệt đối, an tâm sử dụng.</p></div></article>
    <article class="pc-benefit-card"><div class="pc-benefit-icon pc-benefit-icon--green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 10a6 6 0 0 0-12 0v4"/><path d="M4 14h3v5H4zM17 14h3v5h-3z"/><path d="M20 19c0 1.5-1.5 2-3 2h-2"/></svg></div><div><h2>Hỗ trợ tận tâm</h2><p>Đội ngũ hỗ trợ nhanh chóng, nhiệt tình và chuyên nghiệp.</p></div></article>
</section>

<section class="pc-solutions" id="pcCustomer">
    <div class="pc-section-heading">
        <h2>Giải pháp phù hợp</h2>
        <p>Chúng tôi đồng hành cùng bạn với giải pháp tối ưu cho từng nhu cầu.</p>
    </div>

    <div class="pc-solution-grid">
        <article class="pc-solution-card">
            <div class="pc-solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <div><h3>Khách hàng cá nhân</h3><ul><li>Đặt mọi lúc, mọi nơi</li><li>Theo dõi đơn hàng dễ dàng</li><li>Thanh toán nhanh, an toàn</li></ul></div>
        </article>

        <article class="pc-solution-card" id="pcShop">
            <div class="pc-solution-icon pc-solution-icon--green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18l-1.5-6h-15z"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/><path d="M3 10c0 2 2 3 4 2 1.5 1 3.5 1 5 0 1.5 1 3.5 1 5 0 2 1 4 0 4-2"/></svg></div>
            <div><h3>Tiệm photo</h3><ul><li>Quản lý đơn hàng hiệu quả</li><li>Tối ưu vận hành, tiết kiệm thời gian</li><li>Báo cáo doanh thu rõ ràng</li></ul></div>
        </article>
    </div>
</section>

<section class="pc-detail-section" aria-label="Chi tiết dành cho khách hàng và tiệm photocopy">
    <article class="pc-detail-card">
        <span class="pc-pill pc-pill--blue">Dành cho khách hàng</span>
        <h2>Đặt in rõ ràng, dùng dịch vụ đến đâu thanh toán đến đó</h2>
        <p>
            Khách hàng không cần nạp tiền trước. Mỗi đơn in hoặc dịch vụ sẽ được tính theo cấu hình thực tế, sau đó khách hàng thanh toán đúng số tiền của đơn đó.
        </p>
        <p class="pc-detail-note">
            Phù hợp cho luồng customer: đăng nhập, upload tài liệu, chọn cấu hình in, xem chi phí tạm tính, gửi đơn, theo dõi trạng thái và thanh toán theo từng đơn.
        </p>
        <div class="pc-step-grid">
            <div><span>01</span><strong>Gửi &amp; quản lý file</strong><small>Upload PDF, Word, PowerPoint hoặc hình ảnh; lưu danh sách file đã gửi để xem lại khi cần.</small></div>
            <div><span>02</span><strong>Chọn cấu hình in</strong><small>Chọn khổ giấy, số bản, in màu/đen trắng, một mặt/hai mặt và ghi chú riêng cho tiệm.</small></div>
            <div><span>03</span><strong>Xem chi phí tạm tính</strong><small>Hệ thống hiển thị chi phí dự kiến theo cấu hình đơn để khách kiểm tra trước khi gửi.</small></div>
            <div><span>04</span><strong>Theo dõi trạng thái</strong><small>Biết đơn đã tiếp nhận, đang xử lý, hoàn thành hoặc cần bổ sung thông tin.</small></div>
            <div><span>05</span><strong>Thanh toán theo đơn</strong><small>Đơn hết bao nhiêu thì thanh toán bấy nhiêu, không cần nạp tiền vào tài khoản trước.</small></div>
            <div><span>06</span><strong>Sản phẩm &amp; hỗ trợ</strong><small>Đặt thêm sản phẩm photocopy hoặc gửi yêu cầu dịch vụ hỗ trợ ngoài đơn in thông thường.</small></div>
        </div>
    </article>

    <article class="pc-detail-card pc-detail-card--green">
        <span class="pc-pill pc-pill--green">Dành cho tiệm photocopy</span>
        <h2>Vận hành đơn in, file, thanh toán và báo cáo theo từng đơn thực tế</h2>
        <p>
            Tiệm photocopy nhận đơn tập trung, kiểm soát file khách gửi, cập nhật trạng thái xử lý và xác nhận thanh toán đúng theo chi phí của từng đơn hàng.
        </p>
        <p class="pc-detail-note">
            Phù hợp cho luồng shop/admin: xử lý đơn in, tải file đúng quyền, xác nhận chi phí, ghi nhận thanh toán, quản lý sản phẩm, báo cáo doanh thu và đối soát.
        </p>
        <div class="pc-step-grid">
            <div><span>01</span><strong>Nhận đơn tập trung</strong><small>Danh sách đơn rõ theo trạng thái, thời gian, khách hàng và chi nhánh để không bỏ sót đơn.</small></div>
            <div><span>02</span><strong>Kiểm soát file</strong><small>Tải đúng file theo đơn, tránh nhầm tài liệu khách và hỗ trợ kiểm tra trước khi in.</small></div>
            <div><span>03</span><strong>Cập nhật trạng thái</strong><small>Chuyển đơn qua các bước tiếp nhận, xử lý, hoàn thành hoặc hủy theo quy trình rõ ràng.</small></div>
            <div><span>04</span><strong>Xác nhận chi phí</strong><small>Kiểm tra cấu hình, số lượng, dịch vụ phát sinh và xác nhận số tiền cần thanh toán cho từng đơn.</small></div>
            <div><span>05</span><strong>Ghi nhận thanh toán</strong><small>Theo dõi trạng thái đã thanh toán/chưa thanh toán, đúng với số tiền thực tế của đơn hàng.</small></div>
            <div><span>06</span><strong>Báo cáo &amp; đối soát</strong><small>Xem dữ liệu doanh thu, đơn hàng, thanh toán và lịch sử xử lý phục vụ kiểm soát nội bộ.</small></div>
        </div>
    </article>
</section>
