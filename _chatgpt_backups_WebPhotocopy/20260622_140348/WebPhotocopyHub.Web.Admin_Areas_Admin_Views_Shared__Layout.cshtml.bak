@using WebPhotocopyHub.Domain.Constants
@{
    var adminController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var adminAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isSystemAdmin = User.IsInRole(RoleConstants.Admin);

    string IsControllerActive(params string[] controllerNames)
    {
        return controllerNames.Contains(adminController, StringComparer.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    string IsMenuItemActive(string controllerName, string? actionName = null)
    {
        var controllerMatches = string.Equals(adminController, controllerName, StringComparison.OrdinalIgnoreCase);
        var actionMatches = string.IsNullOrWhiteSpace(actionName)
            || string.Equals(adminAction, actionName, StringComparison.OrdinalIgnoreCase);

        return controllerMatches && actionMatches ? "active" : string.Empty;
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị hệ thống - WebPhotocopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/WebPhotocopyHub.Web.Admin/css/admin-system.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="system-admin-body">
    <header class="system-admin-header">
        <div class="system-admin-brandbar">
            <div class="container-fluid system-admin-container">
                <a class="system-admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="system-admin-logo" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z"></path>
                        </svg>
                    </span>
                    <span>
                        <strong>WebPhotocopyHub</strong>
                        <small>System Administration</small>
                    </span>
                </a>

                <div class="system-admin-head-actions">
                    <a class="system-status-pill" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">
                        <span class="system-status-dot"></span>
                        <span>Giám sát hệ thống</span>
                    </a>

                    <div class="dropdown">
                        <button class="btn system-account-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="system-account-avatar">@((User.Identity?.Name ?? "A").Substring(0, 1).ToUpperInvariant())</span>
                            <span class="system-account-copy">
                                <strong>@(User.Identity?.Name ?? "System Admin")</strong>
                                <small>Quản trị viên toàn hệ thống</small>
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end system-account-menu">
                            <div class="system-account-menu-head">
                                <strong>Phiên quản trị</strong>
                                <small>Mọi thao tác nhạy cảm đều phải được ghi audit.</small>
                            </div>
                            <a class="dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Quản lý tài khoản và quyền</a>
                            <a class="dropdown-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Xem nhật ký hoạt động</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Về trang chính</a>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-2 pb-1">
                                <input type="hidden" name="returnUrl" value="/" />
                                <button class="btn btn-outline-danger btn-sm w-100" type="submit">Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <nav class="system-admin-commandbar" aria-label="Điều hướng quản trị hệ thống">
            <div class="container-fluid system-admin-container">
                @if (isSystemAdmin)
                {
                    <div class="system-admin-nav">
                        <div class="dropdown system-nav-group">
                            <button class="system-nav-trigger @(IsControllerActive("Dashboard", "AuditLogs"))" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="system-nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M4 13h6v7H4v-7Zm10-9h6v16h-6V4ZM4 4h6v5H4V4Z"></path></svg>
                                </span>
                                <span><strong>Tổng quan</strong><small>Dashboard và nhật ký</small></span>
                                <span class="system-nav-chevron">⌄</span>
                            </button>
                            <div class="dropdown-menu system-nav-menu">
                                <div class="system-nav-menu-heading">
                                    <strong>Tổng quan và hoạt động</strong>
                                    <small>Điều phối, theo dõi và truy vết thay đổi.</small>
                                </div>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("Dashboard"))" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <span class="system-nav-item-mark">01</span>
                                    <span><strong>Dashboard quản trị</strong><small>Tình hình vận hành toàn hệ thống</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("AuditLogs"))" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                                    <span class="system-nav-item-mark">02</span>
                                    <span><strong>Audit và activity tracking</strong><small>Tra cứu thao tác, IP và chuỗi hash</small></span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown system-nav-group">
                            <button class="system-nav-trigger @(IsControllerActive("Users"))" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="system-nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0H5Zm13-8a3 3 0 0 1 3 3v5h-2v-5a1 1 0 0 0-1-1v-2Z"></path></svg>
                                </span>
                                <span><strong>Tài khoản & quyền</strong><small>Users, roles, trạng thái</small></span>
                                <span class="system-nav-chevron">⌄</span>
                            </button>
                            <div class="dropdown-menu system-nav-menu">
                                <div class="system-nav-menu-heading">
                                    <strong>Danh tính và phân quyền</strong>
                                    <small>Kiểm soát tài khoản, vai trò và ví người dùng.</small>
                                </div>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("Users"))" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                    <span class="system-nav-item-mark">01</span>
                                    <span><strong>Quản lý người dùng</strong><small>Khóa/mở, đổi role, điều chỉnh ví</small></span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown system-nav-group">
                            <button class="system-nav-trigger @(IsControllerActive("TopUpRequests", "WalletTransactions", "Reconciliation"))" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="system-nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M3 6h18v13H3V6Zm2 3v8h14V9H5Zm10 2h3v2h-3v-2ZM6 3h12v2H6V3Z"></path></svg>
                                </span>
                                <span><strong>Tài chính & ví</strong><small>Top-up và đối soát</small></span>
                                <span class="system-nav-chevron">⌄</span>
                            </button>
                            <div class="dropdown-menu system-nav-menu">
                                <div class="system-nav-menu-heading">
                                    <strong>Tài chính và kiểm soát số dư</strong>
                                    <small>Luồng tiền cần bảo toàn idempotency và audit.</small>
                                </div>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("TopUpRequests"))" asp-area="Admin" asp-controller="TopUpRequests" asp-action="Index">
                                    <span class="system-nav-item-mark">01</span>
                                    <span><strong>Duyệt yêu cầu nạp tiền</strong><small>Kiểm tra và phê duyệt top-up</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("WalletTransactions"))" asp-area="Admin" asp-controller="WalletTransactions" asp-action="Index">
                                    <span class="system-nav-item-mark">02</span>
                                    <span><strong>Giao dịch ví</strong><small>Tra cứu biến động và xuất báo cáo</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("Reconciliation"))" asp-area="Admin" asp-controller="Reconciliation" asp-action="Index">
                                    <span class="system-nav-item-mark">03</span>
                                    <span><strong>Đối soát số dư</strong><small>Phát hiện chênh lệch dữ liệu ví</small></span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown system-nav-group">
                            <button class="system-nav-trigger @(IsControllerActive("PrintJobs", "ProductOrders", "SupportOrders", "Inventory"))" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="system-nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M5 3h14v5h2v10h-4v3H7v-3H3V8h2V3Zm2 2v3h10V5H7Zm2 10v4h6v-4H9Zm8-4h2v2h-2v-2Z"></path></svg>
                                </span>
                                <span><strong>Đơn & vận hành</strong><small>In ấn, dịch vụ, kho</small></span>
                                <span class="system-nav-chevron">⌄</span>
                            </button>
                            <div class="dropdown-menu system-nav-menu">
                                <div class="system-nav-menu-heading">
                                    <strong>Điều phối nghiệp vụ toàn hệ thống</strong>
                                    <small>Quản lý trạng thái đơn và lịch sử tồn kho.</small>
                                </div>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("PrintJobs"))" asp-area="Admin" asp-controller="PrintJobs" asp-action="Index">
                                    <span class="system-nav-item-mark">01</span>
                                    <span><strong>Đơn in</strong><small>Trạng thái, file, hoàn tiền và SLA</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("ProductOrders"))" asp-area="Admin" asp-controller="ProductOrders" asp-action="Index">
                                    <span class="system-nav-item-mark">02</span>
                                    <span><strong>Đơn văn phòng phẩm</strong><small>Theo dõi và cập nhật trạng thái</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("SupportOrders"))" asp-area="Admin" asp-controller="SupportOrders" asp-action="Index">
                                    <span class="system-nav-item-mark">03</span>
                                    <span><strong>Đơn dịch vụ hỗ trợ</strong><small>Scan, đóng gáy, ép plastic</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("Inventory"))" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                                    <span class="system-nav-item-mark">04</span>
                                    <span><strong>Tồn kho và biến động</strong><small>Nhập/xuất thủ công có audit</small></span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown system-nav-group">
                            <button class="system-nav-trigger @(IsControllerActive("Products", "SupportServices", "PricingRules"))" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="system-nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z"></path></svg>
                                </span>
                                <span><strong>Danh mục & cấu hình</strong><small>Sản phẩm, giá, dịch vụ</small></span>
                                <span class="system-nav-chevron">⌄</span>
                            </button>
                            <div class="dropdown-menu system-nav-menu">
                                <div class="system-nav-menu-heading">
                                    <strong>Dữ liệu nền và bảng giá</strong>
                                    <small>Cấu hình ảnh hưởng trực tiếp tới giao dịch.</small>
                                </div>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("Products"))" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                    <span class="system-nav-item-mark">01</span>
                                    <span><strong>Danh mục văn phòng phẩm</strong><small>Giá, tồn, trạng thái kinh doanh</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("SupportServices"))" asp-area="Admin" asp-controller="SupportServices" asp-action="Index">
                                    <span class="system-nav-item-mark">02</span>
                                    <span><strong>Danh mục dịch vụ hỗ trợ</strong><small>Đơn giá và kiểu tính phí</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("PricingRules"))" asp-area="Admin" asp-controller="PricingRules" asp-action="Index">
                                    <span class="system-nav-item-mark">03</span>
                                    <span><strong>Bảng giá in</strong><small>Khổ giấy, màu và kiểu in</small></span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown system-nav-group">
                            <button class="system-nav-trigger @(IsControllerActive("SystemMonitoring"))" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="system-nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M3 4h18v13H3V4Zm2 2v9h14V6H5Zm3 13h8v2H8v-2Zm0-8 2-2 2 2 3-4 2 2-5 6-2-2-1 1-2-1Z"></path></svg>
                                </span>
                                <span><strong>API & hệ thống</strong><small>Health, endpoint, runtime</small></span>
                                <span class="system-nav-chevron">⌄</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end system-nav-menu">
                                <div class="system-nav-menu-heading">
                                    <strong>Kiểm soát API và hạ tầng</strong>
                                    <small>Chỉ hiển thị cho role Admin; không công khai cấu hình nhạy cảm.</small>
                                </div>
                                <a class="dropdown-item system-nav-item @(IsMenuItemActive("SystemMonitoring"))" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">
                                    <span class="system-nav-item-mark">01</span>
                                    <span><strong>Trung tâm giám sát</strong><small>Health checks, runtime và endpoint inventory</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item" href="/swagger" target="_blank" rel="noopener">
                                    <span class="system-nav-item-mark">02</span>
                                    <span><strong>Swagger API</strong><small>Mở tài liệu API trong tab mới</small></span>
                                </a>
                                <a class="dropdown-item system-nav-item" href="/healthz/ready" target="_blank" rel="noopener">
                                    <span class="system-nav-item-mark">03</span>
                                    <span><strong>Readiness health</strong><small>Kiểm tra ứng dụng và database</small></span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="system-admin-access-warning">
                        Tài khoản hiện tại không có role Admin nên các nhóm chức năng quản trị đã bị ẩn.
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container-fluid system-admin-container system-admin-main">
        <partial name="_Alert" />
        @RenderBody()
    </main>

    <footer class="system-admin-footer">
        <div class="container-fluid system-admin-container">
            <span>WebPhotocopyHub System Administration</span>
            <span>Role yêu cầu: Admin · Các thao tác thay đổi dữ liệu phải qua controller và audit hiện có.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
