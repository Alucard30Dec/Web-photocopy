@echo off
setlocal

title Tao WebPhotocopy.zip va copy vao Clipboard
cd /d "E:\OneDrive - 0dpmr\WebPhotocopy"

echo.
echo Dang tao file ZIP source sach: WebPhotocopy.zip
echo Neu WebPhotocopy.zip da ton tai thi se bi ghi de.
echo Sau khi xong, file ZIP se duoc copy vao Clipboard.
echo Ban chi can mo ChatGPT va nhan Ctrl + V.
echo.

powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File "E:\OneDrive - 0dpmr\WebPhotocopy\Create-ChatGPT-SourceZip.ps1"

