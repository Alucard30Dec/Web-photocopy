@model BranchHomeViewModel

@{
    ViewData["Title"] = Model.Branch.Name;
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";

    var loginUrl = CustomerBranchContext.ToPath(ViewContext, "Login");
    var dashboardUrl = CustomerBranchContext.ToPath(ViewContext, "Dashboard");
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var supportHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/History");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");

    var displayName = User?.Identity?.Name;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "khách hàng";
    }

    string RequireLogin(string targetUrl)
    {
        return Model.IsSignedIn ? targetUrl : loginUrl + "?returnUrl=" + Uri.EscapeDataString(targetUrl);
    }
}

<section class="branch-home-v2">
    <section class="bh-hero" aria-label="Trang chính khách hàng">
        <div class="bh-hero-main">
            <span class="bh-kicker">Trang cơ sở</span>
            <h1>Đặt in tại @Model.Branch.Name</h1>
            <p>Gửi file, chọn cấu hình in và theo dõi trạng thái xử lý tại cơ sở. Trang này chỉ giữ các chức năng cần dùng nhanh; thông tin tổng quan nằm trong Dashboard.</p>

            <div class="bh-trust-row" aria-label="Thông tin nhanh">
                <span><i class="bi bi-file-earmark-richtext"></i>PDF, DOCX, PPTX</span>
                <span><i class="bi bi-wallet2"></i>Thanh toán theo từng đơn</span>
                <span><i class="bi bi-shop"></i>Nhận tại cơ sở</span>
            </div>

            <div class="bh-hero-actions">
                <a class="bh-btn bh-btn-primary" href="@RequireLogin(printCreateUrl)"><i class="bi bi-printer"></i>Tạo đơn in</a>
                <a class="bh-btn bh-btn-secondary" href="@RequireLogin(printJobsUrl)"><i class="bi bi-clipboard-check"></i>Theo dõi đơn</a>
                <a class="bh-btn bh-btn-soft" href="#customerPriceQuick"><i class="bi bi-tags"></i>Xem bảng giá</a>
            </div>
        </div>

        <aside class="bh-start-card" aria-label="Bắt đầu tạo đơn">
            <div class="bh-start-icon" aria-hidden="true"><i class="bi bi-rocket-takeoff"></i></div>
            <span class="bh-kicker">Bắt đầu nhanh</span>
            <h2>Tạo yêu cầu in</h2>
            <p>Chọn file ở bước tiếp theo, nhập số trang, số bản, màu sắc và ghi chú nếu cần.</p>
            <div class="bh-start-options">
                <span><i class="bi bi-aspect-ratio"></i>A4 / A3</span>
                <span><i class="bi bi-layout-split"></i>1 mặt / 2 mặt</span>
                <span><i class="bi bi-palette"></i>Đen trắng / màu</span>
            </div>
            <a class="bh-btn bh-btn-primary" href="@RequireLogin(printCreateUrl)"><i class="bi bi-arrow-right-circle"></i>Mở form tạo đơn</a>
        </aside>
    </section>

    <section class="bh-action-strip" aria-label="Thao tác nhanh">
        <a class="bh-action-card" href="@RequireLogin(printCreateUrl)">
            <span class="bh-action-icon is-blue" aria-hidden="true"><i class="bi bi-printer"></i></span>
            <strong>Tạo đơn in</strong>
            <small>Upload file và gửi yêu cầu in mới.</small>
        </a>

        <a class="bh-action-card" href="@RequireLogin(printJobsUrl)">
            <span class="bh-action-icon is-green" aria-hidden="true"><i class="bi bi-list-check"></i></span>
            <strong>Đơn của tôi</strong>
            <small>Theo dõi trạng thái đơn đang xử lý.</small>
        </a>

        <a class="bh-action-card" href="@RequireLogin(productsUrl)">
            <span class="bh-action-icon is-purple" aria-hidden="true"><i class="bi bi-bag-heart"></i></span>
            <strong>Sản phẩm</strong>
            <small>Mua giấy, bút, bìa và vật tư.</small>
        </a>

        <a class="bh-action-card" href="@RequireLogin(supportCreateUrl)">
            <span class="bh-action-icon is-rose" aria-hidden="true"><i class="bi bi-life-preserver"></i></span>
            <strong>Dịch vụ hỗ trợ</strong>
            <small>Scan, đóng gáy, ép plastic.</small>
        </a>
    </section>

    <section class="bh-content-grid">
        <article id="customerPriceQuick" class="bh-panel">
            <div class="bh-panel-head">
                <div>
                    <span class="bh-kicker">Bảng giá</span>
                    <h2>Giá tham khảo đang áp dụng</h2>
                </div>
                <a href="@RequireLogin(printCreateUrl)">Tạo đơn</a>
            </div>

            @if (Model.QuickPrices.Count > 0)
            {
                <div class="bh-price-list">
                    @foreach (var price in Model.QuickPrices)
                    {
                        <div>
                            <span>
                                <strong>@price.Name</strong>
                                <small>@price.Description</small>
                            </span>
                            <em>@price.UnitPrice.ToString("N0") đ / trang</em>
                        </div>
                    }
                </div>
            }

            @if (Model.QuickPrices.Count == 0)
            {
                <div class="bh-empty-state">
                    <strong>Chưa có bảng giá hoạt động</strong>
                    <span>Vui lòng cập nhật bảng giá trong phần quản trị để khách hàng xem được giá thật.</span>
                </div>
            }
        </article>

        <aside id="customerContact" class="bh-panel bh-contact-panel">
            <div class="bh-panel-head">
                <div>
                    <span class="bh-kicker">Cơ sở</span>
                    <h2>Thông tin liên hệ</h2>
                </div>
            </div>

            <div class="bh-shop-info">
                <strong>@Model.Branch.Name</strong>
                <span>@Model.Branch.Address</span>
                <span>@Model.Branch.PhoneNumber</span>
                <span>@Model.Branch.OpenHours</span>
            </div>

            <div class="bh-contact-actions">
                <a href="@RequireLogin(supportCreateUrl)">Yêu cầu hỗ trợ</a>
                <a href="@RequireLogin(profileUrl)">Hồ sơ nhận hàng</a>
            </div>
        </aside>

        <article class="bh-panel bh-panel-wide">
            <div class="bh-panel-head">
                <div>
                    <span class="bh-kicker">Đơn cần chú ý</span>
                    <h2>Hoạt động gần đây</h2>
                </div>
                <a href="@RequireLogin(dashboardUrl)">Mở Dashboard</a>
            </div>

            @if (!Model.IsSignedIn)
            {
                <div class="bh-empty-state bh-empty-state-inline">
                    <strong>Đăng nhập để xem đơn của bạn</strong>
                    <span>Sau khi đăng nhập, các đơn in gần đây và trạng thái đang xử lý sẽ hiển thị tại đây.</span>
                    <a class="bh-btn bh-btn-secondary" href="@RequireLogin(dashboardUrl)">Đăng nhập / Dashboard</a>
                </div>
            }

            @if (Model.IsSignedIn && Model.RecentPrintJobs.Count == 0)
            {
                <div class="bh-empty-state bh-empty-state-inline">
                    <strong>Bạn chưa có đơn in nào</strong>
                    <span>Tạo đơn in đầu tiên bằng cách gửi file và chọn cấu hình in.</span>
                    <a class="bh-btn bh-btn-primary" href="@RequireLogin(printCreateUrl)"><i class="bi bi-printer"></i>Tạo đơn in</a>
                </div>
            }

            @if (Model.IsSignedIn && Model.RecentPrintJobs.Count > 0)
            {
                <div class="bh-order-list">
                    @foreach (var job in Model.RecentPrintJobs)
                    {
                        <a href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{job.Id}")">
                            <span class="bh-order-status">@job.Status.GetDisplayName()</span>
                            <div>
                                <strong>@job.PaperSize.GetDisplayName() · @job.ColorMode.GetDisplayName() · @job.PrintSide.GetDisplayName()</strong>
                                <small>@job.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @job.TotalAmount.ToString("N0") đ</small>
                            </div>
                            <em>→</em>
                        </a>
                    }
                </div>
            }
        </article>

        <aside class="bh-panel">
            <div class="bh-panel-head">
                <div>
                    <span class="bh-kicker">Dashboard</span>
                    <h2>Tổng quan riêng</h2>
                </div>
            </div>

            <div class="bh-dashboard-brief">
                <strong>@Model.ActivePrintJobCount</strong>
                <span>đơn in đang cần theo dõi</span>
                <p>Dashboard chứa số dư ví, giao dịch, đơn sản phẩm, dịch vụ hỗ trợ và thống kê cá nhân.</p>
                <a class="bh-btn bh-btn-secondary" href="@RequireLogin(dashboardUrl)">Vào Dashboard</a>
            </div>
        </aside>
    </section>
</section>