@using Microsoft.AspNetCore.Identity
@using WebPhotocopyHub.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentUser = isSignedIn ? await UserManager.GetUserAsync(User) : null;

    var branch = CustomerBranchContext.GetBranch(ViewContext);
    var branchHomeUrl = CustomerBranchContext.Home(ViewContext);
    var loginUrl = CustomerBranchContext.ToPath(ViewContext, "Login");
    var dashboardUrl = CustomerBranchContext.ToPath(ViewContext, "Dashboard");
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var printFilesUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Files");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var productOrdersUrl = CustomerBranchContext.ToPath(ViewContext, "Products/Orders");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var supportHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/History");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var topUpUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUp");
    var topUpHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUpHistory");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");
    var priceUrl = branchHomeUrl.TrimEnd('/') + "#customerPriceQuick";
    var contactUrl = branchHomeUrl.TrimEnd('/') + "#customerContact";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Khu khách hàng";

    string RequireLogin(string targetUrl)
    {
        return isSignedIn ? targetUrl : loginUrl + "?returnUrl=" + System.Uri.EscapeDataString(targetUrl);
    }

    bool InController(params string[] names)
    {
        return names.Any(name => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase));
    }

    string ActiveGroup(params string[] names)
    {
        return InController(names) ? "is-active" : string.Empty;
    }

    var displayName = currentUser?.FullName;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = User.Identity?.Name;
    }

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "Khách hàng";
    }

    var userName = currentUser?.UserName ?? User.Identity?.Name ?? "khachhang";
    var gmail = currentUser?.Email ?? "Chưa cập nhật Gmail";
    var phone = string.IsNullOrWhiteSpace(currentUser?.PhoneNumber) ? "Chưa cập nhật SĐT" : currentUser!.PhoneNumber;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @branch.Name</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="customer-shell customer-app-shell">
<header class="customer-topbar customer-topbar-v2">
    <a class="customer-brand" href="@branchHomeUrl" aria-label="Trang chủ @branch.Name">
        <span class="customer-brand-icon" aria-hidden="true">▣</span>
        <strong>@branch.Name</strong>
    </a>

    <nav class="customer-nav-groups" aria-label="Menu chức năng khách hàng">
        <a class="customer-home-link @(InController("Branch") ? "is-active" : string.Empty)" href="@branchHomeUrl">
            <span aria-hidden="true">⌂</span> Trang chủ
        </a>

        <div class="customer-nav-group dropdown @ActiveGroup("PrintJobs")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">▤</span> Đơn in
            </button>
            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@RequireLogin(printCreateUrl)"><strong>Tạo đơn in</strong><small>Gửi file và chọn cấu hình in.</small></a>
                <a class="customer-nav-item" href="@RequireLogin(printJobsUrl)"><strong>Đơn của tôi</strong><small>Theo dõi trạng thái xử lý và thanh toán.</small></a>
                <a class="customer-nav-item" href="@RequireLogin(printFilesUrl)"><strong>File đã gửi</strong><small>Xem lại file đã upload.</small></a>
            </div>
        </div>

        <div class="customer-nav-group dropdown @ActiveGroup("Products")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">▦</span> Sản phẩm
            </button>
            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@RequireLogin(productsUrl)"><strong>Mua sản phẩm</strong><small>Giấy, bút, bìa và vật tư văn phòng.</small></a>
                <a class="customer-nav-item" href="@RequireLogin(productOrdersUrl)"><strong>Đơn sản phẩm</strong><small>Kiểm tra các đơn sản phẩm đã đặt.</small></a>
            </div>
        </div>

        <div class="customer-nav-group dropdown @ActiveGroup("SupportOrders")">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span aria-hidden="true">?</span> Bảng giá & hỗ trợ
            </button>
            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@priceUrl"><strong>Bảng giá in</strong><small>Xem giá đang áp dụng tại cơ sở.</small></a>
                <a class="customer-nav-item" href="@RequireLogin(supportCreateUrl)"><strong>Tạo yêu cầu dịch vụ</strong><small>Scan, đóng gáy, ép plastic, hỗ trợ file.</small></a>
                <a class="customer-nav-item" href="@RequireLogin(supportHistoryUrl)"><strong>Lịch sử dịch vụ</strong><small>Xem các yêu cầu hỗ trợ đã gửi.</small></a>
                <a class="customer-nav-item" href="@contactUrl"><strong>Liên hệ cơ sở</strong><small>Địa chỉ, điện thoại và giờ mở cửa.</small></a>
            </div>
        </div>
    </nav>

    <div class="customer-head-actions">
        <div class="customer-open-state">
            <span>● Đang mở cửa</span>
            <small>@branch.OpenHours</small>
        </div>

        @if (isSignedIn)
        {
            <div class="customer-account-menu dropdown">
                <button class="customer-user-pill customer-user-pill--menu dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="customer-avatar" aria-hidden="true">👤</span>
                    <span class="customer-user-text">
                        <small>@displayName</small>
                        <strong>@userName</strong>
                    </span>
                </button>

                <div class="dropdown-menu customer-account-dropdown dropdown-menu-end">
                    <div class="customer-account-card">
                        <span class="customer-avatar customer-avatar--large" aria-hidden="true">👤</span>
                        <div>
                            <strong>@displayName</strong>
                            <small>Tên đăng nhập: @userName</small>
                            <small>Gmail: @gmail</small>
                            <small>SĐT: @phone</small>
                        </div>
                    </div>

                    <a class="customer-account-link" href="@RequireLogin(dashboardUrl)"><span>📊</span><div><strong>Dashboard</strong><small>Tổng quan đơn, ví và hoạt động.</small></div></a>
                    <a class="customer-account-link" href="@RequireLogin(profileUrl)"><span>👤</span><div><strong>Hồ sơ khách hàng</strong><small>Cập nhật thông tin cá nhân.</small></div></a>
                    <a class="customer-account-link" href="@RequireLogin(walletUrl)"><span>₫</span><div><strong>Ví & giao dịch</strong><small>Xem số dư và lịch sử thanh toán.</small></div></a>
                    <a class="customer-account-link" href="@RequireLogin(topUpUrl)"><span>＋</span><div><strong>Nạp tiền</strong><small>Tạo yêu cầu nạp ví.</small></div></a>

                    <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="customer-account-logout-form">
                        <input type="hidden" name="returnUrl" value="@branchHomeUrl" />
                        <button type="submit"><span>↪</span> Đăng xuất</button>
                    </form>
                </div>
            </div>
        }

        @if (!isSignedIn)
        {
            <a class="customer-login-button" href="@RequireLogin(dashboardUrl)">Đăng nhập</a>
        }
    </div>
</header>

<main class="customer-main customer-shared-frame" aria-label="Nội dung chức năng khách hàng">
    <div class="customer-shared-frame__inner">
        <partial name="_Alert" />

        <div class="customer-shared-frame__body">
            @RenderBody()
        </div>
    </div>
</main>
@await RenderSectionAsync("Scripts", required: false)

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>