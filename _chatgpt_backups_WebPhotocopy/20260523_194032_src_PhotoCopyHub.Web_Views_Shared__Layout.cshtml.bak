<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhotoCopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAdmin = User.IsInRole("Admin");
    var isCustomer = User.IsInRole("Customer");
    var isShopOperator = User.IsInRole("ShopOperator");
    var customerReturnUrl = Url.Action("Index", "Dashboard") ?? "/Dashboard";
    var shopReturnUrl = Url.Action("Index", "Dashboard", new { area = "Shop" }) ?? "/Shop/Dashboard";
    var adminReturnUrl = Url.Action("Index", "Dashboard", new { area = "Admin" }) ?? "/Admin/Dashboard";
}
<header class="site-header pc-site-header">
    <nav class="navbar navbar-expand-lg pc-navbar">
        <div class="container-xl">
            <a class="navbar-brand pc-brand" asp-controller="Home" asp-action="Index">
                <span class="pc-brand-icon">▦</span>
                <span>PhotoCopy<span>Hub</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0 pc-nav-links">
                    <li class="nav-item"><a class="nav-link @(controller == "Home" && action == "Index" ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">Tính năng</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#customers">Dành cho khách hàng</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#shops">Dành cho tiệm photo</a></li>

                    @if (User.Identity?.IsAuthenticated == true && (isCustomer || isAdmin))
                    {
                        <li class="nav-item"><a class="nav-link @(controller == "Dashboard" ? "active" : string.Empty)" asp-controller="Dashboard" asp-action="Index">Tổng quan</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "PrintJobs" ? "active" : string.Empty)" asp-controller="PrintJobs" asp-action="Index">Đơn in</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Wallet" ? "active" : string.Empty)" asp-controller="Wallet" asp-action="Index">Ví</a></li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center gap-lg-2 pc-nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (isCustomer || isAdmin)
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary pc-nav-btn" asp-controller="PrintJobs" asp-action="Create">Đặt in ngay</a>
                            </li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-nav-link" href="#" role="button" data-bs-toggle="dropdown">
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item @(controller == "Profile" ? "active" : string.Empty)" asp-controller="Profile" asp-action="Index">Hồ sơ</a></li>
                                @if (User.Identity?.IsAuthenticated == true && (isShopOperator || isAdmin))
                                {
                                    <li><a class="dropdown-item" asp-area="Shop" asp-controller="Dashboard" asp-action="Index">Khu vận hành tiệm</a></li>
                                }
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Khu quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item" type="submit">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @(controller == "Account" && action == "Login" ? "active" : string.Empty)" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@customerReturnUrl">Đăng nhập</a></li>
                        <li class="nav-item"><a class="btn btn-sm btn-primary pc-nav-btn" asp-controller="Account" asp-action="Register">Dùng thử miễn phí</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="site-main pc-site-main">
    <div class="container-xl">
        <partial name="_Alert" />
    </div>
    @RenderBody()
</main>

<footer class="site-footer pc-footer">
    <div class="container-xl pc-footer-grid">
        <div class="pc-footer-brand">
            <a class="pc-brand" asp-controller="Home" asp-action="Index">
                <span class="pc-brand-icon">▦</span>
                <span>PhotoCopy<span>Hub</span></span>
            </a>
            <p>Nền tảng web photocopy hiện đại cho khách hàng và tiệm photo.</p>
        </div>
        <div>
            <h2>Sản phẩm</h2>
            <a href="/#features">Tính năng</a>
            <a asp-controller="Home" asp-action="About">Hướng dẫn</a>
        </div>
        <div>
            <h2>Hỗ trợ</h2>
            <a asp-controller="Home" asp-action="About">Trung tâm trợ giúp</a>
            <a asp-controller="Home" asp-action="About">Liên hệ</a>
        </div>
        <div>
            <h2>Công ty</h2>
            <a asp-controller="Home" asp-action="About">Về chúng tôi</a>
            <a asp-controller="Home" asp-action="About">Chính sách</a>
        </div>
        <div class="pc-footer-contact">
            <span>✉ contact@photocopyhub.vn</span>
            <span>⌕ 028 1234 5678</span>
            <span>⌖ TP. Hồ Chí Minh, Việt Nam</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
