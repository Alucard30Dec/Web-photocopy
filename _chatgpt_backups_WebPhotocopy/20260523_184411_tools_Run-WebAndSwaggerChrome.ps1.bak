$ErrorActionPreference = "Stop"

$ProjectRoot = 'E:\OneDrive - 0dpmr\WebPhotocopy\Project'
Set-Location -LiteralPath $ProjectRoot

$WebProject = Join-Path $ProjectRoot 'src\PhotoCopyHub.Web\PhotoCopyHub.Web.csproj'
$HttpsBaseUrl = 'https://localhost:7250'
$HttpBaseUrl = 'http://localhost:5250'

$env:ASPNETCORE_ENVIRONMENT = 'Development'

function Find-Chrome {
    $candidates = @(
        "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
        "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
        "$env:LocalAppData\Google\Chrome\Application\chrome.exe"
    )

    foreach ($candidate in $candidates) {
        if (Test-Path -LiteralPath $candidate) {
            return $candidate
        }
    }

    return $null
}

function Wait-Until-WebReady {
    param(
        [Parameter(Mandatory = $true)][string]$Url
    )

    Write-Host "Đang chờ web chạy: $Url" -ForegroundColor Cyan

    for ($i = 1; $i -le 60; $i++) {
        try {
            $response = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 2
            if ($response.StatusCode -ge 200 -and $response.StatusCode -lt 500) {
                Write-Host "Web đã sẵn sàng." -ForegroundColor Green
                return
            }
        }
        catch {
            Start-Sleep -Seconds 1
        }
    }

    Write-Host "Không xác nhận được web đã sẵn sàng sau 60 giây, vẫn thử mở Chrome." -ForegroundColor Yellow
}

Write-Host "Đang chạy PhotoCopyHub.Web..." -ForegroundColor Cyan

$dotnetArgs = @(
    'run',
    '--project',
    $WebProject,
    '--urls',
    "$HttpsBaseUrl;$HttpBaseUrl"
)

$dotnetProcess = Start-Process -FilePath 'dotnet' -ArgumentList $dotnetArgs -PassThru

try {
    Wait-Until-WebReady -Url "$HttpBaseUrl/"

    $chrome = Find-Chrome

    if ($chrome) {
        Write-Host "Mở Chrome Web: $HttpsBaseUrl/" -ForegroundColor Green
        Start-Process -FilePath $chrome -ArgumentList @('--new-window', "$HttpsBaseUrl/")

        Start-Sleep -Seconds 1

        Write-Host "Mở Chrome Swagger: $HttpsBaseUrl/swagger" -ForegroundColor Green
        Start-Process -FilePath $chrome -ArgumentList @('--new-window', "$HttpsBaseUrl/swagger")
    }

    if (-not $chrome) {
        Write-Host "Không tìm thấy chrome.exe, mở bằng trình duyệt mặc định." -ForegroundColor Yellow
        Start-Process "$HttpsBaseUrl/"
        Start-Sleep -Seconds 1
        Start-Process "$HttpsBaseUrl/swagger"
    }

    Write-Host ""
    Write-Host "Đang chạy. Đóng cửa sổ này hoặc bấm Stop trong Visual Studio để dừng." -ForegroundColor Cyan
    $dotnetProcess.WaitForExit()
}
finally {
    if ($dotnetProcess -and -not $dotnetProcess.HasExited) {
        Stop-Process -Id $dotnetProcess.Id -Force
    }
}