@model LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng nhập admin hệ thống";

    if (string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        Model.ReturnUrl = "/Admin";
    }
}

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-card__intro">
            <span class="eyebrow">System Admin</span>
            <h1>Đăng nhập quản trị hệ thống</h1>
            <p>
                Khu vực này dành cho tài khoản quản trị tổng để quản lý cơ sở,
                người dùng, dữ liệu vận hành, cấu hình dịch vụ và đối soát hệ thống.
            </p>
            <div class="hero-actions mt-3">
                <a class="btn btn-light" href="/">Về trang chủ</a>
            </div>
        </div>

        <div class="auth-card__form">
            <h2>Đăng nhập admin</h2>
            <p class="text-muted mb-3">Chỉ tài khoản có quyền Admin mới truy cập được khu vực này.</p>

            <div class="alert alert-warning small mb-3">
                Tài khoản admin mẫu đã seed tự động:
                <div><strong>admin@photocopyhub.local</strong> / <strong>Admin@123456</strong></div>
            </div>

            <form action="/Admin/Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="admin@photocopyhub.local" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Đăng nhập admin hệ thống</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}