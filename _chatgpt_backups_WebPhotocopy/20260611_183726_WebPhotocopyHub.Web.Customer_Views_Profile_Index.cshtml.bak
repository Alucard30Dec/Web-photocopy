@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ khách hàng";
    var dashboardUrl = CustomerBranchContext.ToPath(ViewContext, "Dashboard");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
}

<section class="cu-page customer-profile-page">
    <section class="cu-hero customer-profile-hero">
        <div>
            <span class="cu-kicker">Hồ sơ khách hàng</span>
            <h1>@Model.FullName</h1>
            <p>Quản lý tên hiển thị, tên đăng nhập, Gmail/email, số điện thoại và địa chỉ để cơ sở liên hệ nhanh khi xử lý đơn.</p>
            <div class="cu-actions">
                <a class="btn btn-primary" href="@dashboardUrl">Dashboard</a>
                <a class="btn btn-outline-secondary" href="@walletUrl">Ví & giao dịch</a>
            </div>
        </div>
        <aside class="cu-hero-card customer-profile-summary">
            <span class="cu-card-label">Tài khoản</span>
            <strong>@Model.UserName</strong>
            <small>Gmail: @Model.Email</small>
            <small>Trạng thái: @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</small>
        </aside>
    </section>

    <section class="cu-card cu-card--narrow customer-profile-card">
        <div class="cu-section-head">
            <div>
                <span class="cu-kicker">Account data</span>
                <h2>Dữ liệu khách hàng</h2>
            </div>
        </div>

        <form asp-action="Index" method="post" class="cu-form customer-profile-form" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="customer-profile-grid">
                <div>
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" readonly />
                    <small class="form-text text-muted">Gmail/email dùng cho đăng nhập nhanh và liên hệ. Không chỉnh trực tiếp tại đây.</small>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="customer-profile-grid-full">
                    <label asp-for="Address" class="form-label"></label>
                    <textarea asp-for="Address" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="CreatedAt" class="form-label"></label>
                    <input value="@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" class="form-control" readonly />
                </div>

                <div>
                    <label asp-for="IsActive" class="form-label"></label>
                    <input value="@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")" class="form-control" readonly />
                </div>
            </div>

            <div class="cu-actions">
                <button class="btn btn-primary" type="submit">Lưu hồ sơ</button>
                <a class="btn btn-outline-secondary" href="@dashboardUrl">Hủy</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}