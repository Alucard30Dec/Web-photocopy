@using WebPhotocopyHub.Domain.Constants
@{
    var adminController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var adminAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isSystemAdmin = User.IsInRole(RoleConstants.Admin);
    var isAdminLoginPage = string.Equals(adminController, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(adminAction, "Login", StringComparison.OrdinalIgnoreCase);
    var accountName = User.Identity?.Name ?? "System Admin";
    var accountInitial = string.IsNullOrWhiteSpace(accountName)
        ? "A"
        : accountName.Substring(0, 1).ToUpperInvariant();

    string IsControllerActive(params string[] controllerNames)
    {
        return controllerNames.Contains(adminController, StringComparer.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị hệ thống - WebPhotocopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/WebPhotocopyHub.Web.Admin/css/admin-system.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="system-admin-body @(isAdminLoginPage ? "system-admin-login-body" : "adminref-body")">
    @if (isAdminLoginPage)
    {
        <header class="system-admin-header">
            <div class="system-admin-brandbar">
                <div class="container-fluid system-admin-container">
                    <a class="system-admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <span class="system-admin-logo" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z"></path>
                                <path d="m9 12 2 2 4-5"></path>
                            </svg>
                        </span>
                        <span>
                            <strong>WebPhotocopyHub</strong>
                            <small>System Administration</small>
                        </span>
                    </a>

                    <div class="system-admin-head-actions">
                        <div class="system-admin-login-context" aria-label="Khu vực quản trị hệ thống">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z"></path>
                                <path d="m9 12 2 2 4-5"></path>
                            </svg>
                            <span>Khu vực quản trị hệ thống</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    }

    @if (!isAdminLoginPage)
    {
        <svg class="adminref-symbols" aria-hidden="true" focusable="false">
            <symbol id="adm-icon-grid" viewBox="0 0 24 24">
                <rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect>
            </symbol>
            <symbol id="adm-icon-dashboard" viewBox="0 0 24 24">
                <path d="M4 13h6v7H4zM14 4h6v16h-6zM4 4h6v5H4z"></path>
            </symbol>
            <symbol id="adm-icon-data" viewBox="0 0 24 24">
                <ellipse cx="12" cy="5" rx="7" ry="3"></ellipse><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5"></path><path d="M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path>
            </symbol>
            <symbol id="adm-icon-import" viewBox="0 0 24 24">
                <path d="M5 4h10l4 4v12H5z"></path><path d="M15 4v4h4"></path><path d="M12 17V10"></path><path d="m9 13 3-3 3 3"></path>
            </symbol>
            <symbol id="adm-icon-export" viewBox="0 0 24 24">
                <path d="M5 4h10l4 4v12H5z"></path><path d="M15 4v4h4"></path><path d="M12 10v7"></path><path d="m9 14 3 3 3-3"></path>
            </symbol>
            <symbol id="adm-icon-report" viewBox="0 0 24 24">
                <path d="M5 4h14v16H5z"></path><path d="M8 16v-4M12 16V8M16 16v-6"></path>
            </symbol>
            <symbol id="adm-icon-admin" viewBox="0 0 24 24">
                <rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect>
            </symbol>
            <symbol id="adm-icon-settings" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="3"></circle><path d="M19 13.5v-3l-2-.7-.7-1.7.9-1.9-2.1-2.1-1.9.9-1.7-.7L10.5 2h-3l-.7 2-1.7.7-1.9-.9L1.1 5.9 2 7.8l-.7 1.7-2 .7v3l2 .7.7 1.7-.9 1.9 2.1 2.1 1.9-.9 1.7.7.7 2h3l.7-2 1.7-.7 1.9.9 2.1-2.1-.9-1.9.7-1.7z" transform="translate(2.5 0)"></path>
            </symbol>
            <symbol id="adm-icon-user" viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4"></circle><path d="M5 20a7 7 0 0 1 14 0"></path>
            </symbol>
            <symbol id="adm-icon-users" viewBox="0 0 24 24">
                <circle cx="9" cy="8" r="3"></circle><path d="M3 19a6 6 0 0 1 12 0"></path><circle cx="17" cy="9" r="2.5"></circle><path d="M15.5 14.5A5 5 0 0 1 21 19"></path>
            </symbol>
            <symbol id="adm-icon-key" viewBox="0 0 24 24">
                <circle cx="8" cy="15" r="4"></circle><path d="m11 12 8-8M16 7l2 2M14 9l2 2"></path>
            </symbol>
            <symbol id="adm-icon-logout" viewBox="0 0 24 24">
                <path d="M10 5H5v14h5"></path><path d="M13 8l4 4-4 4M17 12H9"></path>
            </symbol>
            <symbol id="adm-icon-log" viewBox="0 0 24 24">
                <path d="M6 4h12v16H6z"></path><path d="M9 8h6M9 12h6M9 16h4"></path>
            </symbol>
            <symbol id="adm-icon-api" viewBox="0 0 24 24">
                <path d="M8 7H5a3 3 0 0 0-3 3v4a3 3 0 0 0 3 3h3M16 7h3a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-3M8 12h8"></path>
            </symbol>
            <symbol id="adm-icon-bell" viewBox="0 0 24 24">
                <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 8h18c0-1-3-1-3-8"></path><path d="M10 21h4"></path>
            </symbol>
            <symbol id="adm-icon-globe" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
            </symbol>
        </svg>

        <header class="adminref-header">
            <div class="adminref-header-row">
                <a class="adminref-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-label="WebPhotocopyHub Dashboard">
                    <span class="adminref-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#adm-icon-grid"></use></svg>
                    </span>
                    <span class="adminref-brand-copy">
                        <strong>WebPhotocopyHub</strong>
                        <small>System Administration</small>
                    </span>
                </a>

                @if (isSystemAdmin)
                {
                    <nav class="adminref-primary-nav" aria-label="Điều hướng quản trị">
                        <a class="adminref-nav-item @(IsControllerActive("Dashboard"))"
                           asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            <svg aria-hidden="true"><use href="#adm-icon-dashboard"></use></svg>
                            <span>Dashboard</span>
                        </a>

                        <div class="adminref-nav-group adminref-nav-align-start">
                            <button class="adminref-nav-item adminref-nav-trigger @(IsControllerActive("Users"))"
                                    type="button"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <svg aria-hidden="true"><use href="#adm-icon-users"></use></svg>
                                <span>Người dùng</span>
                                <i class="adminref-nav-chevron" aria-hidden="true">⌄</i>
                            </button>
                            <div class="adminref-nav-dropdown" role="menu">
                                <a class="@(IsControllerActive("Users"))"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-users"></use></svg>
                                    <span>Quản lý tài khoản và phân quyền</span>
                                </a>
                            </div>
                        </div>

                        <div class="adminref-nav-group">
                            <button class="adminref-nav-item adminref-nav-trigger @(IsControllerActive("PrintJobs", "ProductOrders", "SupportOrders"))"
                                    type="button"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <svg aria-hidden="true"><use href="#adm-icon-export"></use></svg>
                                <span>Đơn hàng</span>
                                <i class="adminref-nav-chevron" aria-hidden="true">⌄</i>
                            </button>
                            <div class="adminref-nav-dropdown" role="menu">
                                <a class="@(IsControllerActive("PrintJobs"))"
                                   asp-area="Admin"
                                   asp-controller="PrintJobs"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-import"></use></svg>
                                    <span>Đơn in</span>
                                </a>
                                <a class="@(IsControllerActive("ProductOrders"))"
                                   asp-area="Admin"
                                   asp-controller="ProductOrders"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-export"></use></svg>
                                    <span>Đơn sản phẩm</span>
                                </a>
                                <a class="@(IsControllerActive("SupportOrders"))"
                                   asp-area="Admin"
                                   asp-controller="SupportOrders"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-settings"></use></svg>
                                    <span>Đơn dịch vụ hỗ trợ</span>
                                </a>
                            </div>
                        </div>

                        <div class="adminref-nav-group">
                            <button class="adminref-nav-item adminref-nav-trigger @(IsControllerActive("Products", "SupportServices", "PricingRules", "Inventory"))"
                                    type="button"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <svg aria-hidden="true"><use href="#adm-icon-data"></use></svg>
                                <span>Danh mục</span>
                                <i class="adminref-nav-chevron" aria-hidden="true">⌄</i>
                            </button>
                            <div class="adminref-nav-dropdown" role="menu">
                                <a class="@(IsControllerActive("Products"))"
                                   asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-data"></use></svg>
                                    <span>Sản phẩm</span>
                                </a>
                                <a class="@(IsControllerActive("SupportServices"))"
                                   asp-area="Admin"
                                   asp-controller="SupportServices"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-settings"></use></svg>
                                    <span>Dịch vụ hỗ trợ</span>
                                </a>
                                <a class="@(IsControllerActive("PricingRules"))"
                                   asp-area="Admin"
                                   asp-controller="PricingRules"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-report"></use></svg>
                                    <span>Quy tắc tính giá</span>
                                </a>
                                <a class="@(IsControllerActive("Inventory"))"
                                   asp-area="Admin"
                                   asp-controller="Inventory"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-data"></use></svg>
                                    <span>Kho và tồn sản phẩm</span>
                                </a>
                            </div>
                        </div>

                        <div class="adminref-nav-group">
                            <button class="adminref-nav-item adminref-nav-trigger @(IsControllerActive("TopUpRequests", "WalletTransactions", "Reconciliation"))"
                                    type="button"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <svg aria-hidden="true"><use href="#adm-icon-report"></use></svg>
                                <span>Tài chính</span>
                                <i class="adminref-nav-chevron" aria-hidden="true">⌄</i>
                            </button>
                            <div class="adminref-nav-dropdown" role="menu">
                                <a class="@(IsControllerActive("TopUpRequests"))"
                                   asp-area="Admin"
                                   asp-controller="TopUpRequests"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-import"></use></svg>
                                    <span>Yêu cầu nạp tiền</span>
                                </a>
                                <a class="@(IsControllerActive("WalletTransactions"))"
                                   asp-area="Admin"
                                   asp-controller="WalletTransactions"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-report"></use></svg>
                                    <span>Giao dịch ví</span>
                                </a>
                                <a class="@(IsControllerActive("Reconciliation"))"
                                   asp-area="Admin"
                                   asp-controller="Reconciliation"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-key"></use></svg>
                                    <span>Đối soát số dư</span>
                                </a>
                            </div>
                        </div>

                        <div class="adminref-nav-group adminref-nav-align-end">
                            <button class="adminref-nav-item adminref-nav-trigger @(IsControllerActive("SystemMonitoring", "AuditLogs"))"
                                    type="button"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <svg aria-hidden="true"><use href="#adm-icon-admin"></use></svg>
                                <span>Hệ thống</span>
                                <i class="adminref-nav-chevron" aria-hidden="true">⌄</i>
                            </button>
                            <div class="adminref-nav-dropdown" role="menu">
                                <a class="@(IsControllerActive("SystemMonitoring"))"
                                   asp-area="Admin"
                                   asp-controller="SystemMonitoring"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-api"></use></svg>
                                    <span>Giám sát hệ thống</span>
                                </a>
                                <a class="@(IsControllerActive("AuditLogs"))"
                                   asp-area="Admin"
                                   asp-controller="AuditLogs"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-log"></use></svg>
                                    <span>Nhật ký kiểm toán</span>
                                </a>
                                <a asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index"
                                   role="menuitem">
                                    <svg aria-hidden="true"><use href="#adm-icon-globe"></use></svg>
                                    <span>Về trang chính</span>
                                </a>
                            </div>
                        </div>
                    </nav>
                }

                <div class="adminref-head-actions">
                    <a class="adminref-health" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">
                        <span aria-hidden="true"></span>
                        <strong>Hệ thống hoạt động tốt</strong>
                    </a>
                    <a class="adminref-icon-button" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" aria-label="Nhật ký và thông báo">
                        <svg aria-hidden="true"><use href="#adm-icon-bell"></use></svg>
                    </a>
                    <a class="adminref-icon-button" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Mở trang chính">
                        <svg aria-hidden="true"><use href="#adm-icon-globe"></use></svg>
                    </a>
                    <div class="dropdown adminref-account">
                        <button class="adminref-account-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="adminref-account-avatar">@accountInitial</span>
                            <span class="adminref-account-copy">
                                <strong>@accountName</strong>
                                <small>Quản trị viên toàn hệ thống</small>
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end adminref-account-menu">
                            <div class="adminref-account-menu-head">
                                <span class="adminref-account-avatar">@accountInitial</span>
                                <div>
                                    <strong>@accountName</strong>
                                    <small>Phiên quản trị đang hoạt động</small>
                                </div>
                            </div>
                            <a class="dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Quản lý tài khoản và quyền</a>
                            <a class="dropdown-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Xem nhật ký hoạt động</a>
                            <a class="dropdown-item" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">Giám sát hệ thống</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Về trang chính</a>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-2 pb-1">
                                <input type="hidden" name="returnUrl" value="/" />
                                <button class="btn btn-outline-danger btn-sm w-100" type="submit">Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    }

    <main class="container-fluid system-admin-container system-admin-main @(!isAdminLoginPage ? "adminref-main" : string.Empty)">
        <partial name="_Alert" />
        @RenderBody()
    </main>

    @if (!isAdminLoginPage)
    {
        <footer class="adminref-footer">
            <div class="container-fluid system-admin-container">
                <span>WebPhotocopyHub System Administration</span>
                <span>Quyền truy cập được kiểm soát theo role Admin.</span>
            </div>
        </footer>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (!isAdminLoginPage)
    {
        <script src="~/_content/WebPhotocopyHub.Web.Admin/js/admin-navigation.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
