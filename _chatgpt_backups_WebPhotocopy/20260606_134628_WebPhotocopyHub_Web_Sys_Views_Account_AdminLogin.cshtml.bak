@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập admin hệ thống";
}

<section class="role-login-page role-login-page--admin">
    <div class="role-login-hero">
        <a class="role-login-brand" href="/Admin">
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
            PhotoCopyHub Admin
        </a>
        <h1>Admin toàn hệ thống</h1>
        <p>Chỉ dành cho tài khoản quản trị hệ thống để quản lý người dùng, ví, bảng giá và audit log.</p>
        <div class="role-login-pills">
            <span>Người dùng</span>
            <span>Ví hệ thống</span>
            <span>Audit log</span>
        </div>
    </div>

    <div class="role-login-card">
        <span class="role-login-kicker">System admin</span>
        <h2>Đăng nhập admin</h2>
        <form asp-action="AdminLogin" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control mb-3" placeholder="admin@photocopyhub.local" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control mb-3" placeholder="Mật khẩu admin" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button class="btn btn-dark w-100" type="submit">Vào admin hệ thống</button>
        </form>
        <a class="role-login-alt" href="/Home">Quay về trang chính</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
