{
    "$schema":  "https://json.schemastore.org/launchsettings.json",
    "profiles":  {
                     "https":  {
                                   "commandName":  "Project",
                                   "dotnetRunMessages":  true,
                                   "launchBrowser":  false,
                                   "applicationUrl":  "https://localhost:7250;http://localhost:5250",
