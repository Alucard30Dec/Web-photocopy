:root {
    --sys-ink: #102a43;
    --sys-muted: #5f7488;
    --sys-line: #d8e4ee;
    --sys-line-strong: #bdd2e1;
    --sys-surface: #ffffff;
    --sys-surface-soft: #f5f9fc;
    --sys-surface-tint: #edf6fb;
    --sys-brand: #087ea4;
    --sys-brand-strong: #075985;
    --sys-navy: #0b2f49;
    --sys-success: #13795b;
    --sys-warning: #b86b00;
    --sys-danger: #b42318;
    --sys-shadow: 0 12px 30px rgba(15, 45, 66, 0.08);
    --sys-radius: 16px;
}

.system-admin-body {
    min-height: 100vh;
    margin: 0;
    color: var(--sys-ink);
    background:
        radial-gradient(circle at 92% 6%, rgba(255, 204, 112, 0.14), transparent 24rem),
        linear-gradient(180deg, #eef6fa 0, #f7fafc 270px, #f8fafc 100%);
    font-family: "Be Vietnam Pro", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
}

.system-admin-body *,
.system-admin-body *::before,
.system-admin-body *::after {
    box-sizing: border-box;
}

.system-admin-body a {
    text-decoration: none;
}

.system-admin-body h1,
.system-admin-body h2,
.system-admin-body h3,
.system-admin-body strong,
.system-admin-body .btn {
    letter-spacing: -0.015em;
}

.system-admin-container {
    width: min(100%, 1720px);
    margin-inline: auto;
    padding-inline: clamp(14px, 2.1vw, 34px);
}

.system-admin-header {
    position: sticky;
    top: 0;
    z-index: 1030;
    box-shadow: 0 8px 24px rgba(8, 45, 68, 0.09);
}

.system-admin-brandbar {
    color: #fff;
    background: linear-gradient(115deg, #082f49 0%, #075985 55%, #0e7490 100%);
}

.system-admin-brandbar .system-admin-container {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.system-admin-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
}

.system-admin-brand:hover {
    color: #fff;
}

.system-admin-logo {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.system-admin-logo svg,
.system-nav-icon svg {
    width: 21px;
    height: 21px;
    fill: currentColor;
}

.system-admin-brand > span:last-child {
    display: grid;
    line-height: 1.15;
}

.system-admin-brand strong {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    font-weight: 800;
}

.system-admin-brand small {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.system-admin-head-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.system-status-pill {
    min-height: 38px;
    padding: 8px 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e9fbff;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-weight: 600;
}

.system-status-pill:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
}

.system-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #5ee6a8;
    box-shadow: 0 0 0 4px rgba(94, 230, 168, 0.15);
}

.system-account-trigger {
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
}

.system-account-trigger:hover,
.system-account-trigger:focus,
.system-account-trigger.show {
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
}

.system-account-avatar,
.system-user-avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-weight: 800;
}

.system-account-avatar {
    width: 29px;
    height: 29px;
    color: #0b4665;
    background: #dff6ff;
}

.system-account-copy {
    display: grid;
    min-width: 0;
    text-align: left;
    line-height: 1.12;
}

.system-account-copy strong {
    max-width: 220px;
    overflow: hidden;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.system-account-copy small {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 10px;
}

.system-account-menu {
    width: 300px;
    padding: 8px;
    border: 1px solid var(--sys-line);
    border-radius: 14px;
    box-shadow: var(--sys-shadow);
}

.system-account-menu-head {
    display: grid;
    gap: 4px;
    padding: 10px 11px 12px;
    border-bottom: 1px solid var(--sys-line);
}

.system-account-menu-head small {
    color: var(--sys-muted);
    font-size: 11px;
    line-height: 1.45;
}

.system-account-menu .dropdown-item {
    padding: 9px 10px;
    border-radius: 9px;
    color: var(--sys-ink);
    font-size: 12px;
    font-weight: 600;
}

.system-account-menu .dropdown-item:hover {
    background: var(--sys-surface-tint);
}

.system-admin-commandbar {
    background: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid var(--sys-line);
    backdrop-filter: blur(16px);
}

.system-admin-nav {
    min-height: 70px;
    display: grid;
    grid-template-columns: repeat(6, minmax(160px, 1fr));
    align-items: stretch;
    gap: 7px;
    padding-block: 8px;
}

.system-nav-group {
    min-width: 0;
}

.system-nav-trigger {
    width: 100%;
    min-height: 53px;
    padding: 7px 9px;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 12px;
    align-items: center;
    gap: 8px;
    color: #29465d;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    text-align: left;
    transition: 150ms ease;
}

.system-nav-trigger:hover,
.system-nav-trigger:focus,
.system-nav-trigger.show,
.system-nav-trigger.active {
    color: #075985;
    border-color: #9dd8eb;
    background: #eefaff;
    box-shadow: 0 4px 12px rgba(8, 126, 164, 0.08);
}

.system-nav-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    color: #2f607b;
    border-radius: 10px;
    background: #edf4f8;
}

.system-nav-trigger.active .system-nav-icon,
.system-nav-trigger:hover .system-nav-icon {
    color: #fff;
    background: linear-gradient(135deg, #087ea4, #16a4c8);
}

.system-nav-trigger > span:nth-child(2) {
    min-width: 0;
    display: grid;
    gap: 2px;
}

.system-nav-trigger strong {
    overflow: hidden;
    font-size: 11px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.system-nav-trigger small {
    overflow: hidden;
    color: #7790a2;
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.system-nav-chevron {
    color: #7790a2;
    font-size: 14px;
}

.system-nav-menu {
    width: min(360px, calc(100vw - 28px));
    padding: 9px;
    border: 1px solid var(--sys-line);
    border-radius: 15px;
    box-shadow: 0 20px 45px rgba(15, 45, 66, 0.16);
}

.system-nav-menu-heading {
    display: grid;
    gap: 4px;
    padding: 9px 10px 12px;
    border-bottom: 1px solid var(--sys-line);
}

.system-nav-menu-heading strong {
    font-size: 12px;
}

.system-nav-menu-heading small {
    color: var(--sys-muted);
    font-size: 10px;
    line-height: 1.45;
}

.system-nav-item {
    margin-top: 5px;
    padding: 9px 10px;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    border-radius: 10px;
    white-space: normal;
}

.system-nav-item:hover,
.system-nav-item.active {
    color: #075985;
    background: #effaff;
}

.system-nav-item-mark {
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    color: #527188;
    border: 1px solid #d6e5ee;
    border-radius: 8px;
    background: #fff;
    font-size: 9px;
    font-weight: 800;
}

.system-nav-item > span:last-child {
    min-width: 0;
    display: grid;
    gap: 2px;
}

.system-nav-item strong {
    font-size: 11px;
}

.system-nav-item small {
    color: #71889a;
    font-size: 9px;
}


.system-admin-main {
    min-height: calc(100vh - 190px);
    padding-top: 18px;
    padding-bottom: 38px;
}

.system-admin-main > .alert {
    margin-bottom: 14px;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(15, 45, 66, 0.06);
}

.system-page-hero {
    min-height: 154px;
    padding: clamp(22px, 3vw, 34px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
    position: relative;
    border: 1px solid #cfe1ec;
    border-radius: 20px;
    background:
        radial-gradient(circle at 96% 10%, rgba(255, 194, 82, 0.25) 0 80px, transparent 81px),
        linear-gradient(120deg, #edf8fd 0%, #f8fbfd 60%, #fff9ed 100%);
    box-shadow: var(--sys-shadow);
}

.system-page-hero.compact {
    min-height: 132px;
    padding-block: 24px;
}

.system-page-hero h1 {
    margin: 5px 0 7px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(24px, 2.3vw, 36px);
    font-weight: 800;
    color: #173a55;
}

.system-page-hero p {
    max-width: 860px;
    margin: 0;
    color: var(--sys-muted);
    line-height: 1.6;
}

.system-eyebrow,
.system-panel-kicker {
    color: #087ea4;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.system-hero-meta,
.system-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}

.system-hero-meta {
    margin-top: 14px;
}

.system-hero-actions {
    flex: 0 0 auto;
    justify-content: flex-end;
}

.system-admin-body .btn {
    border-radius: 10px;
    font-weight: 700;
}

.system-admin-body .btn-primary {
    border-color: #087ea4;
    background: linear-gradient(135deg, #087ea4, #0d8fba);
}

.system-admin-body .btn-primary:hover {
    border-color: #066c8e;
    background: #066c8e;
}

.system-health-chip,
.system-soft-chip,
.system-access-badge,
.system-method-badge,
.system-stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
}

.system-health-chip,
.system-soft-chip {
    min-height: 28px;
    padding: 5px 10px;
}

.system-soft-chip {
    color: #48677d;
    border: 1px solid #d3e3ec;
    background: rgba(255, 255, 255, 0.78);
}

.system-health-chip span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 12%, transparent);
}

.is-success {
    color: var(--sys-success) !important;
}

.is-warning {
    color: var(--sys-warning) !important;
}

.is-danger {
    color: var(--sys-danger) !important;
}

.system-health-chip.is-success,
.system-stock-badge.is-success {
    border: 1px solid #b8e2d5;
    background: #eefbf6;
}

.system-health-chip.is-warning,
.system-stock-badge.is-warning {
    border: 1px solid #f2d292;
    background: #fff8e8;
}

.system-health-chip.is-danger,
.system-stock-badge.is-danger {
    border: 1px solid #f0b9b5;
    background: #fff2f1;
}

.system-kpi-grid,
.system-runtime-grid {
    display: grid;
    gap: 12px;
    margin-top: 14px;
}

.system-kpi-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
}

.system-runtime-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
}

.system-kpi-card,
.system-runtime-card {
    min-width: 0;
    border: 1px solid var(--sys-line);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 7px 18px rgba(15, 45, 66, 0.05);
}

.system-kpi-card {
    min-height: 126px;
    padding: 16px;
    display: grid;
    align-content: center;
    gap: 5px;
    position: relative;
    overflow: hidden;
    color: var(--sys-ink);
    transition: 150ms ease;
}

.system-kpi-card::before {
    content: "";
    width: 5px;
    position: absolute;
    inset: 0 auto 0 0;
    background: #3b82f6;
}

.system-kpi-card:hover {
    color: var(--sys-ink);
    transform: translateY(-2px);
    border-color: #a8ccdf;
    box-shadow: 0 14px 30px rgba(15, 45, 66, 0.10);
}

.system-kpi-card.tone-amber::before { background: #f59e0b; }
.system-kpi-card.tone-cyan::before { background: #06b6d4; }
.system-kpi-card.tone-violet::before { background: #8b5cf6; }
.system-kpi-card.tone-green::before { background: #10b981; }
.system-kpi-card.tone-rose::before { background: #f43f5e; }

.system-kpi-label,
.system-runtime-card > span {
    color: #657f92;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.045em;
}

.system-kpi-card > strong {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 27px;
    color: #173a55;
}

.system-kpi-card small,
.system-runtime-card small {
    color: var(--sys-muted);
    font-size: 10px;
    line-height: 1.45;
}

.system-runtime-card {
    min-height: 108px;
    padding: 15px;
    display: grid;
    align-content: center;
    gap: 5px;
}

.system-runtime-card strong {
    color: #153b57;
    font-size: 20px;
}

.system-dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(300px, 0.82fr);
    gap: 14px;
}

.system-panel {
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--sys-line);
    border-radius: var(--sys-radius);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 8px 22px rgba(15, 45, 66, 0.055);
}

.system-panel-span-2 {
    min-width: 0;
}

.system-panel-header {
    margin-bottom: 13px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
}

.system-panel-header h2 {
    margin: 3px 0 0;
    color: #183b56;
    font-size: 16px;
    font-weight: 800;
}

.system-panel-note {
    color: #6d8496;
    font-size: 10px;
    text-align: right;
}

.system-priority-grid,
.system-control-grid,
.system-capability-grid,
.system-health-grid {
    display: grid;
    gap: 10px;
}

.system-priority-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.system-control-grid,
.system-capability-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.system-health-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.system-priority-card,
.system-control-card,
.system-capability-card,
.system-health-card {
    min-width: 0;
    padding: 13px;
    border: 1px solid #d9e7ef;
    border-radius: 12px;
    background: #f9fcfe;
}

.system-priority-card,
.system-control-card,
.system-capability-card {
    color: var(--sys-ink);
}

.system-priority-card:hover,
.system-control-card:hover,
.system-capability-card:hover {
    color: var(--sys-ink);
    border-color: #9dcbdc;
    background: #f0faff;
}

.system-priority-card strong,
.system-control-card strong,
.system-capability-card strong {
    display: block;
    font-size: 12px;
}

.system-priority-card b {
    display: block;
    margin-top: 7px;
    color: #143c58;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px;
}

.system-priority-card small,
.system-control-card small,
.system-capability-card small,
.system-health-card small {
    display: block;
    margin-top: 4px;
    color: var(--sys-muted);
    font-size: 10px;
    line-height: 1.45;
}

.system-health-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 7px 12px;
    border-left-width: 4px;
}

.system-health-card > div {
    display: grid;
    gap: 2px;
}

.system-health-card > div span {
    color: var(--sys-muted);
    font-size: 10px;
}

.system-health-card > div strong,
.system-health-card b {
    font-size: 12px;
}

.system-health-card small {
    grid-column: 1 / -1;
}

.system-guidance-list,
.system-activity-list,
.system-order-lines,
.system-action-stack {
    display: grid;
    gap: 8px;
}

.system-guidance-list > div {
    padding: 11px 12px;
    border: 1px solid #dce9f0;
    border-radius: 11px;
    background: #f8fbfd;
}

.system-guidance-list strong,
.system-guidance-list small {
    display: block;
}

.system-guidance-list strong {
    font-size: 11px;
}

.system-guidance-list small {
    margin-top: 3px;
    color: var(--sys-muted);
    font-size: 9px;
    line-height: 1.5;
}

.system-activity-item {
    padding: 10px 11px;
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    color: var(--sys-ink);
    border: 1px solid #dce9f0;
    border-radius: 11px;
    background: #fbfdfe;
}

.system-activity-item:hover {
    color: var(--sys-ink);
    border-color: #a7cfdf;
    background: #f2fbff;
}

.system-activity-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #0ea5c6;
    box-shadow: 0 0 0 4px rgba(14, 165, 198, 0.1);
}

.system-activity-item > div:nth-child(2),
.system-activity-meta {
    min-width: 0;
    display: grid;
    gap: 2px;
}

.system-activity-item strong {
    overflow: hidden;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.system-activity-item small,
.system-activity-meta span {
    color: var(--sys-muted);
    font-size: 9px;
}

.system-activity-meta {
    text-align: right;
}

.system-admin-body .table-responsive {
    border-radius: 12px;
}

.system-table-wrap {
    border: 1px solid var(--sys-line);
    border-radius: 12px;
}

.system-admin-body .system-table,
.system-admin-body main > .table-responsive > .table,
.system-admin-body main > .table {
    margin: 0;
    color: var(--sys-ink);
    background: #fff;
}

.system-admin-body .system-table thead th,
.system-admin-body main > .table-responsive > .table thead th,
.system-admin-body main > .table thead th {
    padding: 11px 12px;
    color: #587185;
    border-bottom: 1px solid var(--sys-line-strong);
    background: #f3f8fb;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
}

.system-admin-body .system-table tbody td,
.system-admin-body main > .table-responsive > .table tbody td,
.system-admin-body main > .table tbody td {
    padding: 11px 12px;
    border-color: #e5edf2;
    font-size: 11px;
    vertical-align: middle;
}

.system-admin-body .system-table tbody tr:hover td,
.system-admin-body main > .table-responsive > .table tbody tr:hover td,
.system-admin-body main > .table tbody tr:hover td {
    background: #f8fcfe;
}

.system-method-badge,
.system-access-badge,
.system-stock-badge {
    min-height: 24px;
    padding: 4px 8px;
}

.system-method-badge {
    color: #075985;
    border: 1px solid #b9dfeb;
    background: #eefaff;
}

.system-access-badge.is-protected {
    color: #126148;
    border: 1px solid #b7dfd1;
    background: #effaf6;
}

.system-access-badge.is-public {
    color: #8b4d08;
    border: 1px solid #efd39a;
    background: #fff9ea;
}

.system-stock-badge {
    min-width: 44px;
    justify-content: center;
    font-size: 12px;
}

.system-admin-body code,
.system-mono {
    color: #075985;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    word-break: break-all;
}

.system-filter-grid {
    display: grid;
    grid-template-columns: minmax(220px, 2fr) repeat(5, minmax(140px, 1fr)) auto;
    align-items: end;
    gap: 9px;
}

.system-filter-field {
    min-width: 0;
}

.system-filter-field label {
    display: block;
    margin-bottom: 5px;
    color: #5f7789;
    font-size: 9px;
    font-weight: 700;
}

.system-admin-body .form-control,
.system-admin-body .form-select {
    min-height: 37px;
    color: var(--sys-ink);
    border-color: #cbdde8;
    border-radius: 9px;
    background-color: #fff;
    font-size: 11px;
}

.system-admin-body .form-control:focus,
.system-admin-body .form-select:focus {
    border-color: #5cb9d4;
    box-shadow: 0 0 0 3px rgba(8, 126, 164, 0.11);
}

.system-pagination {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    color: var(--sys-muted);
    font-size: 10px;
}

.system-empty-state {
    padding: 26px;
    color: var(--sys-muted);
    text-align: center;
    font-size: 11px;
}

.system-user-cell {
    min-width: 210px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.system-user-avatar {
    width: 34px;
    height: 34px;
    color: #075985;
    background: #e7f6fb;
}

.system-user-cell > div {
    min-width: 0;
    display: grid;
    gap: 2px;
}

.system-user-cell strong,
.system-user-cell small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.system-user-cell small {
    max-width: 230px;
    color: var(--sys-muted);
    font-size: 8px;
}

.system-role-form,
.system-inline-form,
.system-stock-form {
    display: grid;
    gap: 6px;
}

.system-role-form {
    grid-template-columns: minmax(120px, 1fr) auto;
}

.system-inline-form {
    grid-template-columns: minmax(115px, 0.8fr) minmax(130px, 1.2fr) auto;
}

.system-stock-form {
    grid-template-columns: 95px minmax(160px, 1fr) auto;
}

.system-action-stack {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.system-action-stack .btn {
    width: 100%;
    white-space: nowrap;
}

.system-order-lines span {
    display: block;
    min-width: 170px;
    padding-bottom: 4px;
    border-bottom: 1px dashed #dde8ee;
}

.system-order-lines span:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.system-order-lines small {
    color: var(--sys-muted);
}

.system-admin-body main > h1,
.system-admin-body main > h2 {
    color: #173a55;
    font-family: "Plus Jakarta Sans", sans-serif;
}

.system-admin-body main > form,
.system-admin-body main > .card,
.system-admin-body main > .row > [class*="col"] > .card {
    border-color: var(--sys-line);
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(15, 45, 66, 0.055);
}

.system-admin-footer {
    color: #6a8294;
    border-top: 1px solid var(--sys-line);
    background: rgba(255, 255, 255, 0.78);
    font-size: 9px;
}

.system-admin-footer .system-admin-container {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

@media (max-width: 1400px) {
    .system-admin-nav {
        grid-template-columns: repeat(3, minmax(190px, 1fr));
    }

    .system-kpi-grid,
    .system-runtime-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .system-filter-grid {
        grid-template-columns: repeat(4, minmax(150px, 1fr));
    }
}

@media (max-width: 980px) {
    .system-admin-header {
        position: static;
    }

    .system-page-hero {
        align-items: flex-start;
        flex-direction: column;
    }

    .system-hero-actions {
        justify-content: flex-start;
    }

    .system-dashboard-grid {
        grid-template-columns: 1fr;
    }

    .system-priority-grid,
    .system-control-grid,
    .system-capability-grid,
    .system-health-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .system-filter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 720px) {
    .system-admin-brandbar .system-admin-container {
        padding-block: 9px;
        align-items: flex-start;
        flex-direction: column;
    }

    .system-admin-head-actions {
        width: 100%;
        justify-content: space-between;
    }

    .system-account-copy {
        display: none;
    }

    .system-admin-nav {
        grid-template-columns: 1fr 1fr;
    }

    .system-kpi-grid,
    .system-runtime-grid,
    .system-priority-grid,
    .system-control-grid,
    .system-capability-grid,
    .system-health-grid {
        grid-template-columns: 1fr;
    }

    .system-filter-grid,
    .system-role-form,
    .system-inline-form,
    .system-stock-form,
    .system-action-stack {
        grid-template-columns: 1fr;
    }

    .system-panel-header,
    .system-admin-footer .system-admin-container {
        align-items: flex-start;
        flex-direction: column;
    }

    .system-panel-note {
        text-align: left;
    }

    .system-activity-item {
        grid-template-columns: 9px minmax(0, 1fr);
    }

    .system-activity-meta {
        grid-column: 2;
        text-align: left;
    }
}

@media (max-width: 460px) {
    .system-admin-nav {
        grid-template-columns: 1fr;
    }

    .system-status-pill span:last-child {
        display: none;
    }

    .system-page-hero {
        padding: 20px;
        border-radius: 15px;
    }

    .system-page-hero h1 {
        font-size: 24px;
    }
}

.system-kpi-grid + .system-dashboard-grid {
    margin-top: 14px;
}

.system-priority-index {
    display: inline-flex;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    color: #56768a;
    border: 1px solid #d6e5ed;
    border-radius: 8px;
    background: #fff;
    font-size: 9px;
    font-weight: 800;
}

.system-priority-card.is-hot {
    border-color: #f0cf8f;
    background: #fff9eb;
}

.system-control-list {
    display: grid;
    gap: 8px;
}

.system-control-list a {
    padding: 11px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--sys-ink);
    border: 1px solid #dce9f0;
    border-radius: 11px;
    background: #f8fbfd;
}

.system-control-list a:hover {
    color: var(--sys-ink);
    border-color: #a7cfdf;
    background: #f0faff;
}

.system-control-list span {
    color: #607b8d;
    font-size: 10px;
}

.system-control-list strong {
    font-size: 10px;
    text-align: right;
}

.system-capability-card > span {
    color: #087ea4;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.system-capability-card h3 {
    margin: 6px 0 5px;
    color: #183b56;
    font-size: 14px;
    font-weight: 800;
}

.system-capability-card p {
    min-height: 45px;
    margin: 0 0 10px;
    color: var(--sys-muted);
    font-size: 10px;
    line-height: 1.5;
}

.system-capability-card a {
    color: #087ea4;
    font-size: 10px;
    font-weight: 700;
}

.system-action-badge {
    display: inline-flex;
    max-width: 220px;
    padding: 5px 8px;
    overflow: hidden;
    color: #075985;
    border: 1px solid #bdddea;
    border-radius: 8px;
    background: #effaff;
    font-size: 9px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.system-details-cell {
    min-width: 220px;
    max-width: 430px;
    color: #4f697c;
    font-size: 10px !important;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.system-filter-actions {
    display: flex;
    gap: 7px;
}

.system-filter-wide {
    grid-column: span 2;
}

@media (max-width: 1400px) {
    .system-filter-wide {
        grid-column: span 2;
    }
}

@media (max-width: 720px) {
    .system-filter-wide {
        grid-column: auto;
    }

    .system-filter-actions {
        flex-direction: column;
    }
}
