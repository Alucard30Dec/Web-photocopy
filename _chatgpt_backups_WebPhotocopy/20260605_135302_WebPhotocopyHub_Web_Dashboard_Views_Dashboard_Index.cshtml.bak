@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<section class="page-hero mb-3">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <span class="dashboard-kicker">Customer workspace</span>
            <h3 class="mb-2 mt-2">Xin chào, @User.Identity?.Name</h3>
            <p class="mb-0">Theo dõi số dư, đơn in và lịch sử giao dịch tập trung tại một nơi để thao tác nhanh khi cần.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="PrintJobs" asp-action="Create">Tạo đơn in</a>
            <a class="btn btn-outline-secondary" asp-controller="Wallet" asp-action="TopUp">Nạp ví</a>
        </div>
    </div>
</section>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Số dư hiện tại</div>
            <div class="stat-value text-success">@Model.CurrentBalance.ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Yêu cầu nạp chờ duyệt</div>
            <div class="stat-value">@Model.PendingTopUpCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Đơn in</div>
            <div class="stat-value">@Model.PrintJobsCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Đơn văn phòng phẩm + hỗ trợ</div>
            <div class="stat-value">@(Model.ProductOrdersCount + Model.SupportOrdersCount)</div>
        </div>
    </div>
</div>

<div class="workspace-grid">
    <section class="workspace-panel">
        <div class="workspace-panel-header">
            <div>
                <span class="panel-eyebrow">Thao tác nhanh</span>
                <h4>Chuẩn bị đơn trước khi đến tiệm</h4>
            </div>
        </div>

        <div class="quick-action-grid">
            <a class="quick-action-card" asp-controller="PrintJobs" asp-action="Create">
                <span>01</span>
                <strong>Tạo đơn in</strong>
                <small>Upload file, chọn in màu, 2 mặt, đóng gáy.</small>
            </a>
            <a class="quick-action-card" asp-controller="Wallet" asp-action="TopUp">
                <span>02</span>
                <strong>Nạp ví</strong>
                <small>Gửi yêu cầu nạp tiền để thanh toán đơn nhanh.</small>
            </a>
            <a class="quick-action-card" asp-controller="Products" asp-action="Index">
                <span>03</span>
                <strong>Mua văn phòng phẩm</strong>
                <small>Đặt thêm giấy, bút, bìa hồ sơ cùng lúc.</small>
            </a>
            <a class="quick-action-card" asp-controller="SupportOrders" asp-action="Create">
                <span>04</span>
                <strong>Dịch vụ hỗ trợ</strong>
                <small>Scan, ép plastic, đóng gáy sau khi in.</small>
            </a>
        </div>
    </section>

    <aside class="workspace-panel customer-branch-panel">
        <span class="panel-eyebrow">Cơ sở gợi ý</span>
        <h4>Nhận bài tại cơ sở gần trường</h4>
        <p>Chọn cơ sở trên trang chính trước khi đăng nhập để tiệm thấy đúng hàng chờ xử lý.</p>
        <div class="branch-mini-list">
            <span>Đại học Quốc gia</span>
            <span>Sư Phạm</span>
            <span>Bách Khoa</span>
        </div>
        <a class="btn btn-outline-secondary w-100" asp-controller="Home" asp-action="Index" asp-fragment="branches">Xem danh sách cơ sở</a>
    </aside>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Giao dịch ví gần đây</span>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Wallet" asp-action="Index">Xem ví</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Loại</th>
                    <th>Số tiền</th>
                    <th>Số dư sau GD</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.RecentTransactions.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Chưa có giao dịch nào.</td>
                </tr>
            }
            else
            {
                @foreach (var tx in Model.RecentTransactions)
                {
                    <tr>
                        <td>@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@tx.TransactionType.GetDisplayName()</td>
                        <td class="@(tx.Amount >= 0 ? "text-success" : "text-danger")">@tx.Amount.ToString("N0")</td>
                        <td>@tx.BalanceAfter.ToString("N0")</td>
                        <td>@tx.Note</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
