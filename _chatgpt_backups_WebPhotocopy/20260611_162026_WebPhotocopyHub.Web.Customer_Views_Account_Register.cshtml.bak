@model RegisterViewModel
@{
    Layout = "_BranchCustomerLayout";
    var branch = ViewData["Branch"] as ShopBranchLinkViewModel;
    ViewData["Title"] = "Tạo tài khoản khách hàng";

    var branchSlug = branch?.Slug ?? ViewContext.RouteData.Values["branchSlug"]?.ToString() ?? "";
    var branchName = branch?.Name ?? branchSlug;
    var formAction = "/" + branchSlug + "/Register";
    var loginUrl = "/" + branchSlug + "/Login";
    var homeUrl = "/" + branchSlug;
}

<section class="role-login-page role-login-page--customer">
    <div class="role-login-hero">
        <a class="role-login-brand" href="@homeUrl">
            <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10h18l-1.5-6h-15z"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg></span>
            @branchName
        </a>
        <h1>Tạo tài khoản khách hàng</h1>
        <p>Tạo tài khoản để đặt in, thanh toán theo từng đơn và theo dõi trạng thái xử lý tại @branchName.</p>
        <div class="role-login-pills">
            <span>Gửi file</span>
            <span>Thanh toán theo đơn</span>
            <span>Theo dõi trạng thái</span>
        </div>
    </div>

    <div class="role-login-card">
        <span class="role-login-kicker">Khách hàng</span>
        <h2>Đăng ký tại cơ sở</h2>

        <form action="@formAction" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control mb-3" />
            <span asp-validation-for="FullName" class="text-danger"></span>

            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control mb-3" placeholder="email@domain.com" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control mb-3" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>

            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control mb-3" />
            <span asp-validation-for="Address" class="text-danger"></span>

            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control mb-3" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control mb-3" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

            <button class="btn btn-primary w-100" type="submit">Tạo tài khoản khách hàng</button>
        </form>

        <a class="role-login-alt" href="@loginUrl">Đã có tài khoản? Đăng nhập khách hàng</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}