@{
    ViewData["Title"] = "Dành cho khách hàng";
}

<section class="pc-portfolio-hero pc-portfolio-hero--customer" aria-labelledby="customerPortfolioTitle">
    <div class="pc-portfolio-hero__copy">
        <span class="pc-pill pc-pill--blue">Dành cho khách hàng</span>
        <h1 id="customerPortfolioTitle">Đặt in online rõ ràng, nhanh chóng và dễ theo dõi</h1>
        <p>
            PhotoCopyHub giúp khách hàng gửi file, chọn cấu hình in, theo dõi trạng thái và nhận tài liệu mà không phải chờ trao đổi thủ công.
        </p>
        <div class="pc-portfolio-actions">
            <a class="pc-btn pc-btn--primary" asp-controller="PrintJobs" asp-action="Create">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0 4 4m-4-4-4 4"/><path d="M20 16.5V19a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2.5"/></svg>
                Tạo đơn in
            </a>
            <a class="pc-btn pc-btn--ghost" asp-controller="Home" asp-action="Index">Về trang chủ <span aria-hidden="true">→</span></a>
        </div>
    </div>

    <div class="pc-portfolio-preview" aria-hidden="true">
        <div class="pc-phone-card">
            <div class="pc-phone-bar"></div>
            <div class="pc-phone-title">
                <span><svg viewBox="0 0 24 24"><path d="M12 15V3m0 0 4 4m-4-4-4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg></span>
                <strong>Đơn in của bạn</strong>
            </div>
            <div class="pc-phone-upload">
                <svg viewBox="0 0 24 24"><path d="M12 16V4m0 0 4 4m-4-4-4 4"/><path d="M20 16.5V19a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2.5"/></svg>
                <b>Upload tài liệu</b>
                <small>PDF, Word, PowerPoint, hình ảnh</small>
            </div>
            <div class="pc-phone-list">
                <span><b>A4 · In 2 mặt</b><small>Đã chọn cấu hình</small></span>
                <span><b>02 bản</b><small>Sẵn sàng gửi đơn</small></span>
                <span><b>Đang xử lý</b><small>Cập nhật theo thời gian thực</small></span>
            </div>
        </div>
    </div>
</section>

<section class="pc-portfolio-section">
    <div class="pc-section-heading">
        <h2>Khách hàng nhận được gì?</h2>
        <p>Một quy trình đặt in đơn giản từ lúc gửi file đến khi nhận tài liệu.</p>
    </div>

    <div class="pc-portfolio-grid pc-portfolio-grid--four">
        <article class="pc-feature-card">
            <span class="pc-feature-icon"><svg viewBox="0 0 24 24"><path d="M12 15V3m0 0 4 4m-4-4-4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg></span>
            <h3>Gửi file nhanh</h3>
            <p>Tải tài liệu lên trước khi đến tiệm để giảm thời gian chờ và hạn chế gửi nhầm file.</p>
        </article>
        <article class="pc-feature-card">
            <span class="pc-feature-icon pc-feature-icon--green"><svg viewBox="0 0 24 24"><path d="M9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
            <h3>Chọn cấu hình rõ</h3>
            <p>Chọn khổ giấy, số bản, in màu, in hai mặt và ghi chú yêu cầu ngay trên form.</p>
        </article>
        <article class="pc-feature-card">
            <span class="pc-feature-icon"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/></svg></span>
            <h3>Theo dõi trạng thái</h3>
            <p>Biết đơn đã tiếp nhận, đang xử lý, hoàn thành hoặc cần bổ sung thông tin.</p>
        </article>
        <article class="pc-feature-card">
            <span class="pc-feature-icon pc-feature-icon--green"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
            <h3>An toàn dữ liệu</h3>
            <p>File gắn với đúng đơn, đúng tài khoản, giúp hạn chế lộ hoặc thất lạc tài liệu.</p>
        </article>
    </div>
</section>

<section class="pc-process-section">
    <div class="pc-section-heading">
        <h2>Quy trình sử dụng</h2>
        <p>Đơn giản, dễ hiểu, phù hợp cho học sinh, sinh viên, nhân viên văn phòng và khách hàng cá nhân.</p>
    </div>

    <div class="pc-process-timeline">
        <article><span>01</span><h3>Đăng nhập hoặc bắt đầu tạo đơn</h3><p>Khách hàng mở trang tạo đơn in và điền thông tin cơ bản.</p></article>
        <article><span>02</span><h3>Upload file và chọn kiểu in</h3><p>Tải tài liệu, chọn số bản, giấy, màu sắc, hai mặt và ghi chú.</p></article>
        <article><span>03</span><h3>Gửi đơn cho tiệm photo</h3><p>Đơn được chuyển tới khu quản lý để tiệm tiếp nhận và xử lý.</p></article>
        <article><span>04</span><h3>Nhận tài liệu sau khi hoàn thành</h3><p>Khách hàng theo dõi trạng thái và đến nhận khi đơn đã xong.</p></article>
    </div>
</section>

<section class="pc-portfolio-cta">
    <div>
        <span class="pc-pill pc-pill--blue">Bắt đầu ngay</span>
        <h2>Sẵn sàng gửi đơn in đầu tiên?</h2>
        <p>Tạo đơn in online giúp bạn chuẩn bị tài liệu trước, giảm trao đổi thủ công và theo dõi đơn dễ hơn.</p>
    </div>
    <a class="pc-btn pc-btn--primary" asp-controller="PrintJobs" asp-action="Create">Tạo đơn in ngay <span aria-hidden="true">→</span></a>
</section>