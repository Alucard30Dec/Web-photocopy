@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
}

@model CreatePrintJobViewModel
@{
    ViewData["Title"] = "Tạo đơn in";
    var branchSlug = CustomerBranchContext.GetSlug(ViewContext);
}

<section class="cu-page print-create-page">
    <section class="page-hero print-create-hero">
        <div>
            <span class="cu-kicker">Đặt in trực tuyến</span>
            <h1>Tạo đơn in mới</h1>
            <p>Chọn tối đa 5 tài liệu trong một lần. Mỗi tài liệu sẽ tạo thành một đơn riêng nhưng dùng chung cấu hình in và hình thức nhận hàng.</p>
            <div class="info-chip-group">
                <span class="info-chip"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-files"></use></svg>Nhiều file trong một lần gửi</span>
                <span class="info-chip"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-filetype-pdf"></use></svg>PDF và ảnh xem trước trực tiếp</span>
                <span class="info-chip"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-clipboard-check"></use></svg>Kiểm tra từng file trước khi tạo đơn</span>
            </div>
        </div>
        <aside class="print-create-hero__note">
            <strong>Định dạng hỗ trợ</strong>
            <span>PDF, JPG, PNG, Word, Excel, PowerPoint</span>
            <small>Tối đa 20 MB/file và 100 MB cho một lần gửi.</small>
        </aside>
    </section>

    <div class="print-workspace print-workspace--create">
        <div class="print-form-shell">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="printJobForm" asp-route-branchSlug="@branchSlug" novalidate>
                <input asp-for="IdempotencyKey" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger print-validation-summary" role="alert"></div>

                <section class="form-step print-source-step">
                    <div class="step-heading">
                        <div class="step-label"><span class="step-dot" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-file-earmark-arrow-up"></use></svg></span><span>1. Chọn tài liệu</span></div>
                        <span class="step-badge">Tối đa 5 file</span>
                    </div>
                    <p class="step-description">Kéo thả hoặc chọn nhiều file mới từ thiết bị. Nhấn “Xem trước” trên từng tài liệu để mở cửa sổ xem PDF hoặc ảnh.</p>

                    <div class="document-source-grid document-source-grid--upload-only">
                        <div class="document-source-main">
                            <div class="upload-dropzone" id="uploadDropzone" tabindex="0" role="button" aria-controls="UploadFiles">
                                <input asp-for="UploadFiles" class="print-file-input" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.ppt,.pptx,application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                                <span class="upload-dropzone__icon" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-file-earmark-arrow-up"></use></svg></span>
                                <strong>Kéo thả tài liệu vào đây</strong>
                                <span>hoặc bấm để chọn nhiều file từ máy tính</span>
                                <small>PDF, ảnh, Word, Excel, PowerPoint • tối đa 20 MB/file</small>
                            </div>
                            <span asp-validation-for="UploadFiles" class="text-danger"></span>
                            <div class="file-client-error" id="fileClientError" role="alert" hidden></div>

                            <div class="upload-queue" id="uploadQueue" aria-live="polite">
                                <div class="upload-queue-empty" id="uploadQueueEmpty">
                                    <strong>Chưa có file mới</strong>
                                    <span>File bạn chọn sẽ xuất hiện tại đây để kiểm tra tên, dung lượng, số trang và xem trước.</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <dialog class="document-preview-dialog" id="documentPreviewDialog" aria-labelledby="previewFileName">
                        <div class="document-preview-dialog__surface">
                            <div class="document-preview-panel__head">
                                <div>
                                    <span class="cu-kicker">Xem trước tài liệu</span>
                                    <strong id="previewFileName">Tài liệu</strong>
                                </div>
                                <div class="document-preview-dialog__actions">
                                    <a class="btn btn-sm btn-outline-secondary" id="previewDownloadLink" href="#" target="_blank" rel="noopener" hidden>Tải file</a>
                                    <button class="document-preview-dialog__close" id="closeDocumentPreviewButton" type="button" aria-label="Đóng bản xem trước">&times;</button>
                                </div>
                            </div>
                            <div class="document-preview-stage" id="documentPreviewStage" tabindex="0">
                                <div class="document-preview-empty" id="previewEmptyState" hidden>
                                    <svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-file-earmark-richtext"></use></svg>
                                    <strong>Không thể hiển thị tài liệu</strong>
                                    <span>Hãy đóng cửa sổ và chọn lại file cần xem trước.</span>
                                </div>
                                <iframe id="documentPreviewFrame" title="Xem trước tài liệu" loading="lazy" hidden></iframe>
                                <img id="documentPreviewImage" alt="Xem trước hình ảnh" hidden />
                                <div class="document-preview-fallback" id="documentPreviewFallback" hidden>
                                    <span class="file-type-pill file-type-pill--large" id="previewFallbackType">FILE</span>
                                    <strong id="previewFallbackName">Tài liệu</strong>
                                    <span id="previewFallbackMeta"></span>
                                    <p>Trình duyệt không hiển thị trực tiếp định dạng Office. File vẫn được gửi nguyên bản; hãy mở bằng Word, Excel hoặc PowerPoint để kiểm tra bố cục chính xác.</p>
                                </div>
                            </div>
                        </div>
                    </dialog>
                </section>

                <section class="form-step">
                    <div class="step-heading">
                        <div class="step-label"><span class="step-dot" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-sliders"></use></svg></span><span>2. Cấu hình in</span></div>
                        <span class="step-badge">Áp dụng cho tất cả file</span>
                    </div>
                    <p class="step-description">Chọn cấu hình nhanh rồi điều chỉnh chi tiết. Mỗi file được tạo thành một đơn riêng để tiệm kiểm tra và xử lý chính xác.</p>

                    <div class="quick-preset-grid" id="printPresetGrid">
                        <button type="button" class="quick-preset" data-paper-size="@((int)PaperSize.A4)" data-print-side="@((int)PrintSide.TwoSide)" data-color-mode="@((int)ColorMode.BlackWhite)" data-is-photo="false">
                            <span class="preset-title">Tài liệu học tập</span>
                            <span class="preset-meta">A4 • 2 mặt • Trắng đen</span>
                        </button>
                        <button type="button" class="quick-preset" data-paper-size="@((int)PaperSize.A4)" data-print-side="@((int)PrintSide.OneSide)" data-color-mode="@((int)ColorMode.BlackWhite)" data-is-photo="false">
                            <span class="preset-title">Báo cáo</span>
                            <span class="preset-meta">A4 • 1 mặt • Trắng đen</span>
                        </button>
                        <button type="button" class="quick-preset" data-paper-size="@((int)PaperSize.A4)" data-print-side="@((int)PrintSide.OneSide)" data-color-mode="@((int)ColorMode.Color)" data-is-photo="false">
                            <span class="preset-title">Slide màu</span>
                            <span class="preset-meta">A4 • 1 mặt • Màu</span>
                        </button>
                        <button type="button" class="quick-preset" data-paper-size="@((int)PaperSize.A3)" data-print-side="@((int)PrintSide.OneSide)" data-color-mode="@((int)ColorMode.Color)" data-is-photo="true">
                            <span class="preset-title">Poster / ảnh</span>
                            <span class="preset-meta">A3 • 1 mặt • Màu ảnh</span>
                        </button>
                    </div>

                    <div class="print-config-grid">
                        <div>
                            <label asp-for="PaperSize" class="form-label"></label>
                            <select asp-for="PaperSize" class="form-select" asp-items="Html.GetEnumSelectList<PaperSize>()"></select>
                        </div>
                        <div>
                            <label asp-for="PrintSide" class="form-label"></label>
                            <select asp-for="PrintSide" class="form-select" asp-items="Html.GetEnumSelectList<PrintSide>()"></select>
                        </div>
                        <div>
                            <label asp-for="ColorMode" class="form-label"></label>
                            <select asp-for="ColorMode" class="form-select" asp-items="Html.GetEnumSelectList<ColorMode>()"></select>
                        </div>
                        <div>
                            <label asp-for="Copies" class="form-label"></label>
                            <input asp-for="Copies" class="form-control" min="1" max="1000" inputmode="numeric" />
                            <span asp-validation-for="Copies" class="text-danger"></span>
                        </div>
                        <label class="photo-print-toggle">
                            <input asp-for="IsPhoto" class="form-check-input" />
                            <span>
                                <strong>In ảnh chất lượng cao</strong>
                                <small>Dùng giấy ảnh hoặc yêu cầu màu chính xác.</small>
                            </span>
                        </label>
                    </div>
                </section>

                <section class="form-step">
                    <div class="step-heading">
                        <div class="step-label"><span class="step-dot" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-shop"></use></svg></span><span>3. Nhận hàng</span></div>
                    </div>
                    <div class="delivery-grid">
                        <div>
                            <label asp-for="DeliveryMethod" class="form-label"></label>
                            <select asp-for="DeliveryMethod" class="form-select" asp-items="Html.GetEnumSelectList<DeliveryMethod>()"></select>
                        </div>
                        <div class="delivery-address-wrap" id="deliveryAddressWrap">
                            <label asp-for="DeliveryAddress" class="form-label"></label>
                            <input asp-for="DeliveryAddress" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />
                            <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="form-step">
                    <div class="step-heading">
                        <div class="step-label"><span class="step-dot" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-chat-left-text"></use></svg></span><span>4. Ghi chú cho tiệm</span></div>
                    </div>
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Ví dụ: Trang bìa in màu, các trang còn lại trắng đen; đóng gáy xoắn và bọc bìa trong."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </section>

                <div class="print-submit-bar">
                    <div>
                        <strong>Kiểm tra file và số trang trước khi gửi</strong>
                        <span>Tiệm xác nhận từng tài liệu trước khi trừ tiền ví.</span>
                    </div>
                    <div class="print-submit-actions">
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchSlug="@branchSlug"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-arrow-left-circle"></use></svg>Quay lại</a>
                        <button class="btn btn-primary" type="submit" id="submitPrintJobButton"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-send-check"></use></svg><span>Gửi đơn in</span></button>
                    </div>
                </div>
            </form>
        </div>

        <aside class="print-summary-card print-summary-card--create">
            <div class="print-summary-head">
                <span class="cu-kicker">Tóm tắt</span>
                <h2 class="print-summary-title">Đơn in của bạn</h2>
                <p class="print-summary-subtitle">Thông tin được cập nhật theo file và cấu hình đang chọn.</p>
            </div>

            <div class="summary-highlight-grid">
                <div>
                    <span>Tài liệu</span>
                    <strong id="summaryFileCount">0</strong>
                </div>
                <div>
                    <span>Tổng dung lượng mới</span>
                    <strong id="summaryUploadSize">0 MB</strong>
                </div>
            </div>

            <div class="summary-line"><span>Khổ giấy</span><span class="summary-value" id="summaryPaperSize">-</span></div>
            <div class="summary-line"><span>Kiểu in</span><span class="summary-value" id="summaryPrintSide">-</span></div>
            <div class="summary-line"><span>Màu sắc</span><span class="summary-value" id="summaryColorMode">-</span></div>
            <div class="summary-line"><span>Số bản mỗi file</span><span class="summary-value" id="summaryCopies">1</span></div>
            <div class="summary-line"><span>Tổng trang đã biết</span><span class="summary-value" id="summaryPages">0</span></div>
            <div class="summary-line"><span>Tổng lượt trang in</span><span class="summary-value" id="summaryVolume">0</span></div>
            <div class="summary-line"><span>Nhận hàng</span><span class="summary-value" id="summaryDelivery">-</span></div>

            <div class="summary-note">
                <strong>Lưu ý nghiệp vụ</strong>
                <span>PDF được hệ thống đọc số trang khi gửi. Ảnh tính là 1 trang. Với Word, Excel và PowerPoint, hãy nhập số trang sau khi mở file kiểm tra bố cục in.</span>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/_content/WebPhotocopyHub.Web.Customer/js/printjob-create.js" asp-append-version="true"></script>
}
