using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using PhotoCopyHub.Web.Models;

namespace PhotoCopyHub.Web.Controllers;

[AllowAnonymous]
public class ShopController : Controller
{
    private static readonly IReadOnlyList<ShopBranchLinkViewModel> DemoBranches = new List<ShopBranchLinkViewModel>
    {
        new()
        {
            Slug = "141-dien-bien-phu",
            Name = "PhotoCopyHub 141 Điện Biên Phủ",
            Address = "141 Điện Biên Phủ",
            ShortDescription = "Cơ sở mẫu cho khách hàng đặt in, upload file, đặt sản phẩm và theo dõi trạng thái đơn.",
            PhoneNumber = "Đang cập nhật"
        },
        new()
        {
            Slug = "co-so-trung-tam",
            Name = "PhotoCopyHub Cơ sở trung tâm",
            Address = "Khu vực trung tâm",
            ShortDescription = "Cơ sở mẫu dùng để kiểm thử luồng nhiều tiệm photocopy trong cùng hệ thống.",
            PhoneNumber = "Đang cập nhật"
        }
    };

    public IActionResult Index()
    {
        return View(new ShopDirectoryViewModel
        {
            Branches = DemoBranches
        });
    }

    public IActionResult Details(string branchSlug)
    {
        var branch = DemoBranches.FirstOrDefault(x =>
            string.Equals(x.Slug, branchSlug, StringComparison.OrdinalIgnoreCase));

        if (branch is null)
        {
            return NotFound();
        }

        return View(branch);
    }
}