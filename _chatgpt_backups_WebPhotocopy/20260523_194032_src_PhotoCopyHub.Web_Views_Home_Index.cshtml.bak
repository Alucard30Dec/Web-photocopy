@{
    ViewData["Title"] = "Nền tảng Web Photocopy";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var customerReturnUrl = Url.Action("Index", "Dashboard") ?? "/Dashboard";
    var createPrintJobUrl = Url.Action("Create", "PrintJobs") ?? "/PrintJobs/Create";
    var shopReturnUrl = Url.Action("Index", "Dashboard", new { area = "Shop" }) ?? "/Shop/Dashboard";

    var benefits = new[]
    {
        new { Icon = "↑", Title = "Upload & Preview", Text = "Upload tài liệu và xem trước trước khi đặt in." },
        new { Icon = "✓", Title = "Tiện lợi & Nhanh chóng", Text = "Đặt in online 24/7, theo dõi đơn hàng theo thời gian thực." },
        new { Icon = "▣", Title = "Bảo mật & An toàn", Text = "Dữ liệu được bảo mật, an tâm sử dụng." },
        new { Icon = "◔", Title = "Hỗ trợ tận tâm", Text = "Đội ngũ hỗ trợ nhanh chóng, nhiệt tình và chuyên nghiệp." }
    };

    var customerPoints = new[]
    {
        "Đặt mọi lúc, mọi nơi",
        "Theo dõi đơn hàng dễ dàng",
        "Thanh toán nhanh, an toàn"
    };

    var shopPoints = new[]
    {
        "Quản lý đơn hàng hiệu quả",
        "Tối ưu vận hành, tiết kiệm thời gian",
        "Báo cáo doanh thu rõ ràng"
    };
}

<section class="pc-hero" aria-labelledby="pcHeroTitle">
    <div class="pc-hero__decor pc-hero__decor--one"></div>
    <div class="pc-hero__decor pc-hero__decor--two"></div>

    <div class="pc-hero__copy">
        <span class="pc-eyebrow">Nền tảng Web Photocopy hiện đại</span>
        <h1 id="pcHeroTitle">Nền tảng web photocopy hiện đại cho khách hàng và tiệm photo</h1>
        <p>
            Upload file, đặt in, theo dõi đơn hàng theo thời gian thực. Giải pháp tối ưu vận hành cho tiệm photo — tiết kiệm thời gian, tăng hiệu quả.
        </p>
        <div class="pc-hero__actions">
            @if (isAuthenticated)
            {
                <a class="btn btn-primary btn-lg pc-btn" href="@createPrintJobUrl">Đặt in ngay</a>
                <a class="btn btn-outline-primary btn-lg pc-btn pc-btn--outline" asp-controller="Dashboard" asp-action="Index">Vào tổng quan</a>
            }
            else
            {
                <a class="btn btn-primary btn-lg pc-btn" asp-controller="Account" asp-action="Register">Đặt in ngay</a>
                <a class="btn btn-outline-primary btn-lg pc-btn pc-btn--outline" href="#features">Tìm hiểu thêm →</a>
            }
        </div>
    </div>

    <div class="pc-hero__visual" aria-label="Mô phỏng giao diện PhotoCopyHub">
        <div class="pc-dashboard-card">
            <div class="pc-dashboard-card__top">
                <div class="pc-logo-mini"><span></span>PhotoCopyHub</div>
                <div class="pc-search">Tìm đơn hàng, khách hàng...</div>
                <div class="pc-avatar"></div>
            </div>
            <div class="pc-dashboard-card__body">
                <aside class="pc-sidebar-demo">
                    <span class="active">⌂ Tổng quan</span>
                    <span>▦ Đơn hàng</span>
                    <span>▤ Tài liệu</span>
                    <span>◇ Khách hàng</span>
                    <span>◷ Lịch sử in</span>
                    <span>⚙ Cài đặt</span>
                </aside>
                <div class="pc-board-demo">
                    <div class="pc-board-panel pc-orders-panel">
                        <h3>Đơn hàng mới</h3>
                        <div class="pc-order-row"><span>□</span><strong>#PC240 25-001</strong><em>Mới</em><small>Đã tiếp nhận</small></div>
                        <div class="pc-order-row"><span>□</span><strong>#PC240 25-002</strong><em class="warning">Đang xử lý</em><small>Đã tiếp nhận</small></div>
                        <div class="pc-order-row"><span>□</span><strong>#PC240 25-003</strong><em class="success">Hoàn thành</em><small>Đã tiếp nhận</small></div>
                        <a href="#customers">Xem tất cả đơn hàng →</a>
                    </div>
                    <div class="pc-board-side">
                        <div class="pc-board-panel">
                            <h3>Tài liệu lên</h3>
                            <div class="pc-file-line"><span>▰</span><strong>Bao cao_the...15.pdf</strong><small>100%</small></div>
                            <div class="pc-progress"><span></span></div>
                        </div>
                        <div class="pc-board-panel">
                            <h3>Thống kê hôm nay</h3>
                            <div class="pc-stat-lines"><span>Đơn tiếp nhận</span><span>Đơn in xong</span><span>Đã hoàn thành</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pc-benefits" id="features" aria-label="Lợi ích chính">
    @foreach (var item in benefits)
    {
        <article class="pc-benefit-card">
            <div class="pc-benefit-icon">@item.Icon</div>
            <div>
                <h2>@item.Title</h2>
                <p>@item.Text</p>
            </div>
        </article>
    }
</section>

<section class="pc-solutions" id="customers">
    <div class="pc-section-heading">
        <h2>Giải pháp phù hợp</h2>
        <p>Chúng tôi đồng hành cùng bạn với giải pháp tối ưu cho từng nhu cầu.</p>
    </div>

    <div class="pc-solution-grid">
        <article class="pc-solution-card">
            <div class="pc-solution-icon pc-solution-icon--blue">●●●</div>
            <div class="pc-solution-content">
                <h3>Khách hàng cá nhân</h3>
                <ul>
                    @foreach (var point in customerPoints)
                    {
                        <li>@point</li>
                    }
                </ul>
            </div>
            @if (isAuthenticated)
            {
                <a class="btn btn-primary pc-btn" asp-controller="PrintJobs" asp-action="Create">Tạo đơn in →</a>
            }
            else
            {
                <a class="btn btn-primary pc-btn" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@customerReturnUrl">Tìm hiểu thêm →</a>
            }
        </article>

        <article class="pc-solution-card" id="shops">
            <div class="pc-solution-icon pc-solution-icon--green">▣</div>
            <div class="pc-solution-content">
                <h3>Tiệm photo</h3>
                <ul>
                    @foreach (var point in shopPoints)
                    {
                        <li>@point</li>
                    }
                </ul>
            </div>
            <a class="btn btn-success pc-btn" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@shopReturnUrl">Liên hệ tư vấn →</a>
        </article>
    </div>
</section>
