@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
}

@model List<PrintJob>
@{
    ViewData["Title"] = "Đơn in của tôi";

    var processingCount = Model.Count(x => x.Status == PrintJobStatus.Processing);
    var readyCount = Model.Count(x => x.Status == PrintJobStatus.ReadyForPickup);
    var completedCount = Model.Count(x => x.Status == PrintJobStatus.Completed);
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Print orders</span>
            <h1>Đơn in của tôi</h1>
            <p>Theo dõi toàn bộ đơn in theo thời gian: chờ xác nhận, đang in, sẵn sàng nhận và đã hoàn thành.</p>
            <div class="cu-actions">
                <a class="btn btn-primary" asp-action="Create" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Tạo đơn in mới</a>
                <a class="btn btn-outline-secondary" asp-action="Files" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">File đã upload</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Tổng đơn</span>
            <strong>@Model.Count</strong>
            <small>@processingCount đang xử lý · @readyCount sẵn sàng nhận · @completedCount hoàn thành</small>
        </aside>
    </section>

    <section class="cu-card">
        <div class="cu-section-head">
            <div>
                <span class="cu-kicker">Danh sách</span>
                <h2>Lịch sử đơn in</h2>
            </div>
        </div>

        <div class="cu-table-wrap">
            <table class="table cu-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày tạo</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div class="cu-empty">
                                <strong>Bạn chưa có đơn in nào.</strong>
                                <span>Hãy tạo đơn đầu tiên bằng cách upload file và chọn cấu hình in.</span>
                                <a class="btn btn-sm btn-primary" asp-action="Create" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Tạo đơn in</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var detailLabel = item.Status == PrintJobStatus.Completed ? "Xem lại" : "Chi tiết";

                    <tr>
                        <td>
                            <a class="cu-code text-decoration-none"
                               href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{item.Id}")">
                                @item.Id
                            </a>
                        </td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-semibold">@item.TotalAmount.ToString("N0") đ</td>
                        <td><span class="badge @item.Status.ToBadgeClass()">@item.Status.GetDisplayName()</span></td>
                        <td class="text-end">
                            <!-- Completed print-job review UI - start -->
                            <a class="btn btn-sm btn-outline-primary"
                               href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{item.Id}")">
                                @detailLabel
                            </a>
                            <!-- Completed print-job review UI - end -->
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>