@model ExternalLoginConfirmationViewModel
@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
    var branch = ViewData["Branch"] as ShopBranchLinkViewModel;
    ViewData["Title"] = "Liên kết tài khoản khách hàng";

    var branchSlug = branch?.Slug ?? ViewContext.RouteData.Values["branchSlug"]?.ToString() ?? "";
    var branchName = branch?.Name ?? branchSlug;
    var formAction = "/" + branchSlug + "/ExternalLoginConfirmation";
    var homeUrl = "/" + branchSlug;
}

<section class="customer-auth-page">
    <div class="customer-auth-hero">
        <a class="customer-auth-brand" href="@homeUrl"><span class="customer-auth-brand-icon"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-printer-fill"></use></svg></span>@branchName</a>
        <span class="customer-kicker">Liên kết tài khoản khách hàng</span>
        <h1>Hoàn tất thông tin tài khoản</h1>
        <p>Bạn đã đăng nhập thành công bằng <strong>@Model.ProviderDisplayName</strong>. Vui lòng bổ sung các thông tin bên dưới để tạo và liên kết tài khoản.</p>
        <div class="customer-auth-pills">
            <span><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-person-vcard"></use></svg>Hồ sơ đầy đủ</span>
            <span><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-lightning-charge"></use></svg>Đặt in nhanh</span>
            <span><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-card-checklist"></use></svg>Quản lý đơn</span>
        </div>
    </div>

    <div class="customer-auth-card">
        <div class="customer-auth-card-head">
            <span class="customer-kicker">Thông tin khách hàng</span>
            <h2>Liên kết @Model.ProviderDisplayName</h2>
            <p>Tạo tài khoản riêng cho khu khách hàng của @branchName.</p>
        </div>

        <form action="@formAction" method="post" class="customer-auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="customer-auth-form-grid">
                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" readonly />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="vd: sinhvien01" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="Số điện thoại liên hệ" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="customer-auth-form-full">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" autocomplete="street-address" placeholder="Địa chỉ nhận tài liệu nếu cần" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>

            <button class="customer-primary-action w-100" type="submit"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-person-plus"></use></svg>Tạo và liên kết tài khoản</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
