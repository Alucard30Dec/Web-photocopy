@model LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
    var branch = ViewData["Branch"] as ShopBranchLinkViewModel;
    ViewData["Title"] = "Đăng nhập khách hàng";

    var branchSlug = branch?.Slug ?? ViewContext.RouteData.Values["branchSlug"]?.ToString() ?? "";
    var branchName = branch?.Name ?? branchSlug;
    var formAction = "/" + branchSlug + "/Login";
    var externalLoginUrl = "/" + branchSlug + "/ExternalLogin";
    var registerUrl = "/" + branchSlug + "/Register";
    var homeUrl = "/" + branchSlug;
    var defaultDashboardUrl = "/" + branchSlug + "/Dashboard";

    if (string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        Model.ReturnUrl = defaultDashboardUrl;
    }

    var googleConfigured =
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
}

<section class="customer-auth-page">
    <div class="customer-auth-hero">
        <a class="customer-auth-brand" href="@homeUrl"><span class="customer-auth-brand-icon"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-printer-fill"></use></svg></span>@branchName</a>
        <span class="customer-kicker">Đăng nhập khách hàng</span>
        <h1>Vào tài khoản để đặt in nhanh hơn</h1>
        <p>Đăng nhập bằng Gmail/email hoặc tên đăng nhập để tạo đơn in, theo dõi đơn hàng, xem ví và cập nhật hồ sơ tại @branchName.</p>
        <div class="customer-auth-pills">
            <span><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-printer"></use></svg>Tạo đơn in</span>
            <span><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-clipboard-check"></use></svg>Theo dõi trạng thái</span>
            <span><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-wallet2"></use></svg>Thanh toán theo đơn</span>
        </div>
    </div>

    <div class="customer-auth-card">
        <div class="customer-auth-card-head">
            <span class="customer-kicker">Tài khoản</span>
            <h2>Đăng nhập</h2>
            <p>Dùng Gmail/email hoặc tên đăng nhập đã đăng ký.</p>
        </div>

        @if (googleConfigured)
        {
            <form action="@externalLoginUrl" method="post" class="customer-google-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="customer-google-button" type="submit">
                    <span class="customer-google-icon"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-google"></use></svg></span>
                    Tiếp tục với Google/Gmail
                </button>
            </form>

            <div class="customer-auth-divider"><span>hoặc đăng nhập bằng mật khẩu</span></div>
        }

        @if (!googleConfigured)
        {
            <div class="customer-google-disabled">
                <strong>Đăng nhập nhanh bằng Gmail chưa được cấu hình</strong>
                <span>Điền Google ClientId/ClientSecret theo hướng dẫn bên dưới để bật nút Google.</span>
            </div>
        }

        <form action="@formAction" method="post" class="customer-auth-form" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="vd: sinhvien01 hoặc sinhvien@gmail.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="customer-auth-row">
                <label class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <span class="form-check-label">@Html.DisplayNameFor(x => x.RememberMe)</span>
                </label>
            </div>

            <button class="customer-primary-action w-100" type="submit"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-box-arrow-in-right"></use></svg>Đăng nhập khách hàng</button>
        </form>

        <a class="customer-auth-alt" href="@registerUrl">Chưa có tài khoản? Tạo tài khoản khách hàng</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}