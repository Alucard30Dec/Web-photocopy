@model WebPhotocopyHub.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Quên mật khẩu</h2>
        <p class="auth-subtitle">Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>

        <form asp-action="ForgotPassword" asp-route-branchSlug="@ViewData["Branch"]?.GetType().GetProperty("Slug")?.GetValue(ViewData["Branch"])" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Email" class="form-label">Email/Gmail</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary cu-btn cu-btn--primary">Gửi liên kết</button>
        </form>

        <div class="auth-links mt-4 text-center">
            <a href="@Url.Action("Login", "Account", new { branchSlug = ViewData["Branch"]?.GetType().GetProperty("Slug")?.GetValue(ViewData["Branch"]) })">Quay lại đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
