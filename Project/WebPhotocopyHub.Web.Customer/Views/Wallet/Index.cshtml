@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
}

@model WalletIndexViewModel
@{
    ViewData["Title"] = "Ví của tôi";

    var creditTotal = Model.Transactions.Items.Where(x => x.Amount > 0).Sum(x => x.Amount);
    var debitTotal = Model.Transactions.Items.Where(x => x.Amount < 0).Sum(x => Math.Abs(x.Amount));
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant/20 shadow-sm relative overflow-hidden flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md">
        <div>
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Wallet</span>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">Ví của tôi</h1>
            <p class="text-sm text-on-surface-variant max-w-2xl">Theo dõi số dư, giao dịch nạp tiền, thanh toán đơn in, đơn sản phẩm và dịch vụ hỗ trợ.</p>
            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-primary hover:bg-primary-container text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm hover:shadow-md" asp-action="TopUp" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)"><span class="material-symbols-outlined text-[20px]">add_circle</span>Tạo yêu cầu nạp tiền</a>
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" asp-action="TopUpHistory" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)"><span class="material-symbols-outlined text-[20px]">history</span>Lịch sử nạp tiền</a>
            </div>
        </div>
        <aside class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-5 shadow-sm min-w-[240px] flex flex-col gap-2 relative z-10">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1 block">Số dư hiện tại</span>
            <strong class="text-lg font-bold text-on-surface">@Model.CurrentBalance.ToString("N0") đ</strong>
            <small class="text-xs text-on-surface-variant">Giao dịch được ghi lại để đối soát khi cần.</small>
        </aside>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-md mb-lg">
        <div class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-green-100 text-green-800" aria-hidden="true">
                <span class="material-symbols-outlined text-[24px]">arrow_downward</span>
            </span>
            <div class="flex flex-col">
                <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tổng đã nạp</span>
                <strong class="text-lg font-bold text-on-surface">@creditTotal.ToString("N0") đ</strong>
                <small class="text-xs text-on-surface-variant">Các giao dịch tăng số dư.</small>
            </div>
        </div>
        <div class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-error/10 text-error" aria-hidden="true">
                <span class="material-symbols-outlined text-[24px]">arrow_upward</span>
            </span>
            <div class="flex flex-col">
                <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tổng đã chi</span>
                <strong class="text-lg font-bold text-on-surface">@debitTotal.ToString("N0") đ</strong>
                <small class="text-xs text-on-surface-variant">Các khoản thanh toán đơn.</small>
            </div>
        </div>
        <div class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-primary/10 text-primary" aria-hidden="true">
                <span class="material-symbols-outlined text-[24px]">receipt_long</span>
            </span>
            <div class="flex flex-col">
                <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Số giao dịch</span>
                <strong class="text-lg font-bold text-on-surface">@Model.Transactions.TotalCount</strong>
                <small class="text-xs text-on-surface-variant">Lịch sử ví của tài khoản.</small>
            </div>
        </div>
    </section>

    <section class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
        <div class="border-b border-outline-variant/20 pb-4 mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <div>
                <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Transactions</span>
                <h2 class="text-lg font-bold text-on-surface">Lịch sử giao dịch ví</h2>
            </div>
        </div>

        <div class="overflow-x-auto border border-outline-variant/20 rounded-xl w-full">
            <table class="table-auto w-full text-left text-sm border-collapse">
                <thead class="bg-surface-container/60 border-b border-outline-variant/20">
                    <tr>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Thời gian</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Loại</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider text-right">Số tiền</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider text-right">Số dư trước</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider text-right">Số dư sau</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Transactions.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-4 py-3.5 text-on-surface align-middle">
                            <div class="flex flex-col items-center justify-center text-center p-lg gap-3">
                                <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">receipt_long</span>
                                <strong class="text-sm font-bold text-on-surface">Chưa có giao dịch nào.</strong>
                                <span class="text-xs text-on-surface-variant">Các giao dịch ví sẽ hiển thị tại đây.</span>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var tx in Model.Transactions.Items)
                {
                    <tr class="border-b border-outline-variant/10 hover:bg-surface-container-low transition-colors duration-150">
                        <td class="px-4 py-3.5 text-on-surface align-middle">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">@tx.TransactionType.GetDisplayName()</td>
                        <td class="px-4 py-3.5 align-middle text-right @(tx.Amount >= 0 ? "text-green-600 font-bold" : "text-error font-bold")">@tx.Amount.ToString("N0") đ</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle text-right">@tx.BalanceBefore.ToString("N0") đ</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle text-right">@tx.BalanceAfter.ToString("N0") đ</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">@tx.Note</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Transactions.TotalPages > 1)
        {
            <div class="flex justify-center items-center gap-1.5 mt-6">
                @if (Model.Transactions.HasPreviousPage)
                {
                    <a class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm border border-outline-variant/20 transition-all" href="@CustomerBranchContext.ToPath(ViewContext, $"Wallet?page={Model.Transactions.PageNumber - 1}")">Trước</a>
                }
                else
                {
                    <span class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container-low text-on-surface-variant/40 font-medium text-sm border border-outline-variant/10 cursor-not-allowed opacity-50">Trước</span>
                }

                @for (int i = 1; i <= Model.Transactions.TotalPages; i++)
                {
                    if (i == Model.Transactions.PageNumber)
                    {
                        <span class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary text-white font-bold text-sm shadow-sm transition-all">@i</span>
                    }
                    else
                    {
                        <a class="w-9 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm border border-outline-variant/20 transition-all" href="@CustomerBranchContext.ToPath(ViewContext, $"Wallet?page={i}")">@i</a>
                    }
                }

                @if (Model.Transactions.HasNextPage)
                {
                    <a class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm border border-outline-variant/20 transition-all" href="@CustomerBranchContext.ToPath(ViewContext, $"Wallet?page={Model.Transactions.PageNumber + 1}")">Sau</a>
                }
                else
                {
                    <span class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container-low text-on-surface-variant/40 font-medium text-sm border border-outline-variant/10 cursor-not-allowed opacity-50">Sau</span>
                }
            </div>
        }
    </section>
</section>