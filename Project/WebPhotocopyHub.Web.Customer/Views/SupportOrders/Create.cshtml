@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
}

@model CreateSupportOrderViewModel
@{
    ViewData["Title"] = "Dịch vụ hỗ trợ";
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant/20 shadow-sm relative overflow-hidden flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md">
        <div>
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Support service</span>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">Tạo đơn dịch vụ hỗ trợ</h1>
            <p class="text-sm text-on-surface-variant max-w-2xl">Đặt các dịch vụ như scan tài liệu, đóng gáy, ép plastic, đánh máy hoặc hỗ trợ hoàn thiện file.</p>
            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" asp-action="History" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Lịch sử đơn dịch vụ</a>
            </div>
        </div>
        <aside class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-5 shadow-sm min-w-[240px] flex flex-col gap-2 relative z-10">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1 block">Dịch vụ đang có</span>
            <strong class="text-lg font-bold text-on-surface">@Model.AvailableServices.Count</strong>
            <small class="text-xs text-on-surface-variant">Chọn dịch vụ, nhập số lượng và gửi yêu cầu.</small>
        </aside>
    </section>

    <section class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
        <form asp-action="Create" method="post" class="flex flex-col gap-md" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">
            <input asp-for="IdempotencyKey" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-error text-xs mt-1 block font-medium"></div>

            <div>
                <label asp-for="SupportServiceId" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2"></label>
                <select asp-for="SupportServiceId" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:border-primary/50 transition-colors">
                    <option value="">-- Chọn dịch vụ --</option>
                    @foreach (var item in Model.AvailableServices)
                    {
                        <option value="@item.Id">@item.Name - @item.UnitPrice.ToString("N0") đ (@item.FeeType.GetDisplayName())</option>
                    }
                </select>
                <span asp-validation-for="SupportServiceId" class="text-error text-xs mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="Quantity" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2"></label>
                <input asp-for="Quantity" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 text-sm text-on-surface placeholder-on-surface-variant/40 focus:outline-none focus:border-primary/50 transition-colors" />
                <span asp-validation-for="Quantity" class="text-error text-xs mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="Notes" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2"></label>
                <textarea asp-for="Notes" class="w-full bg-surface-container border border-outline-variant/30 rounded-xl px-4 py-3 text-sm text-on-surface placeholder-on-surface-variant/40 focus:outline-none focus:border-primary/50 transition-colors" rows="4"></textarea>
            </div>

            <div class="flex flex-wrap gap-3 mt-4">
                <button class="px-5 py-2.5 bg-primary hover:bg-primary-container text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm hover:shadow-md" type="submit">Gửi yêu cầu dịch vụ</button>
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" asp-action="History" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Lịch sử đơn dịch vụ</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}