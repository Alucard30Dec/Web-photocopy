@model SupportServiceOrder
@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
    ViewData["Title"] = "Chi tiết đơn dịch vụ";
    var branchSlug = ViewContext.RouteData.Values["branchSlug"]?.ToString();
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Support service order detail</span>
            <h1>Chi tiết đơn dịch vụ</h1>
            <p>Mã đơn: <span class="cu-code">@Model.Id</span></p>
            <div class="cu-actions">
                <a class="btn btn-outline-secondary" asp-action="History" asp-route-branchSlug="@branchSlug">Quay lại danh sách</a>
                @if (Model.Status == OrderStatus.Submitted)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" asp-route-branchSlug="@branchSlug" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn huỷ đơn này? (Tiền sẽ được hoàn lại vào ví)');">
                        <button type="submit" class="btn btn-danger">Huỷ đơn</button>
                    </form>
                }
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Tổng tiền</span>
            <strong>@Model.TotalAmount.ToString("N0") đ</strong>
            <small>Trạng thái: @Model.Status.GetDisplayName()</small>
        </aside>
    </section>

    <section class="cu-card">
        <div class="cu-section-head">
            <div>
                <span class="cu-kicker">Service details</span>
                <h2>Thông tin dịch vụ</h2>
            </div>
            <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span>
        </div>

        <div class="cu-detail-list">
            <div><span>Tên dịch vụ</span><strong>@Model.SupportService?.Name</strong></div>
            <div><span>Đơn giá</span><strong>@Model.UnitPrice.ToString("N0") đ</strong></div>
            <div><span>Số lượng (phút/trang/gói)</span><strong>@Model.Quantity</strong></div>
            <div><span>Thành tiền</span><strong>@Model.TotalAmount.ToString("N0") đ</strong></div>
            <div><span>Thời gian đặt</span><strong>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div class="cu-detail-list__full"><span>Yêu cầu chi tiết</span><strong>@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có yêu cầu thêm." : Model.Notes)</strong></div>
            <div class="cu-detail-list__full"><span>Ghi chú từ cửa hàng</span><strong>@(string.IsNullOrWhiteSpace(Model.ProcessNote) ? "Chưa có phản hồi." : Model.ProcessNote)</strong></div>
        </div>
    </section>
</section>
