@model SupportServiceOrder
@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
    ViewData["Title"] = "Chi tiết đơn dịch vụ";
    var branchSlug = ViewContext.RouteData.Values["branchSlug"]?.ToString();

    var statusThemeClass = Model.Status.ToBadgeClass() switch
    {
        "bg-success" => "bg-green-100 text-green-800 border-green-600/20",
        "bg-danger" => "bg-error/10 text-error border-error/20",
        "bg-primary" => "bg-primary/10 text-primary border-primary/20",
        "bg-info text-dark" => "bg-primary/10 text-primary border-primary/20",
        "bg-warning text-dark" => "bg-amber-100 text-amber-800 border-amber-500/20",
        _ => "bg-surface-container-high text-on-surface-variant border-outline-variant/20"
    };
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant/20 shadow-sm relative overflow-hidden flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md">
        <div>
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Support service order detail</span>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">Chi tiết đơn dịch vụ</h1>
            <p class="text-sm text-on-surface-variant max-w-2xl">Mã đơn: <span class="font-mono text-xs font-semibold bg-surface-container px-2 py-1 rounded border border-outline-variant/30 text-primary">@Model.Id</span></p>
            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" asp-action="History" asp-route-branchSlug="@branchSlug">Quay lại danh sách</a>
                @if (Model.Status == OrderStatus.Submitted)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" asp-route-branchSlug="@branchSlug" method="post" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn huỷ đơn này? (Tiền sẽ được hoàn lại vào ví)');">
                        <button type="submit" class="px-5 py-2.5 bg-error hover:opacity-90 text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm">Huỷ đơn</button>
                    </form>
                }
            </div>
        </div>
        <aside class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-5 shadow-sm min-w-[240px] flex flex-col gap-2 relative z-10">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1 block">Tổng tiền</span>
            <strong class="text-lg font-bold text-on-surface">@Model.TotalAmount.ToString("N0") đ</strong>
            <small class="text-xs text-on-surface-variant">Trạng thái: @Model.Status.GetDisplayName()</small>
        </aside>
    </section>

    <section class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
        <div class="border-b border-outline-variant/20 pb-4 mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <div>
                <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Service details</span>
                <h2 class="text-lg font-bold text-on-surface">Thông tin dịch vụ</h2>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border leading-none shadow-xs @statusThemeClass">@Model.Status.GetDisplayName()</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-md p-md">
            <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-sm text-on-surface-variant">Tên dịch vụ</span><strong class="text-sm font-semibold text-on-surface">@Model.SupportService?.Name</strong></div>
            <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-sm text-on-surface-variant">Đơn giá</span><strong class="text-sm font-semibold text-on-surface">@Model.UnitPrice.ToString("N0") đ</strong></div>
            <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-sm text-on-surface-variant">Số lượng (phút/trang/gói)</span><strong class="text-sm font-semibold text-on-surface">@Model.Quantity</strong></div>
            <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-sm text-on-surface-variant">Thành tiền</span><strong class="text-sm font-semibold text-on-surface">@Model.TotalAmount.ToString("N0") đ</strong></div>
            <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-sm text-on-surface-variant">Thời gian đặt</span><strong class="text-sm font-semibold text-on-surface">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div class="col-span-1 md:col-span-2 flex flex-col gap-1 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Yêu cầu chi tiết</span><strong class="text-sm font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có yêu cầu thêm." : Model.Notes)</strong></div>
            <div class="col-span-1 md:col-span-2 flex flex-col gap-1 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ghi chú từ cửa hàng</span><strong class="text-sm font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(Model.ProcessNote) ? "Chưa có phản hồi." : Model.ProcessNote)</strong></div>
        </div>
    </section>
</section>
