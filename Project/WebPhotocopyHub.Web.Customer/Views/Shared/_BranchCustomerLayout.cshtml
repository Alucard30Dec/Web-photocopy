<header class="customer-topbar customer-topbar-v2">
    <a class="customer-brand" href="@branchHomeUrl" aria-label="Trang chủ @branch.Name">
        <span class="customer-brand-icon customer-brand-icon--print" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-printer-fill"></use></svg></span>
        <strong>@branch.Name</strong>
    </a>

    <nav class="customer-nav-groups" aria-label="Menu chức năng khách hàng">
        <a class="customer-home-link @(InController("Branch") ? "is-active" : string.Empty)" href="@branchHomeUrl">
            <span class="customer-nav-icon" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-house-door-fill"></use></svg></span> Trang chủ
        </a>

        @if (isSignedIn)
        {
            <!-- Auth-only customer navigation - start -->
            <div class="customer-nav-group dropdown @ActiveGroup("PrintJobs")" hidden="@(!hasPrintOrders)">
                <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="customer-nav-icon" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-files"></use></svg></span> Đơn in
                </button>

                <div class="dropdown-menu customer-nav-menu">
                    <a class="customer-nav-item" href="@RequireLogin(printCreateUrl)" hidden="@(!isAcceptingOrders)">
                        <strong>Tạo đơn in</strong>
                        <small>Gửi file và chọn cấu hình in.</small>
                    </a>

                    <a class="customer-nav-item" href="@RequireLogin(printJobsUrl)">
                        <strong>Đơn của tôi</strong>
                        <small>Theo dõi trạng thái xử lý và thanh toán.</small>
                    </a>

                </div>
            </div>

            <div class="customer-nav-group dropdown @ActiveGroup("Products")" hidden="@(!hasProductSales)">
                <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="customer-nav-icon" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-bag-heart"></use></svg></span> Sản phẩm
                </button>

                <div class="dropdown-menu customer-nav-menu">
                    <a class="customer-nav-item" href="@RequireLogin(productsUrl)">
                        <strong>Mua sản phẩm</strong>
                        <small>Giấy, bút, bìa và vật tư văn phòng.</small>
                    </a>

                    <a class="customer-nav-item" href="@RequireLogin(productOrdersUrl)">
                        <strong>Đơn sản phẩm</strong>
                        <small>Kiểm tra các đơn sản phẩm đã đặt.</small>
                    </a>
                </div>
            </div>
            <!-- Auth-only customer navigation - end -->
        }

        <div class="customer-nav-group dropdown @ActiveGroup("SupportOrders")" hidden="@(!(hasPricing || hasSupportServices))">
            <button class="customer-nav-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="customer-nav-icon" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-life-preserver"></use></svg></span> Bảng giá & hỗ trợ
            </button>

            <div class="dropdown-menu customer-nav-menu">
                <a class="customer-nav-item" href="@priceUrl" hidden="@(!hasPricing)">
                    <strong>Bảng giá in</strong>
                    <small>Xem giá đang áp dụng tại cơ sở.</small>
                </a>

                @if (isSignedIn && hasSupportServices)
                {
                    <a class="customer-nav-item" href="@RequireLogin(supportCreateUrl)" hidden="@(!isAcceptingOrders)">
                        <strong>Tạo yêu cầu dịch vụ</strong>
                        <small>Scan, đóng gáy, ép plastic, hỗ trợ file.</small>
                    </a>

                    <a class="customer-nav-item" href="@RequireLogin(supportHistoryUrl)">
                        <strong>Lịch sử dịch vụ</strong>
                        <small>Xem các yêu cầu hỗ trợ đã gửi.</small>
                    </a>
                }

                <a class="customer-nav-item" href="@contactUrl">
                    <strong>Liên hệ cơ sở</strong>
                    <small>Địa chỉ, điện thoại và giờ mở cửa.</small>
                </a>
            </div>
        </div>
    </nav>

    <div class="customer-head-actions">
        <div class="customer-open-state">
            <span class="customer-open-dot"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-circle-fill"></use></svg> Đang mở cửa</span>
            <small>@branch.OpenHours</small>
        </div>

        @if (isSignedIn)
        {
            <div class="customer-account-menu dropdown">
                <button class="customer-user-pill customer-user-pill--menu dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="customer-avatar" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-person-fill"></use></svg></span>
                    <span class="customer-user-text">
                        <small>@displayName</small>
                        <strong>@userName</strong>
                    </span>
                </button>

                <div class="dropdown-menu customer-account-dropdown dropdown-menu-end">
                    <div class="customer-account-card">
                        <span class="customer-avatar customer-avatar--large" aria-hidden="true"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-person-fill"></use></svg></span>
                        <div>
                            <strong>@displayName</strong>
                            <small>Tên đăng nhập: @userName</small>
                            <small>Gmail: @gmail</small>
                            <small>SĐT: @phone</small>
                        </div>
                    </div>

                    <a class="customer-account-link" href="@RequireLogin(dashboardUrl)"><span class="customer-account-link-icon is-blue"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-speedometer2"></use></svg></span><div><strong>Tổng quan</strong><small>Tổng quan đơn, ví và hoạt động.</small></div></a>
                    <a class="customer-account-link" href="@RequireLogin(profileUrl)"><span class="customer-account-link-icon is-purple"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-person-gear"></use></svg></span><div><strong>Hồ sơ khách hàng</strong><small>Cập nhật thông tin cá nhân.</small></div></a>
                    <a class="customer-account-link" href="@RequireLogin(walletUrl)" hidden="@(!hasWallet)"><span class="customer-account-link-icon is-green"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-wallet2"></use></svg></span><div><strong>Ví & giao dịch</strong><small>Xem số dư và lịch sử thanh toán.</small></div></a>
                    <a class="customer-account-link" href="@RequireLogin(topUpUrl)" hidden="@(!hasTopUps)"><span class="customer-account-link-icon is-amber"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-plus-circle"></use></svg></span><div><strong>Nạp tiền</strong><small>Tạo yêu cầu nạp ví.</small></div></a>

                    <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="customer-account-logout-form">
                        <input type="hidden" name="returnUrl" value="@branchHomeUrl" />
                        <button type="submit"><span class="customer-account-link-icon is-rose"><svg class="cu-svg-icon" aria-hidden="true" focusable="false"><use href="#cu-icon-box-arrow-right"></use></svg></span> Đăng xuất</button>
                    </form>
                </div>
            </div>
        }

        @if (!isSignedIn)
        {
            <a class="customer-login-button" href="@RequireLogin(dashboardUrl)">Đăng nhập</a>
        }
    </div>
</header>

<main class="customer-main">
    <partial name="_Alert" />
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
