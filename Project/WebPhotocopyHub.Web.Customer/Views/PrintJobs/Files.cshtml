@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
}

@model List<UploadedFileMetadata>
@{
    ViewData["Title"] = "File đã upload";
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant/20 shadow-sm relative overflow-hidden flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md">
        <div>
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">File đã tải lên</span>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">File đã upload</h1>
            <p class="text-sm text-on-surface-variant max-w-2xl">Quản lý các file bạn đã gửi lên hệ thống để tái sử dụng cho đơn in mới hoặc tải lại khi cần.</p>
            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-primary hover:bg-primary-container text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm hover:shadow-md" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create")">Upload trong đơn in mới</a>
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs")">Đơn in của tôi</a>
            </div>
        </div>
        <aside class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-5 shadow-sm min-w-[240px] flex flex-col gap-2 relative z-10">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1 block">Tổng file</span>
            <strong class="text-lg font-bold text-on-surface">@Model.Count</strong>
            <small class="text-xs text-on-surface-variant">Chỉ bạn và nhân sự có quyền xử lý đơn mới được truy cập file.</small>
        </aside>
    </section>

    <section class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
        <div class="overflow-x-auto border border-outline-variant/20 rounded-xl w-full">
            <table class="table-auto w-full text-left text-sm border-collapse">
                <thead class="bg-surface-container/60 border-b border-outline-variant/20">
                    <tr>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tên file</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Dung lượng</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Loại</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ngày upload</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-4 py-3.5 text-on-surface align-middle">
                            <div class="flex flex-col items-center justify-center text-center p-lg gap-3">
                                <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">cloud_off</span>
                                <strong class="text-sm font-bold text-on-surface">Chưa có file nào.</strong>
                                <span class="text-xs text-on-surface-variant">File sẽ xuất hiện ở đây sau khi bạn tạo đơn in.</span>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="border-b border-outline-variant/10 hover:bg-surface-container-low transition-colors duration-150">
                        <td class="px-4 py-3.5 text-on-surface align-middle font-semibold">@item.OriginalFileName</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">@(item.Size / 1024) KB</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">@item.ContentType</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle text-right">
                            <a class="px-3.5 py-2 bg-surface-container-low border border-primary/20 hover:border-primary/50 hover:bg-surface-container text-primary font-medium rounded-lg text-xs transition-colors inline-flex items-center justify-center gap-1.5" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/PreviewFile/{item.Id}")" target="_blank" rel="noopener">Xem trước</a>
                            <a class="px-3.5 py-2 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-medium rounded-lg text-xs transition-colors inline-flex items-center justify-center gap-1.5" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/DownloadFile/{item.Id}")">Tải xuống</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
