@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
}

@model WebPhotocopyHub.Application.DTOs.PagedResult<PrintJob>
@{
    ViewData["Title"] = "Đơn in của tôi";

    var processingCount = Model.Items.Count(x => x.Status == PrintJobStatus.Processing);
    var readyCount = Model.Items.Count(x => x.Status == PrintJobStatus.ReadyForPickup);
    var completedCount = Model.Items.Count(x => x.Status == PrintJobStatus.Completed);
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant/20 shadow-sm relative overflow-hidden flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md">
        <div>
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Đơn in</span>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">Đơn in của tôi</h1>
            <p class="text-sm text-on-surface-variant max-w-2xl">Theo dõi toàn bộ đơn in theo thời gian: chờ xác nhận, đang in, sẵn sàng nhận và đã hoàn thành.</p>
            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-primary hover:bg-primary-container text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm hover:shadow-md" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create")">Tạo đơn in mới</a>
            </div>
        </div>
        <aside class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-5 shadow-sm min-w-[240px] flex flex-col gap-2 relative z-10">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1 block">Tổng đơn</span>
            <strong class="text-lg font-bold text-on-surface">@Model.TotalCount</strong>
            <small class="text-xs text-on-surface-variant">@processingCount đang xử lý · @readyCount sẵn sàng nhận · @completedCount hoàn thành</small>
        </aside>
    </section>

    <section class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
        <div class="border-b border-outline-variant/20 pb-4 mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <div>
                <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Danh sách</span>
                <h2 class="text-lg font-bold text-on-surface">Lịch sử đơn in</h2>
            </div>
        </div>

        <div class="overflow-x-auto border border-outline-variant/20 rounded-xl w-full">
            <table class="table-auto w-full text-left text-sm border-collapse">
                <thead class="bg-surface-container/60 border-b border-outline-variant/20">
                    <tr>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Mã đơn</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ngày tạo</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tổng tiền</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider">Trạng thái</th>
                        <th class="px-4 py-3 text-xs font-bold text-on-surface-variant uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-4 py-3.5 text-on-surface align-middle">
                            <div class="flex flex-col items-center justify-center text-center p-lg gap-3">
                                <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">print_disabled</span>
                                <strong class="text-sm font-bold text-on-surface">Bạn chưa có đơn in nào.</strong>
                                <span class="text-xs text-on-surface-variant">Hãy tạo đơn đầu tiên bằng cách upload file và chọn cấu hình in.</span>
                                <a class="px-3.5 py-2 bg-primary hover:bg-primary-container text-white font-bold rounded-lg text-xs transition-colors inline-flex items-center justify-center gap-1.5 shadow-sm" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create")">Tạo đơn in</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    var detailLabel = item.Status == PrintJobStatus.Completed ? "Xem lại" : "Chi tiết";
                    var statusThemeClass = item.Status.ToBadgeClass() switch
                    {
                        "bg-success" => "bg-green-100 text-green-800 border-green-600/20",
                        "bg-danger" => "bg-error/10 text-error border-error/20",
                        "bg-primary" => "bg-primary/10 text-primary border-primary/20",
                        "bg-info text-dark" => "bg-primary/10 text-primary border-primary/20",
                        "bg-warning text-dark" => "bg-amber-100 text-amber-800 border-amber-500/20",
                        _ => "bg-surface-container-high text-on-surface-variant border-outline-variant/20"
                    };

                    <tr class="border-b border-outline-variant/10 hover:bg-surface-container-low transition-colors duration-150">
                        <td class="px-4 py-3.5 text-on-surface align-middle">
                            <a class="font-mono text-xs font-semibold bg-surface-container px-2 py-1 rounded border border-outline-variant/30 text-primary hover:bg-primary/10 transition-colors"
                               href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{item.Id}")">
                                @item.Id
                            </a>
                        </td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle font-semibold">@item.TotalAmount.ToString("N0") đ</td>
                        <td class="px-4 py-3.5 text-on-surface align-middle">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border leading-none shadow-xs @statusThemeClass">@item.Status.GetDisplayName()</span>
                        </td>
                        <td class="px-4 py-3.5 text-on-surface align-middle text-right">
                            <!-- Completed print-job review UI - start -->
                            <a class="px-3.5 py-2 bg-surface-container-low border border-primary/20 hover:border-primary/50 hover:bg-surface-container text-primary font-medium rounded-lg text-xs transition-colors inline-flex items-center justify-center gap-1.5"
                               href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{item.Id}")">
                                @detailLabel
                            </a>
                            <!-- Completed print-job review UI - end -->
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="flex justify-center items-center gap-1.5 mt-6">
                @if (Model.HasPreviousPage)
                {
                    <a class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm border border-outline-variant/20 transition-all" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs?page={Model.PageNumber - 1}")">Trước</a>
                }
                else
                {
                    <span class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container-low text-on-surface-variant/40 font-medium text-sm border border-outline-variant/10 cursor-not-allowed opacity-50">Trước</span>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.PageNumber)
                     {
                         <span class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary text-white font-bold text-sm shadow-sm transition-all">@i</span>
                     }
                     else
                     {
                         <a class="w-9 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm border border-outline-variant/20 transition-all" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs?page={i}")">@i</a>
                     }
                }

                @if (Model.HasNextPage)
                {
                    <a class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm border border-outline-variant/20 transition-all" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs?page={Model.PageNumber + 1}")">Sau</a>
                }
                else
                {
                    <span class="px-3.5 h-9 flex items-center justify-center rounded-lg bg-surface-container-low text-on-surface-variant/40 font-medium text-sm border border-outline-variant/10 cursor-not-allowed opacity-50">Sau</span>
                }
            </div>
        }
    </section>
</section>
