@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
}

@model WebPhotocopyHub.Application.DTOs.PagedResult<PrintJob>
@{
    ViewData["Title"] = "Đơn in của tôi";

    var processingCount = Model.Items.Count(x => x.Status == PrintJobStatus.Processing);
    var readyCount = Model.Items.Count(x => x.Status == PrintJobStatus.ReadyForPickup);
    var completedCount = Model.Items.Count(x => x.Status == PrintJobStatus.Completed);
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Print orders</span>
            <h1>Đơn in của tôi</h1>
            <p>Theo dõi toàn bộ đơn in theo thời gian: chờ xác nhận, đang in, sẵn sàng nhận và đã hoàn thành.</p>
            <div class="cu-actions">
                <a class="btn btn-primary" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create")">Tạo đơn in mới</a>
                <a class="btn btn-outline-secondary" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Files")">File đã upload</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Tổng đơn</span>
            <strong>@Model.TotalCount</strong>
            <small>@processingCount đang xử lý · @readyCount sẵn sàng nhận · @completedCount hoàn thành</small>
        </aside>
    </section>

    <section class="cu-card">
        <div class="cu-section-head">
            <div>
                <span class="cu-kicker">Danh sách</span>
                <h2>Lịch sử đơn in</h2>
            </div>
        </div>

        <div class="cu-table-wrap">
            <table class="table cu-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày tạo</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div class="cu-empty">
                                <strong>Bạn chưa có đơn in nào.</strong>
                                <span>Hãy tạo đơn đầu tiên bằng cách upload file và chọn cấu hình in.</span>
                                <a class="btn btn-sm btn-primary" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create")">Tạo đơn in</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    var detailLabel = item.Status == PrintJobStatus.Completed ? "Xem lại" : "Chi tiết";

                    <tr>
                        <td>
                            <a class="cu-code text-decoration-none"
                               href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{item.Id}")">
                                @item.Id
                            </a>
                        </td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-semibold">@item.TotalAmount.ToString("N0") đ</td>
                        <td><span class="badge @item.Status.ToBadgeClass()">@item.Status.GetDisplayName()</span></td>
                        <td class="text-end">
                            <!-- Completed print-job review UI - start -->
                            <a class="btn btn-sm btn-outline-primary"
                               href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{item.Id}")">
                                @detailLabel
                            </a>
                            <!-- Completed print-job review UI - end -->
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="cu-pagination mt-4 d-flex justify-content-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs?page={Model.PageNumber - 1}")" tabindex="-1">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs?page={i}")">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs?page={Model.PageNumber + 1}")">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</section>