@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
}

@model PrintJob
@{
    ViewData["Title"] = "Chi tiết đơn in";

    var isCompleted = Model.Status == PrintJobStatus.Completed;
    var createdAt = Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    var updatedAt = (Model.UpdatedAt ?? Model.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    var paidAt = Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận";
    var uploadedFileName = Model.UploadedFile?.OriginalFileName ?? "Không còn thông tin tên file";

    var statusThemeClass = Model.Status.ToBadgeClass() switch
    {
        "bg-success" => "bg-green-100 text-green-800 border-green-600/20",
        "bg-danger" => "bg-error/10 text-error border-error/20",
        "bg-primary" => "bg-primary/10 text-primary border-primary/20",
        "bg-info text-dark" => "bg-primary/10 text-primary border-primary/20",
        "bg-warning text-dark" => "bg-amber-100 text-amber-800 border-amber-500/20",
        _ => "bg-surface-container-high text-on-surface-variant border-outline-variant/20"
    };
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant/20 shadow-sm relative overflow-hidden flex flex-col lg:flex-row justify-between items-start lg:items-center gap-md">
        <div>
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">@(isCompleted ? "Completed print order" : "Print order detail")</span>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">@(isCompleted ? "Chi tiết đơn đã hoàn thành" : "Chi tiết đơn in")</h1>
            <p class="text-sm text-on-surface-variant max-w-2xl">Mã đơn: <span class="font-mono text-xs font-semibold bg-surface-container px-2 py-1 rounded border border-outline-variant/30 text-primary">@Model.Id</span></p>
            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" href="@CustomerBranchContext.ToPath(ViewContext, "PrintJobs")">Quay lại danh sách</a>
                <a class="px-5 py-2.5 bg-primary hover:bg-primary-container text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm hover:shadow-md" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/DownloadFile/{Model.UploadedFileId}")">Tải lại file</a>
                @if (Model.Status == PrintJobStatus.Draft || Model.Status == PrintJobStatus.Submitted || Model.Status == PrintJobStatus.ConfirmedByShop)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" asp-route-branchSlug="@ViewContext.RouteData.Values["branchSlug"]" method="post" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn huỷ đơn này? (Sẽ hoàn tiền về ví nếu đã thanh toán)');">
                        <button type="submit" class="px-5 py-2.5 bg-error hover:opacity-90 text-white font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm">Huỷ đơn</button>
                    </form>
                }
            </div>
        </div>
        <aside class="bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-5 shadow-sm min-w-[240px] flex flex-col gap-2 relative z-10">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1 block">Trạng thái</span>
            <strong class="text-lg font-bold text-on-surface">@Model.Status.GetDisplayName()</strong>
            <small class="text-xs text-on-surface-variant">Cập nhật gần nhất: @updatedAt</small>
        </aside>
    </section>

    @if (isCompleted)
    {
        <!-- Completed print-job review UI - start -->
        <div class="bg-green-100 border border-green-600/20 text-green-800 rounded-xl p-4 text-sm mb-6" role="status">
            <strong class="font-bold">Đơn này đã hoàn thành.</strong>
            Bạn vẫn có thể xem lại toàn bộ cấu hình, chi phí, ghi chú xử lý và file đã gửi.
        </div>
        <!-- Completed print-job review UI - end -->
    }

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-lg">
        <div class="lg:col-span-7 bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
            <div class="border-b border-outline-variant/20 pb-4 mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <div>
                    <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Thông tin in</span>
                    <h2 class="text-lg font-bold text-on-surface">Thông tin đầy đủ của đơn</h2>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border leading-none shadow-xs @statusThemeClass">@Model.Status.GetDisplayName()</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-md p-md">
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ngày tạo</span><strong class="text-sm font-semibold text-on-surface">@createdAt</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Cập nhật gần nhất</span><strong class="text-sm font-semibold text-on-surface">@updatedAt</strong></div>
                <div class="col-span-1 md:col-span-2 flex flex-col gap-1 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tên file</span><strong class="text-sm font-semibold text-on-surface break-all">@uploadedFileName</strong></div>

                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Khổ giấy</span><strong class="text-sm font-semibold text-on-surface">@Model.PaperSize.GetDisplayName()</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Kiểu in</span><strong class="text-sm font-semibold text-on-surface">@Model.PrintSide.GetDisplayName()</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Màu sắc</span><strong class="text-sm font-semibold text-on-surface">@Model.ColorMode.GetDisplayName()</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Loại tài liệu</span><strong class="text-sm font-semibold text-on-surface">@(Model.IsPhoto ? "Ảnh" : "Tài liệu")</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Số bản</span><strong class="text-sm font-semibold text-on-surface">@Model.Copies</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Số trang mỗi bản</span><strong class="text-sm font-semibold text-on-surface">@Model.TotalPages</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tổng trang cần in</span><strong class="text-sm font-semibold text-on-surface">@(Model.Copies * Model.TotalPages)</strong></div>

                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Đơn giá</span><strong class="text-sm font-semibold text-on-surface">@Model.UnitPrice.ToString("N0") đ</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tạm tính</span><strong class="text-sm font-semibold text-on-surface">@Model.SubTotal.ToString("N0") đ</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Phí giao hàng</span><strong class="text-sm font-semibold text-on-surface">@Model.ShippingFee.ToString("N0") đ</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Tổng tiền</span><strong class="text-sm font-semibold text-on-surface">@Model.TotalAmount.ToString("N0") đ</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Thanh toán lúc</span><strong class="text-sm font-semibold text-on-surface">@paidAt</strong></div>

                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Hình thức nhận</span><strong class="text-sm font-semibold text-on-surface">@Model.DeliveryMethod.GetDisplayName()</strong></div>
                <div class="flex justify-between items-center border-b border-outline-variant/10 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Địa chỉ giao</span><strong class="text-sm font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "Nhận tại tiệm" : Model.DeliveryAddress)</strong></div>
                <div class="col-span-1 md:col-span-2 flex flex-col gap-1 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ghi chú của khách hàng</span><strong class="text-sm font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có ghi chú." : Model.Notes)</strong></div>
                <div class="col-span-1 md:col-span-2 flex flex-col gap-1 py-2.5"><span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ghi chú xử lý</span><strong class="text-sm font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(Model.LastStatusNote) ? "Không có ghi chú xử lý." : Model.LastStatusNote)</strong></div>
            </div>
        </div>

        <aside class="lg:col-span-5 bg-surface-container-lowest border border-surface-variant/20 rounded-xl p-md md:p-lg shadow-sm flex flex-col gap-md">
            <div class="border-b border-outline-variant/20 pb-4 mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <div>
                    <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Xem trước</span>
                    <h2 class="text-lg font-bold text-on-surface">File đơn in</h2>
                </div>
            </div>

            <div class="w-full aspect-[4/3] md:aspect-[16/10] rounded-xl border border-outline-variant/20 overflow-hidden bg-surface-container-low">
                <iframe
                    src="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/PreviewFile/{Model.UploadedFileId}")"
                    title="Xem trước file đơn in @Model.Id"
                    class="w-full h-full border-0"
                    loading="lazy">
                </iframe>
            </div>

            <div class="flex flex-wrap gap-3 mt-4">
                <a class="px-5 py-2.5 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 shadow-sm" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/DownloadFile/{Model.UploadedFileId}")">Tải lại file</a>
            </div>
        </aside>
    </section>
</section>
