@model BranchHomeViewModel

@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
    ViewData["Title"] = Model.Branch.Name;

    var loginUrl = CustomerBranchContext.ToPath(ViewContext, "Login");
    var dashboardUrl = CustomerBranchContext.ToPath(ViewContext, "Dashboard");
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");

    var branchOpenHours = string.IsNullOrWhiteSpace(Model.Branch.OpenHours) ? "08:00 - 21:00 hằng ngày" : Model.Branch.OpenHours;
    var branchAddress = string.IsNullOrWhiteSpace(Model.Branch.Address) || Model.Branch.Address.Equals("Đang cập nhật", StringComparison.OrdinalIgnoreCase)
        ? "12 Nguyễn Văn Bảo, Phường 4, Gò Vấp, TP.HCM"
        : Model.Branch.Address;

    string RequireLogin(string targetUrl)
    {
        return Model.IsSignedIn ? targetUrl : loginUrl + "?returnUrl=" + Uri.EscapeDataString(targetUrl);
    }
}

<section class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg flex flex-col gap-lg">
    <section class="bg-surface-container-low rounded-xl p-lg border border-surface-variant relative overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-lg items-center">
        <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-primary-container/20 to-secondary-container/10 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none"></div>

        <div class="lg:col-span-8 relative z-10">
            <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Trang cơ sở</span>
            <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold mb-2">Đặt in tại <span class="text-primary">@Model.Branch.Name</span></h1>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">
                Gửi file, chọn cấu hình in, mua văn phòng phẩm và theo dõi trạng thái xử lý trong cùng một trải nghiệm khách hàng.
            </p>

            <div class="flex flex-wrap gap-3 mt-6">
                @if (Model.IsSignedIn)
                {
                    <a class="bg-primary hover:bg-primary-fixed-variant text-on-primary font-bold py-2 px-4 rounded-lg flex items-center gap-2 transition-colors shadow-sm" href="@RequireLogin(printCreateUrl)">
                        <span class="material-symbols-outlined text-[18px]">print</span>
                        Tạo đơn in
                    </a>
                    <a class="bg-surface border border-outline-variant hover:bg-surface-container text-on-surface font-medium py-2 px-4 rounded-lg flex items-center gap-2 transition-colors" href="@RequireLogin(dashboardUrl)">
                        <span class="material-symbols-outlined text-[18px]">dashboard</span>
                        Tổng quan
                    </a>
                }
                else
                {
                    <a class="bg-primary hover:bg-primary-fixed-variant text-on-primary font-bold py-2 px-4 rounded-lg flex items-center gap-2 transition-colors shadow-sm" href="@RequireLogin(dashboardUrl)">
                        <span class="material-symbols-outlined text-[18px]">login</span>
                        Đăng nhập khách hàng
                    </a>
                }

                <a class="bg-surface border border-outline-variant hover:bg-surface-container text-on-surface font-medium py-2 px-4 rounded-lg flex items-center gap-2 transition-colors" href="#customerPriceQuick">
                    <span class="material-symbols-outlined text-[18px]">sell</span>
                    Xem bảng giá
                </a>
            </div>
        </div>

        <aside class="lg:col-span-4 bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm flex flex-col gap-3 relative z-10">
            <span class="text-primary font-bold text-xs uppercase tracking-wider block">Bắt đầu nhanh</span>
            @if (Model.IsSignedIn)
            {
                <strong class="text-[36px] leading-tight text-on-surface font-bold">@Model.ActivePrintJobCount</strong>
                <span class="text-sm text-on-surface-variant">đơn in đang cần theo dõi tại cơ sở này.</span>
                <a class="inline-flex items-center gap-2 text-primary text-sm font-bold mt-2" href="@RequireLogin(printJobsUrl)">
                    <span class="material-symbols-outlined text-[18px]">fact_check</span>
                    Theo dõi đơn của tôi
                </a>
            }
            else
            {
                <strong class="text-lg text-on-surface font-bold">Đăng nhập để dùng đầy đủ chức năng</strong>
                <span class="text-sm text-on-surface-variant">Sau khi đăng nhập, bạn có thể tạo đơn, thanh toán ví và xem lịch sử xử lý.</span>
                <a class="inline-flex items-center gap-2 text-primary text-sm font-bold mt-2" href="@RequireLogin(dashboardUrl)">
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    Mở tổng quan
                </a>
            }
        </aside>
    </section>

    @if (Model.IsSignedIn)
    {
        <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-md">
            <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex flex-col items-start gap-3" href="@RequireLogin(printCreateUrl)">
                <span class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors"><span class="material-symbols-outlined">print</span></span>
                <strong class="text-sm font-bold text-on-surface">Tạo đơn in</strong>
                <small class="text-xs text-on-surface-variant">Upload file và gửi yêu cầu in mới.</small>
            </a>
            <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-tertiary/30 transition-all group flex flex-col items-start gap-3" href="@RequireLogin(printJobsUrl)">
                <span class="w-10 h-10 rounded-full bg-tertiary/10 text-tertiary flex items-center justify-center group-hover:bg-tertiary group-hover:text-white transition-colors"><span class="material-symbols-outlined">fact_check</span></span>
                <strong class="text-sm font-bold text-on-surface">Đơn của tôi</strong>
                <small class="text-xs text-on-surface-variant">Theo dõi xử lý, thanh toán và nhận hàng.</small>
            </a>
            <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-secondary/30 transition-all group flex flex-col items-start gap-3" href="@RequireLogin(productsUrl)">
                <span class="w-10 h-10 rounded-full bg-secondary/10 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors"><span class="material-symbols-outlined">inventory_2</span></span>
                <strong class="text-sm font-bold text-on-surface">Sản phẩm</strong>
                <small class="text-xs text-on-surface-variant">Mua giấy, bìa và vật tư văn phòng.</small>
            </a>
            <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex flex-col items-start gap-3" href="@RequireLogin(supportCreateUrl)">
                <span class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors"><span class="material-symbols-outlined">support_agent</span></span>
                <strong class="text-sm font-bold text-on-surface">Dịch vụ hỗ trợ</strong>
                <small class="text-xs text-on-surface-variant">Scan, đóng gáy, ép plastic và xử lý file.</small>
            </a>
        </section>
    }

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-lg">
        <article id="customerPriceQuick" class="lg:col-span-8 bg-surface-container-lowest rounded-xl p-md md:p-lg border border-surface-variant shadow-sm flex flex-col gap-md">
            <div class="border-b border-outline-variant/20 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <div>
                    <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Bảng giá</span>
                    <h2 class="text-lg font-bold text-on-surface">Giá tham khảo đang áp dụng</h2>
                </div>
                @if (Model.IsSignedIn)
                {
                    <a class="px-3.5 py-2 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-lg text-xs transition-colors inline-flex items-center gap-1.5" href="@RequireLogin(printCreateUrl)">Tạo đơn</a>
                }
            </div>

            @if (Model.QuickPrices.Count > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                    @foreach (var price in Model.QuickPrices)
                    {
                        <div class="bg-surface-container-low border border-outline-variant/20 rounded-xl p-md flex justify-between items-center gap-3">
                            <span class="flex flex-col">
                                <strong class="text-sm font-bold text-on-surface">@price.Name</strong>
                                <small class="text-xs text-on-surface-variant">@price.Description</small>
                            </span>
                            <em class="text-primary text-sm font-bold text-right">@price.UnitPrice.ToString("N0") đ / trang</em>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center text-center p-lg gap-2">
                    <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">sell</span>
                    <strong class="text-sm font-bold text-on-surface">Chưa có bảng giá hoạt động</strong>
                    <span class="text-xs text-on-surface-variant">Vui lòng cập nhật bảng giá trong phần quản trị để khách hàng xem được giá thật.</span>
                </div>
            }
        </article>

        <aside id="customerContact" class="lg:col-span-4 bg-surface-container-lowest rounded-xl p-md md:p-lg border border-surface-variant shadow-sm flex flex-col gap-md">
            <div>
                <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Cơ sở</span>
                <h2 class="text-lg font-bold text-on-surface">@Model.Branch.Name</h2>
            </div>
            <div class="flex items-start gap-2 text-on-surface-variant text-sm">
                <span class="material-symbols-outlined text-[18px] text-primary">schedule</span>
                <span>@branchOpenHours</span>
            </div>
            <div class="flex items-start gap-2 text-on-surface-variant text-sm">
                <span class="material-symbols-outlined text-[18px] text-primary">location_on</span>
                <span>@branchAddress</span>
            </div>
            <div class="flex items-start gap-2 text-on-surface-variant text-sm">
                <span class="material-symbols-outlined text-[18px] text-primary">call</span>
                <span>@Model.Branch.PhoneNumber</span>
            </div>
            <div class="w-full h-32 rounded-lg bg-surface-variant overflow-hidden relative">
                <img class="w-full h-full object-cover" data-alt="Bản đồ đường đi" src="~/_content/WebPhotocopyHub.Web.Customer/images/customer-dashboard-map.jpg" asp-append-version="true" />
            </div>
            @if (Model.IsSignedIn)
            {
                <div class="flex flex-wrap gap-2">
                    <a class="px-3.5 py-2 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-lg text-xs transition-colors inline-flex items-center gap-1.5" href="@RequireLogin(supportCreateUrl)">Yêu cầu hỗ trợ</a>
                    <a class="px-3.5 py-2 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-lg text-xs transition-colors inline-flex items-center gap-1.5" href="@RequireLogin(profileUrl)">Hồ sơ nhận hàng</a>
                </div>
            }
        </aside>
    </section>

    @if (Model.IsSignedIn)
    {
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-lg">
            <article class="lg:col-span-8 bg-surface-container-lowest rounded-xl p-md md:p-lg border border-surface-variant shadow-sm flex flex-col gap-md">
                <div class="border-b border-outline-variant/20 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <div>
                        <span class="text-primary font-bold text-xs uppercase tracking-wider mb-1 block">Hoạt động gần đây</span>
                        <h2 class="text-lg font-bold text-on-surface">Đơn in cần chú ý</h2>
                    </div>
                    <a class="px-3.5 py-2 bg-surface-container border border-outline-variant/30 hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-bold rounded-lg text-xs transition-colors inline-flex items-center gap-1.5" href="@RequireLogin(dashboardUrl)">Mở tổng quan</a>
                </div>

                @if (Model.RecentPrintJobs.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center text-center p-lg gap-3">
                        <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">print_disabled</span>
                        <strong class="text-sm font-bold text-on-surface">Bạn chưa có đơn in nào</strong>
                        <span class="text-xs text-on-surface-variant">Tạo đơn in đầu tiên bằng cách gửi file và chọn cấu hình in.</span>
                        <a class="px-3.5 py-2 bg-primary hover:bg-primary-container text-white font-bold rounded-lg text-xs transition-colors inline-flex items-center gap-1.5 shadow-sm" href="@RequireLogin(printCreateUrl)">Tạo đơn in</a>
                    </div>
                }
                else
                {
                    <div class="flex flex-col">
                        @foreach (var job in Model.RecentPrintJobs)
                        {
                            <a class="flex justify-between items-center gap-3 py-3 border-b border-outline-variant/10 hover:bg-surface-container-low transition-colors" href="@CustomerBranchContext.ToPath(ViewContext, $"PrintJobs/Details/{job.Id}")">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border leading-none bg-primary/10 text-primary border-primary/20">@job.Status.GetDisplayName()</span>
                                <span class="flex flex-col flex-1">
                                    <strong class="text-sm font-bold text-on-surface">@job.PaperSize.GetDisplayName() · @job.ColorMode.GetDisplayName() · @job.PrintSide.GetDisplayName()</strong>
                                    <small class="text-xs text-on-surface-variant">@job.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @job.TotalAmount.ToString("N0") đ</small>
                                </span>
                                <span class="material-symbols-outlined text-primary text-[18px]">arrow_forward</span>
                            </a>
                        }
                    </div>
                }
            </article>

            <aside class="lg:col-span-4 bg-gradient-to-br from-primary to-secondary-container rounded-xl p-lg text-on-primary shadow-md relative overflow-hidden">
                <div class="relative z-10 flex flex-col gap-4">
                    <div>
                        <span class="text-primary-fixed text-xs font-bold uppercase tracking-wider">Tổng quan riêng</span>
                        <strong class="block text-[40px] leading-tight font-bold mt-2">@Model.ActivePrintJobCount</strong>
                        <span class="text-primary-fixed text-sm">đơn in đang cần theo dõi</span>
                    </div>
                    <p class="text-white/70 text-sm">
                        Tổng quan chứa số dư ví, giao dịch, đơn sản phẩm, dịch vụ hỗ trợ và thống kê cá nhân.
                    </p>
                    <div class="flex flex-col gap-2">
                        <a class="w-full bg-white text-primary font-bold py-3 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-surface-bright transition-colors shadow-sm" href="@RequireLogin(dashboardUrl)">
                            <span class="material-symbols-outlined">dashboard</span>
                            Vào tổng quan
                        </a>
                        <a class="w-full bg-white text-primary font-bold py-3 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-surface-bright transition-colors shadow-sm" href="@RequireLogin(walletUrl)">
                            <span class="material-symbols-outlined">account_balance_wallet</span>
                            Ví của tôi
                        </a>
                    </div>
                </div>
            </aside>
        </section>
    }
</section>
