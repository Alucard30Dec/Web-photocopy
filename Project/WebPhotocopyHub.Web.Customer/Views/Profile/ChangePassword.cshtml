@model WebPhotocopyHub.Web.Models.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_BranchCustomerLayout.cshtml";
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="customer-profile-page">
    <div class="customer-page-header">
        <h1>Đổi mật khẩu</h1>
        <p>Vui lòng nhập mật khẩu cũ và mật khẩu mới để thay đổi.</p>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="cu-card">
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="cu-btn cu-btn--primary">Lưu mật khẩu mới</button>
                        <a href="@Url.Action("Index", "Profile", new { branchSlug = ViewContext.RouteData.Values["branchSlug"] })" class="cu-btn cu-btn--outline">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
