@using Microsoft.AspNetCore.Identity
@using WebPhotocopyHub.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@model DashboardViewModel
@{
    Layout = "~/Views/Shared/_BranchCustomerModernLayout.cshtml";
    ViewData["Title"] = "Tổng quan khách hàng";

    var branch = CustomerBranchContext.GetBranch(ViewContext);
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.FullName;
    if (string.IsNullOrWhiteSpace(displayName)) { displayName = User.Identity?.Name ?? "Nguyễn Minh Khoa"; }

    // Codex 2026-07-04: Align branch display text with the supplied customer dashboard mockup; scope limited to this dashboard.
    var branchOpenHours = string.IsNullOrWhiteSpace(branch.OpenHours) ? "08:00 - 21:00 hằng ngày" : branch.OpenHours;
    var branchAddress = string.IsNullOrWhiteSpace(branch.Address) || branch.Address.Equals("Đang cập nhật", StringComparison.OrdinalIgnoreCase)
        ? "12 Nguyễn Văn Bảo, Phường 4, Gò Vấp, TP.HCM"
        : branch.Address;

    var branchHomeUrl = CustomerBranchContext.Home(ViewContext);
    var printCreateUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs/Create");
    var printJobsUrl = CustomerBranchContext.ToPath(ViewContext, "PrintJobs");
    var productsUrl = CustomerBranchContext.ToPath(ViewContext, "Products");
    var productOrdersUrl = CustomerBranchContext.ToPath(ViewContext, "Products/Orders");
    var supportCreateUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/Create");
    var supportHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "SupportOrders/History");
    var walletUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet");
    var topUpUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUp");
    var topUpHistoryUrl = CustomerBranchContext.ToPath(ViewContext, "Wallet/TopUpHistory");
    var profileUrl = CustomerBranchContext.ToPath(ViewContext, "Profile");
}

<main class="flex-1 p-md md:p-lg overflow-y-auto max-w-container-max mx-auto w-full px-lg">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg mb-lg items-start">
        
        <!-- Welcome & Balance Section -->
        <div class="lg:col-span-8 flex flex-col gap-lg">
            <!-- Welcome Card -->
            <div class="bg-surface-container-low rounded-xl p-lg shadow-sm border border-surface-variant relative overflow-hidden flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md min-h-[280px]">
                <!-- Decorative background -->
                <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-primary-container/20 to-secondary-container/10 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none"></div>
                
                <div class="relative z-10">
                    <p class="text-primary font-label-md text-label-md mb-1 uppercase tracking-wider">Tổng quan khách hàng</p>
                    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">Chào mừng trở lại,<br/><span class="text-primary">@displayName</span></h2>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-lg">
                        Xem nhanh đơn in, đơn sản phẩm, dịch vụ hỗ trợ, ví và hồ sơ tại cơ sở @branch.Name.
                    </p>
                    
                    <div class="flex gap-md mt-6">
                        <a href="@printCreateUrl" class="bg-primary hover:bg-primary-fixed-variant text-on-primary font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-2 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-sm">print</span>
                            Tạo đơn in
                        </a>
                        <a href="@branchHomeUrl" class="bg-surface border border-outline-variant hover:bg-surface-container text-on-surface font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-2 transition-colors">
                            <span class="material-symbols-outlined text-sm">home</span>
                            Về trang chính
                        </a>
                    </div>
                </div>
            </div>

            <!-- Statistics Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-md w-full">
                <!-- Stat Card 1 -->
                <a href="@printJobsUrl" class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col items-start">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3">
                        <span class="material-symbols-outlined">description</span>
                    </div>
                    <p class="text-on-surface-variant text-sm font-medium mb-1">Đơn in đang xử lý</p>
                    <h3 class="font-headline-md text-headline-md text-on-surface font-bold mb-0">@Model.PrintJobsCount</h3>
                </a>
                
                <!-- Stat Card 2 -->
                <a href="@productOrdersUrl" class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col items-start">
                    <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center text-secondary mb-3">
                        <span class="material-symbols-outlined">inventory_2</span>
                    </div>
                    <p class="text-on-surface-variant text-sm font-medium mb-1">Đơn sản phẩm</p>
                    <h3 class="font-headline-md text-headline-md text-on-surface font-bold mb-0">@Model.ProductOrdersCount</h3>
                </a>
                
                <!-- Stat Card 3 -->
                <a href="@supportHistoryUrl" class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col items-start">
                    <div class="w-10 h-10 rounded-full bg-tertiary/10 flex items-center justify-center text-tertiary mb-3">
                        <span class="material-symbols-outlined">support_agent</span>
                    </div>
                    <p class="text-on-surface-variant text-sm font-medium mb-1">Yêu cầu hỗ trợ</p>
                    <h3 class="font-headline-md text-headline-md text-on-surface font-bold mb-0">@Model.SupportOrdersCount</h3>
                </a>
                
                <!-- Stat Card 4 -->
                <a href="@topUpHistoryUrl" class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col items-start">
                    <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center text-on-surface-variant mb-3">
                        <span class="material-symbols-outlined">pending_actions</span>
                    </div>
                    <p class="text-on-surface-variant text-sm font-medium mb-1">Thanh toán chờ</p>
                    <h3 class="font-headline-md text-headline-md text-on-surface font-bold mb-0">@Model.PendingTopUpCount</h3>
                </a>
            </div>

            <div class="mt-4">
                <div class="flex items-center gap-2 mb-4">
                    <h3 class="font-headline-md text-lg font-bold text-on-surface mb-0">Thao tác nhanh</h3>
                    <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface text-xs font-medium">Truy cập nhanh</span>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-md">
                    <!-- Action 1 -->
                    <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex flex-col items-start gap-3" href="@printCreateUrl">
                        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">print</span>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md font-bold text-on-surface mb-1">Tạo đơn in</h4>
                            <p class="text-xs text-on-surface-variant line-clamp-2 mb-0">Gửi file và yêu cầu in mới nhanh chóng.</p>
                        </div>
                    </a>
                    
                    <!-- Action 2 -->
                    <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-tertiary/30 transition-all group flex flex-col items-start gap-3" href="@printJobsUrl">
                        <div class="w-10 h-10 rounded-full bg-tertiary/10 text-tertiary flex items-center justify-center group-hover:bg-tertiary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">fact_check</span>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md font-bold text-on-surface mb-1">Đơn của tôi</h4>
                            <p class="text-xs text-on-surface-variant line-clamp-2 mb-0">Theo dõi trạng thái xử lý các đơn hàng.</p>
                        </div>
                    </a>
                    
                    <!-- Action 3 -->
                    <a class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm hover:shadow-md hover:border-secondary/30 transition-all group flex flex-col items-start gap-3" href="@productsUrl">
                        <div class="w-10 h-10 rounded-full bg-secondary/10 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">inventory_2</span>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md font-bold text-on-surface mb-1">Sản phẩm</h4>
                            <p class="text-xs text-on-surface-variant line-clamp-2 mb-0">Mua vật tư văn phòng phẩm tại cơ sở.</p>
                        </div>
                    </a>
                </div>
            </div>
            
        </div>
        
        <!-- Balance & Branch Info Side -->
        <div class="lg:col-span-4 flex flex-col gap-lg lg:sticky lg:top-24">
            <!-- Balance Card -->
            <div class="bg-gradient-to-br from-primary to-secondary-container rounded-xl p-lg text-on-primary shadow-md relative overflow-hidden h-[280px]">
                <div class="relative z-10 flex flex-col h-full justify-between">
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="font-label-md text-label-md font-medium text-primary-fixed mb-0">Số dư ví</h3>
                            <span class="material-symbols-outlined text-primary-fixed">account_balance_wallet</span>
                        </div>
                        <p class="font-display-lg text-[40px] leading-tight font-bold mb-1">@Model.CurrentBalance.ToString("N0") đ</p>
                        <a href="@walletUrl" class="flex items-center gap-1 text-primary-fixed hover:text-white transition-colors text-sm font-medium mt-2">
                            <span class="material-symbols-outlined text-[16px]">history</span>
                            Xem lịch sử giao dịch
                        </a>
                    </div>
                    <div class="mt-6">
                        <a href="@topUpUrl" class="w-full bg-white text-primary font-label-md text-label-md py-3 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-surface-bright transition-colors shadow-sm font-bold">
                            <span class="material-symbols-outlined">add_circle</span>
                            Nạp tiền ngay
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Branch Info Card -->
            <div class="bg-surface-container-lowest rounded-xl p-md border border-surface-variant shadow-sm flex-1">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-label-md text-label-md font-bold text-on-surface uppercase tracking-wide text-xs text-primary mb-0">Cơ sở hiện tại</h3>
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-green-100 text-green-800 text-[10px] font-bold">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                        Đang mở cửa
                    </span>
                </div>
                <h4 class="font-headline-md text-headline-md text-on-surface mb-3 font-bold">@branch.Name</h4>
                <div class="flex items-start gap-2 text-on-surface-variant text-sm mb-3">
                    <span class="material-symbols-outlined text-[18px] mt-0.5 text-primary">schedule</span>
                    <p class="mb-0 mt-0.5">@branchOpenHours</p>
                </div>
                <div class="flex items-start gap-2 text-on-surface-variant text-sm mb-4">
                    <span class="material-symbols-outlined text-[18px] mt-0.5 text-primary">location_on</span>
                    <p class="mb-0 mt-0.5">@branchAddress</p>
                </div>
                <div class="w-full h-32 rounded-lg bg-surface-variant overflow-hidden relative">
                    <img class="w-full h-full object-cover" data-alt="Bản đồ đường đi" src="~/_content/WebPhotocopyHub.Web.Customer/images/customer-dashboard-map.jpg" asp-append-version="true" />
                </div>
            </div>
            
        </div>
    </div>
</main>
