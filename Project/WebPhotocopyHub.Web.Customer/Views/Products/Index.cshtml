@model ProductCatalogViewModel
@{
    ViewData["Title"] = "Văn phòng phẩm";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Stationery</span>
            <h1>Đặt mua văn phòng phẩm</h1>
            <p>Chọn số lượng sản phẩm cần mua. Hệ thống kiểm tra tồn kho và tạo đơn để cơ sở chuẩn bị cùng tài liệu in của bạn.</p>
            <div class="cu-actions">
                <a class="btn btn-outline-secondary" asp-action="Orders" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Lịch sử đơn hàng</a>
                <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Tổng quan</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Sản phẩm đang bán</span>
            <strong>@Model.Items.Count</strong>
            <small>Giấy, bút, bìa, vật tư học tập và văn phòng.</small>
        </aside>
    </section>

    <section class="cu-card">
        <form asp-action="Index" method="post" class="cu-form" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">
            <input asp-for="IdempotencyKey" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="cu-product-grid">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <article class="cu-product-card">
                        <div>
                            <span class="cu-product-icon">SP</span>
                            <h2>@Model.Items[i].Name</h2>
                            <p>@Model.Items[i].Price.ToString("N0") đ · Tồn kho: @Model.Items[i].StockQuantity</p>
                        </div>
                        <input asp-for="Items[i].ProductId" type="hidden" />
                        <input asp-for="Items[i].Name" type="hidden" />
                        <input asp-for="Items[i].Price" type="hidden" />
                        <input asp-for="Items[i].StockQuantity" type="hidden" />

                        <label asp-for="Items[i].Quantity" class="form-label"></label>
                        <input asp-for="Items[i].Quantity" class="form-control" min="0" />
                    </article>
                }
            </div>

            <div class="cu-form-grid mt-3">
                <div>
                    <label asp-for="DeliveryMethod" class="form-label"></label>
                    <select asp-for="DeliveryMethod" class="form-select" asp-items="Html.GetEnumSelectList<DeliveryMethod>()"></select>
                </div>
                <div>
                    <label asp-for="DeliveryAddress" class="form-label"></label>
                    <input asp-for="DeliveryAddress" class="form-control" />
                </div>
                <div class="cu-form-grid__full">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="cu-actions mt-3">
                <button class="btn btn-primary" type="submit">Tạo đơn sản phẩm</button>
                <a class="btn btn-outline-secondary" asp-action="Orders" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Lịch sử đơn hàng</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}