@model ProductOrder
@{
    ViewData["Title"] = "Chi tiết đơn văn phòng phẩm";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Product order detail</span>
            <h1>Chi tiết đơn văn phòng phẩm</h1>
            <p>Mã đơn: <span class="cu-code">@Model.Id</span></p>
            <div class="cu-actions">
                <a class="btn btn-outline-secondary" asp-action="Orders" asp-route-branchSlug="@CustomerBranchContext.GetSlug(ViewContext)">Quay lại danh sách</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Tổng tiền</span>
            <strong>@Model.TotalAmount.ToString("N0") đ</strong>
            <small>Trạng thái: @Model.Status.GetDisplayName()</small>
        </aside>
    </section>

    <section class="cu-card">
        <div class="cu-section-head">
            <div>
                <span class="cu-kicker">Line items</span>
                <h2>Sản phẩm trong đơn</h2>
            </div>
            <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span>
        </div>

        <div class="cu-table-wrap">
            <table class="table cu-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@line.Product?.Name</td>
                        <td class="text-end">@line.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end">@line.Quantity</td>
                        <td class="text-end fw-semibold">@line.LineTotal.ToString("N0") đ</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>