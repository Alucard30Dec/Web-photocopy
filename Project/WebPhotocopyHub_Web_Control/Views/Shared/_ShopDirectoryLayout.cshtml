<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhotoCopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="shop-directory-shell">
<header class="shop-directory-topbar">
    <a class="shop-directory-brand" href="/Home" aria-label="PhotoCopyHub trang chính">
        <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 3h8v4H8z"/><path d="M6 7h12a3 3 0 0 1 3 3v5h-4v6H7v-6H3v-5a3 3 0 0 1 3-3z"/><path d="M9 15h6M9 18h6"/></svg>
        </span>
        PhotoCopyHub
    </a>

    <nav class="shop-directory-topnav" aria-label="Điều hướng nhanh">
        <a href="/Customer#customerFlow">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.8 9a2.2 2.2 0 0 1 4.3.7c0 1.8-2.1 2-2.1 3.5"></path><path d="M12 17h.01"></path></svg>
            Trợ giúp
        </a>
        <span aria-hidden="true"></span>
        <strong>Chọn cơ sở để đặt in</strong>
    </nav>
</header>

<main class="shop-directory-main">
    <partial name="_Alert" />
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
