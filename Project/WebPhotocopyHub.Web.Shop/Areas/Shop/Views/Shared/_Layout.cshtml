@using System.Security.Claims
@using WebPhotocopyHub.Application.Branching
@using WebPhotocopyHub.Application.Contracts
@using WebPhotocopyHub.Domain.Constants
@inject IBranchContext BranchContext
@inject IBranchManagementService BranchManagementService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop - WebPhotocopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/WebPhotocopyHub.Web.Shop/css/shop-admin.css" asp-append-version="true" />
</head>
<body class="shop-admin-app">
@{
    var shopController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var shopAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var branchSlug = ViewContext.RouteData.Values["branchSlug"]?.ToString();
    var branch = ShopBranchCatalog.Find(branchSlug ?? string.Empty);
    var shopName = branch?.Name ?? "Tiệm photocopy";
    var branchHomeUrl = string.IsNullOrWhiteSpace(branchSlug) ? "/" : $"/{branchSlug}";
    var displayName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Nhân viên vận hành" : User.Identity!.Name!;
    var displayInitial = displayName.Trim().Substring(0, 1).ToUpperInvariant();
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    var isSystemAdmin = User.IsInRole(RoleConstants.Admin);
    var currentBranchId = BranchContext.BranchId;
    var enabledFeatures = currentBranchId.HasValue
        ? await BranchManagementService.GetEnabledFeaturesAsync(currentBranchId.Value)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    async Task<bool> CanAsync(string featureCode, string permissionCode)
    {
        if (!currentBranchId.HasValue || !enabledFeatures.Contains(featureCode))
        {
            return false;
        }

        return isSystemAdmin || await BranchManagementService.UserHasPermissionAsync(currentUserId, currentBranchId.Value, permissionCode);
    }

    var canDashboard = currentBranchId.HasValue && (isSystemAdmin || await BranchManagementService.UserHasPermissionAsync(currentUserId, currentBranchId.Value, BranchPermissionCodes.DashboardView));
    var canTopUpView = await CanAsync(BranchFeatureCodes.TopUps, BranchPermissionCodes.TopUpsView);
    var canTopUpReview = await CanAsync(BranchFeatureCodes.TopUps, BranchPermissionCodes.TopUpsReview);
    var canCounterTopUp = await CanAsync(BranchFeatureCodes.TopUps, BranchPermissionCodes.CounterTopUp);
    var canPrintView = await CanAsync(BranchFeatureCodes.PrintOrders, BranchPermissionCodes.PrintJobsView);
    var canSupportView = await CanAsync(BranchFeatureCodes.SupportServices, BranchPermissionCodes.SupportOrdersView);
    var canProductView = await CanAsync(BranchFeatureCodes.ProductSales, BranchPermissionCodes.ProductOrdersView);
    var canInventoryView = await CanAsync(BranchFeatureCodes.Inventory, BranchPermissionCodes.InventoryView);

    string ShopUrl(string controllerName, string actionName = "Index")
    {
        object routeValues = string.IsNullOrWhiteSpace(branchSlug)
            ? new { area = "Shop" }
            : new { area = "Shop", branchSlug };

        return Url.Action(actionName, controllerName, routeValues) ?? "#";
    }

    bool IsActive(string controllerName, string? actionName = null)
    {
        var controllerMatch = string.Equals(shopController, controllerName, StringComparison.OrdinalIgnoreCase);
        var actionMatch = string.IsNullOrWhiteSpace(actionName)
            || string.Equals(shopAction, actionName, StringComparison.OrdinalIgnoreCase);

        return controllerMatch && actionMatch;
    }
}

<svg class="shop-svg-sprite" aria-hidden="true" focusable="false">
    <symbol id="shop-icon-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect></symbol>
    <symbol id="shop-icon-wallet-check" viewBox="0 0 24 24"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H18a2 2 0 0 1 2 2v2"></path><path d="M3 8h14.5A2.5 2.5 0 0 1 20 10.5V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><path d="m15 14 1.5 1.5L20 12"></path></symbol>
    <symbol id="shop-icon-counter" viewBox="0 0 24 24"><path d="M4 21h16"></path><path d="M6 21V8h12v13"></path><path d="M8 8V4h8v4"></path><path d="M9 12h6"></path><path d="M12 10v4"></path><path d="M9 17h6"></path></symbol>
    <symbol id="shop-icon-printer" viewBox="0 0 24 24"><path d="M6 9V3h12v6"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="7" rx="1"></rect><path d="M18 12h.01"></path></symbol>
    <symbol id="shop-icon-package" viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Z"></path><path d="m4.5 7.75 7.5 4.1 7.5-4.1"></path><path d="M12 21v-9.15"></path><path d="m8 5.25 8 4.45"></path></symbol>
    <symbol id="shop-icon-service" viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5 5L3 18v3h3l6.7-6.7a4 4 0 0 0 5-5l-2.4 2.4-3-3Z"></path><path d="m15 15 6 6"></path></symbol>
    <symbol id="shop-icon-inventory" viewBox="0 0 24 24"><path d="M4 7h16v14H4z"></path><path d="M3 3h18v4H3z"></path><path d="M9 11h6"></path></symbol>
    <symbol id="shop-icon-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"></path><path d="M5 10v11h14V10"></path><path d="M9 21v-6h6v6"></path></symbol>
    <symbol id="shop-icon-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></symbol>
    <symbol id="shop-icon-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></symbol>
    <symbol id="shop-icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></symbol>
    <symbol id="shop-icon-alert" viewBox="0 0 24 24"><path d="M12 3 2.5 20h19Z"></path><path d="M12 9v5"></path><path d="M12 17h.01"></path></symbol>
</svg>

<header class="shop-admin-header">
    <div class="shop-admin-topline">
        <div class="shop-admin-header-inner">
            <a class="shop-admin-brand" href="@ShopUrl("Dashboard")" aria-label="Mở dashboard vận hành">
                <span class="shop-admin-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><use href="#shop-icon-printer"></use></svg>
                </span>
                <span class="shop-admin-brand-copy">
                    <strong>WebPhotocopyHub</strong>
                    <small>Quản trị cơ sở</small>
                </span>
            </a>

            <div class="shop-admin-context" aria-label="Ngữ cảnh làm việc hiện tại">
                <span>Khu vận hành</span>
                <strong>@shopName</strong>
                <small>@ViewData["Title"]</small>
            </div>

            <div class="shop-admin-head-actions">
                <span class="shop-admin-live-status"><i aria-hidden="true"></i> Đang trực tuyến</span>
                <a class="shop-admin-home-link" href="@branchHomeUrl">
                    <svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-home"></use></svg>
                    <span>Trang cơ sở</span>
                </a>

                <div class="dropdown">
                    <button class="shop-admin-user-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="shop-admin-avatar">@displayInitial</span>
                        <span class="shop-admin-user-copy">
                            <strong>@displayName</strong>
                            <small>Nhân viên vận hành</small>
                        </span>
                        <svg class="shop-icon shop-admin-user-chevron" aria-hidden="true"><use href="#shop-icon-chevron"></use></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shop-admin-user-menu">
                        <div class="shop-admin-user-menu-head">
                            <span class="shop-admin-avatar">@displayInitial</span>
                            <div>
                                <strong>@displayName</strong>
                                <small>@shopName</small>
                            </div>
                        </div>
                        <a class="dropdown-item" href="@branchHomeUrl">Mở trang cơ sở</a>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                            <input type="hidden" name="returnUrl" value="@branchHomeUrl" />
                            <button class="dropdown-item text-danger" type="submit">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="shop-function-bar">
        <nav class="shop-function-groups" aria-label="Nhóm chức năng quản trị cơ sở">
            <div class="shop-function-group dropdown @(IsActive("Dashboard") ? "is-active" : string.Empty)" hidden="@(!canDashboard)">
                <button class="shop-function-group-toggle dropdown-toggle" type="button" id="shop-nav-overview" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                    <span class="shop-function-group-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-dashboard"></use></svg></span>
                    <span class="shop-function-group-copy"><strong>Tổng quan</strong><small>Điều hành chung</small></span>
                    <svg class="shop-icon shop-function-group-chevron" aria-hidden="true"><use href="#shop-icon-chevron"></use></svg>
                </button>
                <ul class="dropdown-menu shop-function-menu" aria-labelledby="shop-nav-overview">
                    <li>
                        <div class="shop-function-menu-head">
                            <strong>Tổng quan cơ sở</strong>
                            <small>Theo dõi nhanh hoạt động và truy cập trang khách hàng.</small>
                        </div>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("Dashboard") ? "active" : string.Empty)" href="@ShopUrl("Dashboard")">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-dashboard"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Tổng quan</strong><small>Tổng quan vận hành và cảnh báo</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item" href="@branchHomeUrl">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-home"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Trang cơ sở</strong><small>Mở giao diện dành cho khách hàng</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="shop-function-group dropdown @(IsActive("TopUpRequests") ? "is-active" : string.Empty)" hidden="@(!(canTopUpView || canCounterTopUp))">
                <button class="shop-function-group-toggle dropdown-toggle" type="button" id="shop-nav-finance" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                    <span class="shop-function-group-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-wallet-check"></use></svg></span>
                    <span class="shop-function-group-copy"><strong>Tài chính</strong><small>Nạp tiền và ví</small></span>
                    <svg class="shop-icon shop-function-group-chevron" aria-hidden="true"><use href="#shop-icon-chevron"></use></svg>
                </button>
                <ul class="dropdown-menu shop-function-menu" aria-labelledby="shop-nav-finance">
                    <li>
                        <div class="shop-function-menu-head">
                            <strong>Giao dịch khách hàng</strong>
                            <small>Kiểm tra yêu cầu online và xử lý giao dịch trực tiếp tại quầy.</small>
                        </div>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("TopUpRequests", "Index") ? "active" : string.Empty)" href="@ShopUrl("TopUpRequests")" hidden="@(!canTopUpView)">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-wallet-check"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Duyệt nạp tiền</strong><small>Kiểm tra chứng từ và giao dịch</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("TopUpRequests", "CounterTopUp") ? "active" : string.Empty)" href="@ShopUrl("TopUpRequests", "CounterTopUp")" hidden="@(!canCounterTopUp)">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-counter"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Nạp tiền tại quầy</strong><small>Cộng ví trực tiếp cho khách hàng</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="shop-function-group dropdown @((IsActive("PrintJobs") || IsActive("SupportOrders")) ? "is-active" : string.Empty)" hidden="@(!(canPrintView || canSupportView))">
                <button class="shop-function-group-toggle dropdown-toggle" type="button" id="shop-nav-services" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                    <span class="shop-function-group-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-printer"></use></svg></span>
                    <span class="shop-function-group-copy"><strong>Xử lý đơn</strong><small>In ấn và hỗ trợ</small></span>
                    <svg class="shop-icon shop-function-group-chevron" aria-hidden="true"><use href="#shop-icon-chevron"></use></svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shop-function-menu" aria-labelledby="shop-nav-services">
                    <li>
                        <div class="shop-function-menu-head">
                            <strong>Đơn dịch vụ</strong>
                            <small>Tiếp nhận, xử lý và cập nhật trạng thái các yêu cầu tại cơ sở.</small>
                        </div>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("PrintJobs") ? "active" : string.Empty)" href="@ShopUrl("PrintJobs")" hidden="@(!canPrintView)">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-printer"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Hàng chờ in</strong><small>Nhận file và xử lý đơn in</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("SupportOrders") ? "active" : string.Empty)" href="@ShopUrl("SupportOrders")" hidden="@(!canSupportView)">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-service"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Dịch vụ hỗ trợ</strong><small>Scan, đóng gáy và ép plastic</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="shop-function-group dropdown @((IsActive("ProductOrders") || IsActive("Inventory")) ? "is-active" : string.Empty)" hidden="@(!(canProductView || canInventoryView))">
                <button class="shop-function-group-toggle dropdown-toggle" type="button" id="shop-nav-goods" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                    <span class="shop-function-group-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-package"></use></svg></span>
                    <span class="shop-function-group-copy"><strong>Hàng hóa &amp; kho</strong><small>Đơn hàng, tồn kho</small></span>
                    <svg class="shop-icon shop-function-group-chevron" aria-hidden="true"><use href="#shop-icon-chevron"></use></svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shop-function-menu" aria-labelledby="shop-nav-goods">
                    <li>
                        <div class="shop-function-menu-head">
                            <strong>Hàng hóa và tồn kho</strong>
                            <small>Quản lý đơn văn phòng phẩm, số lượng tồn và cảnh báo nhập hàng.</small>
                        </div>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("ProductOrders") ? "active" : string.Empty)" href="@ShopUrl("ProductOrders")" hidden="@(!canProductView)">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-package"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Đơn văn phòng phẩm</strong><small>Chuẩn bị và bàn giao đơn hàng</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item shop-function-menu-item @(IsActive("Inventory") ? "active" : string.Empty)" href="@ShopUrl("Inventory")" hidden="@(!canInventoryView)">
                            <span class="shop-function-menu-icon"><svg class="shop-icon" aria-hidden="true"><use href="#shop-icon-inventory"></use></svg></span>
                            <span class="shop-function-menu-copy"><strong>Quản lý tồn kho</strong><small>Nhập, xuất và theo dõi cảnh báo</small></span>
                            <svg class="shop-icon shop-function-menu-arrow" aria-hidden="true"><use href="#shop-icon-arrow"></use></svg>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</header>

<main class="shop-admin-main">
    <div class="shop-admin-container">
        <partial name="_Alert" />
        @RenderBody()
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
