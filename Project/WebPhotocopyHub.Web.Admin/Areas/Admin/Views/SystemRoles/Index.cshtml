@model SystemRoleIndexViewModel
@{
    ViewData["Title"] = "Vai trò hệ thống";
    var activeCount = Model.Roles.Count(x => x.IsActive);
    var canCreate = ViewBag.CanCreate is true;
    var canEdit = ViewBag.CanEdit is true;
    var canViewPermissions = ViewBag.CanViewPermissions is true;
}

<section class="system-page-hero compact">
    <div>
        <span class="system-eyebrow">Identity role governance</span>
        <h1>Vai trò và nhóm quyền</h1>
        <p>Dùng ASP.NET Core Identity Role làm nhóm thành viên; quyền chức năng được cấu hình riêng theo ma trận.</p>
        <div class="system-hero-meta">
            <span class="system-soft-chip">@Model.Roles.Count vai trò</span>
            <span class="system-soft-chip">@activeCount đang hoạt động</span>
        </div>
    </div>
    <div class="system-hero-actions">
        @if (canViewPermissions)
        {
            <a class="btn btn-outline-secondary"
               asp-area="Admin"
               asp-controller="SystemPermissions"
               asp-action="Index">Phân quyền</a>
        }
        @if (canCreate)
        {
            <a class="btn btn-primary" asp-action="Create">Tạo vai trò</a>
        }
    </div>
</section>

<section class="system-panel mt-3">
    <div class="table-responsive system-table-wrap">
        <table class="table system-table align-middle">
            <thead>
                <tr>
                    <th>Vai trò</th>
                    <th>Mô tả</th>
                    <th class="text-center">Tài khoản</th>
                    <th class="text-center">Chức năng được xem</th>
                    <th>Trạng thái</th>
                    <th style="width:260px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td>
                            <strong>@role.DisplayName</strong>
                            <small class="d-block text-muted">@role.RoleName @(role.IsSystemRole ? "• Role hệ thống" : string.Empty)</small>
                        </td>
                        <td>@(role.Description ?? "Chưa có mô tả")</td>
                        <td class="text-center">@role.UserCount</td>
                        <td class="text-center">@role.GrantedFunctionCount</td>
                        <td>
                            <span class="system-access-badge @(role.IsActive ? "is-protected" : "is-public")">
                                @(role.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")
                            </span>
                        </td>
                        <td>
                            <div class="system-action-stack">
                                @if (canEdit)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit"
                                       asp-route-id="@role.RoleId">Chỉnh sửa</a>
                                }
                                @if (canViewPermissions)
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-area="Admin"
                                       asp-controller="SystemPermissions"
                                       asp-action="Index"
                                       asp-route-roleId="@role.RoleId">Phân quyền</a>
                                }
                                @if (canEdit && !role.IsSystemRole)
                                {
                                    <form asp-action="SetActive" method="post">
                                        <input type="hidden" name="id" value="@role.RoleId" />
                                        <input type="hidden" name="isActive" value="@(!role.IsActive)" />
                                        <button class="btn btn-sm @(role.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                type="submit">
                                            @(role.IsActive ? "Vô hiệu hóa" : "Kích hoạt")
                                        </button>
                                    </form>
                                }
                                @if (!canEdit && !canViewPermissions)
                                {
                                    <span class="text-muted">Chỉ xem</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
