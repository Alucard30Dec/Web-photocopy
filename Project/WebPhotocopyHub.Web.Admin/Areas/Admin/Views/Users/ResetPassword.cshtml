@model ResetSystemUserPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="system-page-hero compact">
    <div>
        <span class="system-eyebrow">Credential reset</span>
        <h1>Đặt lại mật khẩu tài khoản</h1>
        <p>@Model.UserDisplay</p>
    </div>
    <div class="system-hero-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </div>
</section>

<section class="system-panel mt-3">
    <form asp-action="ResetPassword" method="post" class="system-form-grid">
        <input asp-for="UserId" type="hidden" />
        <input asp-for="UserDisplay" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger system-validation-summary"></div>

        <div class="alert alert-warning">
            Sau khi đặt lại mật khẩu, security stamp được đổi để các phiên đăng nhập cũ phải xác thực lại.
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="col-lg-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="system-form-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            <button class="btn btn-danger" type="submit">Đặt lại mật khẩu</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
