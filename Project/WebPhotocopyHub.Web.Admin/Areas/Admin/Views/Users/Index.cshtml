@model List<ApplicationUser>
@using WebPhotocopyHub.Application.DTOs
@using WebPhotocopyHub.Domain.Constants
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var userRoleMap = ViewBag.UserRoleMap as Dictionary<string, IReadOnlyList<string>>
        ?? new Dictionary<string, IReadOnlyList<string>>();
    var currentUserId = User.GetUserId();
    var activeCount = Model.Count(x => x.IsActive);
    var adminCount = Model.Count(user =>
        user.IsActive
        && userRoleMap.TryGetValue(user.Id, out var roles)
        && roles.Contains(RoleConstants.Admin, StringComparer.Ordinal));
    var canCreateUsers = ViewBag.CanCreateUsers is true;
    var canEditUsers = ViewBag.CanEditUsers is true;
    var canViewRoles = ViewBag.CanViewRoles is true;
    var canViewPermissions = ViewBag.CanViewPermissions is true;
}

<section class="system-page-hero compact">
    <div>
        <span class="system-eyebrow">Identity & account governance</span>
        <h1>Quản lý tài khoản hệ thống</h1>
        <p>Tạo tài khoản, cập nhật hồ sơ, gán nhiều vai trò, khóa/mở và đặt lại mật khẩu theo luồng có audit.</p>
        <div class="system-hero-meta">
            <span class="system-soft-chip">@Model.Count tài khoản</span>
            <span class="system-soft-chip">@activeCount đang hoạt động</span>
            <span class="system-health-chip @(adminCount > 0 ? "is-success" : "is-danger")">
                <span></span>@adminCount quản trị viên hoạt động
            </span>
        </div>
    </div>
    <div class="system-hero-actions">
        @if (canViewRoles)
        {
            <a class="btn btn-outline-secondary"
               asp-area="Admin"
               asp-controller="SystemRoles"
               asp-action="Index">Vai trò</a>
        }
        @if (canViewPermissions)
        {
            <a class="btn btn-outline-primary"
               asp-area="Admin"
               asp-controller="SystemPermissions"
               asp-action="Index">Phân quyền</a>
        }
        @if (canCreateUsers)
        {
            <a class="btn btn-primary"
               asp-action="Create">Tạo tài khoản</a>
        }
    </div>
</section>

<section class="system-panel mt-3">
    <div class="system-panel-header">
        <div>
            <span class="system-panel-kicker">Users</span>
            <h2>Danh sách tài khoản toàn hệ thống</h2>
        </div>
        <span class="system-panel-note">Không xóa cứng tài khoản; dùng khóa để giữ lịch sử và liên kết nghiệp vụ</span>
    </div>

    <div class="table-responsive system-table-wrap">
        <table class="table system-table align-middle">
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Liên hệ</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Số dư</th>
                    <th>Ngày tạo</th>
                    <th style="min-width:300px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="system-empty-state">Chưa có tài khoản.</div>
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    var roles = userRoleMap.TryGetValue(user.Id, out var assignedRoles)
                        ? assignedRoles
                        : Array.Empty<string>();
                    var isCurrentUser = string.Equals(
                        currentUserId,
                        user.Id,
                        StringComparison.Ordinal);
                    var isTargetAdmin = roles.Contains(
                        RoleConstants.Admin,
                        StringComparer.Ordinal);
                    var canManageThisUser = canEditUsers
                        && (User.IsInRole(RoleConstants.Admin) || !isTargetAdmin);

                    <tr>
                        <td>
                            <div class="system-user-cell">
                                <span class="system-user-avatar">
                                    @((string.IsNullOrWhiteSpace(user.FullName)
                                        ? user.Email
                                        : user.FullName)?.Substring(0, 1).ToUpperInvariant())
                                </span>
                                <div>
                                    <strong>@(string.IsNullOrWhiteSpace(user.FullName)
                                        ? "Chưa cập nhật họ tên"
                                        : user.FullName)</strong>
                                    <small>@user.Id</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <strong>@user.Email</strong>
                            <small class="d-block text-muted">
                                @(user.PhoneNumber ?? "Chưa có số điện thoại")
                            </small>
                        </td>
                        <td>
                            <div class="system-role-chip-list">
                                @if (roles.Count == 0)
                                {
                                    <span class="system-soft-chip">Chưa gán vai trò</span>
                                }
                                @foreach (var role in roles)
                                {
                                    <span class="system-soft-chip">@role</span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="system-access-badge @(user.IsActive ? "is-protected" : "is-public")">
                                @(user.IsActive ? "Đang hoạt động" : "Đã khóa")
                            </span>
                            @if (isCurrentUser)
                            {
                                <small class="d-block text-muted mt-1">Phiên đang đăng nhập</small>
                            }
                        </td>
                        <td class="text-end">
                            <strong>@user.BranchWalletBalance.ToString("N0") đ</strong>
                        </td>
                        <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (canManageThisUser)
                            {
                                <div class="system-action-stack">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit"
                                       asp-route-userId="@user.Id">Cập nhật</a>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="ResetPassword"
                                       asp-route-userId="@user.Id">Đặt lại mật khẩu</a>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="AdjustBalance"
                                       asp-route-userId="@user.Id">Điều chỉnh ví</a>
                                    <form asp-action="ToggleActive" method="post">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                type="submit"
                                                disabled="@isCurrentUser">
                                            @(user.IsActive ? "Khóa" : "Mở")
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Chỉ xem</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
