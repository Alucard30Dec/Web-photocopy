@model AdminDashboardPageViewModel
@{
    ViewData["Title"] = "Dashboard quản trị hệ thống";
    var healthClass = string.Equals(Model.HealthStatus, "Healthy", StringComparison.OrdinalIgnoreCase)
        ? "is-success"
        : string.Equals(Model.HealthStatus, "Degraded", StringComparison.OrdinalIgnoreCase)
            ? "is-warning"
            : "is-danger";
    var auditClass = Model.IsAuditChainValid ? "is-success" : "is-danger";
    var urgentWorkCount = Model.Summary.PendingTopUps + Model.Summary.PrintJobsPending;
    var activeCatalogCount = Model.Summary.ActiveProducts + Model.Summary.ActiveSupportServices;
    var updatedAt = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
}

<section class="adminops-dashboard-header" aria-labelledby="admin-dashboard-title">
    <div>
        <span class="adminops-eyebrow">Operations console</span>
        <h1 id="admin-dashboard-title">Dashboard quản trị toàn hệ thống</h1>
        <p>Tập trung vào công việc cần xử lý, kiểm soát tài chính, vận hành đơn hàng và sức khỏe hệ thống.</p>
        <div class="adminops-dashboard-meta">
            <span>Cập nhật lúc @updatedAt</span>
            <span class="adminops-status-chip @healthClass"><i aria-hidden="true"></i>Health: @Model.HealthStatus</span>
            <span>@Model.ActivityLast24Hours hoạt động trong 24 giờ</span>
        </div>
    </div>
    <div class="adminops-dashboard-actions">
        <a class="adminops-button secondary" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Tra cứu audit log</a>
        <a class="adminops-button primary" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">Mở trung tâm giám sát</a>
    </div>
</section>

<section class="adminops-attention-grid" aria-label="Chỉ số cần chú ý">
    <a class="adminops-attention-card tone-warning" asp-area="Admin" asp-controller="TopUpRequests" asp-action="Index">
        <div class="adminops-attention-head"><span>Top-up chờ duyệt</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16v12H4zM4 10h16M16 14h2M7 4h10"></path></svg></div>
        <strong>@Model.Summary.PendingTopUps</strong>
        <p>Chứng từ và giao dịch cần kiểm tra trước khi ghi nhận số dư.</p>
        <span class="adminops-card-link">Mở hàng đợi <b aria-hidden="true">→</b></span>
    </a>
    <a class="adminops-attention-card tone-info" asp-area="Admin" asp-controller="PrintJobs" asp-action="Index">
        <div class="adminops-attention-head"><span>Đơn in đang xử lý</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 4h12v5H6zM5 9h14a2 2 0 0 1 2 2v6h-4v3H7v-3H3v-6a2 2 0 0 1 2-2ZM9 15h6v5H9z"></path></svg></div>
        <strong>@Model.Summary.PrintJobsPending</strong>
        <p>Theo dõi file, trạng thái xử lý và các tình huống cần can thiệp.</p>
        <span class="adminops-card-link">Điều phối đơn <b aria-hidden="true">→</b></span>
    </a>
    <a class="adminops-attention-card tone-neutral" asp-area="Admin" asp-controller="Reconciliation" asp-action="Index">
        <div class="adminops-attention-head"><span>Đối soát ví</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h15v13H4zM16 10h5v5h-5a2.5 2.5 0 0 1 0-5ZM7 3h10"></path></svg></div>
        <strong>Kiểm tra</strong>
        <p>Đối chiếu số dư hiện tại với lịch sử giao dịch và tham chiếu nghiệp vụ.</p>
        <span class="adminops-card-link">Mở đối soát <b aria-hidden="true">→</b></span>
    </a>
    <a class="adminops-attention-card @healthClass" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">
        <div class="adminops-attention-head"><span>Sức khỏe hệ thống</span><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4M7 11h2l2-4 3 8 2-4h2"></path></svg></div>
        <strong>@Model.HealthStatus</strong>
        <p>@Model.ApiEndpointCount API endpoint đang được kiểm kê trong hệ thống.</p>
        <span class="adminops-card-link">Xem giám sát <b aria-hidden="true">→</b></span>
    </a>
</section>

<section class="adminops-summary-strip" aria-label="Tổng quan dữ liệu hệ thống">
    <a asp-area="Admin" asp-controller="Users" asp-action="Index"><span>Tài khoản</span><strong>@Model.Summary.TotalUsers</strong><small>Người dùng toàn hệ thống</small></a>
    <a asp-area="Admin" asp-controller="WalletTransactions" asp-action="Index"><span>Giao dịch ví</span><strong>@Model.Summary.TotalWalletTransactions</strong><small>Lịch sử biến động</small></a>
    <a asp-area="Admin" asp-controller="Products" asp-action="Index"><span>Danh mục hoạt động</span><strong>@activeCatalogCount</strong><small>@Model.Summary.ActiveProducts sản phẩm · @Model.Summary.ActiveSupportServices dịch vụ</small></a>
    <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><span>Audit 24 giờ</span><strong>@Model.ActivityLast24Hours</strong><small class="@auditClass">Chuỗi audit: @(Model.IsAuditChainValid ? "Hợp lệ" : "Cần kiểm tra")</small></a>
</section>

<div class="adminops-dashboard-layout">
    <section class="adminops-panel adminops-work-panel">
        <header class="adminops-panel-header">
            <div><span class="adminops-eyebrow">Work queue</span><h2>Trung tâm công việc</h2><p>@urgentWorkCount mục đang cần theo dõi trực tiếp.</p></div>
            <span class="adminops-panel-badge">Ưu tiên vận hành</span>
        </header>
        <div class="adminops-work-table" role="table" aria-label="Danh sách công việc ưu tiên">
            <div class="adminops-work-row adminops-work-head" role="row">
                <span role="columnheader">Ưu tiên</span><span role="columnheader">Công việc</span><span role="columnheader">Số lượng</span><span role="columnheader">Kiểm soát</span><span role="columnheader">Thao tác</span>
            </div>
            <div class="adminops-work-row" role="row">
                <span role="cell"><b class="adminops-priority high">Cao</b></span>
                <span role="cell"><strong>Duyệt yêu cầu nạp tiền</strong><small>Kiểm tra chứng từ, trạng thái và idempotency.</small></span>
                <span role="cell"><b>@Model.Summary.PendingTopUps</b></span>
                <span role="cell">Luồng tiền</span>
                <span role="cell"><a asp-area="Admin" asp-controller="TopUpRequests" asp-action="Index">Xử lý</a></span>
            </div>
            <div class="adminops-work-row" role="row">
                <span role="cell"><b class="adminops-priority medium">Trung bình</b></span>
                <span role="cell"><strong>Điều phối đơn in</strong><small>Kiểm soát file, tiến độ, trạng thái và hoàn tiền.</small></span>
                <span role="cell"><b>@Model.Summary.PrintJobsPending</b></span>
                <span role="cell">Vận hành</span>
                <span role="cell"><a asp-area="Admin" asp-controller="PrintJobs" asp-action="Index">Mở danh sách</a></span>
            </div>
            <div class="adminops-work-row" role="row">
                <span role="cell"><b class="adminops-priority normal">Định kỳ</b></span>
                <span role="cell"><strong>Đối soát số dư ví</strong><small>Phát hiện chênh lệch giữa số dư và lịch sử.</small></span>
                <span role="cell"><b>—</b></span>
                <span role="cell">Tài chính</span>
                <span role="cell"><a asp-area="Admin" asp-controller="Reconciliation" asp-action="Index">Đối soát</a></span>
            </div>
        </div>
    </section>

    <aside class="adminops-panel adminops-control-panel">
        <header class="adminops-panel-header"><div><span class="adminops-eyebrow">Security &amp; observability</span><h2>Trạng thái kiểm soát</h2><p>Các chỉ báo kỹ thuật và truy vết quan trọng.</p></div></header>
        <div class="adminops-control-list">
            <a asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index"><span><i class="@healthClass" aria-hidden="true"></i>Health checks</span><strong class="@healthClass">@Model.HealthStatus</strong></a>
            <a asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index"><span><i class="is-info" aria-hidden="true"></i>API inventory</span><strong>@Model.ApiEndpointCount endpoints</strong></a>
            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><span><i class="@auditClass" aria-hidden="true"></i>Audit chain</span><strong class="@auditClass">@(Model.IsAuditChainValid ? "Hợp lệ" : "Cần kiểm tra")</strong></a>
            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><span><i class="is-neutral" aria-hidden="true"></i>Activity 24 giờ</span><strong>@Model.ActivityLast24Hours bản ghi</strong></a>
        </div>
    </aside>
</div>

<div class="adminops-dashboard-layout lower">
    <section class="adminops-panel adminops-activity-panel">
        <header class="adminops-panel-header">
            <div><span class="adminops-eyebrow">Activity tracking</span><h2>Hoạt động gần đây</h2><p>Nhật ký mới nhất phục vụ truy vết thay đổi.</p></div>
            <a class="adminops-text-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Xem toàn bộ →</a>
        </header>
        <div class="adminops-activity-list">
            @if (Model.RecentActivities.Count == 0)
            {
                <div class="adminops-empty-state"><strong>Chưa có hoạt động gần đây</strong><span>Các thao tác quản trị mới sẽ xuất hiện tại đây.</span></div>
            }
            @foreach (var item in Model.RecentActivities)
            {
                var activityIso = item.CreatedAt.ToString("O");
                <a class="adminops-activity-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" asp-route-query="@item.Action">
                    <span class="adminops-activity-dot" aria-hidden="true"></span>
                    <span><strong>@item.Action</strong><small>@item.EntityName · @(item.EntityId ?? "Không có mã")</small></span>
                    <time datetime="@activityIso">@item.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time>
                </a>
            }
        </div>
    </section>

    <section class="adminops-panel adminops-quick-panel">
        <header class="adminops-panel-header"><div><span class="adminops-eyebrow">Management center</span><h2>Truy cập nhanh</h2><p>Mở các nhóm chức năng quản trị thường dùng.</p></div></header>
        <div class="adminops-quick-grid">
            <a asp-area="Admin" asp-controller="Users" asp-action="Index"><span>Danh tính</span><strong>Người dùng và quyền</strong><small>Tài khoản, vai trò và số dư</small></a>
            <a asp-area="Admin" asp-controller="ProductOrders" asp-action="Index"><span>Vận hành</span><strong>Đơn hàng hệ thống</strong><small>Đơn sản phẩm và dịch vụ</small></a>
            <a asp-area="Admin" asp-controller="Inventory" asp-action="Index"><span>Kho</span><strong>Tồn kho và biến động</strong><small>Sản phẩm, nhập xuất và cảnh báo</small></a>
            <a asp-area="Admin" asp-controller="PricingRules" asp-action="Index"><span>Cấu hình</span><strong>Danh mục và bảng giá</strong><small>Quy tắc giá và dịch vụ</small></a>
        </div>
    </section>
</div>
