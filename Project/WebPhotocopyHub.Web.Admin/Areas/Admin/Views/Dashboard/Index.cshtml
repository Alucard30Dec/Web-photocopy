@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-hero mb-3">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <span class="dashboard-kicker">Admin console</span>
            <h3 class="mb-2 mt-2">Dashboard quản trị</h3>
            <p class="mb-0">Theo dõi nhanh tình hình vận hành hệ thống và các đầu việc cần xử lý ngay.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Users" asp-action="Index">Quản lý users</a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Reconciliation" asp-action="Index">Đối soát ví</a>
        </div>
    </div>
</section>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Tổng users</div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Top-up chờ duyệt</div>
            <div class="stat-value">@ViewBag.PendingTopUps</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Đơn in chờ xử lý</div>
            <div class="stat-value">@ViewBag.PrintJobsPending</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Tổng giao dịch ví</div>
            <div class="stat-value">@ViewBag.TotalWalletTransactions</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Sản phẩm active</div>
            <div class="stat-value">@ViewBag.ActiveProducts</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Dịch vụ hỗ trợ active</div>
            <div class="stat-value">@ViewBag.ActiveSupportServices</div>
        </div>
    </div>
</div>

<div class="workspace-grid">
    <section class="workspace-panel">
        <div class="workspace-panel-header">
            <div>
                <span class="panel-eyebrow">Điều phối hệ thống</span>
                <h4>Việc admin cần theo dõi</h4>
            </div>
        </div>

        <div class="queue-board admin-board">
            <a class="queue-lane queue-lane-hot" asp-area="Admin" asp-controller="TopUpRequests" asp-action="Index">
                <span>Top-up chờ duyệt</span>
                <strong>@ViewBag.PendingTopUps</strong>
                <small>Luồng tiền cần kiểm tra</small>
            </a>
            <a class="queue-lane" asp-area="Admin" asp-controller="PrintJobs" asp-action="Index">
                <span>Đơn in chờ xử lý</span>
                <strong>@ViewBag.PrintJobsPending</strong>
                <small>Theo dõi SLA vận hành</small>
            </a>
            <a class="queue-lane" asp-area="Admin" asp-controller="WalletTransactions" asp-action="Index">
                <span>Giao dịch ví</span>
                <strong>@ViewBag.TotalWalletTransactions</strong>
                <small>Tra cứu biến động số dư</small>
            </a>
        </div>
    </section>

    <aside class="workspace-panel">
        <span class="panel-eyebrow">Quản trị nhanh</span>
        <h4>Cấu hình và kiểm soát</h4>
        <div class="quick-action-stack">
            <a asp-area="Admin" asp-controller="PricingRules" asp-action="Index">Bảng giá in</a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index">Văn phòng phẩm</a>
            <a asp-area="Admin" asp-controller="SupportServices" asp-action="Index">Dịch vụ hỗ trợ</a>
            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Audit logs</a>
        </div>
    </aside>
</div>
