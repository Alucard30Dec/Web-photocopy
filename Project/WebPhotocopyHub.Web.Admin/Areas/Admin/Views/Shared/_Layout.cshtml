@using WebPhotocopyHub.Domain.Constants
@using WebPhotocopyHub.Application.Contracts
@using WebPhotocopyHub.Application.DTOs
@inject IBranchContext BranchContext
@inject ISystemAdministrationService SystemAdministrationService
@{
    var adminController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var adminAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAdminLoginPage = string.Equals(adminController, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(adminAction, "Login", StringComparison.OrdinalIgnoreCase);
    var accountName = User.Identity?.Name ?? "Quản trị hệ thống";
    var adminNavigation = isAdminLoginPage
        ? Array.Empty<SystemNavigationItemDto>()
        : await SystemAdministrationService.GetNavigationAsync(User, Context.RequestAborted);
    var adminBranches = isAdminLoginPage
        ? Array.Empty<Branch>()
        : await SystemAdministrationService.GetAccessibleAdminBranchesAsync(User, Context.RequestAborted);
    var selectedBranch = BranchContext.BranchId.HasValue
        ? adminBranches.FirstOrDefault(x => x.Id == BranchContext.BranchId.Value)
        : null;
    var accountInitial = string.IsNullOrWhiteSpace(accountName)
        ? "A"
        : accountName.Trim()[0].ToString().ToUpperInvariant();
    var pageTitle = ViewData["Title"]?.ToString() ?? "Quản trị hệ thống";

    SystemNavigationItemDto? FindFirstNavigationLink(IEnumerable<SystemNavigationItemDto> items)
    {
        foreach (var item in items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
        {
            if (!string.IsNullOrWhiteSpace(item.Controller))
            {
                return item;
            }

            var child = FindFirstNavigationLink(item.Children);
            if (child is not null)
            {
                return child;
            }
        }

        return null;
    }

    bool NavigationContainsController(IEnumerable<SystemNavigationItemDto> items, string controller)
    {
        return items.Any(item =>
            string.Equals(item.Controller, controller, StringComparison.OrdinalIgnoreCase)
            || NavigationContainsController(item.Children, controller));
    }

    var firstNavigationLink = FindFirstNavigationLink(adminNavigation);
    var adminHomePath = firstNavigationLink is null
        ? "/Admin"
        : $"/Admin/{firstNavigationLink.Controller}/{firstNavigationLink.Action ?? "Index"}";
    var canOpenBranches = NavigationContainsController(adminNavigation, "Branches");
    var canOpenUsers = NavigationContainsController(adminNavigation, "Users");
    var canOpenAuditLogs = NavigationContainsController(adminNavigation, "AuditLogs");
    var canOpenMonitoring = NavigationContainsController(adminNavigation, "SystemMonitoring");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Quản trị hệ thống - WebPhotocopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/WebPhotocopyHub.Web.Admin/css/admin-system.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="system-admin-body @(isAdminLoginPage ? "system-admin-login-body" : "adminops-body adminmega-body")">
    @if (isAdminLoginPage)
    {
        <header class="system-admin-header">
            <div class="system-admin-brandbar">
                <div class="container-fluid system-admin-container">
                    <a class="system-admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <span class="system-admin-logo" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z"></path>
                                <path d="m9 12 2 2 4-5"></path>
                            </svg>
                        </span>
                        <span>
                            <strong>WebPhotocopyHub</strong>
                            <small>Quản trị hệ thống</small>
                        </span>
                    </a>

                    <div class="system-admin-head-actions">
                        <div class="system-admin-login-context" aria-label="Khu vực quản trị hệ thống">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z"></path>
                                <path d="m9 12 2 2 4-5"></path>
                            </svg>
                            <span>Khu vực quản trị hệ thống</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="container-fluid system-admin-container system-admin-main">
            <partial name="_Alert" />
            @RenderBody()
        </main>
    }


    @if (!isAdminLoginPage)
    {
        <svg class="adminops-symbols" aria-hidden="true" focusable="false">
            <symbol id="adm-icon-grid" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect></symbol>
            <symbol id="adm-icon-dashboard" viewBox="0 0 24 24"><path d="M4 13h6v7H4zM14 4h6v16h-6zM4 4h6v5H4z"></path></symbol>
            <symbol id="adm-icon-data" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="7" ry="3"></ellipse><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5"></path><path d="M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path></symbol>
            <symbol id="adm-icon-import" viewBox="0 0 24 24"><path d="M5 4h10l4 4v12H5z"></path><path d="M15 4v4h4"></path><path d="M12 17V10"></path><path d="m9 13 3-3 3 3"></path></symbol>
            <symbol id="adm-icon-export" viewBox="0 0 24 24"><path d="M5 4h10l4 4v12H5z"></path><path d="M15 4v4h4"></path><path d="M12 10v7"></path><path d="m9 14 3 3 3-3"></path></symbol>
            <symbol id="adm-icon-report" viewBox="0 0 24 24"><path d="M5 4h14v16H5z"></path><path d="M8 16v-4M12 16V8M16 16v-6"></path></symbol>
            <symbol id="adm-icon-admin" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect></symbol>
            <symbol id="adm-icon-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19 13.5v-3l-2-.7-.7-1.7.9-1.9-2.1-2.1-1.9.9-1.7-.7L10.5 2h-3l-.7 2-1.7.7-1.9-.9L1.1 5.9 2 7.8l-.7 1.7-2 .7v3l2 .7.7 1.7-.9 1.9 2.1 2.1 1.9-.9 1.7.7.7 2h3l.7-2 1.7-.7 1.9.9 2.1-2.1-.9-1.9.7-1.7z" transform="translate(2.5 0)"></path></symbol>
            <symbol id="adm-icon-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M5 20a7 7 0 0 1 14 0"></path></symbol>
            <symbol id="adm-icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M3 19a6 6 0 0 1 12 0"></path><circle cx="17" cy="9" r="2.5"></circle><path d="M15.5 14.5A5 5 0 0 1 21 19"></path></symbol>
            <symbol id="adm-icon-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"></circle><path d="m11 12 8-8M16 7l2 2M14 9l2 2"></path></symbol>
            <symbol id="adm-icon-log" viewBox="0 0 24 24"><path d="M6 4h12v16H6z"></path><path d="M9 8h6M9 12h6M9 16h4"></path></symbol>
            <symbol id="adm-icon-api" viewBox="0 0 24 24"><path d="M8 7H5a3 3 0 0 0-3 3v4a3 3 0 0 0 3 3h3M16 7h3a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-3M8 12h8"></path></symbol>
            <symbol id="adm-icon-bell" viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 8h18c0-1-3-1-3-8"></path><path d="M10 21h4"></path></symbol>
            <symbol id="adm-icon-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></symbol>
            <symbol id="adm-icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
            <symbol id="adm-icon-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></symbol>
            <symbol id="adm-icon-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"></path></symbol>
            <symbol id="adm-icon-collapse" viewBox="0 0 24 24"><path d="M4 5h16v14H4zM9 5v14M15 9l-3 3 3 3"></path></symbol>
            <symbol id="adm-icon-monitor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4M7 11h2l2-4 3 8 2-4h2"></path></symbol>
        </svg>

        <div class="adminmega-shell" data-admin-mega-shell>
            <header class="adminmega-header">
                <div class="adminmega-utilitybar">
                    <div class="container-fluid adminmega-container adminmega-utilitybar-inner">
                        <div class="adminmega-utility-left">
                            <button class="adminmega-nav-toggle"
                                    type="button"
                                    data-admin-mega-nav-toggle
                                    aria-controls="adminmega-primary-nav"
                                    aria-expanded="false"
                                    aria-label="Mở hoặc đóng danh sách chức năng">
                                <svg aria-hidden="true"><use href="#adm-icon-menu"></use></svg>
                            </button>

                            <a class="adminmega-brand" href="@adminHomePath" aria-label="Mở trang quản trị">
                                <span class="adminmega-brand-mark" aria-hidden="true">
                                    <svg><use href="#adm-icon-grid"></use></svg>
                                </span>
                                <span class="adminmega-brand-copy">
                                    <strong>WebPhotocopyHub</strong>
                                    <small>Quản trị hệ thống</small>
                                </span>
                            </a>

                            <span class="adminmega-utility-divider" aria-hidden="true"></span>

                            <div class="adminmega-current-page">
                                <strong>@pageTitle</strong>
                                <small>@(selectedBranch?.Name ?? "Toàn hệ thống")</small>
                            </div>
                        </div>

                        <div class="adminmega-utility-actions">
                            <div class="dropdown adminmega-branch-switcher">
                                <button class="adminmega-branch-trigger dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <span>Phạm vi</span>
                                    <strong>@(selectedBranch?.Name ?? "Toàn hệ thống")</strong>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end adminmega-dropdown-menu">
                                    @if (User.IsInRole(RoleConstants.Admin))
                                    {
                                        <a class="dropdown-item @(selectedBranch is null ? "active" : string.Empty)"
                                           asp-area="Admin"
                                           asp-controller="Branches"
                                           asp-action="ClearSelection">Toàn hệ thống</a>
                                        <div class="dropdown-divider"></div>
                                    }

                                    @foreach (var branchItem in adminBranches)
                                    {
                                        <a class="dropdown-item @(selectedBranch?.Id == branchItem.Id ? "active" : string.Empty)"
                                           asp-area="Admin"
                                           asp-controller="Branches"
                                           asp-action="Select"
                                           asp-route-id="@branchItem.Id">
                                            @branchItem.Name
                                        </a>
                                    }

                                    @if (canOpenBranches)
                                    {
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Branches"
                                           asp-action="Index">Quản lý cơ sở</a>
                                    }
                                </div>
                            </div>

                            @if (canOpenMonitoring)
                            {
                                <a class="adminmega-health-link"
                                   asp-area="Admin"
                                   asp-controller="SystemMonitoring"
                                   asp-action="Index">
                                    <span aria-hidden="true"></span>
                                    <strong>Giám sát</strong>
                                </a>
                            }

                            @if (canOpenAuditLogs)
                            {
                                <a class="adminmega-icon-button"
                                   asp-area="Admin"
                                   asp-controller="AuditLogs"
                                   asp-action="Index"
                                   aria-label="Mở nhật ký kiểm toán">
                                    <svg aria-hidden="true"><use href="#adm-icon-bell"></use></svg>
                                </a>
                            }

                            <a class="adminmega-icon-button"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               aria-label="Mở trang chính">
                                <svg aria-hidden="true"><use href="#adm-icon-globe"></use></svg>
                            </a>

                            <div class="dropdown adminmega-account">
                                <button class="adminmega-account-trigger dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <span class="adminmega-account-avatar">@accountInitial</span>
                                    <span class="adminmega-account-copy">
                                        <strong>@accountName</strong>
                                        <small>@(selectedBranch is null ? "Quản trị toàn hệ thống" : selectedBranch.Name)</small>
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end adminmega-dropdown-menu adminmega-account-menu">
                                    <div class="adminmega-account-menu-head">
                                        <span class="adminmega-account-avatar">@accountInitial</span>
                                        <div>
                                            <strong>@accountName</strong>
                                            <small>Phiên quản trị đang hoạt động</small>
                                        </div>
                                    </div>

                                    @if (canOpenUsers)
                                    {
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Users"
                                           asp-action="Index">Tài khoản và phân quyền</a>
                                    }

                                    @if (canOpenAuditLogs)
                                    {
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="AuditLogs"
                                           asp-action="Index">Nhật ký kiểm toán</a>
                                    }

                                    @if (canOpenMonitoring)
                                    {
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="SystemMonitoring"
                                           asp-action="Index">Giám sát hệ thống</a>
                                    }

                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Index">Về trang chính</a>

                                    <form asp-area=""
                                          asp-controller="Account"
                                          asp-action="Logout"
                                          method="post"
                                          class="px-2 pb-1">
                                        <input type="hidden" name="returnUrl" value="/" />
                                        <button class="btn btn-outline-danger btn-sm w-100" type="submit">Đăng xuất</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="adminmega-navband" id="adminmega-primary-nav">
                    <div class="container-fluid adminmega-container adminmega-navband-inner">
                        @await Component.InvokeAsync("AdminNavigation", new { items = adminNavigation })
                    </div>
                </div>

                <div class="adminmega-contextbar">
                    <div class="container-fluid adminmega-container adminmega-contextbar-inner">
                        <nav class="adminmega-breadcrumb" aria-label="Breadcrumb">
                            <a href="@adminHomePath">Quản trị</a>
                            <span aria-hidden="true">/</span>
                            <span>@pageTitle</span>
                        </nav>

                        <span class="adminmega-access-note">
                            Quyền truy cập được áp dụng theo vai trò, chức năng và phạm vi cơ sở.
                        </span>
                    </div>
                </div>
            </header>

            <button class="adminmega-backdrop"
                    type="button"
                    data-admin-mega-close
                    aria-label="Đóng danh sách chức năng"></button>

            <main class="container-fluid system-admin-container system-admin-main adminops-main adminmega-main">
                <partial name="_Alert" />
                @RenderBody()
            </main>

            <footer class="adminmega-footer">
                <div class="container-fluid adminmega-container adminmega-footer-inner">
                    <span>WebPhotocopyHub Quản trị hệ thống</span>
                    <span>Quản trị an toàn, có kiểm soát và truy vết.</span>
                </div>
            </footer>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (!isAdminLoginPage)
    {
        <script src="~/_content/WebPhotocopyHub.Web.Admin/js/admin-navigation.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
