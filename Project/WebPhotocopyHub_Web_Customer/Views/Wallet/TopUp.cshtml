@model TopUpPageViewModel
@{
    ViewData["Title"] = "Nạp tiền";
    var suggestedContent = $"{Model.TransferContentPrefix}-{User.Identity?.Name}";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Top-up request</span>
            <h1>Tạo yêu cầu nạp tiền</h1>
            <p>Chuyển khoản theo thông tin bên dưới, nhập mã giao dịch và upload minh chứng nếu có để cơ sở duyệt nhanh hơn.</p>
            <div class="cu-actions">
                <a class="btn btn-outline-secondary" asp-action="Index">Ví của tôi</a>
                <a class="btn btn-outline-secondary" asp-action="TopUpHistory">Lịch sử nạp tiền</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Nội dung gợi ý</span>
            <strong>@suggestedContent</strong>
            <small>Điền nội dung này khi chuyển khoản để shop đối soát nhanh.</small>
        </aside>
    </section>

    <section class="cu-grid cu-grid--detail">
        <aside class="cu-card">
            <div class="cu-section-head">
                <div>
                    <span class="cu-kicker">Bank transfer</span>
                    <h2>Thông tin chuyển khoản</h2>
                </div>
            </div>

            <div class="cu-detail-list">
                <div><span>Ngân hàng</span><strong>@(string.IsNullOrWhiteSpace(Model.BankName) ? "Chưa cấu hình" : Model.BankName)</strong></div>
                <div><span>Số tài khoản</span><strong>@(string.IsNullOrWhiteSpace(Model.AccountNumber) ? "Chưa cấu hình" : Model.AccountNumber)</strong></div>
                <div><span>Chủ tài khoản</span><strong>@(string.IsNullOrWhiteSpace(Model.AccountName) ? "Chưa cấu hình" : Model.AccountName)</strong></div>
                <div class="cu-detail-list__full"><span>Nội dung</span><strong>@suggestedContent</strong></div>
            </div>
        </aside>

        <div class="cu-card">
            <div class="cu-section-head">
                <div>
                    <span class="cu-kicker">Form</span>
                    <h2>Thông tin yêu cầu</h2>
                </div>
            </div>

            <form asp-action="TopUp" method="post" enctype="multipart/form-data" class="cu-form">
                <input asp-for="Form.IdempotencyKey" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div>
                    <label asp-for="Form.Amount" class="form-label"></label>
                    <input asp-for="Form.Amount" class="form-control" />
                    <span asp-validation-for="Form.Amount" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Form.TransferContent" class="form-label"></label>
                    <input asp-for="Form.TransferContent" class="form-control" placeholder="@suggestedContent" />
                    <span asp-validation-for="Form.TransferContent" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Form.TransactionReferenceCode" class="form-label"></label>
                    <input asp-for="Form.TransactionReferenceCode" class="form-control" />
                    <span asp-validation-for="Form.TransactionReferenceCode" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Form.ProofFile" class="form-label"></label>
                    <input asp-for="Form.ProofFile" class="form-control" />
                    <span asp-validation-for="Form.ProofFile" class="text-danger small"></span>
                </div>

                <div class="cu-actions">
                    <button class="btn btn-primary" type="submit">Gửi yêu cầu nạp tiền</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                </div>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}