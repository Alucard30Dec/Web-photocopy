@model List<SupportServiceOrder>
@{
    ViewData["Title"] = "Lịch sử dịch vụ hỗ trợ";
}

<section class="cu-page">
    <section class="cu-hero">
        <div>
            <span class="cu-kicker">Support history</span>
            <h1>Lịch sử dịch vụ hỗ trợ</h1>
            <p>Theo dõi các đơn scan, đóng gáy, ép plastic, đánh máy hoặc hỗ trợ hoàn thiện tài liệu.</p>
            <div class="cu-actions">
                <a class="btn btn-primary" asp-action="Create">Tạo đơn dịch vụ mới</a>
            </div>
        </div>
        <aside class="cu-hero-card">
            <span class="cu-card-label">Tổng đơn</span>
            <strong>@Model.Count</strong>
            <small>Dịch vụ hỗ trợ của tài khoản hiện tại.</small>
        </aside>
    </section>

    <section class="cu-card">
        <div class="cu-table-wrap">
            <table class="table cu-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Dịch vụ</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6"><div class="cu-empty"><strong>Chưa có đơn dịch vụ.</strong><span>Hãy tạo yêu cầu dịch vụ hỗ trợ mới.</span></div></td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="cu-code">@item.Id</span></td>
                        <td>@item.SupportService?.Name</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end fw-semibold">@item.TotalAmount.ToString("N0") đ</td>
                        <td><span class="badge @item.Status.ToBadgeClass()">@item.Status.GetDisplayName()</span></td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>