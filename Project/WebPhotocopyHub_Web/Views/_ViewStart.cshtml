@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var branchSlug = ViewContext.RouteData.Values["branchSlug"]?.ToString();

    Layout = string.IsNullOrWhiteSpace(area) &&
        !string.IsNullOrWhiteSpace(branchSlug) &&
        !string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
            ? "_BranchCustomerLayout"
            : "_Layout";
}
