@model WebPhotocopyHub.Web.Models.ShopBranchLinkViewModel

@{
    ViewData["Title"] = Model.Name;

    var rootUrl = "/" + Model.Slug;
    var loginUrl = rootUrl + "/Login";
    var dashboardUrl = rootUrl + "/Dashboard";
    var printCreateUrl = rootUrl + "/PrintJobs/Create";
    var printJobsUrl = rootUrl + "/PrintJobs";
    var productsUrl = rootUrl + "/Products";
    var walletUrl = rootUrl + "/Wallet";
    var walletTopUpUrl = rootUrl + "/Wallet/TopUp";
    var supportUrl = rootUrl + "/SupportOrders/Create";
    var profileUrl = rootUrl + "/Profile";
    var isSignedIn = User?.Identity?.IsAuthenticated == true;

    var loginToPrintUrl = loginUrl + "?returnUrl=" + Uri.EscapeDataString(printCreateUrl);
    var loginToDashboardUrl = loginUrl + "?returnUrl=" + Uri.EscapeDataString(dashboardUrl);
    var loginToPrintJobsUrl = loginUrl + "?returnUrl=" + Uri.EscapeDataString(printJobsUrl);
    var loginToWalletUrl = loginUrl + "?returnUrl=" + Uri.EscapeDataString(walletUrl);
    var loginToProductsUrl = loginUrl + "?returnUrl=" + Uri.EscapeDataString(productsUrl);
    var loginToSupportUrl = loginUrl + "?returnUrl=" + Uri.EscapeDataString(supportUrl);
}

<section class="branch-customer-landing">
    <div class="branch-customer-hero">
        <div class="branch-customer-hero-copy">
            <span class="branch-customer-pill">Trang khách hàng</span>

            <h1>@Model.Name</h1>
            <p>@Model.ShortDescription</p>


            <div class="branch-customer-meta">
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>@Model.Address</span>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.63a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6.25 6.25l1.29-1.29a2 2 0 0 1 2.11-.45c.85.3 1.73.51 2.63.63A2 2 0 0 1 22 16.92z"></path></svg>@Model.PhoneNumber</span>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>@Model.OpenHours</span>
            </div>

            <div class="branch-customer-actions">
                @if (isSignedIn)
                {
                    <a class="branch-customer-btn branch-customer-btn--primary" href="@printCreateUrl">Tạo đơn in ngay</a>
                    <a class="branch-customer-btn branch-customer-btn--soft" href="@dashboardUrl">Vào tổng quan</a>
                }

                @if (!isSignedIn)
                {
                    <a class="branch-customer-btn branch-customer-btn--primary" href="@loginToPrintUrl">Đăng nhập để tạo đơn</a>
                    <a class="branch-customer-btn branch-customer-btn--soft" href="#branchCustomerFeaturesTitle">Xem chức năng</a>
                }
            </div>
        </div>

        <aside class="branch-customer-hero-panel">
            <span>Link cơ sở</span>
            <strong>@rootUrl</strong>
            <p>@Model.CustomerNote</p>

            @if (isSignedIn)
            {
                <a href="@dashboardUrl">Vào tổng quan khách hàng</a>
            }

            @if (!isSignedIn)
            {
                <a href="@loginToDashboardUrl">Đăng nhập vào cơ sở</a>
            }
        </aside>
    </div>

    <section class="branch-customer-section" aria-labelledby="branchCustomerFeaturesTitle">
        <div class="branch-customer-section-head">
            <span>Danh mục chức năng</span>

            @if (isSignedIn)
            {
                <h2 id="branchCustomerFeaturesTitle">Chức năng dành cho khách hàng đã đăng nhập</h2>
                <p>Truy cập nhanh các thao tác chính: tạo đơn in, theo dõi xử lý, thanh toán bằng ví và quản lý hồ sơ.</p>
            }

            @if (!isSignedIn)
            {
                <h2 id="branchCustomerFeaturesTitle">Chức năng dành cho khách chưa đăng nhập</h2>
                <p>Bạn có thể xem thông tin cơ sở trước. Các thao tác cá nhân như tạo đơn, theo dõi đơn và nạp ví sẽ yêu cầu đăng nhập.</p>
            }
        </div>

        @if (isSignedIn)
        {
            <div class="branch-customer-feature-grid branch-customer-feature-grid--signed-in">
                <a class="branch-customer-feature-card is-primary" href="@printCreateUrl">
                    <span>01</span>
                    <strong>Tạo đơn in</strong>
                    <small>Upload file, chọn khổ giấy, số bản, in màu hoặc trắng đen.</small>
                </a>

                <a class="branch-customer-feature-card" href="@printJobsUrl">
                    <span>02</span>
                    <strong>Theo dõi đơn in</strong>
                    <small>Xem trạng thái xác nhận, thanh toán, xử lý và nhận tài liệu.</small>
                </a>

                <a class="branch-customer-feature-card" href="@productsUrl">
                    <span>03</span>
                    <strong>Mua văn phòng phẩm</strong>
                    <small>Đặt thêm giấy, bút, bìa hồ sơ và các sản phẩm tại tiệm.</small>
                </a>

                <a class="branch-customer-feature-card" href="@supportUrl">
                    <span>04</span>
                    <strong>Dịch vụ hỗ trợ</strong>
                    <small>Đặt scan, đóng gáy, ép plastic hoặc các dịch vụ hoàn thiện.</small>
                </a>

                <a class="branch-customer-feature-card" href="@walletTopUpUrl">
                    <span>05</span>
                    <strong>Nạp ví</strong>
                    <small>Tạo yêu cầu nạp tiền để thanh toán đơn nhanh hơn.</small>
                </a>

                <a class="branch-customer-feature-card" href="@profileUrl">
                    <span>06</span>
                    <strong>Hồ sơ cá nhân</strong>
                    <small>Cập nhật thông tin liên hệ, địa chỉ nhận hàng và tài khoản.</small>
                </a>
            </div>
        }

        @if (!isSignedIn)
        {
            <div class="branch-customer-feature-grid branch-customer-feature-grid--guest">
                <a class="branch-customer-feature-card is-primary" href="@loginToPrintUrl">
                    <span>01</span>
                    <strong>Đăng nhập để tạo đơn</strong>
                    <small>Sau khi đăng nhập, bạn có thể upload file và gửi yêu cầu in cho cơ sở.</small>
                </a>

                <a class="branch-customer-feature-card is-locked" href="@loginToProductsUrl">
                    <span>02</span>
                    <strong>Đăng nhập để xem sản phẩm</strong>
                    <small>Sản phẩm thuộc khu khách hàng của cơ sở, vui lòng đăng nhập trước khi đặt mua.</small>
                </a>

                <a class="branch-customer-feature-card is-locked" href="@loginToSupportUrl">
                    <span>03</span>
                    <strong>Đăng nhập để đặt dịch vụ</strong>
                    <small>Dịch vụ hỗ trợ thuộc khu khách hàng của cơ sở, vui lòng đăng nhập trước khi tạo yêu cầu.</small>
                </a>

                <a class="branch-customer-feature-card is-locked" href="@loginToPrintJobsUrl">
                    <span>04</span>
                    <strong>Theo dõi đơn in</strong>
                    <small>Cần đăng nhập để xem trạng thái và lịch sử đơn của bạn.</small>
                </a>

                <a class="branch-customer-feature-card is-locked" href="@loginToWalletUrl">
                    <span>05</span>
                    <strong>Nạp ví</strong>
                    <small>Cần đăng nhập để tạo yêu cầu nạp tiền và xem lịch sử giao dịch.</small>
                </a>

                <a class="branch-customer-feature-card is-locked" href="@loginToDashboardUrl">
                    <span>06</span>
                    <strong>Vào trang khách hàng</strong>
                    <small>Đăng nhập để mở tổng quan cá nhân tại cơ sở này.</small>
                </a>
            </div>
        }
    </section>

    <section class="branch-customer-section branch-customer-section--split">
        <div>
            <span class="branch-customer-pill">Dịch vụ phổ biến</span>
            <h2>Khách có thể đặt nhanh các nhu cầu in ấn thường gặp</h2>
        </div>

        <div class="branch-customer-service-list">
            @foreach (var service in Model.PopularServices)
            {
                <span>@service</span>
            }
        </div>
    </section>
</section>