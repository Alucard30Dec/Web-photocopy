@model WebPhotocopyHub.Web.Models.ShopDirectoryViewModel

@{
    Layout = "_ShopDirectoryLayout";
    ViewData["Title"] = "Danh sách tiệm photocopy";
}

<section class="shop-directory-hero" aria-labelledby="shopDirectoryTitle">
    <span class="shop-hero-dots shop-hero-dots--left" aria-hidden="true"></span>
    <span class="shop-hero-dots shop-hero-dots--right" aria-hidden="true"></span>
    <span class="shop-hero-cloud shop-hero-cloud--left" aria-hidden="true"></span>
    <span class="shop-hero-cloud shop-hero-cloud--right" aria-hidden="true"></span>

    <div class="shop-hero-illustration" aria-hidden="true">
        <svg viewBox="0 0 170 130">
            <path class="shop-ill-shadow" d="M25 114h106"></path>
            <path class="shop-ill-tree" d="M23 94V70"></path>
            <circle class="shop-ill-leaf" cx="23" cy="66" r="12"></circle>
            <path class="shop-ill-wall" d="M44 54h78v55H44z"></path>
            <path class="shop-ill-roof" d="M37 36h91l9 23H47z"></path>
            <path class="shop-ill-awning" d="M47 59h83v19H47z"></path>
            <path class="shop-ill-awning-stripe" d="M68 59v19M92 59v19M116 59v19"></path>
            <path class="shop-ill-door" d="M58 78h22v31H58z"></path>
            <path class="shop-ill-window" d="M92 78h24v21H92z"></path>
            <path class="shop-ill-pin" d="M145 71c9 0 16 7 16 16 0 12-16 26-16 26s-16-14-16-26c0-9 7-16 16-16z"></path>
            <circle class="shop-ill-pin-dot" cx="145" cy="87" r="5"></circle>
        </svg>
    </div>

    <div class="shop-hero-copy">
        <span class="shop-route-pill">WebPhotocopyHub</span>
        <h1 id="shopDirectoryTitle">Chọn cơ sở <span>photocopy</span></h1>
        <p>Chọn tiệm photocopy gần bạn để vào trang khách hàng, gửi file và tạo đơn in nhanh.</p>
    </div>
</section>

<section class="shop-directory-benefits" aria-label="Lợi ích khi đặt in qua WebPhotocopyHub">
    <article>
        <span class="shop-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
        <div><strong>Bảo mật</strong><small>An toàn tuyệt đối</small></div>
    </article>
    <article>
        <span class="shop-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m13 2-8 12h7l-1 8 8-12h-7z"></path></svg></span>
        <div><strong>Nhanh chóng</strong><small>Xử lý siêu tốc</small></div>
    </article>
    <article>
        <span class="shop-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2 15 5l4-.5.5 4 3 3-3 3-.5 4-4-.5-3 3-3-3-4 .5-.5-4-3-3 3-3 .5-4 4 .5z"></path><path d="m8.5 12 2.2 2.2 4.8-5"></path></svg></span>
        <div><strong>Chất lượng</strong><small>In sắc nét, chuẩn màu</small></div>
    </article>
    <article>
        <span class="shop-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="7" ry="3"></ellipse><path d="M5 5v10c0 1.7 3.1 3 7 3s7-1.3 7-3V5"></path><path d="M5 10c0 1.7 3.1 3 7 3s7-1.3 7-3"></path><path d="M17 19h5M19.5 16.5V21.5"></path></svg></span>
        <div><strong>Tiết kiệm</strong><small>Giá tốt, nhiều ưu đãi</small></div>
    </article>
    <article>
        <span class="shop-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13a8 8 0 0 1 16 0"></path><path d="M4 13v4a2 2 0 0 0 2 2h2v-8H6a2 2 0 0 0-2 2z"></path><path d="M20 13v4a2 2 0 0 1-2 2h-2v-8h2a2 2 0 0 1 2 2z"></path></svg></span>
        <div><strong>Hỗ trợ 24/7</strong><small>Đội ngũ tận tâm</small></div>
    </article>
</section>

<section class="shop-directory-grid" aria-label="Danh sách cơ sở photocopy">
    @foreach (var branch in Model.Branches)
    {
        var shortUrl = "/" + branch.Slug;

        <a class="shop-directory-card" href="@shortUrl" aria-label="Vào trang khách hàng của @branch.Name">
            <span class="shop-directory-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 10h18l-1.5-6h-15z"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg>
            </span>

            <div class="shop-directory-content">
                <span class="shop-directory-slug">@shortUrl</span>
                <h2>@branch.Name</h2>
                <p>@branch.ShortDescription</p>

                <dl>
                    <div>
                        <dt>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            Địa chỉ
                        </dt>
                        <dd>@branch.Address</dd>
                    </div>
                    <div>
                        <dt>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                            Liên hệ
                        </dt>
                        <dd>@branch.PhoneNumber</dd>
                    </div>
                    <div>
                        <dt>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                            Trạng thái
                        </dt>
                        <dd><span class="shop-status-dot" aria-hidden="true"></span>Hoạt động</dd>
                    </div>
                </dl>

                <div class="shop-directory-actions">
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M11 8l4 4-4 4"></path><path d="M7 12h8"></path></svg>Vào trang khách hàng</span>
                </div>
            </div>
        </a>
    }
</section>

<section class="shop-security-panel" aria-label="Cam kết bảo mật">
    <div class="shop-security-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6z"></path><path d="m9 12 2 2 4-5"></path></svg>
    </div>
    <div class="shop-security-copy">
        <h2>Thông tin của bạn luôn được bảo mật</h2>
        <p>Chúng tôi cam kết bảo vệ dữ liệu cá nhân và tệp tin của bạn.</p>
    </div>
    <div class="shop-security-items">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>Mã hoá dữ liệu</span>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 18a5 5 0 0 0-1-9.9A7 7 0 0 0 2 10a4 4 0 0 0 2 7.5"></path><path d="M8 18h9"></path></svg>Lưu trữ an toàn</span>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6z"></path><path d="m9 12 2 2 4-5"></path></svg>Không chia sẻ</span>
    </div>
    <div class="shop-security-illustration" aria-hidden="true">
        <svg viewBox="0 0 150 92">
            <path d="M42 22h58l8 14v38H42z"></path>
            <path d="M100 22v15h15"></path>
            <path d="M20 49h78l10 33H30z"></path>
            <path d="M106 56h27v27h-27z"></path>
            <path d="M113 56v-7a6.5 6.5 0 0 1 13 0v7"></path>
            <circle cx="119.5" cy="70" r="3"></circle>
        </svg>
    </div>
</section>
