<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebPhotocopyHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var isHome = controller == "Home" && action == "Index";
    var isCustomer = controller == "Home" && (action == "Customer" || action == "CustomerPortfolio");
    var isShopIntro = controller == "Home" && (action == "Shop" || action == "ShopPortfolio");
}
<header class="pc-site-header">
    <nav class="navbar navbar-expand-lg pc-navbar" aria-label="Điều hướng chính">
        <div class="container-fluid px-0">
            <a class="pc-brand navbar-brand" href="/Home" aria-label="WebPhotocopyHub trang chủ">
                <span class="pc-brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 3h8v4H8z"/><path d="M6 7h12a3 3 0 0 1 3 3v5h-4v6H7v-6H3v-5a3 3 0 0 1 3-3z"/><path d="M9 15h6M9 18h6"/></svg>
                </span>
                <span>PhotoCopy<span>Hub</span></span>
            </a>

            <button class="navbar-toggler pc-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav pc-nav-links mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(isHome ? "active" : string.Empty)" href="/Home">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isCustomer ? "active" : string.Empty)" href="/Customer">Dành cho khách hàng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isShopIntro ? "active" : string.Empty)" href="/Shop">Dành cho tiệm photocopy</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="pc-site-main">
    <div class="pc-alert-wrap">
        <partial name="_Alert" />
    </div>
    @RenderBody()
</main>

<footer class="pc-footer">
    <div class="pc-footer-grid">
        <div class="pc-footer-brand">
            <a class="pc-brand pc-brand--footer" href="/Home">
                <span class="pc-brand-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 3h8v4H8z"/><path d="M6 7h12a3 3 0 0 1 3 3v5h-4v6H7v-6H3v-5a3 3 0 0 1 3-3z"/><path d="M9 15h6M9 18h6"/></svg></span>
                <span>PhotoCopy<span>Hub</span></span>
            </a>
            <p>Nền tảng web photocopy hiện đại cho khách hàng và tiệm photo.</p>
        </div>

        <div>
            <h3>Sản phẩm</h3>
            <a href="/Customer">Dành cho khách hàng</a>
            <a href="/Shop">Dành cho tiệm photocopy</a>
        </div>
        <div>
            <h3>Hỗ trợ</h3>
            <a href="/Customer#customerFlow">Quy trình đặt in</a>
            <a href="/Shop#shopFlow">Quy trình vận hành tiệm</a>
        </div>
        <div>
            <h3>Công ty</h3>
            <a asp-controller="Home" asp-action="About">Về chúng tôi</a>
            <a href="/Home">Trang chủ</a>
        </div>
        <div class="pc-footer-contact">
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="m4 6 8 7 8-7"/></svg> contact@webphotocopyhub.vn</p>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.1 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.63 2.63a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6.25 6.25l1.29-1.29a2 2 0 0 1 2.11-.45c.85.3 1.73.51 2.63.63A2 2 0 0 1 22 16.92z"/></svg> 028 1234 5678</p>
            <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> TP. Hồ Chí Minh, Việt Nam</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
