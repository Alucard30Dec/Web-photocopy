@model AdminDashboardPageViewModel
@{
    ViewData["Title"] = "Dashboard quản trị hệ thống";
    var healthClass = string.Equals(Model.HealthStatus, "Healthy", StringComparison.OrdinalIgnoreCase)
        ? "is-success"
        : string.Equals(Model.HealthStatus, "Degraded", StringComparison.OrdinalIgnoreCase)
            ? "is-warning"
            : "is-danger";
}

<section class="adminref-dashboard-hero">
    <div class="adminref-dashboard-hero-copy">
        <span class="adminref-eyebrow">System administration center</span>
        <h1>Dashboard quản trị toàn hệ thống</h1>
        <p>Theo dõi tài khoản, giao dịch, đơn hàng, danh mục...</p>
        <div class="adminref-hero-meta">
            <span class="adminref-health-chip @healthClass"><i aria-hidden="true"></i>Health: @Model.HealthStatus</span>
            <span class="adminref-soft-chip">@Model.ApiEndpointCount API endpoints</span>
            <span class="adminref-soft-chip">@Model.ActivityLast24Hours hoạt động / 24 giờ</span>
        </div>
    </div>
    <div class="adminref-hero-actions">
        <a class="adminref-primary-button" asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index">Mở trung tâm giám sát</a>
        <a class="adminref-outline-button" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Tra cứu audit log</a>
    </div>
    <span class="adminref-hero-orb" aria-hidden="true"></span>
</section>

<section class="adminref-kpi-grid" aria-label="Chỉ số quản trị chính">
    <a class="adminref-kpi-card tone-blue" asp-area="Admin" asp-controller="Users" asp-action="Index">
        <div><span>Tổng tài khoản</span><strong>@Model.Summary.TotalUsers</strong><small>Quản lý trạng thái, role và số dư</small></div>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M5 21a7 7 0 0 1 14 0"></path></svg></i>
    </a>
    <a class="adminref-kpi-card tone-amber" asp-area="Admin" asp-controller="TopUpRequests" asp-action="Index">
        <div><span>Top-up chờ duyệt</span><strong>@Model.Summary.PendingTopUps</strong><small>Luồng tiền cần xử lý và đối soát</small></div>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v12H4z"></path><path d="M4 10h16M16 14h2"></path><path d="M7 4h10"></path></svg></i>
    </a>
    <a class="adminref-kpi-card tone-cyan" asp-area="Admin" asp-controller="PrintJobs" asp-action="Index">
        <div><span>Đơn in đang xử lý</span><strong>@Model.Summary.PrintJobsPending</strong><small>Theo dõi trạng thái, file và SLA</small></div>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h12v5H6zM5 9h14a2 2 0 0 1 2 2v6h-4v3H7v-3H3v-6a2 2 0 0 1 2-2Z"></path><path d="M9 15h6v5H9z"></path></svg></i>
    </a>
    <a class="adminref-kpi-card tone-violet" asp-area="Admin" asp-controller="WalletTransactions" asp-action="Index">
        <div><span>Giao dịch ví</span><strong>@Model.Summary.TotalWalletTransactions</strong><small>Tra cứu biến động và tham chiếu</small></div>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h15v13H4z"></path><path d="M16 10h5v5h-5a2.5 2.5 0 0 1 0-5Z"></path><path d="M7 3h10"></path></svg></i>
    </a>
    <a class="adminref-kpi-card tone-green" asp-area="Admin" asp-controller="Products" asp-action="Index">
        <div><span>Sản phẩm hoạt động</span><strong>@Model.Summary.ActiveProducts</strong><small>Danh mục, giá và tồn kho</small></div>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7 12 3l8 4-8 4-8-4Z"></path><path d="M4 7v10l8 4 8-4V7M12 11v10"></path></svg></i>
    </a>
    <a class="adminref-kpi-card tone-sky" asp-area="Admin" asp-controller="SupportServices" asp-action="Index">
        <div><span>Dịch vụ hoạt động</span><strong>@Model.Summary.ActiveSupportServices</strong><small>Đơn giá và kiểu tính phí</small></div>
        <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 12h2M10 12h10M4 17h8M16 17h4"></path><circle cx="16" cy="7" r="2"></circle><circle cx="8" cy="12" r="2"></circle><circle cx="14" cy="17" r="2"></circle></svg></i>
    </a>
</section>

<div class="adminref-dashboard-grid">
    <section class="adminref-panel adminref-priority-panel">
        <header class="adminref-panel-header">
            <div><span>Điều phối ưu tiên</span><h2>Việc cần kiểm soát ngay</h2></div>
            <small>Dữ liệu lấy từ service hiện có <i aria-hidden="true">ⓘ</i></small>
        </header>
        <div class="adminref-priority-grid">
            <a class="adminref-priority-card is-hot" asp-area="Admin" asp-controller="TopUpRequests" asp-action="Index">
                <em>01</em><strong>Duyệt top-up</strong><small>Kiểm tra chứng từ, trạng thái và idempotency.</small><b>@Model.Summary.PendingTopUps</b>
            </a>
            <a class="adminref-priority-card" asp-area="Admin" asp-controller="PrintJobs" asp-action="Index">
                <em>02</em><strong>Điều phối đơn in</strong><small>Kiểm soát file, tiến độ và hoàn tiền.</small><b>@Model.Summary.PrintJobsPending</b>
            </a>
            <a class="adminref-priority-card" asp-area="Admin" asp-controller="Reconciliation" asp-action="Index">
                <em>03</em><strong>Đối soát ví</strong><small>Phát hiện chênh lệch giữa số dư và lịch sử.</small><b>→</b>
            </a>
        </div>
    </section>

    <aside class="adminref-panel adminref-control-panel">
        <header class="adminref-panel-header">
            <div><span>Security &amp; observability</span><h2>Trạng thái kiểm soát</h2></div>
        </header>
        <div class="adminref-control-list">
            <a asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index"><span>Health checks</span><strong class="@healthClass">@Model.HealthStatus</strong></a>
            <a asp-area="Admin" asp-controller="SystemMonitoring" asp-action="Index"><span>API inventory</span><strong>@Model.ApiEndpointCount endpoints</strong></a>
            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><span>Audit chain</span><strong class="@(Model.IsAuditChainValid ? "is-success" : "is-danger")">@(Model.IsAuditChainValid ? "Hợp lệ" : "Cần kiểm tra")</strong></a>
            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><span>Activity 24 giờ</span><strong>@Model.ActivityLast24Hours bản ghi</strong></a>
        </div>
    </aside>
</div>

<section class="adminref-panel adminref-capability-panel">
    <header class="adminref-panel-header">
        <div><span>Quyền quản trị hiện có</span><h2>Trung tâm chức năng</h2></div>
        <small>Mỗi action vẫn được bảo vệ bằng role Admin tại controller <i aria-hidden="true">ⓘ</i></small>
    </header>
    <div class="adminref-capability-grid">
        <a class="adminref-capability-card" asp-area="Admin" asp-controller="Users" asp-action="Index">
            <span>Danh tính</span><h3>Người dùng và phân quyền</h3><p>Khóa/mở tài khoản, thay đổi role, điều chỉnh ví và kiểm soát quyền quản trị.</p>
        </a>
        <a class="adminref-capability-card" asp-area="Admin" asp-controller="Reconciliation" asp-action="Index">
            <span>Tài chính</span><h3>Ví, top-up và đối soát</h3><p>Duyệt nạp tiền, tra cứu giao dịch và kiểm tra tính nhất quán số dư.</p>
        </a>
        <a class="adminref-capability-card" asp-area="Admin" asp-controller="ProductOrders" asp-action="Index">
            <span>Vận hành</span><h3>Đơn hàng toàn hệ thống</h3><p>Quản lý đơn in, đơn sản phẩm, dịch vụ hỗ trợ và biến động kho.</p>
        </a>
        <a class="adminref-capability-card" asp-area="Admin" asp-controller="PricingRules" asp-action="Index">
            <span>Cấu hình</span><h3>Danh mục và bảng giá</h3><p>Thiết lập sản phẩm, dịch vụ hỗ trợ và quy tắc giá in đang áp dụng.</p>
        </a>
    </div>
</section>

<section class="adminref-panel adminref-activity-panel">
    <header class="adminref-panel-header">
        <div><span>Activity tracking</span><h2>Hoạt động gần đây</h2></div>
        <a class="adminref-outline-button compact" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Xem toàn bộ</a>
    </header>
    <div class="adminref-activity-list">
        @if (Model.RecentActivities.Count == 0)
        {
            <div class="adminref-empty-state">Chưa có bản ghi audit nào.</div>
        }
        else
        {
            @foreach (var item in Model.RecentActivities)
            {
                <a class="adminref-activity-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" asp-route-query="@item.Action">
                    <i aria-hidden="true"></i>
                    <div><strong>@item.Action</strong><small>@item.EntityName · @(item.EntityId ?? "Không có mã")</small></div>
                    <time>@item.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time>
                </a>
            }
        }
    </div>
</section>
