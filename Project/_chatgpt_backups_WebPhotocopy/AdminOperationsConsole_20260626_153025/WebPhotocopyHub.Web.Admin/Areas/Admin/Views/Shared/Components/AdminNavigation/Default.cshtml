@model AdminNavigationViewModel
@using WebPhotocopyHub.Application.DTOs
@{
    IEnumerable<(SystemNavigationItemDto Item, int Level)> Flatten(
        IEnumerable<SystemNavigationItemDto> items,
        int level = 0)
    {
        foreach (var item in items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
        {
            yield return (item, level);
            foreach (var child in Flatten(item.Children, level + 1))
            {
                yield return child;
            }
        }
    }

    bool IsActive(SystemNavigationItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Controller)
            && string.Equals(
                item.Controller,
                Model.CurrentController,
                StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return item.Children.Any(IsActive);
    }
}

<nav class="adminref-primary-nav" aria-label="Điều hướng quản trị">
    @foreach (var item in Model.Items)
    {
        var activeClass = IsActive(item) ? "active" : string.Empty;
        var hasChildren = item.Children.Count > 0;

        if (!hasChildren && !string.IsNullOrWhiteSpace(item.Controller))
        {
            <a class="adminref-nav-item @activeClass"
               asp-area="@item.Area"
               asp-controller="@item.Controller"
               asp-action="@(item.Action ?? "Index")">
                <svg aria-hidden="true"><use href="#adm-icon-@item.IconKey"></use></svg>
                <span>@item.Name</span>
            </a>
        }
        else
        {
            <div class="adminref-nav-group">
                <button class="adminref-nav-item adminref-nav-trigger @activeClass"
                        type="button"
                        aria-expanded="false"
                        aria-haspopup="true">
                    <svg aria-hidden="true"><use href="#adm-icon-@item.IconKey"></use></svg>
                    <span>@item.Name</span>
                    <i class="adminref-nav-chevron" aria-hidden="true">⌄</i>
                </button>
                <div class="adminref-nav-dropdown" role="menu">
                    @foreach (var childEntry in Flatten(item.Children))
                    {
                        var child = childEntry.Item;
                        var indentStyle = childEntry.Level > 0
                            ? $"padding-left:{16 + childEntry.Level * 14}px"
                            : string.Empty;

                        if (!string.IsNullOrWhiteSpace(child.Controller))
                        {
                            <a class="@(IsActive(child) ? "active" : string.Empty)"
                               asp-area="@child.Area"
                               asp-controller="@child.Controller"
                               asp-action="@(child.Action ?? "Index")"
                               style="@indentStyle"
                               role="menuitem">
                                <svg aria-hidden="true"><use href="#adm-icon-@child.IconKey"></use></svg>
                                <span>@child.Name</span>
                            </a>
                        }
                        else
                        {
                            <div class="adminref-nav-section-label" style="@indentStyle">
                                @child.Name
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</nav>
