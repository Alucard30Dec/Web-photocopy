@model AdminNavigationViewModel
@using WebPhotocopyHub.Application.DTOs
@{
    IEnumerable<(SystemNavigationItemDto Item, int Level)> Flatten(IEnumerable<SystemNavigationItemDto> items, int level = 0)
    {
        foreach (var item in items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
        {
            yield return (item, level);
            foreach (var child in Flatten(item.Children, level + 1))
            {
                yield return child;
            }
        }
    }

    bool IsActive(SystemNavigationItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Controller)
            && string.Equals(item.Controller, Model.CurrentController, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return item.Children.Any(IsActive);
    }
}

<nav class="adminops-nav" aria-label="Chức năng quản trị">
    <span class="adminops-nav-caption">Điều hướng</span>

    @if (Model.Items.Count == 0)
    {
        <div class="adminops-nav-empty">Không có chức năng phù hợp với quyền hiện tại.</div>
    }

    @foreach (var item in Model.Items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
    {
        var isActive = IsActive(item);
        var activeClass = isActive ? "active" : string.Empty;
        var hasChildren = item.Children.Count > 0;
        var panelId = $"adminops-nav-{item.Id:N}";

        if (!hasChildren && !string.IsNullOrWhiteSpace(item.Controller))
        {
            <a class="adminops-nav-link @activeClass"
               asp-area="@item.Area"
               asp-controller="@item.Controller"
               asp-action="@(item.Action ?? "Index")"
               title="@item.Name">
                <svg aria-hidden="true"><use href="#adm-icon-@item.IconKey"></use></svg>
                <span>@item.Name</span>
            </a>
        }

        if (hasChildren)
        {
            <section class="adminops-nav-group @(isActive ? "is-open active" : string.Empty)">
                <button class="adminops-nav-group-trigger"
                        type="button"
                        data-admin-nav-toggle
                        aria-expanded="@(isActive ? "true" : "false")"
                        aria-controls="@panelId"
                        title="@item.Name">
                    <svg aria-hidden="true"><use href="#adm-icon-@item.IconKey"></use></svg>
                    <span>@item.Name</span>
                    <svg class="adminops-nav-chevron" aria-hidden="true"><use href="#adm-icon-chevron"></use></svg>
                </button>
                <div class="adminops-nav-children" id="@panelId">
                    @foreach (var childEntry in Flatten(item.Children))
                    {
                        var child = childEntry.Item;
                        var childLevel = Math.Min(childEntry.Level, 3);

                        if (!string.IsNullOrWhiteSpace(child.Controller))
                        {
                            <a class="adminops-nav-child level-@childLevel @(IsActive(child) ? "active" : string.Empty)"
                               asp-area="@child.Area"
                               asp-controller="@child.Controller"
                               asp-action="@(child.Action ?? "Index")">
                                <svg aria-hidden="true"><use href="#adm-icon-@child.IconKey"></use></svg>
                                <span>@child.Name</span>
                            </a>
                        }

                        if (string.IsNullOrWhiteSpace(child.Controller))
                        {
                            <div class="adminops-nav-section-label level-@childLevel">@child.Name</div>
                        }
                    }
                </div>
            </section>
        }
    }
</nav>
